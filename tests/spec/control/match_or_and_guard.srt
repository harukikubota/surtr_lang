def is_even(n: Int) -> Boolean {
  Int::is_even(n)
}

print(match "b" {
  "a" | "b" => "ab",
  _ => "other",
})

print(match 8 {
  num when is_even(num) => "even",
  _ => "odd",
})

print(match 5 {
  num when 0 < num `and` num < 10 => "in-range",
  _ => "out-range",
})

print(match 12 {
  num when 0 < num `and` num < 10 => "in-range",
  _ => "out-range",
})
