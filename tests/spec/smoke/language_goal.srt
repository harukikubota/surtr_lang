match flag {
  True  => print("flag is true"),
  False => print("flag is false"),
}

result: Result<Int> = Ok(42)
match result {
  Ok(val)  => print(to_string(val)),
  Err(e)   => print("error"),
}

deferror MyError {
  "something went wrong"
}

err_result: Result<Int> = Err(MyError)
match err_result {
  Ok(val)  => print(to_string(val)),
  Err(e)   => print("got error"),
}

msg = "hello" ++ " world"
