some: Option<Int> = Option::Some(7)
none: Option<Int> = Option::None
wrapped: Option<String> = Option::wrap("wrapped")

print(to_string(Option::is_some(some)))
print(to_string(Option::is_some(none)))
print(to_string(Option::is_none(some)))
print(to_string(Option::is_none(none)))

print(match some {
  Option::Some(value) => to_string(value),
  Option::None => "none",
})

print(match none {
  Option::Some(value) => to_string(value),
  Option::None => "none",
})

print(inspect(from(some, Result)))
print(inspect(from(none, Result)))
print(inspect(from(Option::Some(1), Result)))
print(inspect(from(Ok(9), Option)))
print(inspect(from(Err(NoneError), Option)))
print(inspect(wrapped))
