some: Option<Int> = Option::Some(7)
none: Option<Int> = Option::None
wrapped: Option<String> = Option::wrap("wrapped")

print(to_string(Option::is_some(some)))
print(to_string(Option::is_some(none)))
print(to_string(Option::is_none(some)))
print(to_string(Option::is_none(none)))

print(match some {
  Option::Some(value) => to_string(value),
  Option::None => "none",
})

print(match none {
  Option::Some(value) => to_string(value),
  Option::None => "none",
})

print(inspect(from(some, Result)))
print(inspect(from(none, Result)))
print(inspect(from(Option::Some(1), Result)))
print(inspect(from(Ok(9), Option)))
print(inspect(from(Err(NoneError), Option)))
print(inspect(wrapped))

def inc(value: Int) -> Int {
  value + 1
}

def double_if_small(value: Int) -> Option<Int> {
  if(value < 10, Option::Some(value * 2), Option::None)
}

def maybe_inc(value: Int) -> Option<Int> {
  if(value < 10, Option::Some(value + 1), Option::None)
}

lifted = &maybe_inc >* &inc
chained = &maybe_inc >=> &double_if_small

print(inspect(some |*> inc()))
print(inspect(none |*> inc()))
print(inspect(some |>= double_if_small()))
print(inspect(none |>= double_if_small()))
print(inspect(lifted(7)))
print(inspect(lifted(10)))
print(inspect(chained(4)))
print(inspect(chained(10)))
