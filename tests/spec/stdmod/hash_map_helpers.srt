empty = HashMap::empty()
print(inspect(empty))

map = HashMap::insert(empty, "a", 1)
map = HashMap::insert(map, "b", 2)
print(inspect(map))
print(to_string(HashMap::len(map)))
print(to_string(HashMap::contains_key(map, "a")))
print(to_string(HashMap::contains_key(map, "z")))
print(to_string(HashMap::get(map, "a")))
print(to_string(HashMap::get(map, "z")))

from_entries = HashMap::from_entries([("b", 2), ("a", 1), ("a", 3)])
print(inspect(from_entries))

removed = HashMap::remove(from_entries, "b")
print(inspect(removed))
print(inspect(HashMap::remove(removed, "missing")))

print(to_string(HashMap::keys(from_entries)))
print(to_string(HashMap::values(from_entries)))
print(to_string(HashMap::entries(from_entries)))
print(inspect(HashMap::map_values(from_entries, {|v| v * 10})))

escaped = HashMap::from_entries([
  ("line\nfeed", 1),
  ("path\\to", 2),
  ("say\"hi", 3),
  ("tab\tchar", 4),
])
print(inspect(escaped))
