defstruct User {
  name: String,
  age: Int,
}

impl User {
  def new(name: String, age: Int) -> Self {
    User { name: name, age: age }
  }

  def greeting(self) -> String {
    "hello " ++ self.name
  }
}

user = User(age: 30, name: "alice")
print(User::greeting(user))

defenum Light {
  Red,
  Green,
}

impl Light {
  def is_green(self: Self) -> Boolean {
    match self {
      Light::Green => True,
      _ => False,
    }
  }
}

print(to_string(Light::is_green(Light::Green)))
print(to_string(Light::is_green(Light::Red)))
