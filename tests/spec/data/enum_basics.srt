defenum Direction {
  Up,
  Down,
  Left,
  Right,
}

up: Direction = Direction::Up
down: Direction = Direction::Down
print(to_string(up == down))
print(to_string(up != down))
print(match up {
  Direction::Up => "U",
  Direction::Down => "D",
  Direction::Left => "L",
  Direction::Right => "R",
})

defenum KeyInput {
  Arrow(Direction),
  Enter,
  Space,
}

key: KeyInput = KeyInput::Arrow(Direction::Left)
print(match key {
  KeyInput::Arrow(dir) => match dir {
    Direction::Up => "U",
    Direction::Down => "D",
    Direction::Left => "L",
    Direction::Right => "R",
  },
  KeyInput::Enter => "E",
  KeyInput::Space => "S",
})

defenum Code {
  A = 1,
  B,
  C = 10,
  D,
}

print(to_string(Code::B == Code::D))
print(match Code::D {
  Code::A => "A",
  Code::B => "B",
  Code::C => "C",
  Code::D => "D",
})
