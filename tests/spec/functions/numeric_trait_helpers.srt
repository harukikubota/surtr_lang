def double<$N: Add>(x: $N) -> $N {
  x + x
}

def show_abs(x: impl Numeric) -> String {
  to_string(Numeric::abs(x))
}

def pick_max<$N: Numeric>(left: $N, right: $N) -> $N {
  Numeric::max(left, right)
}

print(to_string(add(1, 2)))
print(to_string(Add::add(1, 2)))
print(to_string(double(21)))
print(to_string(double(1.25)))
print(to_string(pick_max(3, 7)))
print(to_string(pick_max(3.5, 1.25)))
print(show_abs(-9))
print(show_abs(-2.5))
print(inspect(Numeric::safe_div(8, 2)))
print(inspect(Numeric::safe_div(9.0, 3.0)))
