def parse_csv(text: String) -> Result<List<Int>> {
  Ok([1, 2, 3])
}

def expand(n: Int) -> List<Int> {
  [n, n + 10]
}

def show(n: Int) -> String {
  "#" ++ to_string(n)
}

nums =? parse_csv("1,2,3")
[head, ..tail] =? nums

print(to_string(head))
print(to_string(tail |>= expand()))
print(to_string((head |> List::wrap()) |*> show()))
