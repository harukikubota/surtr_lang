defagent Logger {
  meta {
    instance: Singleton
    init_policy: Eager
    state: Int
    handlers {
      out: OutHandler = StdOut
    }
  }

  @init
  def init() -> Result<Int> {
    Ok(0)
  }

  @get
  def log(state: Int, message: String) -> Result<Unit> {
    OutHandler::write(ctx.out, message)
  }
}

supervisor_init {
  singleton Logger {
    handlers {
      out: NullOutHandler
    }
  }
}
