@process_state(Counter)
defstruct CounterState {
  value: Int,
}

defagent Counter {
  meta {
    instance: Singleton
    init_policy: Eager
  }

  @init
  def init() -> Result<CounterState> {
    Ok(CounterState { value: 41 })
  }

  @get
  def get(state: CounterState, label: String) -> Result<String> {
    Ok(label ++ ":" ++ to_string(state.value + 1))
  }

  @set
  def set(state: CounterState, next: Int) -> Result<CounterState> {
    if(next >= 0,
      Ok(CounterState { value: next }),
      Ok(state)
    )
  }
}
