@process_state(CounterServer)
defstruct CounterState {
  value: Int,
}

defgenserver CounterServer {
  meta {
    instance: Singleton
    init_policy: Eager
  }

  @init
  def init() -> Result<CounterState> {
    Ok(CounterState { value: 0 })
  }

  @call
  def get(state: CounterState) -> Result<(Int, String)> {
    Ok((state.value, to_string(state.value)))
  }

  @cast
  def set(_state: CounterState, next: Int) -> Result<CounterState> {
    Ok(CounterState { value: next })
  }
}
