@process_state(Counter)
defstruct CounterState {
  value: Int,
}

defagent Counter {
  meta {
    instance: Singleton
    init_policy: Eager
  }

  @init
  def init() -> Result<CounterState> {
    Ok(CounterState { value: 0 })
  }

  @get
  def get(state: CounterState) -> Result<Int> {
    Ok(state.value)
  }

  @set
  def set(state: CounterState, _next: Int) -> Result<String> {
    Ok(to_string(state.value))
  }
}
