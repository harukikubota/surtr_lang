defagent Counter {
  meta {
    instance: Worker
    init_policy: Eager
  }

  @init
  def init() -> Result<Int> {
    Ok(41)
  }

  @get
  def get(state: Int, label: String) -> Result<String> {
    Ok(label ++ ":" ++ to_string(state + 1))
  }

  @set
  def set(_state: Int, next: Int) -> Result<Int> {
    Ok(next)
  }
}

