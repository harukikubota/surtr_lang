defgenserver Counter {
  meta {
    instance: Singleton
    init_policy: Eager
    state: Int
  }
  @init
  def init() -> Result<Int> { Ok(1) }
  @call
  def value(state: Int) -> Result<CallResult<Int, Int>> {
    Ok(CallResult::Reply(state, state))
  }
}

impl Eq for PID<Counter> {
  def eq(self: Self, rhs: Self) -> Boolean { True }
}
