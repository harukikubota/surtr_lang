deftrait Marker {
  def mark(self: Self) -> String
}

deftrait Use {
  def use(self: Self) -> String
}

impl Use for List<$A>
where
  $A: Marker
{
  def use(self: List<$A>) -> String {
    match self {
      [] => "used",
      [head, ..tail] => Marker::mark(head),
    }
  }
}

def hidden_bound(values: List<$A>) -> String {
  Use::use(values)
}
