re =? Regex::compile("^ok$")
print(to_string(Regex::matches(re, "ok")))
print(to_string(`Regex::matches`(re, "ok")))
print(to_string(re `Regex::matches` "ok"))
predicate = &Regex::matches
print(to_string(predicate(re, "ok")))
partial = &Regex::matches(re, &1)
print(to_string(partial("ok")))
print(to_string(re |> Regex::matches("ok")))
