def bracket_index() -> Int { print("index"); 0 }

read1 = &Facet::view(Duration.millis, &1)
read2: (Duration -> Int) = &Facet::view(Duration.millis, &1)
read3 = &Duration.millis
p = Duration.millis
read4 = &view(p, &1)
read5 = &p
read6: (Duration -> Int) = _.millis

print(inspect(read1))
print(inspect(read2))
print(inspect(read3))
print(inspect(read4))
print(inspect(read5))
print(inspect(read6))
print(inspect([read1(10ms), read2(10ms), read3(10ms), read4(10ms), read5(10ms), read6(10ms)]))
print(inspect(Function::apply(_.millis, 10ms)))

first = Tuple._0
second = Tuple._1
update: ((Int, String) -> (Int, String)) = &Facet::put(first, &1, 3)
update_direct: ((Int, String) -> (Int, String)) = &Facet::put(Tuple._0, &1, 3)
update_literal: ((Int, String) -> (Int, String)) = {|pair| Facet::put(first, pair, 3)}
composed: (((Int, String), Int) -> String) = {|pair| Facet::view(Facet::chain(first, second), pair)}
composed_direct: (((Int, String), Int) -> String) = {|pair| Facet::view(Tuple._0 -> Tuple._1, pair)}
print(inspect(update))
print(inspect(update_direct))
print(inspect(update((1, "a"))))
print(inspect(update_literal((1, "a"))))
print(composed(((1, "a"), 2)))
print(composed_direct(((1, "a"), 2)))

read_bracket: (List<Int> -> Result<Int>) = &Facet::view(List.[bracket_index()], &1)
index = 1
read_lexical: (List<Int> -> Result<Int>) = &Facet::view(List.[index], &1)
print("created")
print(inspect(read_bracket([10, 20])))
print(inspect(read_bracket([30, 40])))
print(inspect(read_lexical([10, 20])))


read_at: (Int, List<Int> -> Result<Int>) = &Facet::view(List.[&1], &2)
read_offset: (Int, List<Int> -> Result<Int>) = &Facet::view(List.[&1 + 1], &2)
read_key: (String, HashMap<Int> -> Result<Int>) = &Facet::view(HashMap.[&1], &2)
read_slice: (Int, Int, List<Int> -> Result<List<Int>>) = &Facet::view(List.[&1..&2], &3)
read_nested: (Int, (List<Int>, String) -> Result<Int>) = &Facet::view(Tuple._0 -> List.[&1], &2)
print(inspect(read_at(1, [10, 20])))
print(inspect(read_at(0, [30, 40])))
print(inspect(read_offset(0, [10, 20])))
print(inspect(read_key("a", HashMap::map_from_entries([("a", 7)]))))
print(inspect(read_slice(0, 1, [10, 20, 30])))
print(inspect(read_nested(1, ([10, 20], "a"))))
