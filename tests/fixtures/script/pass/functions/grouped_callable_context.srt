def make(label: String, value: Int) -> (Int -> Int) {
  print(label)
  {|input: Int| value}
}

def make_list(label: String) -> (Int -> List<Int>) {
  print(label)
  {|input: Int| [20]}
}

def make_option(label: String) -> (Int -> Option<Int>) {
  print(label)
  {|input: Int| Option::Some(30)}
}

def make_result(label: String) -> (Int -> Result<Int>) {
  print(label)
  {|input: Int| Ok(40)}
}

def input() -> Int {
  print("left")
  1
}

def consume(mapper: (Int -> Int)) -> Int { mapper(1) }
def returned() -> (Int -> Int) { (({|input: Int| 50})) }
def generic::<$A>() -> ($A -> $A) { {|value| value} }
def identity(value: Int) -> Int { value }

print(inspect(1 |> (make("plain", 10))))
print(inspect([1, 2] |*> ((make("map", 10)))))
empty: List<Int> = []
print(inspect(empty |*> (make("empty map", 10))))
print(inspect([1, 2] |>= (make_list("bind"))))
print(inspect(empty |>= (make_list("empty bind"))))
print(inspect(Option::Some(1) |>= (make_option("option"))))
absent: Option<Int> = Option::None
print(inspect(absent |>= (make_option("absent option"))))
print(inspect(Ok(1) |>= (make_result("result"))))
failure: Result<Int> = Err(NoneError())
print(inspect(is_match(failure |>= (make_result("failed result")), Err(_))))

print(inspect(consume(({|input: Int| 50}))))
annotated: (Int -> Int) = (({|input: Int| 50}))
print(inspect(annotated(1)))
returned_mapper = returned()
print(inspect(returned_mapper(1)))
generic_mapper: (Int -> Int) = ((generic()))
captured_mapper: (Int -> Int) = ((&identity))
print(inspect(generic_mapper(60)))
print(inspect(captured_mapper(70)))

left: (Int -> Int) = if(True, ({|input: Int| 80}), (&identity))
right: (Int -> Int) = if(False, (&identity), ({|input: Int| 90}))
print(inspect(left(1)))
print(inspect(right(1)))

print(inspect(input() |> (make("right", 100))))
