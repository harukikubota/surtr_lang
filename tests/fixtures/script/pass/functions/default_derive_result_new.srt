@derive Default
defstruct Amount {
  value: Int
}

impl Amount {
  def new(value: Int) -> Result<Amount, InvalidAmountError> {
    Err(InvalidAmountError(value))
  }
}

deferror InvalidAmountError(value: Int) {
  |value: Int|
  Self(message: "Invalid amount: #{value}", value)
}

def main() -> Unit {
  amount: Amount = default()
  print(to_string(amount.value))
}

main()
