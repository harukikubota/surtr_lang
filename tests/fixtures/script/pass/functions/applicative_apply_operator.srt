def inc(value: Int) -> Int {
  value + 1
}

def add3(left: Int, middle: Int, right: Int) -> Int {
  left + middle + right
}

def add4(a: Int, b: Int, c: Int, d: Int) -> Int {
  a + b + c + d
}

def make_pair<$A, $B>(left: $A, right: $B) -> ($A, $B) {
  (left, right)
}

mapper: Result<(Int -> Int)> = Ok(&inc)
value: Result<Int> = Ok(1)
applied: Result<Int> = mapper |*| value

print(inspect(applied))

