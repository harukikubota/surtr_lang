mapped_fn = always(10)
bound_fn = always([10])
optional_fn = always(Option::Some(10))

mapped = [1, 2] |*> (always(10))
bound = [1, 2] |>= (always([10]))
optional = Option::Some(1) |>= (always(Option::Some(10)))

print(inspect(mapped))
print(inspect(bound))
print(inspect(optional))

print(inspect([1, 2] |*> mapped_fn))
print(inspect([1, 2] |>= bound_fn))
print(inspect(Option::Some(1) |>= optional_fn))
