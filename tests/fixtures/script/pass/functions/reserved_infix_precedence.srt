def note(tag: String, value: Boolean) -> Boolean { print(tag); value }
def key(value: Int) -> Int { value + 1 }

print(to_string(3 `eq` 1 + 2))
print(to_string(3 `neq` 1 + 2))
print(to_string(2 `lt` 1 + 2))
print(to_string(3 `lte` 1 + 2))
print(to_string(4 `gt` 1 + 2))
print(to_string(3 `gte` 1 + 2))
print(to_string(False `and` note("unreachable-and", True)))
print(to_string(True `or` note("unreachable-or", False)))
print(to_string(True `and` note("and-rhs", True)))
print(to_string(False `or` note("or-rhs", True)))
compare_by_key = &eq `on` &key
compare_by_qualified_key = &eq `Function::on` &key
print(to_string(compare_by_key(2, 2)))
print(to_string(compare_by_qualified_key(2, 3)))

standard_on = on(&eq, &key)
print(to_string(standard_on(20, 20)))
qualified_on = Function::on(&eq, &key)
print(to_string(qualified_on(10, 2)))
same_int: (Int, Int -> Boolean) = &eq
piped_on = same_int |> on(&key)
print(to_string(piped_on(1, 1)))
on_capture: ((Int, Int -> Boolean), (Int -> Int) -> (Int, Int -> Boolean)) = &on
captured_on = on_capture(&eq, &key)
print(to_string(captured_on(7, 7)))
print(to_string(False `Kernel::and` note("unreachable-qualified-and", True)))
print(to_string(True `Kernel::or` note("unreachable-qualified-or", False)))
