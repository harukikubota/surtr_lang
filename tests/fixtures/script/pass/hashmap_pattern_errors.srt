def report(result: Result<Unit>) -> String {
  match result {
    Err(HashMapKeyMissing(key) @ err) => "#{Error::kind(err)}:#{key}:#{err.message}",
    Err(err) => Error::kind(err),
    Ok(_) => "ok",
  }
}
map: HashMap<Int> = hash![]
print(report(apply_pattern(map, hash!["b" => _, "a" => _])))
print(report(apply_pattern(hash!["a" => 2], hash!["a" => 3, "b" => _])))
print(report(apply_pattern(hash!["a" => map], hash!["a" => hash!["z" => _]])))
pinned = "actual-key"
print(report(apply_pattern(map, hash![^pinned => _])))
values: HashMap<Result<Int>> = hash!["a" => Ok(2), "extra" => Err(NoneError)]
print(inspect(apply_pattern(values, hash!["a" => _1])))
print(inspect(apply_pattern(values, hash!["a" => Ok(_1)])))
print(report(apply_pattern(hash!["a" => Err(NoneError)], hash!["a" => Ok(_: Int)])))
print(inspect(match hash!["a" => Err(NoneError)] { hash!["a" => entire: Result<Int>] => is_match(entire, Err(_)), _ => False, }))
original: Error = HashMapKeyMissing("original")
failed: ExtractorClosure<(Int -> MatchResult<Int>)> = *{|n: Int| MatchResult::Err(original)}
print(report(apply_pattern(hash!["a" => 1], hash!["a" => failed(_), "b" => _])))
print(report(do::<Result> { hash!["b" => _] <- Ok(hash!["a" => 1]); Ok(()) }))
print(report(do::<Result> { hash!["a" => failed(_)] <- Ok(hash!["a" => 1]); Ok(()) }))
