defgenserver Resident {
  meta {
    instance: Singleton
    init_policy: Eager
    state: Int
  }

  @init
  def init() -> Result<Int> { Ok(1) }

  @call
  def value(state: Int) -> Result<CallResult<Int, Int>> {
    Ok(CallResult::Reply(state, state))
  }
}

defgenserver Worker {
  meta {
    instance: Worker
    init_policy: Eager
    state: Int
  }

  @init
  def init(seed: Int) -> Result<Int> { Ok(seed) }

  @call
  def value(state: Int) -> Result<CallResult<Int, Int>> {
    Ok(CallResult::Reply(state, state))
  }
}

defsupervisor Root {
  meta {
    strategy: OneForOne
    max_restarts: 5
    max_seconds: 10
    child_restart_default: Transient
    allow_adopt: True
  }
}

supervisor_init {
  Root {}
  Resident {}
}

resident = Resident::pid()
first =? Root::spawn(Worker::init(1))
second =? Root::spawn(Worker::init(2))
print(inspect(resident == Resident::pid()))
print(inspect(resident != Resident::pid()))
print(inspect(first == first))
print(inspect(first != first))
print(inspect(first == second))
print(inspect(first != second))
