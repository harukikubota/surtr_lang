defagent BroadcastGate {
  meta {
    instance: Singleton
    init_policy: Eager
    state: Int
  }

  @init
  def init() -> Result<Int> { Ok(0) }

  @get
  def phase(state: Int) -> Result<Int> { Ok(state) }

  @set
  def release(_state: Int) -> Result<Int> { Ok(1) }
}

defgenserver MyWorker {
  meta {
    instance: Worker
    init_policy: Eager
    state: Int
  }

  @init
  def init(seed: Int) -> Result<Int> {
    Ok(seed)
  }

  @call
  def value(state: Int) -> Result<CallResult<Int, Int>> {
    Ok(CallResult::Reply(state, state))
  }

  @call
  def delayed(state: Int) -> Result<CallResult<Int, Int>> {
    next = state + 1
    Ok(CallResult::ReplyLater(next, {||
      Process::sleep(100ms)
      Ok(next)
    }))
  }
}

defsupervisor MySup {
  meta {
    strategy: OneForOne
    max_restarts: 5
    max_seconds: 10
    child_restart_default: Transient
    allow_adopt: True
  }
}

defgenserver MyPool {
  meta {
    instance: Singleton
    init_policy: Eager
    state: Workers<MyWorker>
  }

  defp wait_for_release() -> Result<Unit> {
    phase =? BroadcastGate::phase()
    match phase {
      1 => Ok(()),
      _ => {
        _ =? Process::sleep(1ms)
        wait_for_release()
      },
    }
  }

  @init
  def init() -> Result<Workers<MyWorker>> {
    MySup::workers(MyWorker::init(1), WorkerStrategy::fixed(1))
  }

  @call
  def delayed(workers: Workers<MyWorker>) -> Result<CallResult<List<Result<Int>>, Workers<MyWorker>>> {
    # The closed gate prevents handler admission until the timed message is cancelled.
    replies = Workers::broadcast(workers, {|pid|
      _ =? wait_for_release()
      MyWorker::delayed(pid)
    }) @timeout(1ms)
    Ok(CallResult::Reply(replies, workers))
  }

  @call
  def value(workers: Workers<MyWorker>) -> Result<CallResult<List<Result<Int>>, Workers<MyWorker>>> {
    Ok(CallResult::Reply(Workers::broadcast(workers, MyWorker::value()), workers))
  }
}

supervisor_init {
  BroadcastGate {}
  MySup {}
  MyPool {}
}

def reply_kind(reply: Result<Int>) -> String {
  match reply {
    Ok(_) => "Ok",
    Err(error) => Error::kind(error),
  }
}

reply =? MyPool::delayed()
print(inspect(List::map(reply, &reply_kind)))
_ =? BroadcastGate::release()
value =? MyPool::value()
print(inspect(value))
