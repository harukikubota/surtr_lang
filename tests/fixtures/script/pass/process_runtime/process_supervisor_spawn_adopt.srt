defgenserver MyWorker {
  meta {
    instance: Worker
    init_policy: Eager
    state: Int
  }

  @init
  def init(seed: Int) -> Result<Int> {
    Ok(seed)
  }

  @call
  def value(state: Int) -> Result<CallResult<Int, Int>> {
    Ok(CallResult::Reply(state, state))
  }
}

defsupervisor MySup {
  meta {
    strategy: OneForOne
    max_restarts: 5
    max_seconds: 10
    child_restart_default: Transient
    allow_adopt: True
  }
}

defgenserver MyPool {
  meta {
    instance: Singleton
    init_policy: Eager
    state: PID<MyWorker>
  }

  @init
  def init() -> Result<PID<MyWorker>> {
    owned =? MySup::spawn(MyWorker::init(5))
    Ok(owned)
  }

  @call
  def owned(pid: PID<MyWorker>) -> Result<CallResult<PID<MyWorker>, PID<MyWorker>>> {
    Ok(CallResult::Reply(pid, pid))
  }

  @call
  def report(pid: PID<MyWorker>) -> Result<CallResult<SupervisorStatus, PID<MyWorker>>> {
    status =? MySup::status()
    Ok(CallResult::Reply(status, pid))
  }

  @call
  def value(pid: PID<MyWorker>) -> Result<CallResult<Int, PID<MyWorker>>> {
    value =? MyWorker::value(pid)
    Ok(CallResult::Reply(value, pid))
  }
}

supervisor_init {
  MySup {}
  MyPool {}
}

owned =? MyPool::owned()
_ =? MySup::adopt(owned)
print(to_string(MyPool::report()))
print(to_string(MyPool::value()))
