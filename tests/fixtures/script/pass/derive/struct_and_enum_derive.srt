@derive Eq, Neq, Compare, Show
defstruct User {
  name: Int,
  age: Int,
}

impl User {
  def new(name: Int, age: Int) -> Self {
    User { name: name, age: age }
  }
}

@derive Eq, Neq, Compare, Show
defenum Color {
  Red,
  Green,
  Blue,
}

u = User(1, 3)
v = User(1, 4)
print(inspect(u == u))
print(inspect(u != v))
print(inspect(u < v))
print(inspect(to_string(u)))
print(inspect(Color::Red < Color::Blue))
