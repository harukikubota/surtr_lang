deferror TailFailure(detail: String) { |detail: String| Self(message: detail, detail) }

def inc(x: Int) -> Int {
  x + 1
}

def add2(x: Int, y: Int) -> Int {
  x + y
}

def add3(x: Int, y: Int, z: Int) -> Int {
  x + y + z
}

def safe_inc(x: Int) -> Result<Int> {
  Ok(x + 1)
}

def safe_add2(x: Int, y: Int) -> Result<Int> {
  Ok(x + y)
}

def safe_add3(x: Int, y: Int, z: Int) -> Result<Int> {
  Ok(x + y + z)
}

def emit_next() -> Result<String> {
  print("then-next")
  Ok("next")
}

def side_effect_label() -> String {
  print("side-effect")
  "detail"
}

print(to_string(Result::is_ok(Ok(1))))
print(to_string(Result::is_ok(Err(NoneError))))
print(to_string(Result::is_err(Ok(1))))
print(to_string(Result::is_err(Err(NoneError))))
print(inspect(Result::map_err(Ok(1), ZeroDivisionError)))
print(inspect(Result::map_err(Err(NoneError), ZeroDivisionError)))
print(inspect(Result::cause(Ok(1), ZeroDivisionError)))
print(inspect(Result::cause(Err(NoneError), ZeroDivisionError)))
print(inspect(Result::map_err(Ok(1), TailFailure(side_effect_label()))))
print(inspect(Result::cause(Ok(1), TailFailure(side_effect_label()))))
print(inspect(Result::chain(Ok(7), Ok(()))))
pair: (Result<Int>, Int) = (Ok(7), 1)
print(inspect(chain(pair._0, Ok(()))))
print(inspect(Result::chain(Ok(7), Err(TailFailure("tail")))))
print(inspect(Result::chain(Err(NoneError), Ok(()))))
print(inspect(Result::chain(Err(NoneError), Err(ZeroDivisionError))))
print(inspect(Result::chain(Err(TailFailure("tail")), Result::cause(Err(NoneError), ZeroDivisionError))))
match Result::cause(Err(NoneError), ZeroDivisionError) {
  Ok(_) => print("unexpected"),
  Err(e) => print(inspect(e)),
}
print(inspect(Ok(&inc) |*| Ok(1)))
print(inspect(Ok(curry(&add2)) |*| Ok(1) |*| Ok(2)))
print(inspect(Ok(curry(&add3)) |*| Ok(1) |*| Ok(2) |*| Ok(3)))
print(inspect(Applicative::ap(Ok(&inc), Ok(1))))
print(inspect(Ok(curry(&add2)) |*| Ok(1) |*| Ok(2)))
print(inspect(Ok(curry(&add3)) |*| Ok(1) |*| Ok(2) |*| Ok(3)))
print(inspect((Ok(&safe_inc) |*| Ok(1)) |>= {|inner| inner}))
print(inspect((Ok(curry(&safe_add2)) |*| Ok(1) |*| Ok(2)) |>= {|inner| inner}))
print(inspect((Ok(curry(&safe_add3)) |*| Ok(1) |*| Ok(2) |*| Ok(3)) |>= {|inner| inner}))
print(inspect(Ok(1) |>= safe_inc()))
print(inspect(Ok(1) |>= {|a| Ok(2) |>= {|b| safe_add2(a, b)}}))
print(inspect(Ok(1) |>= {|a| Ok(2) |>= {|b| Ok(3) |>= {|c| safe_add3(a, b, c)}}}))
print(inspect(Result::zip(Ok(1), Ok(2))))
print(inspect(Result::zip3(Ok(1), Ok(2), Ok(3))))
print(inspect(Result::all([Ok(1), Ok(2), Ok(3)])))
print(inspect(Result::all([Ok(1), Err(NoneError), Ok(3)])))
print(inspect(Result::flatten(Ok(Ok(1)))))
print(inspect(Result::flatten(Err(NoneError))))
print(inspect(Result::tap_ok(Ok(1), {|x| print("tap:#{to_string(x)}")})))
print(inspect(Result::tap_err(Err(NoneError), {|err| print("tap_err:#{inspect(err)}")})))
tap_bound = {|err| print("tap_bound:#{Error::kind(err)}")}
print(inspect(Result::tap_err(Err(NoneError), tap_bound)))
print(inspect(Result::tap_err(Err(NoneError), &Error::kind >> &print)))
print(inspect(Result::then(Ok(1), &emit_next)))
print(inspect(Result::then(Err(NoneError), &emit_next)))
print(inspect(Result::zip(Err(NoneError), Err(ZeroDivisionError))))
print(inspect(Result::zip3(Err(NoneError), Err(ZeroDivisionError), Err(EmptyHeadTailListPattern))))
print(inspect(Result::all([Err(NoneError)])))
print(inspect(Result::then(Err(NoneError), {||
  print("unexpected no-payload continuation")
  Err(ZeroDivisionError)
})))
