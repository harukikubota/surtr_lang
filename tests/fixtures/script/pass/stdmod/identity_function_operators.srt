defstruct Identity<$T> {
  value: $T,
}

impl Identity {
  def new(value: $T) -> Identity<$T> {
    Identity { value: value }
  }
}

impl Functor for Identity<$T> {
  def fmap(self: Identity<$A>, mapper: ($A -> $B)) -> Identity<$B> {
    Identity { value: mapper(self.value) }
  }
}

impl Applicative for Identity<$T> {
  def pure::<Identity<$T>>(value: $A) -> Identity<$A> {
    Identity { value: value }
  }

  def ap(mapper: Identity<($A -> $B)>, value: Identity<$A>) -> Identity<$B> {
    f = mapper.value
    Identity { value: f(value.value) }
  }
}

impl Monad for Identity<$T> {
  def return::<Identity<$T>>(value: $A) -> Identity<$A> {
    Identity { value: value }
  }

  def bind(self: Identity<$A>, mapper: ($A -> Identity<$B>)) -> Identity<$B> {
    mapper(self.value)
  }
}

impl LiftComposable<$A, $B, $C, Identity<$C>> for ($A -> Identity<$B>) {
  def lift_compose::<($A -> Identity<$B>), $A, $B, $C, Identity<$C>>(self: Self, rhs: ($B -> $C)) -> ($A -> Identity<$C>) {
    {|value| Functor::fmap(self(value), rhs)}
  }
}

impl KleisliComposable<$A, $B, Identity<$C>> for ($A -> Identity<$B>) {
  def kleisli_compose::<($A -> Identity<$B>), $A, $B, Identity<$C>>(self: Self, rhs: ($B -> Identity<$C>)) -> ($A -> Identity<$C>) {
    {|value| Monad::bind(self(value), rhs)}
  }
}

def inc(value: Int) -> Int {
  value + 1
}

def render(value: Int) -> String {
  to_string(value)
}

def ident_inc(value: Int) -> Identity<Int> {
  Identity(value + 1)
}

def ident_double(value: Int) -> Identity<Int> {
  Identity(value * 2)
}

def ident_render(value: Int) -> Identity<String> {
  Identity(to_string(value))
}

def show_identity_int(value: Identity<Int>) -> String {
  to_string(value.value)
}

def show_identity_string(value: Identity<String>) -> String {
  value.value
}

mapped: Identity<Int> = Identity(1) |*> &inc
bound: Identity<Int> = Identity(1) |>= &ident_double
pure: Identity<Int> = Applicative::pure(2)
mapper_identity: Identity<(Int -> Int)> = Identity(&inc)
returned: Identity<Int> = Monad::return(3)
value_identity: Identity<Int> = Identity(1)
applied: Identity<Int> = Applicative::ap(mapper_identity, value_identity)
lifted = &ident_inc >* &render
kleisli = &ident_inc >=> &ident_render

print(show_identity_int(mapped))
print(show_identity_int(bound))
print(show_identity_int(pure))
print(show_identity_int(applied))
print(show_identity_int(returned))
print(show_identity_string(lifted(1)))
print(show_identity_string(kleisli(1)))
