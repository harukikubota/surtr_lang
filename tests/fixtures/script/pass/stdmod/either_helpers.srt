def inc(value: Int) -> Int {
  value + 1
}

print(to_string(Either::is_left(Either::Left("x"))))
folded: Either<String, Int> = Either::Left("x")
print(Either::fold(folded, {|value| "left:" ++ value}, {|value| to_string(value)}))
right: Either<String, Int> = Either::Right(2)
print(inspect(right |*> &inc))
print(inspect(Either::Left("x") |>= {|value| Either::Right(value + 1)}))
