raw = Range(3, 1)
normalized = Range::normalized(3, 1)
advanced = Range::advance(raw, 2)
retreated = Range::retreat(raw, 2)
left = Range(1, 4)
right = Range(2, 0)
same = Range(1, 4)
different = Range(1, 5)
value = Range(4, 6)
duration_ctor = Range(10ms, 20ms)
duration_left = Range(10ms, 20ms)
duration_right = Range(10ms, 30ms)
duration_same = Range(10ms, 20ms)

print(inspect((raw.min, raw.max)))
print(inspect((normalized.min, normalized.max)))
print(inspect((to_string(duration_ctor.min), to_string(duration_ctor.max))))
print(inspect(compare(left, right)))
print(inspect((left == same, left != different)))
print(inspect(compare(duration_left, duration_right)))
print(inspect((duration_left == duration_same, duration_left != duration_right)))
print(inspect((advanced.min, advanced.max)))
print(inspect((retreated.min, retreated.max)))
print(inspect(match value {
  Range(min, max) => (min, max),
  _ => (0, 0),
}))
