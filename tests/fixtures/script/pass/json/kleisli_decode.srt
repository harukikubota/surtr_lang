defrecord JsonSpecKleisliConfig(name: String)

impl Decode<JsonSpecKleisliConfig> for JsonValue {
  def decode(self: Self) -> Result<JsonSpecKleisliConfig, Error> {
    name_json =? Json::get(self, "name")
    name =? Decode::decode::<String>(name_json)
    Ok(JsonSpecKleisliConfig(name))
  }
}

parse_config = &Json::decode >=> {|json: JsonValue| Decode::decode::<JsonSpecKleisliConfig>(json)}
cfg =? parse_config("{\"name\":\"surtr\"}")
print(cfg.name)
