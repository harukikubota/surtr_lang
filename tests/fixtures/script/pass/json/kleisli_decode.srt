defrecord JsonSpecKleisliConfig(name: String)

impl Decode<JsonSpecKleisliConfig> for JsonValue {
  def decode(self: Self, to: TypeRef<JsonSpecKleisliConfig>) -> Result<JsonSpecKleisliConfig, Error> {
    name_json =? Json::get(self, "name")
    name =? JsonValue::decode(name_json, String)
    Ok(JsonSpecKleisliConfig(name))
  }
}

parse_config = &Json::decode >=> {|json: JsonValue| JsonValue::decode(json, JsonSpecKleisliConfig)}
cfg =? parse_config("{\"name\":\"surtr\"}")
print(cfg.name)
