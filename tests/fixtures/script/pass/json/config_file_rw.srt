defrecord JsonSpecRwConfig(name: String, entrypoint: String)

impl Decode<JsonSpecRwConfig> for JsonValue {
  def decode(self: Self) -> Result<JsonSpecRwConfig, Error> {
    name_json =? Json::get(self, "name")
    name =? Decode::decode::<String>(name_json)
    entry_json =? Json::get(self, "entrypoint")
    entry =? Decode::decode::<String>(entry_json)
    Ok(JsonSpecRwConfig(name, entry))
  }
}

impl Encode<JsonValue> for JsonSpecRwConfig {
  def encode(self: Self) -> Result<JsonValue, Error> {
    Ok(JsonValue::Object(HashMap::from_entries([
      ("name", JsonValue::String(self.name)),
      ("entrypoint", JsonValue::String(self.entrypoint)),
    ])))
  }
}

def load_config(path: String) -> Result<JsonSpecRwConfig, Error> {
  text =? File::read(path)
  json =? Json::decode(text)
  Decode::decode::<JsonSpecRwConfig>(json)
}

def save_config(path: String, config: JsonSpecRwConfig) -> Result<Unit, Error> {
  json =? JsonValue::encode(config)
  text =? Json::encode(json)
  File::write(path, text)
}

tmp_root =? FS::path("./tmp/sandbox")
_ =? FS::mkdir_all(tmp_root)
path = "./tmp/sandbox/surtr-json-config-rw.fixture.json"
_ =? save_config(path, JsonSpecRwConfig("surtr", "boot"))
cfg =? load_config(path)
_ =? File::delete(path)
print(cfg.name ++ ":" ++ cfg.entrypoint)
