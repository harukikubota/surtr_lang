defrecord User(name: String, age: Int)
defrecord Envelope(user: User, revision: Int)
defrecord Pair(first: Int, second: Int)
namespace Auth {
  defrecord User(name: String)
}

user = User("Ada", 37)
User(name, age) = user
User(age: reordered_age, name: reordered_name) = user
User((typed_name: String), typed_age) = user
age = 999
User(name: shorthand_name, age) = user
name = "outer"
User(age: shorthand_age, name) = user
print(inspect((shorthand_name, age, name, shorthand_age)))

print(inspect((name, age, reordered_name, reordered_age, typed_name, typed_age)))
print(inspect(match user {
  User(name: "Bob", age) => age,
  User(age: years, name: _) => years,
}))

auth_user: Auth::User = Auth::User(name: "Lin")
Auth::User(auth_name) = auth_user
print(auth_name)

name_probe = *{|value: String| print("name"); MatchResult::Ok(value)}
age_probe = *{|value: Int| print("age"); MatchResult::Ok(value)}
print(inspect(match user {
  User(age: age_probe(_), name: name_probe(_)) => 1,
  _ => 0,
}))

# A nested keyword does not change the outer positional classification.
envelope = Envelope(user, 9)
Envelope(User(age: nested_age, name), revision) = envelope
print(inspect((name, nested_age, revision)))

# With no keyword, binding names do not select fields.
Pair(second, first) = Pair(1, 2)
print(inspect((first, second)))
