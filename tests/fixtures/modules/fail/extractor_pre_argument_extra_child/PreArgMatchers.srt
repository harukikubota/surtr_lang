defmod PreArgMatchers {
  defextractor offset(amount: Int, value: Int) -> MatchResult<Int, Error> {
    MatchResult::Ok(value + amount)
  }

  defextractor guard(min: Int, value: Int) -> MatchResult<Unit, Error> {
    match (value >= min) {
      True => MatchResult::Ok(()),
      False => MatchResult::Err(NoneError()),
    }
  }
}
