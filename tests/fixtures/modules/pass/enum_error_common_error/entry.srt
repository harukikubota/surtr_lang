selected: Result<Int, ClosedFailures> = Err(Failure())
common: Result<Int, Error> = selected
returned: Result<Int> = Transport::relay(selected)
wrapped: ResultT<Identity, Int, Error> = ResultT::new(Identity::new(common))
restored: Result<Int> = Identity::run(ResultT::run(wrapped))
stored: ResultT<Identity, Int, ClosedFailures> =? Facet::set(ResultT.inner, wrapped, Identity::new(selected))
kept: Result<Int, ClosedFailures> = Identity::run(Transport::preserve(stored))
print(match returned { Ok(_) => "wrong", Err(error) => Error::message(error) })
print(match restored { Ok(_) => "wrong", Err(error) => Error::message(error) })
print(match kept { Ok(_) => "wrong", Err(error) => Error::message(error) })
rta_result: Result<Int> = Applicative::pure::<Result<Int>>(7)
rta_transformer: ResultT<Identity, Int, Error> = Applicative::pure::<ResultT<Identity, Int, Error>>(9)
print(inspect(rta_result))
print(inspect(Identity::run(ResultT::run(rta_transformer))))
