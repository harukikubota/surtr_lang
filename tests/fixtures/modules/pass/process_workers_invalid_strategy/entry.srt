defagent MyWorker {
  meta {
    instance: Worker
    init_policy: Eager
    state: Int
  }

  @init
  def init(seed: Int) -> Result<Int> {
    Ok(seed)
  }

  @get
  def value(state: Int) -> Result<Int> {
    Ok(state)
  }

  @set
  def set(_state: Int, next: Int) -> Result<Int> {
    Ok(next)
  }
}

defsupervisor MySup {
  meta {
    strategy: OneForOne
    max_restarts: 5
    max_seconds: 10
    child_restart_default: Transient
    allow_adopt: True
  }
}

defgenserver MyPool {
  meta {
    instance: Singleton
    init_policy: Eager
    state: String
  }

  @init
  def init() -> Result<String> {
    result = MySup::workers(
      MyWorker::init(1),
      WorkerStrategy::new(2, 1, 2, WorkerScale::Fix(1)),
    )
    match result {
      Err(err) => Ok(Error::kind(err)),
      Ok(_) => Ok("unexpected-ok"),
    }
  }

  @call
  def value(state: String) -> Result<CallResult<String, String>> {
    Ok(CallResult::Reply(state, state))
  }
}

supervisor_init {
  MySup {}
  MyPool {}
}

print(to_string(MyPool::value()))
