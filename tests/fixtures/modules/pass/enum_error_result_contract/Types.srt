deferror AlphaFailure(value: Int) { |input: Int| Self(message: "alpha", value: input) }
deferror BetaFailure { "beta" }
defenumerror OpenFailures { AlphaFailure, Other(Error) }
defenumerror ClosedFailures { AlphaFailure }
