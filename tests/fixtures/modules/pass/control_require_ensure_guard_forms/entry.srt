def is_even(n: Int) -> Boolean {
  Int::is_even(n)
}

def next_num() -> Int {
  print("value")
  4
}

def build_error_detail() -> String {
  print("err")
  "boom"
}

print(inspect(require(True, GuardError(build_error_detail()))))
print(inspect(require(False, GuardError(build_error_detail()))))
print(inspect(ensure(next_num(), &is_even, GuardError(build_error_detail()))))
print(inspect(ensure(3, {|n| Int::is_even(n) }, GuardError(build_error_detail()))))
