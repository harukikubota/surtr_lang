{
  "Test suite": {
    "prefix": "test",
    "body": [
      "import Test;",
      "",
      "test(\"${1:suite}\") {",
      "  it(\"${2:case}\") {",
      "    assert_eq(${3:3}, ${4:1 + 2})",
      "  }",
      "}",
      "$0"
    ],
    "description": "Testモジュールをimportし、テストスイートを作成"
  },
  "Test group": {
    "prefix": "describe",
    "body": [
      "describe(\"${1:group}\") {",
      "  it(\"${2:case}\") {",
      "    assert_eq(${3:3}, ${4:1 + 2})",
      "  }",
      "}",
      "$0"
    ],
    "description": "関連ケースをまとめる（import Testが必要）"
  },
  "Test case": {
    "prefix": "it",
    "body": [
      "it(\"${1:case}\") {",
      "  assert_eq(${2:3}, ${3:1 + 2})",
      "}",
      "$0"
    ],
    "description": "Result<()>を返すテストケース（import Testが必要）"
  },
  "Paused test case": {
    "prefix": "xit",
    "body": [
      "xit(\"${1:case}\", \"${2:implementation pending}\") {",
      "  assert_eq(${3:3}, ${4:1 + 2})",
      "}",
      "$0"
    ],
    "description": "理由付きの休止ケース（--include-xitで実行）"
  },
  "Pending test case": {
    "prefix": "pend",
    "body": [
      "pend(\"${1:case}\", \"${2:implementation pending}\")",
      "$0"
    ],
    "description": "本文を持たない未実装ケース（import Testが必要）"
  },
  "Assert equality": {
    "prefix": "assert_eq",
    "body": [
      "assert_eq(${1:3}, ${2:1 + 2})$0"
    ],
    "description": "期待値、実際の値の順で比較（import Testが必要）"
  },
  "Assert true": {
    "prefix": "assert_true",
    "body": [
      "assert_true(${1:True})$0"
    ],
    "description": "Trueであることを検証（import Testが必要）"
  },
  "Assert false": {
    "prefix": "assert_false",
    "body": [
      "assert_false(${1:False})$0"
    ],
    "description": "Falseであることを検証（import Testが必要）"
  },
  "Function": {
    "prefix": "def",
    "body": [
      "def ${1:name}(${2:value}: ${3:Int}) -> ${4:Int} {",
      "  ${5:value}",
      "}",
      "$0"
    ],
    "description": "関数を定義"
  },
  "Module": {
    "prefix": "defmod",
    "body": [
      "defmod ${1:Example} {",
      "  $0",
      "}"
    ],
    "description": "moduleファイルにモジュールを定義（script top-level不可）"
  },
  "Match": {
    "prefix": "match",
    "body": [
      "match ${1:True} {",
      "  ${2:True} => ${3:()},",
      "  ${4:False} => ${5:()},",
      "}$0"
    ],
    "description": "パターンで分岐"
  },
  "Do": {
    "prefix": "do",
    "body": [
      "do::<${1:Result}> {",
      "  ${2:value} <- ${3:Ok(1)}",
      "  Ok($2)",
      "}$0"
    ],
    "description": "明示carrierのbindと最終Monad値を持つdo式"
  },
  "Documentation": {
    "prefix": "doc",
    "body": [
      "@doc \"\"\"",
      "${1:Description.}",
      "\"\"\"",
      "$0"
    ],
    "description": "宣言のドキュメントを記述"
  },
  "Private function": {
    "prefix": "defp",
    "body": [
      "defp ${1:name}(${2:value}: ${3:Int}) -> ${4:Int} {",
      "  $2",
      "}",
      "$0"
    ],
    "description": "privateな関数を定義"
  },
  "Expression body function": {
    "prefix": "defexpr",
    "body": [
      "def ${1:name}(${2:value}: ${3:Int}) -> ${4:Int} = $2",
      "$0"
    ],
    "description": "同じ行の式を本体にする関数"
  },
  "Boolean suffix function": {
    "prefix": "defbool",
    "body": [
      "def ${1:positive}?(${2:value}: Int) -> Boolean {",
      "  $2 > ${3:0}",
      "}",
      "$0"
    ],
    "description": "Booleanを返す末尾?付き関数"
  },
  "Polymorphic function": {
    "prefix": "defgeneric",
    "body": [
      "def ${1:identity}(${2:value}: \\$T) -> \\$T {",
      "  $2",
      "}",
      "$0"
    ],
    "description": "値引数から型変数を導入する関数"
  },
  "Struct": {
    "prefix": "defstruct",
    "body": [
      "defstruct ${1:Example} {",
      "  ${2:value}: ${3:Int},",
      "}",
      "",
      "impl $1 {",
      "  def new($2: $3) -> Self {",
      "    $1 { $2 }",
      "  }",
      "}",
      "$0"
    ],
    "description": "structと必須のnew実装を定義"
  },
  "Record": {
    "prefix": "defrecord",
    "body": [
      "defrecord ${1:Example}(${2:value}: ${3:Int})",
      "$0"
    ],
    "description": "1個以上のpublicフィールドを持つrecord"
  },
  "Enum": {
    "prefix": "defenum",
    "body": [
      "defenum ${1:Example} {",
      "  ${2:Empty},",
      "  ${3:Value}(${4:Int}),",
      "}",
      "$0"
    ],
    "description": "payloadなし・ありのvariantを持つenum"
  },
  "Error": {
    "prefix": "deferror",
    "body": [
      "deferror ${1:ExampleError}(${2:detail}: String) {",
      "  |$2: String|",
      "  Self(message: $2, $2)",
      "}",
      "$0"
    ],
    "description": "messageと保存フィールドを持つError"
  },
  "Trait": {
    "prefix": "deftrait",
    "body": [
      "deftrait ${1:ExampleTrait} {",
      "  def ${2:get}(self: Self) -> ${3:Int}",
      "}",
      "$0"
    ],
    "description": "method契約を定義するtrait"
  },
  "Inherent implementation": {
    "prefix": "impl",
    "body": [
      "impl ${1:Example} {",
      "  def new(${2:value}: Int) -> Self {",
      "    $1 { $2 }",
      "  }",
      "",
      "  def ${3:get}(self: Self) -> Int {",
      "    self.$2",
      "  }",
      "}",
      "$0"
    ],
    "description": "structの唯一のimplにnewとmethodを定義（既存implがある場合はその中へ追加）"
  },
  "Trait implementation": {
    "prefix": "impltrait",
    "body": [
      "impl ${1:ExampleTrait} for ${2:Example} {",
      "  def ${3:get}(self: Self) -> Int {",
      "    self.${4:value}",
      "  }",
      "}",
      "$0"
    ],
    "description": "既存traitの契約を既存型に実装"
  },
  "Constant": {
    "prefix": "const",
    "body": [
      "const ${1:LIMIT}: ${2:Int} = ${3:3}",
      "$0"
    ],
    "description": "file top-levelのprimitive定数を宣言"
  },
  "Type alias": {
    "prefix": "type",
    "body": [
      "type ${1:Transform}<\\$A, \\$B> = (\\$A -> \\$B)",
      "$0"
    ],
    "description": "関数シグネチャのaliasを宣言（データ型alias不可）"
  },
  "Typed closure": {
    "prefix": "closure",
    "body": [
      "{|${1:value}: ${2:Int}| $1}$0"
    ],
    "description": "値に束縛する際にも型が確定するclosure"
  },
  "SafeBind": {
    "prefix": "safebind",
    "body": [
      "${1:value} =? ${2:Ok(1)}",
      "$0"
    ],
    "description": "失敗返却先のある関数やdo内でpayloadを一段取り出す"
  }
}
