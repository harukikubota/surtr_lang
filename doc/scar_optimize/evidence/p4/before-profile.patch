+    pub(super) fn canonical_identity_lookup(
+        &self,
+        capability: bool,
+        comparisons: u64,
+        start: Option<Instant>,
+    ) {
+        let Some(start) = start else { return };
+        // End timing before updating aggregates.
+        let elapsed = start.elapsed();
+        let (lookup, compared) = if capability {
+            (
+                &self.data.canonical_capability_lookup,
+                &self.data.canonical_capability_comparisons,
+            )
+        } else {
+            (
+                &self.data.canonical_constraints_lookup,
+                &self.data.canonical_constraints_comparisons,
+            )
+        };
+        lookup.add(elapsed);
+        compared.fetch_add(comparisons, Ordering::Relaxed);
+    }
