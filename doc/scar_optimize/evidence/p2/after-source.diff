+                        let callee = if reverse { index - 1 } else { index + 1 };
+                        let TypedInner::Def(_, _, _, _, _, _, body, _) = &mut definition.node
+                        else {
+                            unreachable!()
+                        };
+                        *body = Box::new(call_generic(
