+                    requirements.insert(
+                        index,
+                        CallableSpecializationRequirements {
+                            tyvars: if level + 1 == depth {
+                                vec![variable]
+                            } else {
+                                Vec::new()
+                            },
+                            requires_concrete: level + 1 == depth,
