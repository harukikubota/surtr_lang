+        // Stop after the first finish transition transferred the owned suffix.
+        // The nonempty prefix is still held by the construction checkpoint.
+        for _ in 0..150 {
+            let outcome = vm.run_quantum(&mut context, &mut Budget::new(1));
+            assert!(
