+fn materialize_until_first_append(vm: &mut VM, context: &mut ExecutionContext) {
+    for _ in 0..100 {
+        assert!(matches!(
+            vm.run_quantum(context, &mut Budget::new(1)),
+            ProcessRunOutcome::QuantumExpired
