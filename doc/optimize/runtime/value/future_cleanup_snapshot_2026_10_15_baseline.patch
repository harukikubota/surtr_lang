+#[test]
+fn unresolved_snapshot_cache_eviction_and_next_pass_keep_ids_unresolved() {
+    let mut vm = VM::new(base_bytecode(vec![Opcode::Halt]));
+    let ids: Vec<_> = (0..3)
+        .map(|_| vm.process_runtime.allocate_future(None, None, false))
+        .collect();
+    vm.stack = ids
+        .iter()
+        .cycle()
+        .take(30)
+        .map(|&id| Value::PendingFuture(id))
+        .collect();
+    let before = vm.stack.clone();
+    vm.resolve_ready_pending_stack_values();
+    assert_eq!(vm.stack, before);
+    vm.process_runtime
+        .resolve_future(ids[1], Value::Int(int(7)));
+    vm.resolve_ready_pending_stack_values();
+    for (i, value) in vm.stack.iter().enumerate() {
+        assert_eq!(
+            value,
+            &if i % 3 == 1 {
+                Value::Int(int(7))
+            } else {
+                Value::PendingFuture(ids[i % 3])
+            }
+        );
+    }
+}
