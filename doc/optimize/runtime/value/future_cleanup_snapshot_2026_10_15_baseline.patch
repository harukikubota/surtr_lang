+#[test]
+fn ready_snapshot_visits_cleanup_tasks_once_for_many_distinct_ready_ids() {
+    let mut vm = VM::new(base_bytecode(vec![Opcode::Halt]));
+    for _ in 0..32 {
+        future_with_cleanup_record(&mut vm);
+    }
+    let (blocked_task, blocked) = future_with_cleanup_record(&mut vm);
+    vm.process_runtime.resolve_future(blocked, Value::Unit);
+    let ready: Vec<_> = (0..128)
+        .map(|i| {
+            let id = vm.process_runtime.allocate_future(None, None, false);
+            vm.process_runtime.resolve_future(id, Value::Int(int(i)));
+            id
+        })
+        .collect();
+    vm.stack = ready
+        .iter()
+        .flat_map(|&id| [Value::PendingFuture(id), Value::PendingFuture(blocked)])
+        .collect();
+    reset_scans();
+    vm.resolve_ready_pending_stack_values();
+    assert_eq!(
+        cleanup_visits(),
+        33,
+        "one cleanup table pass for the entire snapshot"
+    );
+    assert_eq!(
+        ready_lookups(),
+        129,
+        "blocked raw-ready ID also belongs to the snapshot"
+    );
+    for (i, pair) in vm.stack.chunks_exact(2).enumerate() {
+        assert_eq!(pair[0], Value::Int(int(i)));
+        assert_eq!(pair[1], Value::PendingFuture(blocked));
+    }
+    vm.process_runtime.detached_tasks.remove(&blocked_task);
+    reset_scans();
+    vm.resolve_ready_pending_stack_values();
+    assert_eq!(ready_lookups(), 1, "recheck cleanup on the next collection");
+    assert_eq!(vm.stack.pending_slot_count(), 0);
+}
