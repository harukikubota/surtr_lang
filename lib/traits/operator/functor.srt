@doc """
Standard `Functor` trait declaration.
`Functor<$A, $B, $Mapped>` models mapping a plain unary callable over a
contextual value. The `|*>` operator lowers through this trait.
"""
deftrait Functor<$A, $B, $Mapped> {
  # Map a plain callable over the contextual receiver.
  def map(self: Self, f: ($A -> $B)) -> $Mapped
}
