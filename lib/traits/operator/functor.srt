@doc """
Standard `Functor` trait declaration.
`Functor` models mapping a plain unary callable over a unary type constructor.
The `|*>` operator lowers through this trait.
"""
deftrait Functor
where
  Self: Type<$A>
{
  # Map a plain callable over the contextual receiver.
  def fmap(self: Self<$A>, mapper: ($A -> $B)) -> Self<$B>
}
