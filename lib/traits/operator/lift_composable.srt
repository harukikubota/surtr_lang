@@doc """
Standard `LiftComposable` flow operator trait declaration.
`LiftComposable<$A, $B, $C, $Mapped>` models composing a contextual unary
callable with a plain unary callable. The `>*` operator lowers through this
trait.
"""
deftrait LiftComposable<$A, $B, $C, $Mapped> {
  # Compose the receiver contextual callable before a plain mapper.
  def lift_compose(self: Self, rhs: ($B -> $C)) -> ($A -> $Mapped)
}

@@doc """
`LiftComposable` implementation for `Result`-returning unary functions.
This is the source-level meaning of `left >* right` for `Result`.
"""
impl LiftComposable<$A, $B, $C, Result<$C>> for ($A -> Result<$B>) {
  def lift_compose(self: Self, rhs: ($B -> $C)) -> ($A -> Result<$C>) {
    {|value| Functor::map(self(value), rhs)}
  }
}

@@doc """
`LiftComposable` implementation for `List`-returning unary functions.
This is the source-level meaning of `left >* right` for `List`.
"""
impl LiftComposable<$A, $B, $C, List<$C>> for ($A -> List<$B>) {
  def lift_compose(self: Self, rhs: ($B -> $C)) -> ($A -> List<$C>) {
    {|value| Functor::map(self(value), rhs)}
  }
}
