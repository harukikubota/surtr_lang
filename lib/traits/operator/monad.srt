@doc """
Standard `Monad` trait declaration.
`Monad` extends `Applicative` with contextual sequencing. The `|>=` operator
lowers through this trait.
"""
deftrait Monad
where
  Self: Applicative
{
  # Chain a contextual callable after the contextual receiver.
  def bind(self: Self<$A>, mapper: ($A -> Self<$B>)) -> Self<$B>
}
