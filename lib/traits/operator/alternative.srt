@doc """
Standard `Alternative` trait declaration.

`Alternative` extends `Applicative` with an empty contextual value and eager
choice. The `<|>` operator lowers to `Alternative::choose`.
"""
deftrait Alternative
where
  Self: Applicative
{
  # Construct the identity value for choice. The full `Self` carrier is
  # selected explicitly or from the expected result type.
  def empty::<Self>() -> Self

  # Choose between two values in the same contextual family.
  def choose(left: Self<$A>, right: Self<$A>) -> Self<$A>
}
