@doc """
Standard `Decode` trait declaration.
`Decode<$To>` converts `Self` into `$To`.
Choose the decoded target with an explicit type argument.
Use `Decode::decode::<Target>(value)` to select the target type.

## REPL
xldr(1)> json =? Json::decode("\"surtr\"")
xldr(2)> Decode::decode::<String>(json)
Ok("surtr")
"""
deftrait Decode<$To> {
  # Convert the value into the requested target type.
  def decode::<$To>(self: Self) -> Result<$To, Error>
}
