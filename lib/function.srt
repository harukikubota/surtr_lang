@doc """
Function module.

Provides the small auto-imported standard surface for pure callable
combinators and tuple-oriented helper functions.
Use this layer when you want to reshape callables, build new callables from
existing ones, or thread tuple state without introducing ad-hoc closures.

## REPL
xldr(1)> apply(&id, 42)
42
xldr(2)> dup("ok")
("ok", "ok")
"""
@autoimport
defmod Function {
  @doc """
  Lift a binary callable through a key function.

  `on(f, key)` turns a callable like `f: ($B, $B -> $C)` into
  `($A, $A -> $C)` by applying `key` to both inputs before calling `f`.

  This is useful for keyed comparisons and grouping logic.

  ## REPL
  xldr(1)> by_len = on({|left, right| compare(left, right)}, &String::len)
  > by_len: (String, String -> Ordering)
  xldr(2)> by_len("a", "abcd")
  Ordering::Less
  """
  def on(f: ($B, $B -> $C), key: ($A -> $B)) -> ($A, $A -> $C) {
    {|left, right| f(key(left), key(right)) }
  }

  @doc """
  Return `value` unchanged.

  This is the smallest possible identity helper and is mainly useful when a
  named callable reads better than an inline closure.

  ## REPL
  xldr(1)> id(42)
  42
  """
  def id(value: $A) -> $A { value }

  @doc """
  Return a callable that ignores its input and always yields `value`.

  This is a small pure helper for constant-like closure behavior in pipelines
  and composition.

  ## REPL
  xldr(1)> keep_one = always(1)
  > keep_one: (_ -> Int)
  xldr(2)> keep_one("ignored")
  1
  """
  def always(value: $A) -> (_ -> $A) { {|_| value} }

  @doc """
  Return a zero-argument callable that does nothing and yields `()`.

  This is useful when a callback surface needs an explicit no-op function value
  rather than an omitted branch.

  ## REPL
  xldr(1)> idle = noop()
  > idle: (-> Unit)
  xldr(2)> idle()
  ()
  """
  def noop() -> (-> Unit) { {|| ()} }

  @doc """
  Swap the argument order of a binary callable.

  ## REPL
  xldr(1)> sub = {|left: Int, right: Int| left - right}
  xldr(2)> flipped = flip(sub)
  xldr(3)> flipped(2, 10)
  8
  """
  def flip(f: ($A, $B -> $C)) -> ($B, $A -> $C) {
    {|right, left| f(left, right) }
  }

  @doc """
  Apply `value` to `f`.

  This is useful when a callable should be passed around as a value before the
  final application step.

  ## REPL
  xldr(1)> apply(&id, 42)
  42
  """
  def apply(f: ($A -> $B), value: $A) -> $B { f(value) }

  @doc """
  Build one callable that applies two projections to the same input.

  ## REPL
  xldr(1)> pair = both(&String::len, {|text: String| text ++ "!"})
  xldr(2)> pair("abc")
  (3, "abc!")
  """
  def both(f: ($A -> $B), g: ($A -> $C)) -> ($A -> ($B, $C)) {
    {|value| (f(value), g(value)) }
  }

  @doc """
  Build one callable that applies three projections to the same input.

  ## REPL
  xldr(1)> triple = both3(&String::len, {|text: String| text ++ "!"}, {|text: String| text ++ "?"})
  xldr(2)> triple("abc")
  (3, "abc!", "abc?")
  """
  def both3(f: ($A -> $B), g: ($A -> $C), h: ($A -> $D)) -> ($A -> ($B, $C, $D)) {
    {|value| (f(value), g(value), h(value)) }
  }

  @doc """
  Build one callable that applies four projections to the same input.
  """
  def both4(f: ($A -> $B), g: ($A -> $C), h: ($A -> $D), i: ($A -> $E)) -> ($A -> ($B, $C, $D, $E)) {
    {|value| (f(value), g(value), h(value), i(value)) }
  }

  @doc """
  Build one callable that applies five projections to the same input.
  """
  def both5(f: ($A -> $B), g: ($A -> $C), h: ($A -> $D), i: ($A -> $E), j: ($A -> $F)) -> ($A -> ($B, $C, $D, $E, $F)) {
    {|value| (f(value), g(value), h(value), i(value), j(value)) }
  }

  @doc """
  Build one callable that applies six projections to the same input.
  """
  def both6(f: ($A -> $B), g: ($A -> $C), h: ($A -> $D), i: ($A -> $E), j: ($A -> $F), k: ($A -> $G)) -> ($A -> ($B, $C, $D, $E, $F, $G)) {
    {|value| (f(value), g(value), h(value), i(value), j(value), k(value)) }
  }

  @doc """
  Build one callable that applies seven projections to the same input.
  """
  def both7(f: ($A -> $B), g: ($A -> $C), h: ($A -> $D), i: ($A -> $E), j: ($A -> $F), k: ($A -> $G), l: ($A -> $H)) -> ($A -> ($B, $C, $D, $E, $F, $G, $H)) {
    {|value| (f(value), g(value), h(value), i(value), j(value), k(value), l(value)) }
  }

  @doc """
  Build one callable that applies eight projections to the same input.
  """
  def both8(f: ($A -> $B), g: ($A -> $C), h: ($A -> $D), i: ($A -> $E), j: ($A -> $F), k: ($A -> $G), l: ($A -> $H), m: ($A -> $I)) -> ($A -> ($B, $C, $D, $E, $F, $G, $H, $I)) {
    {|value| (f(value), g(value), h(value), i(value), j(value), k(value), l(value), m(value)) }
  }

  @doc """
  Map two 2-tuples pointwise with one mapper per position.

  ## REPL
  xldr(1)> zip_with2((1, 2), (10, 20), {|a, b| a + b}, {|a, b| a + b})
  (11, 22)
  """
  def zip_with2<$A0, $A1, $B0, $B1, $C0, $C1>(
    left: ($A0, $A1),
    right: ($B0, $B1),
    f0: ($A0, $B0 -> $C0),
    f1: ($A1, $B1 -> $C1),
  ) -> ($C0, $C1) {
    (f0(left._0, right._0), f1(left._1, right._1))
  }

  @doc """
  Map two 2-tuples pointwise with `Result`-returning mappers.

  ## REPL
  xldr(1)> zip_with2_result((1, 2), (10, 20), {|a, b| Ok(a + b)}, {|a, b| Ok(a + b)})
  Ok((11, 22))
  """
  def zip_with2_result<$A0, $A1, $B0, $B1, $C0, $C1>(
    left: ($A0, $A1),
    right: ($B0, $B1),
    f0: ($A0, $B0 -> Result<$C0>),
    f1: ($A1, $B1 -> Result<$C1>),
  ) -> Result<($C0, $C1)> {
    c0 =? f0(left._0, right._0)
    c1 =? f1(left._1, right._1)
    Ok((c0, c1))
  }

  @doc """
  Map two 3-tuples pointwise with one mapper per position.
  """
  def zip_with3<$A0, $A1, $A2, $B0, $B1, $B2, $C0, $C1, $C2>(
    left: ($A0, $A1, $A2),
    right: ($B0, $B1, $B2),
    f0: ($A0, $B0 -> $C0),
    f1: ($A1, $B1 -> $C1),
    f2: ($A2, $B2 -> $C2),
  ) -> ($C0, $C1, $C2) {
    (f0(left._0, right._0), f1(left._1, right._1), f2(left._2, right._2))
  }

  @doc """
  Map two 3-tuples pointwise with `Result`-returning mappers.
  """
  def zip_with3_result<$A0, $A1, $A2, $B0, $B1, $B2, $C0, $C1, $C2>(
    left: ($A0, $A1, $A2),
    right: ($B0, $B1, $B2),
    f0: ($A0, $B0 -> Result<$C0>),
    f1: ($A1, $B1 -> Result<$C1>),
    f2: ($A2, $B2 -> Result<$C2>),
  ) -> Result<($C0, $C1, $C2)> {
    c0 =? f0(left._0, right._0)
    c1 =? f1(left._1, right._1)
    c2 =? f2(left._2, right._2)
    Ok((c0, c1, c2))
  }

  @doc """
  Map two 4-tuples pointwise with one mapper per position.
