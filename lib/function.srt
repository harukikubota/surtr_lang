  @doc """
  Map two 5-tuples pointwise with `Result`-returning mappers.
  """
  def zip_with5_result<$A0, $A1, $A2, $A3, $A4, $B0, $B1, $B2, $B3, $B4, $C0, $C1, $C2, $C3, $C4>(
    left: ($A0, $A1, $A2, $A3, $A4),
    right: ($B0, $B1, $B2, $B3, $B4),
    f0: ($A0, $B0 -> Result<$C0>),
    f1: ($A1, $B1 -> Result<$C1>),
    f2: ($A2, $B2 -> Result<$C2>),
    f3: ($A3, $B3 -> Result<$C3>),
    f4: ($A4, $B4 -> Result<$C4>),
