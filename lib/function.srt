    left: ($A0, $A1, $A2, $A3, $A4, $A5, $A6, $A7),
    right: ($B0, $B1, $B2, $B3, $B4, $B5, $B6, $B7),
    f0: ($A0, $B0 -> $C0),
    f1: ($A1, $B1 -> $C1),
    f2: ($A2, $B2 -> $C2),
