  @doc """
  Duplicate one value into a pair.

  ## REPL
  xldr(1)> dup(7)
  (7, 7)
  """
  def dup(value: $A) -> ($A, $A) { (value, value) }

  @doc """
  Apply a unary callable to the first element of a pair.

  ## REPL
  xldr(1)> show_first = first(&to_string)
  xldr(2)> show_first((10, "ok"))
  ("10", "ok")
  """
  def first(f: ($A -> $C)) -> (($A, $B) -> ($C, $B)) {
    {|pair: ($A, $B)|
      (left, right) = pair
      (f(left), right)
    }
  }

  @doc """
  Apply a unary callable to the second element of a pair.

  ## REPL
  xldr(1)> len_second = second(&String::len)
  xldr(2)> len_second((10, "four"))
  (10, 4)
  """
  def second(f: ($B -> $C)) -> (($A, $B) -> ($A, $C)) {
    {|pair: ($A, $B)|
      (left, right) = pair
      (left, f(right))
    }
  }

  @doc """
  Convert a binary callable into a curried callable.

  ## REPL
  xldr(1)> add = {|left: Int, right: Int| left + right}
  xldr(2)> curried = curry(add)
  xldr(3)> add_two = curried(2)
  xldr(4)> add_two(5)
  7
  """
  def curry(f: ($A, $B -> $C)) -> ($A -> ($B -> $C)) {
    {|left|
      {|right|
        f(left, right)
      }
    }
  }

  @doc """
  Convert a curried callable into a binary callable.

  ## REPL
  xldr(1)> add = {|left: Int| {|right: Int| left + right}}
  xldr(2)> binary = uncurry(add)
  xldr(3)> binary(3, 4)
  7
  """
  def uncurry(f: ($A -> ($B -> $C))) -> ($A, $B -> $C) {
    {|left, right|
      step = f(left)
      step(right)
    }
  }
}
