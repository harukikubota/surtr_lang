  def zip_with6_result<$A0, $A1, $A2, $A3, $A4, $A5, $B0, $B1, $B2, $B3, $B4, $B5, $C0, $C1, $C2, $C3, $C4, $C5>(
    left: ($A0, $A1, $A2, $A3, $A4, $A5),
