  @doc """
  Map two 4-tuples pointwise with `Result`-returning mappers.
  """
  def zip_with4_result<$A0, $A1, $A2, $A3, $B0, $B1, $B2, $B3, $C0, $C1, $C2, $C3>(
    left: ($A0, $A1, $A2, $A3),
