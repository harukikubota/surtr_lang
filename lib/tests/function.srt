include "./schema/function_schema.srt"

import FunctionSchema::{double, inc, show_int};
import Test;

def on(_left: String, _right: String) -> Ordering {
  Ordering::Greater
}

test("Function") {
  describe("plain composition laws") {
    # ghci> let f = (+ 1)
    # ghci> (f . id) 2
    # ghci> f 2
    it("right identity uses id") {
      composed = &id >> &inc
      assert_eq(inc(2), composed(2))
    }

    # ghci> let f = (+ 1)
    # ghci> (id . f) 2
    # ghci> f 2
    it("left identity uses id") {
      composed = &inc >> &id
      assert_eq(inc(2), composed(2))
    }

    # ghci> let f = (+ 1)
    # ghci> let g = (* 2)
    # ghci> let h = show
    # ghci> ((h . g) . f) 2 == (h . (g . f)) 2
    it("composition is associative") {
      left = (&inc >> &double) >> &show_int
      right = &inc >> (&double >> &show_int)
      assert_eq(left(2), right(2))
    }
  }

  describe("trait integration") {
    it("Composable::compose matches >>") {
      direct = Composable::compose(&inc, &double)
      operator = &inc >> &double
      assert_eq(6, direct(2))
      assert_eq(direct(2), operator(2))
    }

    it("id composes on both sides through the trait") {
      left = Composable::compose(&id, &inc)
      right = Composable::compose(&inc, &id)
      assert_eq(inc(4), left(4))
      assert_eq(inc(4), right(4))
    }
  }

  describe("on helper") {
    it("call form lifts a comparison through a key function") {
      by_len = Function::on({|left, right| compare(left, right)}, &String::len)
      sorted = List::sort_by(["a", "abcd", "xy"], by_len)
      assert_eq(["a", "xy", "abcd"], sorted)
    }

    it("ordinary call form still follows shadowing") {
      assert_eq(Ordering::Greater, on("a", "b"))
    }

    it("infix form resolves to Function::on even when shadowed") {
      sorted = List::sort_by(["a", "abcd", "xy"], &compare `on` &String::len)
      assert_eq(["a", "xy", "abcd"], sorted)
    }
  }

  describe("bothN helpers") {
    it("both3 returns a flat triple") {
      summary = Tuple::both3(&String::len, {|text: String| text ++ "!"}, {|text: String| text ++ "?"})
      assert_eq((3, "abc!", "abc?"), summary("abc"))
    }

    it("both3 works with compare on sort_by") {
      users = [
        (2, 9, 10),
        (1, 9, 30),
        (1, 5, 20),
        (1, 5, 10),
      ]
      sorted = List::sort_by(users, &compare `on` Tuple::both3(
        {|user: (Int, Int, Int)| user._0},
        {|user: (Int, Int, Int)| user._1},
        {|user: (Int, Int, Int)| user._2},
      ))
      assert_eq(
        [
          (1, 5, 10),
          (1, 5, 20),
          (1, 9, 30),
          (2, 9, 10),
        ],
        sorted,
      )
    }
  }
}
