defrecord GeneratorHolder(saved: Generator<Int>)

defmod GeneratorSchema {
  def fibonacci(count: Int) -> Generator<Int> {
    Generator::unfold((0, 1, count), {|state|
      if(state._2 > 0,
        Option::Some((state._0, (state._1, state._0 + state._1, state._2 - 1))),
        Option::None)
    })
  }

  def observed_sequence() -> Generator<Int> {
    Generator::unfold(1, {|n|
      print("step=#{n}")
      if(n <= 2, Option::Some((n, n + 1)), Option::None)
    })
  }
}
