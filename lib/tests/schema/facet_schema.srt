defmod FacetSchema {
  defrecord ScoreFixture(scores: List<Int>, score: HashMap<Int>)

  def demo_fixture() -> ((Config, Result<String>), (String, Int), BitWidth) {
    (
      (Config::new("App"), Ok("ally")),
      ("score", 7),
      BitWidth::Any(5),
    )
  }

  def pending_fixture() -> ((Config, Result<String>), (String, Int), BitWidth) {
    (
      (Config::new("Guest"), Err(NoneError)),
      ("score", 1),
      BitWidth::Any(2),
    )
  }

  def rename(value: String) -> Result<String> {
    Ok(value ++ "!")
  }

  def bump(value: Int) -> Result<Int> {
    Ok(value + 1)
  }

  def score_fixture(scores: List<Int>, score: HashMap<Int>) -> ScoreFixture {
    ScoreFixture(scores, score)
  }
}
