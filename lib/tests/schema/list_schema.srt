defmod ListSchema {
  def add_one(x: Int) -> Int {
    x + 1
  }

  def list_pure(x: Int) -> List<Int> {
    [x]
  }

  def list_step1(x: Int) -> List<Int> {
    [x, x + 10]
  }

  def list_step2(x: Int) -> List<Int> {
    if(x < 10, [x * 2], [])
  }

  def list_step3(x: Int) -> List<Int> {
    [x - 3]
  }
}
