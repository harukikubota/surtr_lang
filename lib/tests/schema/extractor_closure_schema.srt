defmod ExtractorClosureSchema {
  def make_threshold(limit: Int) -> ExtractorClosure<(Int -> MatchResult<Int, Error>)> {
    *{|value: Int|
      True =? value > limit
      MatchResult::OK(value)
    }
  }

  def run(ext: ExtractorClosure<(Int -> MatchResult<Int, Error>)>, value: Int) -> Result<Int> {
    ext(accepted) =? Ok(value)
    Ok(accepted)
  }

  def make_runner(limit: Int) -> (Int -> Result<Int>) {
    ext = make_threshold(limit)
    {|value: Int|
      ext(accepted) =? Ok(value)
      Ok(accepted)
    }
  }

  def make_checked() -> ExtractorClosure<(Int -> MatchResult<Int, Error>)> {
    *{|value: Int|
      accepted =? ExtractorSchema::source(value)
      print("after-closure-result")
      MatchResult::OK(accepted)
    }
  }

  def make_nested_checked() -> ExtractorClosure<(Int -> MatchResult<Int, Error>)> {
    *{|value: Int|
      ExtractorSchema::result_checked(accepted) =? Ok(value)
      print("after-closure-extractor")
      MatchResult::OK(accepted)
    }
  }

  def run_tuple(ext: ExtractorClosure<((Int, Int) -> MatchResult<Int, Error>)>) -> Int {
    if_let((2, 3), ext(result), result, 0)
  }

  def run_two(ext: ExtractorClosure<(Int, Int -> MatchResult<Int, Error>)>) -> Int {
    if_let(3, ext(2, result), result, 0)
  }
}
