defmod ApplyPatternSchema {
  def error_kind(value: Result<$A>) -> String {
    match value { Err(error) => Error::kind(error), Ok(_) => "Ok" }
  }

  def continue_after_failure(value: Int) -> Int {
    failed = apply_pattern(value, 7)
    print("after-failure")
    if(is_match(failed, Err(_)), value + 1, 0)
  }

  def make_runner(amount: Int) -> (Int -> Result<Int>) {
    {|value: Int| apply_pattern(value, ExtractorSchema::offset(amount, _1))}
  }
}
