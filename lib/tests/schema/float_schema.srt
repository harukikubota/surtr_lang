defstruct Score {
  value: Float,
}

impl Show for Score {
  def to_string(self: Self) -> String {
    "Score(" ++ inspect(self.value) ++ ")"
  }
}

impl Score {
  def new(value: Float) -> Self {
    Score { value: value }
  }
}

defmod FloatSchema {
  def safe_ratio(left: Float, right: Float) -> Result<Float> {
    Float::safe_div(left, right)
  }
}
