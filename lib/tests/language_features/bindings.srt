include "./support/bindings.srt"
import BindingProbe;
import Test;

def add_one(value: Int) -> Int { value + 1 }
included_sum = add(1, 2)
top_level_sum = add_one(included_sum)

test("bindings") {
  describe("include and top-level order") {
    it("uses the included declaration") { assert_eq(3, included_sum) }
    it("runs expressions in source order") { assert_eq(4, top_level_sum) }
  }
  describe("annotation") {
    it("binds an Int") { num: Int = 10; assert_eq(10, num) }
    it("binds a String") { name: String = "hello"; assert_eq("hello", name) }
  }
  describe("shadowing") {
    it("uses the latest binding") { x = 10; x = 20; assert_eq(20, x) }
  }
  describe("tuple destructuring") {
    it("binds each tuple component") {
      pair = (1, "two")
      (left, right) = pair
      do::<Result> { assert_eq(1, left); assert_eq("two", right) }
    }
    it("binds names in a tuple Pattern") {
      pair = (1, "two")
      actual = match pair { (n, text) => text ++ ":" ++ to_string(n), }
      assert_eq("two:1", actual)
    }
  }
  describe("list literal") {
    it("binds an Int list") { nums = [1, 2, 3]; assert_eq([1, 2, 3], nums) }
    it("binds a String list") { strs = ["a", "b", "c"]; assert_eq(["a", "b", "c"], strs) }
    it("annotates an empty list") { empty: List<Int> = []; assert_eq(0, List::len(empty)) }
  }
}
