include "./support/bindings.srt"
import BindingProbe;
import Test;

def add_one(value: Int) -> Int { value + 1 }
included_sum = add(1, 2)
top_level_sum = add_one(included_sum)

test("bindings") {
  describe("include and top-level order") {
    it("uses the included declaration") {
      do {
        assert_eq(3, included_sum)
      }
    }
    it("runs expressions in source order") {
      do {
        assert_eq(4, top_level_sum)
      }
    }
  }
  describe("annotation") {
    it("binds an Int") {
      do {
        num: Int = 10; assert_eq(10, num)
      }
    }
    it("binds a String") {
      do {
        name: String = "hello"; assert_eq("hello", name)
      }
    }
  }
  describe("shadowing") {
    it("uses the latest binding") {
      do {
        x = 10; x = 20; assert_eq(20, x)
      }
    }
  }
  describe("tuple destructuring") {
    it("binds each tuple component") {
      do {
        pair = (1, "two")
        (left, right) = pair

        assert_eq(1, left)
        assert_eq("two", right)
      }
    }
    it("binds names in a tuple Pattern") {
      do {
        pair = (1, "two")
        actual = match pair { (n, text) => text ++ ":" ++ to_string(n), }

        assert_eq("two:1", actual)
      }
    }
  }
  describe("list literal") {
    it("binds an Int list") {
      do {
        nums = [1, 2, 3]; assert_eq([1, 2, 3], nums)
      }
    }
    it("binds a String list") {
      do {
        strs = ["a", "b", "c"]; assert_eq(["a", "b", "c"], strs)
      }
    }
    it("annotates an empty list") {
      do {
        empty: List<Int> = []; assert_eq(0, List::len(empty))
      }
    }
  }
}
