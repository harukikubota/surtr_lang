import Test;

def traced_boolean(value: Boolean) -> Boolean { print("right"); value }

def assert_list_decomposition(value: List<Int>) -> Result<()> {
  match value {
    uncons(head, tail) => do {
      assert_eq(1, head)
      assert_eq([2, 3], tail)
    },
    _ => fail("expected List decomposition"),
  }
}

def assert_string_decomposition(value: String) -> Result<()> {
  match value {
    uncons(head, tail) => do {
      assert_eq("猫", head)
      assert_eq("ab", tail)
    },
    _ => fail("expected String decomposition"),
  }
}

test("Kernel") {
  describe("guard") {
    it("returns Unit in a successful Option") {
      do {
        assert_some_eq((), guard::<Option>(True))
      }
    }
    it("returns empty Option on rejection") {
      do {
        assert_none(guard::<Option>(False))
      }
    }
  }
  describe("require") {
    it("accepts true") {
      do {
        assert_ok(require(True, NoneError))
      }
    }
    it("rejects false with the provided kind") {
      do {
        assert_err_kind(NoneError, require(False, NoneError))
      }
    }
  }
  describe("ensure") {
    it("returns an accepted value unchanged") {
      do {
        assert_ok_eq(3, ensure(3, {|n| n > 0}, NoneError))
      }
    }
    it("rejects a failed predicate") {
      do {
        assert_err_kind(NoneError, ensure(0, {|n| n > 0}, NoneError))
      }
    }
    it("calls the predicate once") {
      do {
        actual = ensure(3, {|n| print("predicate"); n > 0}, NoneError)

        assert_ok_eq(3, actual)
        assert_stdout_eq(["predicate"])
      }
    }
  }
  describe("tap") {
    it("observes and preserves the value") {
      do {
        actual = tap(3, {|n| print(to_string(n))})

        assert_eq(3, actual)
        assert_stdout_eq(["3"])
      }
    }
  }
  describe("dup") {
    it("copies the same input into both positions") {
      do {
        (left, right) = dup(7)

        assert_eq(7, left)
        assert_eq(7, right)
      }
    }
  }
  describe("todo") {
    it("returns NotImplemented for the chosen success type") {
      do {
        assert_err_kind(NotImplemented, todo::<Int>())
      }
    }
  }
  describe("inspect") {
    it("quotes and escapes String control characters") {
      do {
        assert_eq("\"a\\nb\"", inspect("a\nb"))
      }
    }
  }
  describe("and") {
    it("skips the right side after False") {
      do {
        actual = and(False, traced_boolean(True))

        assert_false(actual)
        assert_stdout_eq([])
      }
    }
    it("evaluates the right side once after True") {
      do {
        actual = and(True, traced_boolean(False))

        assert_false(actual)
        assert_stdout_eq(["right"])
      }
    }
  }
  describe("or") {
    it("skips the right side after True") {
      do {
        actual = or(True, traced_boolean(False))

        assert_true(actual)
        assert_stdout_eq([])
      }
    }
    it("evaluates the right side once after False") {
      do {
        actual = or(False, traced_boolean(True))

        assert_true(actual)
        assert_stdout_eq(["right"])
      }
    }
  }
  describe("uncons") {
    it("decomposes a nonempty List") {
      do {
        assert_list_decomposition([1, 2, 3])
      }
    }
    it("rejects an empty List") {
      do {
        empty: List<Int> = []

        assert_false(is_match(empty, uncons(_, _)))
      }
    }
    it("decomposes a multibyte String") {
      do {
        assert_string_decomposition("猫ab")
      }
    }
    it("rejects an empty String") {
      do {
        assert_false(is_match("", uncons(_, _)))
      }
    }
  }
}
