def inc(x: Int) -> Int { x + 1 }
def double(x: Int) -> Int { x * 2 }
def show_int(x: Int) -> String { to_string(x) }

import Test;

def add_pair(x: Int, y: Int) -> Int { x + y }

def on(_left: String, _right: String) -> Ordering {
  Ordering::Greater
}

test("Function") {
  describe("plain composition laws") {
    # ghci> let f = (+ 1)
    # ghci> (f . id) 2
    # ghci> f 2
    it("right identity uses id") {
      composed = &id >> &inc
      assert_eq(inc(2), composed(2))
    }

    # ghci> let f = (+ 1)
    # ghci> (id . f) 2
    # ghci> f 2
    it("left identity uses id") {
      composed = &inc >> &id
      assert_eq(inc(2), composed(2))
    }

    # ghci> let f = (+ 1)
    # ghci> let g = (* 2)
    # ghci> let h = show
    # ghci> ((h . g) . f) 2 == (h . (g . f)) 2
    it("composition is associative") {
      left = (&inc >> &double) >> &show_int
      right = &inc >> (&double >> &show_int)
      assert_eq(left(2), right(2))
    }
  }

  describe("fixed composition") {
    it(">> composes two unary functions") {
      composed = &inc >> &double
      assert_eq(6, composed(2))
    }

    it("id composes on both sides") {
      left = &id >> &inc
      right = &inc >> &id
      do::<Result> {
        assert_eq(inc(4), left(4))
        assert_eq(inc(4), right(4))
      }
    }
  }

  describe("on helper") {
    it("call form lifts a comparison through a key function") {
      by_len = Function::on({|left, right| compare(left, right)}, &String::len)
      sorted = List::sort_by(["a", "abcd", "xy"], by_len)
      assert_eq(["a", "xy", "abcd"], sorted)
    }

    it("ordinary call form still follows shadowing") {
      assert_eq(Ordering::Greater, on("a", "b"))
    }

    it("infix form resolves to Function::on even when shadowed") {
      sorted = List::sort_by(["a", "abcd", "xy"], &compare `on` &String::len)
      assert_eq(["a", "xy", "abcd"], sorted)
    }
  }

  describe("id") { it("returns its input") { assert_eq(4, id(4)) } }
  describe("always") { it("returns the fixed value") { keep = always(3); assert_eq(3, keep("ignored")) } }
  describe("noop") { it("returns Unit without output") { idle = noop(); idle(); assert_stdout_eq([]) } }
  describe("flip") { it("swaps arguments") { flipped = flip({|x: Int, y: Int| x - y}); assert_eq(8, flipped(2, 10)) } }
  describe("apply") { it("invokes a unary callable") { assert_eq(5, apply(&inc, 4)) } }
  describe("curry") { it("supplies arguments in stages") { curried = curry(&add_pair); add_two = curried(2); assert_eq(7, add_two(5)) } }
  describe("uncurry") { it("supplies both arguments together") { binary = uncurry({|x: Int| {|y: Int| x + y}}); assert_eq(7, binary(3, 4)) } }
}
