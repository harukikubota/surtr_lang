import Test;

defrecord Settings(value: Int)
impl Default for Settings {
  def default::<Settings>() -> Settings { Settings(7) }
}

test("Default") {
  describe("default") {
    it("constructs the expected custom target") {
      do {
        value: Settings = Default::default()

        assert_eq(7, value.value)
      }
    }

    it("constructs the explicitly selected custom target") {
      do {
        value = Default::default::<Settings>()

        assert_eq(7, value.value)
      }
    }

  }

}
