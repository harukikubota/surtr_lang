import Test;

defrecord Decimal(text: String)
impl TryConvert<Int> for Decimal {
  def try_to::<Int>(self: Self) -> Result<Int> { try_to::<Int>(self.text) }
}

test("TryConvert") {
  describe("try_to") {
    it("returns a successful custom conversion") {
      assert_ok_eq(7, TryConvert::try_to::<Int>(Decimal("7")))
    }

    it("preserves the custom conversion error") {
      assert_err_kind(InvalidIntegerLiteral, TryConvert::try_to::<Int>(Decimal("invalid")))
    }

  }

}
