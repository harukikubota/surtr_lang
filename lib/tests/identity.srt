import Test;

defstruct IdentityTestHolder {
  value: Identity<Int>,
}

impl IdentityTestHolder {
  def new(value: Identity<Int>) -> IdentityTestHolder {
    IdentityTestHolder { value: value }
  }
}

defstruct IdentityPayload {
  value: Int,
}

impl IdentityPayload {
  def new(value: Int) -> IdentityPayload {
    IdentityPayload { value: value }
  }
}

def increment(value: Int) -> Int {
  value + 1
}

def double_plain(value: Int) -> Int {
  value * 2
}

def identity_inc(value: Int) -> Identity<Int> {
  Identity::new(value + 1)
}

def identity_double(value: Int) -> Identity<Int> {
  Identity::new(value * 2)
}

def identity_pure(value: Int) -> Identity<Int> {
  Applicative::pure(value)
}

test("Identity") {
  describe("documented API") {
    it("constructs and runs a value") {
      value: Identity<Int> = Identity::new(7)
      assert_eq(7, Identity::run(value))
    }
  }

  describe("trait behavior") {
    it("maps through Functor") {
      mapped: Identity<Int> = Identity::new(7) |*> {|value| value + 1}
      assert_eq(8, Identity::run(mapped))
    }

    it("lifts through Applicative pure") {
      lifted: Identity<Int> = Applicative::pure(7)
      assert_eq(7, Identity::run(lifted))
    }

    it("applies a contextual function through Applicative") {
      mapper: Identity<(Int -> Int)> = Identity::new({|value| value + 5})
      value: Identity<Int> = Identity::new(3)
      applied: Identity<Int> = Applicative::ap(mapper, value)
      assert_eq(8, Identity::run(applied))
    }

    it("chains through Monad without nesting") {
      chained: Identity<Int> = Identity::new(3) |>= &identity_double
      assert_eq(6, Identity::run(chained))
    }

    it("changes payload types without Eq or Show bounds") {
      payload: Identity<IdentityPayload> = Identity::new(IdentityPayload::new(4))
      mapped: Identity<Int> = payload |*> {|item| item.value + 1}
      bound: Identity<Int> = payload |>= {|item| Identity::new(item.value * 2)}

      assert_eq(5, Identity::run(mapped))
      assert_eq(8, Identity::run(bound))
    }

    it("preserves Identity in properties, lists, tuples, and Facet updates") {
      original: Identity<Int> = Identity::new(10)
      holder: IdentityTestHolder = IdentityTestHolder::new(original)
      updated_holder: IdentityTestHolder = Facet::put(IdentityTestHolder.value, holder, Identity::new(20))
      values: List<Identity<Int>> = [original, updated_holder.value]
      first: Identity<Int> =? List::at(values, 0)
      second: Identity<Int> =? List::at(values, 1)
      pair: (Identity<Int>, Identity<Int>) = (first, second)

      assert_eq(10, Identity::run(holder.value))
      assert_eq(20, Identity::run(updated_holder.value))
      assert_eq(10, Identity::run(pair._0))
      assert_eq(20, Identity::run(second))
    }

    it("keeps Applicative pure and Monad return equivalent") {
      pure_value: Identity<Int> = Applicative::pure(4)
      returned_value: Identity<Int> = Monad::return(4)
      assert_eq(Identity::run(pure_value), Identity::run(returned_value))
    }
  }

  describe("finite functor laws") {
    it("satisfies identity") {
      value: Identity<Int> = Identity::new(3)
      mapped: Identity<Int> = value |*> {|item| item}

      assert_eq(Identity::run(value), Identity::run(mapped))
    }

    it("satisfies composition") {
      value: Identity<Int> = Identity::new(3)
      left: Identity<Int> = (value |*> &increment) |*> &double_plain
      right: Identity<Int> = value |*> {|item| double_plain(increment(item))}

      assert_eq(Identity::run(left), Identity::run(right))
    }
  }

  describe("finite applicative laws") {
    it("satisfies identity") {
      mapper: Identity<(Int -> Int)> = Identity::new({|item| item})
      value: Identity<Int> = Identity::new(3)
      applied: Identity<Int> = Applicative::ap(mapper, value)

      assert_eq(3, Identity::run(applied))
    }

    it("satisfies homomorphism") {
      mapper: Identity<(Int -> Int)> = Applicative::pure(&increment)
      value: Identity<Int> = Applicative::pure(3)
      left: Identity<Int> = Applicative::ap(mapper, value)
      right: Identity<Int> = Applicative::pure(increment(3))

      assert_eq(Identity::run(left), Identity::run(right))
    }

    it("satisfies interchange") {
      mapper: Identity<(Int -> Int)> = Identity::new(&increment)
      value: Identity<Int> = Identity::new(3)
      left: Identity<Int> = Applicative::ap(mapper, value)
      apply_to_value: Identity<((Int -> Int) -> Int)> = Identity::new({|function| function(3)})
      right: Identity<Int> = Applicative::ap(apply_to_value, mapper)

      assert_eq(Identity::run(left), Identity::run(right))
    }

    it("satisfies composition") {
      mapper: Identity<(Int -> Int)> = Identity::new(&increment)
      value_mapper: Identity<(Int -> Int)> = Identity::new(&double_plain)
      value: Identity<Int> = Identity::new(3)
      left: Identity<Int> = Identity::new({|first| {|second| {|item| first(second(item))}}}) |*| mapper |*| value_mapper |*| value
      right: Identity<Int> = Applicative::ap(mapper, Applicative::ap(value_mapper, value))

      assert_eq(Identity::run(left), Identity::run(right))
    }
  }

  describe("finite monad laws") {
    it("satisfies left identity") {
      left: Identity<Int> = Monad::return(3) |>= &identity_inc
      right: Identity<Int> = identity_inc(3)
      assert_eq(Identity::run(left), Identity::run(right))
    }

    it("satisfies right identity") {
      value: Identity<Int> = Identity::new(3)
      chained: Identity<Int> = value |>= &identity_pure
      assert_eq(Identity::run(value), Identity::run(chained))
    }

    it("satisfies associativity") {
      value: Identity<Int> = Identity::new(3)
      left: Identity<Int> = (value |>= &identity_inc) |>= &identity_double
      right: Identity<Int> = value |>= {|inner| identity_inc(inner) |>= &identity_double}
      assert_eq(Identity::run(left), Identity::run(right))
    }
  }
}
