import Test;
import Option;

test("Test assertions") {
  it("checks equality, branches, and strings") {
    no_function: Option<(Int -> Int)> = Option::None
    do {
      assert_ne(1, 2)
      assert_err_contains("expected unequal", assert_ne(1, 1))
      assert_ok(Ok({|x: Int| x}))
      assert_err(Err(NoneError))
      assert_err_contains("expected Ok", assert_ok(Err(NoneError)))
      assert_err_contains("expected Err", assert_err(Ok(1)))
      assert_some_eq(2, Option::Some(2))
      assert_err_contains("expected", assert_some_eq(2, Option::Some(3)))
      assert_err_contains("None", assert_some_eq(2, Option::None))
      assert_none(no_function)
      assert_err_contains("Some(3)", assert_none(Option::Some(3)))
      assert_contains("世界", "hello 世界")
      assert_contains("", "text")
      assert_err_contains("missing", assert_contains("missing", "text"))
      assert_err_contains("Keep this detail", fail("Keep this detail"))
    }
  }
  it("checks absolute float tolerance without overflow") {
    huge = .0
    do {
      assert_approx(1.0, 1.25, 0.25)
      assert_approx(1.0, 1.0, 0.0)
      assert_approx(-1.0, 1.0, 2.0)
      assert_err_contains("tolerance", assert_approx(1.0, 1.0, -0.1))
      assert_err_contains("expected", assert_approx(1.0, 1.5, 0.25))
      assert_err_contains("expected", assert_approx(huge, 0.0 - huge, huge))
    }
  }
}
