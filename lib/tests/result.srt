include "./schema/result_schema.srt"

import ResultSchema::{
  add2,
  add3,
  emit_next,
  ensure_adult,
  inc,
  load_user,
  parse_user_id,
  recover_to_one,
  render_user,
  result_pure,
  safe_add2,
  safe_add3,
  safe_double_under_limit,
  safe_inc,
  safe_step3,
};
import Result::{
  all,
  cause,
  chain,
  flat_lift,
  flat_lift2,
  flat_lift3,
  flat_with,
  flat_with2,
  flat_with3,
  flatten,
  is_err,
  is_ok,
  lift,
  lift2,
  lift3,
  map_err,
  tap_ok,
  tap_err,
  then,
  with,
  with2,
  with3,
  zip,
  zip3,
};
import Test;

test("Result") {
  describe("is_ok") {
    it("returns True for Ok") { assert_true(is_ok(Ok(1))) }
    it("returns False for Err") { assert_false(is_ok(Err(NoneError))) }
  }

  describe("is_err") {
    it("returns False for Ok") { assert_false(is_err(Ok(1))) }
    it("returns True for Err") { assert_true(is_err(Err(NoneError))) }
  }

  describe("map_err") {
    it("keeps Ok") {
      assert_eq("Ok(1)", inspect(map_err(Ok(1), NoneError)))
    }

    it("replaces Err") {
      assert_eq(
        "Err(ZeroDivisionError(\"division by zero\"))",
        inspect(map_err(Err(NoneError), ZeroDivisionError)),
      )
    }

    it("accepts an existing Error value from Err binding") {
      rebound = match Err(ZeroDivisionError) {
        Ok(_) => map_err(Err(NoneError), NoneError),
        Err(e) => map_err(Err(NoneError), e),
      }

      assert_eq(
        "Err(ZeroDivisionError(\"division by zero\"))",
        inspect(rebound),
      )
    }
  }

  describe("cause") {
    it("keeps Ok") {
      assert_eq("Ok(1)", inspect(cause(Ok(1), ZeroDivisionError)))
    }

    it("appends previous error") {
      assert_eq(
        "Err(ZeroDivisionError(\"division by zero\"))\n|_ NoneError(\"None Value.\")",
        inspect(cause(Err(NoneError), ZeroDivisionError)),
      )
    }

    it("accepts an existing Error value from Err binding") {
      wrapped = match Err(ZeroDivisionError) {
        Ok(_) => cause(Err(NoneError), NoneError),
        Err(e) => cause(Err(NoneError), e),
      }

      assert_eq(
        "Err(ZeroDivisionError(\"division by zero\"))\n|_ NoneError(\"None Value.\")",
        inspect(wrapped),
      )
    }
  }

  describe("chain") {
    it("keeps left Ok value") {
      assert_eq("Ok(1)", inspect(chain(Ok(1), Ok(()))))
    }

    it("propagates right Err after Ok") {
      assert_eq(
        "Err(ZeroDivisionError(\"division by zero\"))",
        inspect(chain(Ok(1), Err(ZeroDivisionError))),
      )
    }

    it("keeps left Err when right succeeds") {
      assert_eq("Err(NoneError(\"None Value.\"))", inspect(chain(Err(NoneError), Ok(()))))
    }

    it("chains right Err") {
      assert_eq(
        "Err(ZeroDivisionError(\"division by zero\"))\n|_ NoneError(\"None Value.\")",
        inspect(chain(Err(NoneError), Err(ZeroDivisionError))),
      )
    }
  }

  describe("recover / recover_kind") {
    it("recover keeps Ok without running the handler") {
      assert_eq("Ok(7)", inspect(recover(Ok(7), &recover_to_one)))
    }

    it("recover handles Err values") {
      assert_eq("Ok(1)", inspect(recover(Err(NoneError), &recover_to_one)))
    }

    it("recover_kind keeps Ok values") {
      assert_eq("Ok(7)", inspect(recover_kind(Ok(7), NoneError, {|err| Ok(String::len(inspect(err)))})))
    }

    it("recover_kind handles matching errors") {
      assert_eq("Ok(24)", inspect(recover_kind(Err(NoneError), NoneError, {|err| Ok(String::len(inspect(err)))})))
    }

    it("recover_kind keeps non-matching errors") {
      assert_eq(
        "Err(ZeroDivisionError(\"division by zero\"))",
        inspect(recover_kind(Err(ZeroDivisionError), NoneError, {|err| Ok(String::len(inspect(err)))})),
      )
    }

    it("recover_kind accepts constructor markers with payload") {
      assert_eq(
        "Ok(16)",
        inspect(recover_kind(Err(ApiError("boom")), ApiError("ignored"), {|err| Ok(String::len(inspect(err)))})),
      )
    }
  }

  describe("lift / with") {
    it("lift applies wrapped unary function") {
      assert_eq("Ok(2)", inspect(lift(Ok(&inc), Ok(1))))
    }

    it("lift propagates function errors first") {
      assert_eq("Err(NoneError(\"None Value.\"))", inspect(lift(Err(NoneError), Ok(1))))
    }

    it("lift2 applies wrapped binary function") {
      assert_eq("Ok(3)", inspect(lift2(Ok(&add2), Ok(1), Ok(2))))
    }

    it("lift2 propagates argument errors") {
      assert_eq("Err(NoneError(\"None Value.\"))", inspect(lift2(Ok(&add2), Err(NoneError), Ok(2))))
    }

    it("lift3 applies wrapped ternary function") {
      assert_eq("Ok(6)", inspect(lift3(Ok(&add3), Ok(1), Ok(2), Ok(3))))
    }

    it("lift3 stops at the first Err input") {
      assert_eq(
        "Err(NoneError(\"None Value.\"))",
        inspect(lift3(Ok(&add3), Ok(1), Err(NoneError), Ok(3))),
      )
    }

    it("with keeps value-first order") {
      assert_eq("Ok(2)", inspect(with(Ok(1), Ok(&inc))))
    }

    it("with2 keeps value-first order") {
      assert_eq("Ok(3)", inspect(with2(Ok(1), Ok(2), Ok(&add2))))
    }

    it("with3 keeps value-first order") {
      assert_eq("Ok(6)", inspect(with3(Ok(1), Ok(2), Ok(3), Ok(&add3))))
    }
  }

  describe("flat_lift / flat_with") {
    it("flat_lift flattens nested result") {
      assert_eq("Ok(2)", inspect(flat_lift(Ok(&safe_inc), Ok(1))))
    }

    it("flat_lift propagates argument errors") {
      assert_eq("Err(NoneError(\"None Value.\"))", inspect(flat_lift(Ok(&safe_inc), Err(NoneError))))
    }

    it("flat_lift2 flattens nested result") {
      assert_eq("Ok(3)", inspect(flat_lift2(Ok(&safe_add2), Ok(1), Ok(2))))
    }

    it("flat_lift2 propagates function errors") {
      assert_eq(
        "Err(NoneError(\"None Value.\"))",
        inspect(flat_lift2(Err(NoneError), Ok(1), Ok(2))),
      )
    }

    it("flat_lift3 flattens nested result") {
      assert_eq("Ok(6)", inspect(flat_lift3(Ok(&safe_add3), Ok(1), Ok(2), Ok(3))))
    }

    it("flat_lift3 propagates Err inputs") {
      assert_eq(
        "Err(NoneError(\"None Value.\"))",
        inspect(flat_lift3(Ok(&safe_add3), Ok(1), Ok(2), Err(NoneError))),
      )
    }

    it("flat_with keeps value-first order") {
      assert_eq("Ok(2)", inspect(flat_with(Ok(1), Ok(&safe_inc))))
    }

    it("flat_with2 keeps value-first order") {
      assert_eq("Ok(3)", inspect(flat_with2(Ok(1), Ok(2), Ok(&safe_add2))))
    }

    it("flat_with3 keeps value-first order") {
      assert_eq("Ok(6)", inspect(flat_with3(Ok(1), Ok(2), Ok(3), Ok(&safe_add3))))
    }
  }

  describe("zip / all / flatten") {
    it("zips two results") {
      assert_eq("Ok((1, 2))", inspect(zip(Ok(1), Ok(2))))
    }

    it("zip short-circuits on Err") {
      assert_eq("Err(NoneError(\"None Value.\"))", inspect(zip(Err(NoneError), Ok(2))))
    }

    it("zips three results") {
      assert_eq("Ok((1, 2, 3))", inspect(zip3(Ok(1), Ok(2), Ok(3))))
    }

    it("zip3 returns the first Err") {
      assert_eq("Err(NoneError(\"None Value.\"))", inspect(zip3(Ok(1), Err(NoneError), Ok(3))))
    }

    it("collects all Ok values") {
      assert_eq("Ok([1, 2, 3])", inspect(all([Ok(1), Ok(2), Ok(3)])))
    }

    it("returns first Err from all") {
      assert_eq("Err(NoneError(\"None Value.\"))", inspect(all([Ok(1), Err(NoneError), Ok(3)])))
    }

    it("flattens nested Ok") {
      assert_eq("Ok(1)", inspect(flatten(Ok(Ok(1)))))
    }

    it("keeps outer Err values") {
      assert_eq("Err(NoneError(\"None Value.\"))", inspect(flatten(Err(NoneError))))
    }
  }

  describe("tap_ok / tap_err / then") {
    it("tap_ok observes Ok and keeps value") {
      capture_stdout()
      result = tap_ok(Ok(1), {|x| print("tap:#{to_string(x)}")})
      assert_eq("Ok(1)", inspect(result))
      assert_stdout_eq(["tap:1"])
    }

    it("tap_err observes Err and keeps error") {
      capture_stdout()
      result = tap_err(Err(NoneError), {|err| print("tap_err:#{inspect(err)}")})
      assert_eq("Err(NoneError(\"None Value.\"))", inspect(result))
      assert_stdout_eq(["tap_err:NoneError(\"None Value.\")"])
    }

    it("tap_ok skips handlers for Err") {
      capture_stdout()
      result = tap_ok(Err(NoneError), {|_| print("unexpected")})
      assert_eq("Err(NoneError(\"None Value.\"))", inspect(result))
      assert_stdout_eq([])
    }

    it("tap_err skips handlers for Ok") {
      capture_stdout()
      result = tap_err(Ok(1), {|_| print("unexpected")})
      assert_eq("Ok(1)", inspect(result))
      assert_stdout_eq([])
    }

    it("then runs next when Ok") {
      capture_stdout()
      assert_eq("Ok(\"next\")", inspect(then(Ok(1), &emit_next)))
      assert_stdout_eq(["then-next"])
    }

    it("then short-circuits on Err") {
      capture_stdout()
      result = then(Err(NoneError), &emit_next)
      assert_eq("Err(NoneError(\"None Value.\"))", inspect(result))
      assert_stdout_eq([])
    }
  }

  describe("monad laws") {
    # ghci> let pureR = Right
    # ghci> let f x = Right (x + 1)
    # ghci> pureR 2 >>= f
    # ghci> f 2
    it("left identity holds") {
      assert_eq(safe_inc(2), result_pure(2) |>= safe_inc())
    }

    # ghci> let pureR = Right
    # ghci> let ok = Right 2
    # ghci> ok >>= pureR
    # ghci> ok
    it("right identity keeps Ok") {
      value: Result<Int> = Ok(2)
      assert_eq(value, value |>= result_pure())
    }

    # ghci> let pureR = Right
    # ghci> let err = Left "NoneError"
    # ghci> err >>= pureR
    # ghci> err
    it("right identity keeps Err") {
      value: Result<Int> = Err(NoneError)
      assert_eq(value, value |>= result_pure())
    }

    # ghci> let f x = Right (x + 1)
    # ghci> let g x = if x < 5 then Right (x * 2) else Left "NoneError"
    # ghci> let ok = Right 2
    # ghci> ((ok >>= f) >>= g) == (ok >>= (f >=> g))
    it("associativity holds on success") {
      value: Result<Int> = Ok(2)
      composed = &safe_inc >=> &safe_double_under_limit
      assert_eq((value |>= safe_inc()) |>= safe_double_under_limit(), value |>= composed)
    }

    # ghci> let f x = Right (x + 1)
    # ghci> let g x = if x < 5 then Right (x * 2) else Left "NoneError"
    # ghci> let ok = Right 5
    # ghci> ((ok >>= f) >>= g) == (ok >>= (f >=> g))
    it("associativity holds on propagated Err") {
      value: Result<Int> = Ok(5)
      composed = &safe_inc >=> &safe_double_under_limit
      assert_eq((value |>= safe_inc()) |>= safe_double_under_limit(), value |>= composed)
    }

    # ghci> let pureR = Right
    # ghci> let f x = Right (x + 1)
    # ghci> (pureR >=> f) 2
    # ghci> f 2
    it("kleisli left identity uses pure") {
      composed = &result_pure >=> &safe_inc
      assert_eq(composed(2), safe_inc(2))
    }

    # ghci> let pureR = Right
    # ghci> let f x = Right (x + 1)
    # ghci> (f >=> pureR) 2
    # ghci> f 2
    it("kleisli right identity uses pure") {
      composed = &safe_inc >=> &result_pure
      assert_eq(composed(2), safe_inc(2))
    }

    # ghci> let f x = Right (x + 1)
    # ghci> let g x = if x < 5 then Right (x * 2) else Left "NoneError"
    # ghci> let h x = Right (x - 3)
    # ghci> (((f >=> g) >=> h) 2) == ((f >=> (g >=> h)) 2)
    it("kleisli composition is associative") {
      left = (&safe_inc >=> &safe_double_under_limit) >=> &safe_step3
      right = &safe_inc >=> (&safe_double_under_limit >=> &safe_step3)
      assert_eq(left(2), right(2))
    }

    # ghci> let f x = Right (x + 1)
    # ghci> let g x = if x < 5 then Right (x * 2) else Left "NoneError"
    # ghci> (f >=> g) 2
    # ghci> f 2 >>= g
    it("kleisli composition matches staged bind") {
      composed = &safe_inc >=> &safe_double_under_limit
      assert_eq(composed(2), safe_inc(2) |>= safe_double_under_limit())
    }

    # ghci> let pureR = Right
    # ghci> let ok = Right 2
    # ghci> fmap (+ 1) ok
    # ghci> ok >>= (pureR . (+ 1))
    it("fmap matches bind with pure after mapping") {
      value: Result<Int> = Ok(2)
      assert_eq(value |*> inc(), value |>= {|x| result_pure(inc(x))})
    }
  }

  describe("applicative laws") {
    # pure(id) <*> v == v
    it("identity holds for Ok") {
      value: Result<Int> = Ok(2)
      identity = Ok({|x| x}) |*| value
      assert_eq(value, identity)
    }

    it("identity preserves Err") {
      value: Result<Int> = Err(NoneError)
      identity = Ok({|x| x}) |*| value
      assert_eq(value, identity)
    }

    # pure(f) <*> pure(x) == pure(f(x))
    it("homomorphism holds") {
      lifted = Ok({|x| x + 1}) |*| Ok(2)
      direct: Result<Int> = Ok(3)
      assert_eq(direct, lifted)
    }

    # u <*> pure(y) == pure(\f -> f(y)) <*> u
    it("interchange holds") {
      u: Result<(Int -> Int)> = Ok(&safe_inc)
      left = u |*| Ok(2)
      right = Ok({|f| f(2)}) |*| u
      assert_eq(left, right)
    }

    # pure(.) <*> u <*> v <*> w == u <*> (v <*> w)
    it("composition holds") {
      u: Result<(Int -> Int)> = Ok(&safe_inc)
      v: Result<(Int -> Int)> = Ok(&safe_double_under_limit)
      w: Result<Int> = Ok(2)
      left = Ok({|f| {|g| {|x| f(g(x))}}}) |*| u |*| v |*| w
      right = u |*| (v |*| w)
      assert_eq(left, right)
    }
  }

  describe("trait integration") {
    it("supports realistic user pipelines through result operators") {
      lookup = &parse_user_id >=> &load_user
      summary: Result<String> = lookup("7") |>= ensure_adult() |*> render_user()
      assert_eq("Ok(\"alice:20\")", inspect(summary))
    }

    it("propagates user-defined errors through the same pipeline") {
      lookup = &parse_user_id >=> &load_user
      summary: Result<String> = lookup("9") |>= ensure_adult() |*> render_user()
      assert_eq("Err(MissingUser(\"user 9\"))", inspect(summary))
    }
  }
}
