defmod SpecDefs {
  def take(flag: Boolean, block: (-> Int)) -> Int {
    if(flag, block(), 0)
  }

  def run_if(flag: Boolean, block: (-> Unit)) -> Unit {
    if_then(flag, block())
  }

  def fallback_value() -> Int {
    2
  }

  def is_even(n: Int) -> Boolean {
    Int::is_even(n)
  }

  def add(x: Int, y: Int) -> Int { x + y }
  def add3(x: Int, y: Int, z: Int) -> Int { x + y + z }

  def make() -> (_ -> Int) {
    always(2)
  }
}
