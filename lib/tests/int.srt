include "./schema/int_schema.srt"

import Int::{
  abs,
  min,
  max,
  sign,
  is_even,
  is_odd,
  bit_and,
  bit_or,
  bit_xor,
  bit_not,
  parse,
  parse_dec,
  parse_hex,
  parse_oct,
  parse_bin,
  parse_literal,
  test_bit,
  set_bit,
  clear_bit,
  toggle_bit,
  width_bits,
  mask,
  wrap_unsigned,
  wrap_signed,
  bit_not_in,
  test_bit_in,
  set_bit_in,
  clear_bit_in,
  toggle_bit_in,
  shl_in,
  shr_logical_in,
  rotl_in,
  rotr_in,
  shl,
  shr,
};
import Test;

test("Int") {
  describe("numeric helpers") {
    it("supports safe division and modulo") {
      assert_eq(
        ("Ok(4)", "Ok(1)", "Err(ZeroDivisionError(\"division by zero\"))"),
        (
          inspect(Int::safe_div(8, 2)),
          inspect(Int::safe_mod(7, 3)),
          inspect(Int::safe_div(8, 0))
        ),
      )
    }

    it("supports abs min max and sign") {
      assert_eq((5, -2, 4, -1, 0, 1), (abs(-5), min(4, -2), max(4, -2), sign(-12), sign(0), sign(9)))
    }

    it("supports parity helpers") {
      assert_eq((True, False, False), (is_even(8), is_odd(8), is_even(-3)))
    }
  }

  describe("bit_and") {
    it("combines shared bits") { assert_eq(2, bit_and(6, 3)) }
  }

  describe("parse") {
    it("parses decimal text") { assert_eq("Ok(123)", inspect(parse("123"))) }
    it("aliases parse_dec") { assert_eq(inspect(parse_dec("123")), inspect(parse("123"))) }
    it("accepts signed decimal text") { assert_eq("Ok(-42)", inspect(parse("-42"))) }
  }

  describe("parse_dec") {
    it("parses plain decimal digits") { assert_eq("Ok(123)", inspect(parse_dec("123"))) }
    it("accepts an explicit plus sign") { assert_eq("Ok(12)", inspect(parse_dec("+12"))) }
    it("rejects sign-only input") {
      assert_eq("Err(ParseIntError(\"sign without digits\"))", inspect(parse_dec("-")))
    }
    it("rejects literal prefixes") {
      assert_eq(
        "Err(ParseIntError(\"invalid digit for decimal integer: x at index 1\"))",
        inspect(parse_dec("0xff")),
      )
    }
  }

  describe("parse_hex") {
    it("parses lowercase digits") { assert_eq("Ok(255)", inspect(parse_hex("ff"))) }
    it("parses uppercase digits") { assert_eq("Ok(255)", inspect(parse_hex("FF"))) }
    it("accepts a leading sign") { assert_eq("Ok(-255)", inspect(parse_hex("-ff"))) }
    it("rejects prefixed input") {
      assert_eq(
        "Err(ParseIntError(\"invalid digit for hexadecimal integer: x at index 1\"))",
        inspect(parse_hex("0xff")),
      )
    }
  }

  describe("parse_oct") {
    it("parses octal digits") { assert_eq("Ok(15)", inspect(parse_oct("17"))) }
    it("accepts signed octal input") { assert_eq("Ok(-15)", inspect(parse_oct("-17"))) }
    it("rejects invalid digits") {
      assert_eq(
        "Err(ParseIntError(\"invalid digit for octal integer: 8 at index 1\"))",
        inspect(parse_oct("18")),
      )
    }
  }

  describe("parse_bin") {
    it("parses binary digits") { assert_eq("Ok(13)", inspect(parse_bin("1101"))) }
    it("accepts a leading sign") { assert_eq("Ok(-13)", inspect(parse_bin("-1101"))) }
    it("rejects invalid digits") {
      assert_eq(
        "Err(ParseIntError(\"invalid digit for binary integer: 2 at index 2\"))",
        inspect(parse_bin("102")),
      )
    }
  }

  describe("parse_literal") {
    it("parses prefixed literals") {
      assert_eq("Ok(255)", inspect(parse_literal("0xff")))
    }

    it("parses octal and binary literals") {
      assert_eq("Ok(15)", inspect(parse_literal("0o17")))
      assert_eq("Ok(13)", inspect(parse_literal("0b1101")))
    }

    it("parses explicit decimal literals") {
      assert_eq("Ok(123)", inspect(parse_literal("0d123")))
    }

    it("treats unprefixed literals as decimal") {
      assert_eq("Ok(123)", inspect(parse_literal("123")))
    }

    it("accepts signed literals") {
      assert_eq("Ok(-255)", inspect(parse_literal("-0xff")))
      assert_eq("Ok(13)", inspect(parse_literal("+0b1101")))
    }

    it("rejects unknown prefixes") {
      assert_eq(
        "Err(ParseIntLiteralError(\"unknown integer base prefix: 0q\"))",
        inspect(parse_literal("0q123")),
      )
    }

    it("rejects missing digits after a prefix") {
      assert_eq(
        "Err(ParseIntLiteralError(\"missing digits after integer base prefix: 0x\"))",
        inspect(parse_literal("0x")),
      )
    }

    it("rejects empty input") {
      assert_eq("Err(ParseIntLiteralError(\"empty integer literal input\"))", inspect(parse_literal("")))
    }

    it("rejects sign-only input") {
      assert_eq("Err(ParseIntLiteralError(\"sign without digits\"))", inspect(parse_literal("-")))
    }
  }

  describe("bit_or") {
    it("combines any set bit") { assert_eq(7, bit_or(6, 3)) }
  }

  describe("bit_xor") {
    it("keeps differing bits") { assert_eq(5, bit_xor(6, 3)) }
  }

  describe("bit_not") {
    it("inverts zero") { assert_eq(-1, bit_not(0)) }
    it("inverts positive values") { assert_eq(-7, bit_not(6)) }
  }

  describe("test_bit") {
    it("reads the lowest bit") { assert_eq("Ok(True)", inspect(test_bit(5, 0))) }
    it("reads a cleared bit") { assert_eq("Ok(False)", inspect(test_bit(5, 1))) }
    it("reads a higher set bit") { assert_eq("Ok(True)", inspect(test_bit(5, 2))) }
    it("rejects negative indexes") {
      assert_eq(
        "Err(NegativeBitIndex(\"bit index must be non-negative: -1\"))",
        inspect(test_bit(5, -1)),
      )
    }
  }

  describe("set_bit") {
    it("sets a bit") { assert_eq("Ok(2)", inspect(set_bit(0, 1))) }
    it("rejects negative indexes") {
      assert_eq(
        "Err(NegativeBitIndex(\"bit index must be non-negative: -1\"))",
        inspect(set_bit(5, -1)),
      )
    }
  }

  describe("clear_bit") {
    it("clears a bit") { assert_eq("Ok(5)", inspect(clear_bit(7, 1))) }
    it("rejects negative indexes") {
      assert_eq(
        "Err(NegativeBitIndex(\"bit index must be non-negative: -1\"))",
        inspect(clear_bit(5, -1)),
      )
    }
  }

  describe("toggle_bit") {
    it("toggles a bit") { assert_eq("Ok(4)", inspect(toggle_bit(5, 0))) }
    it("rejects negative indexes") {
      assert_eq(
        "Err(NegativeBitIndex(\"bit index must be non-negative: -1\"))",
        inspect(toggle_bit(5, -1)),
      )
    }
  }

  describe("width_bits") {
    it("returns named widths") { assert_eq("Ok(8)", inspect(width_bits(BitWidth::W8))) }
    it("returns custom widths") { assert_eq("Ok(24)", inspect(width_bits(BitWidth::Any(24)))) }
    it("rejects non-positive custom widths") {
      assert_eq(
        "Err(InvalidBitWidth(\"bit width must be positive: 0\"))",
        inspect(width_bits(BitWidth::Any(0))),
      )
    }
  }

  describe("mask") {
    it("builds a W8 mask") { assert_eq("Ok(255)", inspect(mask(BitWidth::W8))) }
    it("builds a custom-width mask") { assert_eq("Ok(31)", inspect(mask(BitWidth::Any(5)))) }
    it("rejects invalid custom widths") {
      assert_eq(
        "Err(InvalidBitWidth(\"bit width must be positive: 0\"))",
        inspect(mask(BitWidth::Any(0))),
      )
    }
  }

  describe("wrap_unsigned") {
    it("wraps negative values") {
      assert_eq("Ok(255)", inspect(wrap_unsigned(-1, BitWidth::W8)))
    }

    it("wraps overflowing values") {
      assert_eq("Ok(4)", inspect(wrap_unsigned(260, BitWidth::W8)))
    }

    it("rejects invalid widths") {
      assert_eq(
        "Err(InvalidBitWidth(\"bit width must be positive: 0\"))",
        inspect(wrap_unsigned(5, BitWidth::Any(0))),
      )
    }
  }

  describe("wrap_signed") {
    it("wraps into signed range") {
      assert_eq("Ok(-1)", inspect(wrap_signed(255, BitWidth::W8)))
    }

    it("wraps positive values with sign bit set") {
      assert_eq("Ok(-127)", inspect(wrap_signed(129, BitWidth::W8)))
    }

    it("keeps in-range signed values unchanged") {
      assert_eq("Ok(127)", inspect(wrap_signed(127, BitWidth::W8)))
    }
  }

  describe("bit_not_in") {
    it("inverts within W8") {
      assert_eq("Ok(249)", inspect(bit_not_in(6, BitWidth::W8)))
    }

    it("inverts within custom width") {
      assert_eq("Ok(30)", inspect(bit_not_in(1, BitWidth::Any(5))))
    }

    it("rejects invalid widths") {
      assert_eq(
        "Err(InvalidBitWidth(\"bit width must be positive: 0\"))",
        inspect(bit_not_in(1, BitWidth::Any(0))),
      )
    }
  }

  describe("test_bit_in") {
    it("reads an in-range fixed-width bit") {
      assert_eq("Ok(True)", inspect(test_bit_in(5, 2, BitWidth::W8)))
    }

    it("rejects negative indexes") {
      assert_eq(
        "Err(NegativeBitIndex(\"bit index must be non-negative: -1\"))",
        inspect(test_bit_in(5, -1, BitWidth::W8)),
      )
    }

    it("rejects out-of-range indexes") {
      assert_eq(
        "Err(BitIndexOutOfRange(\"bit index 8 out of range for width 8\"))",
        inspect(test_bit_in(5, 8, BitWidth::W8)),
      )
    }
  }

  describe("set_bit_in") {
    it("sets an in-range bit") {
      assert_eq("Ok(2)", inspect(set_bit_in(0, 1, BitWidth::W8)))
    }

    it("rejects negative indexes") {
      assert_eq(
        "Err(NegativeBitIndex(\"bit index must be non-negative: -1\"))",
        inspect(set_bit_in(0, -1, BitWidth::W8)),
      )
    }
  }

  describe("clear_bit_in") {
    it("clears an in-range bit") {
      assert_eq("Ok(5)", inspect(clear_bit_in(7, 1, BitWidth::W8)))
    }

    it("rejects negative indexes") {
      assert_eq(
        "Err(NegativeBitIndex(\"bit index must be non-negative: -1\"))",
        inspect(clear_bit_in(0, -1, BitWidth::W8)),
      )
    }

    it("rejects out-of-range indexes") {
      assert_eq(
        "Err(BitIndexOutOfRange(\"bit index 8 out of range for width 8\"))",
        inspect(clear_bit_in(0, 8, BitWidth::W8)),
      )
    }
  }

  describe("toggle_bit_in") {
    it("toggles an in-range bit") {
      assert_eq("Ok(4)", inspect(toggle_bit_in(5, 0, BitWidth::W8)))
    }

    it("rejects negative indexes") {
      assert_eq(
        "Err(NegativeBitIndex(\"bit index must be non-negative: -1\"))",
        inspect(toggle_bit_in(5, -1, BitWidth::W8)),
      )
    }

    it("rejects out-of-range indexes") {
      assert_eq(
        "Err(BitIndexOutOfRange(\"bit index 8 out of range for width 8\"))",
        inspect(toggle_bit_in(5, 8, BitWidth::W8)),
      )
    }
  }

  describe("shl_in") {
    it("shifts left within width") {
      assert_eq("Ok(254)", inspect(shl_in(255, 1, BitWidth::W8)))
    }

    it("rejects negative shifts") {
      assert_eq(
        "Err(NegativeShiftCount(\"shift amount must be non-negative: -1\"))",
        inspect(shl_in(1, -1, BitWidth::W8)),
      )
    }
  }

  describe("shr_logical_in") {
    it("shifts logically within width") {
      assert_eq("Ok(127)", inspect(shr_logical_in(-1, 1, BitWidth::W8)))
    }

    it("zeros values when shifting by the width") {
      assert_eq("Ok(0)", inspect(shr_logical_in(255, 8, BitWidth::W8)))
    }

    it("rejects negative shifts") {
      assert_eq(
        "Err(NegativeShiftCount(\"shift amount must be non-negative: -1\"))",
        inspect(shr_logical_in(1, -1, BitWidth::W8)),
      )
    }
  }

  describe("rotl_in") {
    it("rotates left within W8") {
      assert_eq("Ok(3)", inspect(rotl_in(129, 1, BitWidth::W8)))
    }

    it("rotates left within custom widths") {
      assert_eq("Ok(3)", inspect(rotl_in(17, 1, BitWidth::Any(5))))
    }

    it("normalizes rotation counts") {
      assert_eq("Ok(3)", inspect(rotl_in(129, 9, BitWidth::W8)))
    }
  }

  describe("rotr_in") {
    it("rotates right within W8") {
      assert_eq("Ok(192)", inspect(rotr_in(129, 1, BitWidth::W8)))
    }

    it("normalizes rotation counts") {
      assert_eq("Ok(192)", inspect(rotr_in(129, 9, BitWidth::W8)))
    }

    it("rejects negative shifts") {
      assert_eq(
        "Err(NegativeShiftCount(\"shift amount must be non-negative: -1\"))",
        inspect(rotr_in(1, -1, BitWidth::W8)),
      )
    }
  }

  describe("shl") {
    it("shifts by one") { assert_eq("Ok(2)", inspect(shl(1, 1))) }
    it("shifts by several bits") { assert_eq("Ok(16)", inspect(shl(1, 4))) }
    it("shifts larger numbers") { assert_eq("Ok(32)", inspect(shl(8, 2))) }
    it("rejects negative shifts") {
      assert_eq(
        "Err(NegativeShiftCount(\"shift amount must be non-negative: -1\"))",
        inspect(shl(1, -1)),
      )
    }
  }

  describe("shr") {
    it("shifts down by one") { assert_eq("Ok(0)", inspect(shr(1, 1))) }
    it("shifts down by several bits") { assert_eq("Ok(4)", inspect(shr(16, 2))) }
    it("shifts large powers") { assert_eq("Ok(1)", inspect(shr(1024, 10))) }
    it("rejects negative shifts") {
      assert_eq(
        "Err(NegativeShiftCount(\"shift amount must be non-negative: -1\"))",
        inspect(shr(1, -1)),
      )
    }
  }

  describe("trait integration") {
    it("normalizes user-defined bit packs through impl Trait") {
      packed = Permissions::new(260, BitWidth::W8)
      normalized =? BitPack::normalize(packed)
      assert_eq("Permissions(bits: 4, width: BitWidth::W8)", inspect(normalized))
    }

    it("inspects user-defined bit packs through impl Trait") {
      packed = Permissions::new(5, BitWidth::W8)
      assert_eq("Ok(True)", inspect(BitPack::lowest_bit_on(packed)))
    }
  }
}
