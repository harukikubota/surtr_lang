import Test;

def option_pure(value: Int) -> Option<Int> { Applicative::pure(value) }
def option_step(value: Int) -> Option<Int> { if(value < 10, Option::Some(value + 1), Option::None) }

deferror MissingOption(label: String) {
  |label: String|
  Self(message: label, label)
}

def option_error_probe(label: String) -> Error {
  print(label)
  MissingOption(label)
}

def option_ok_or_forward(value: Option<Int>, err: (-> Error)) -> Result<Int> {
  Option::ok_or(value, err)
}

def option_first_in_result(values: List<Int>) -> Result<Int> {
  do::<Result> {
    value =? List::first(values)
    print("continued")
    Ok(value)
  }
}

test("Option") {
  describe("absence API failures") {
    it("lets callers select EmptyList or a custom Error") {
      do {
        empty: List<Int> = []
        assert_err_kind(EmptyList, Option::ok_or(List::first(empty), EmptyList()))
        assert_err_message_eq("empty list", Option::ok_or(List::first(empty), EmptyList()))
        assert_err_kind(MissingOption, Option::ok_or(List::first(empty), MissingOption("required")))
      }
    }

    it("continues Result do for Some and short circuits None with NoneError") {
      do {
        assert_ok_eq(7, option_first_in_result([7]))
        assert_err_kind(NoneError, option_first_in_result([]))
        assert_stdout_eq(["continued"])
      }
    }
  }

  describe("ok_or") {
    it("keeps Some without evaluating the error expression") {
      do {
        assert_ok_eq(7, Option::ok_or(Option::Some(7), option_error_probe("unexpected")))
        assert_stdout_eq([])
      }
    }

    it("evaluates the None error once and preserves its saved payload") {
      do {
        failed = Option::ok_or(Option<Int>::None, option_error_probe("missing"))
        match failed {
          Err(MissingOption(label)) => assert_eq("missing", label),
          _ => fail_test("expected custom absence Error"),
        }
        assert_stdout_eq(["missing"])
      }
    }

    it("preserves an existing Error message and cause") {
      do {
        source = MissingOption("saved")
        wrapped: Result<Int> = Result::cause(Err(source), ZeroDivisionError())
        match wrapped {
          Err(error) => do {
            converted = Option::ok_or(Option<Int>::None, error)
            assert_cause_chain([ZeroDivisionError, MissingOption], converted)
            match converted {
              Err(saved) => assert_eq(Error::format(error), Error::format(saved)),
              _ => fail_test("expected preserved Error"),
            }
          },
          _ => fail_test("expected source Error"),
        }
      }
    }

    it("uses existing Lazy normalization for captures and forwarded thunks") {
      do {
        convert: (Option<Int>, (-> Error) -> Result<Int>) = &Option::ok_or(&1, &2)
        assert_ok_eq(4, convert(Option::Some(4), {|| option_error_probe("unexpected capture")}))
        assert_err_kind(MissingOption, convert(Option::None, {|| option_error_probe("capture")}))
        assert_ok_eq(5, option_ok_or_forward(Option::Some(5), {|| option_error_probe("unexpected forward")}))
        assert_err_kind(MissingOption, option_ok_or_forward(Option::None, {|| option_error_probe("forward")}))
        assert_stdout_eq(["capture", "forward"])
      }
    }
  }

  describe("is_some") {
    it("recognizes Some") {
      do {
        assert_true(Option::is_some(Option::Some(7)))
      }
    }

    it("rejects None") {
      do {
        assert_false(Option::is_some(Option<Int>::None))
      }
    }

  }

  describe("is_none") {
    it("rejects Some") {
      do {
        assert_false(Option::is_none(Option::Some(7)))
      }
    }

    it("recognizes None") {
      do {
        assert_true(Option::is_none(Option<Int>::None))
      }
    }

  }

  describe("wrap") {
    it("constructs Some") {
      do {
        assert_some_eq("wrapped", Option::wrap("wrapped"))
      }
    }

  }

  describe("Convert") {
    it("converts Some to Ok") {
      do {
        converted: Result<Int> = to::<Result>(Option::Some(7))

        assert_ok_eq(7, converted)
      }
    }

    it("converts None to NoneError") {
      do {
        converted: Result<Int> = to::<Result>(Option<Int>::None)

        assert_err_kind(NoneError, converted)
      }
    }

    it("converts Ok to Some") {
      do {
        converted: Option<Int> = to::<Option>(Ok(9))

        assert_some_eq(9, converted)
      }
    }

    it("converts Err to None") {
      do {
        source: Result<Int> = Err(ZeroDivisionError())
        converted: Option<Int> = to::<Option>(source)

        assert_none(converted)
      }
    }

  }

  describe("traverse_result") {
    it("maps Some through the successful Result") {
      do {
        assert_ok_eq(Option::Some(8), Option::traverse_result(Option::Some(7), {|value| Ok(value + 1)}))
      }
    }

    it("does not call the mapper for None") {
      do {
        mapped = Option::traverse_result(Option<Int>::None, {|value|
            print("unexpected")
            Ok(value + 1)
        })

        assert_ok_eq(Option<Int>::None, mapped)
        assert_stdout_eq([])
      }
    }

    it("propagates a mapper error") {
      do {
        mapped: Result<Option<Int>> = Option::traverse_result(Option::Some(7), {|_| Err(NoneError())})

        assert_err_kind(NoneError, mapped)
      }
    }

  }

  describe("Functor::fmap") {
    it("maps Some") {
      do {
        assert_some_eq(8, Functor::fmap(Option::Some(7), {|value| value + 1}))
      }
    }

    it("does not call the mapper for None") {
      do {
        mapped = Functor::fmap(Option<Int>::None, {|value|
            print("unexpected")
            value + 1
        })

        assert_none(mapped)
        assert_stdout_eq([])
      }
    }

  }

  describe("Applicative::pure/ap") {
    it("injects Some") {
      do {
        value: Option<Int> = Applicative::pure(4)

        assert_some_eq(4, value)
      }
    }

    it("applies a Some function") {
      do {
        assert_some_eq(8, Applicative::ap(Option::Some({|value| value + 1}), Option::Some(7)))
      }
    }

    it("keeps an absent mapper") {
      do {
        mapper: Option<(Int -> Int)> = Option::None

        assert_none(Applicative::ap(mapper, Option::Some(7)))
      }
    }

    it("does not apply a mapper to None") {
      do {
        result = Applicative::ap(Option::Some({|value: Int|
              print("unexpected")
              value + 1
          }), Option::None)

        assert_none(result)
        assert_stdout_eq([])
      }
    }

  }

  describe("Monad::bind/return") {
    it("binds a successful Some") {
      do {
        assert_some_eq(14, Monad::bind(Option::Some(7), {|value| Option::Some(value * 2)}))
      }
    }

    it("permits a callback to stop with None") {
      do {
        assert_none(Monad::bind(Option::Some(10), {|value| if(value < 10, Option::Some(value), Option::None)}))
      }
    }

    it("does not invoke a callback for None") {
      do {
        result: Option<Int> = Monad::bind(Option::None, {|value|
            print("unexpected")
            Option::Some(value + 1)
        })

        assert_none(result)
        assert_stdout_eq([])
      }
    }

    it("return agrees with pure") {
      do {
        pure: Option<Int> = Applicative::pure(4)
        returned: Option<Int> = Monad::return(4)

        assert_eq(pure, returned)
      }
    }

  }

  describe("Alternative") {
    it("chooses the first Some") {
      do {
        assert_some_eq(7, Option::Some(7) <|> Option::Some(9))
      }
    }

    it("uses Some after None") {
      do {
        assert_some_eq(9, Option::None <|> Option::Some(9))
      }
    }

    it("keeps two None values empty") {
      do {
        assert_none(Option<Int>::None <|> Option::None)
      }
    }

    it("obeys identity and associativity") {
      do {
        empty: Option<Int> = Alternative::empty()
        a: Option<Int> = Option::Some(1)
        b: Option<Int> = Option::Some(2)
        c: Option<Int> = Option::Some(3)

        assert_eq(a, empty <|> a)
        assert_eq(a, a <|> empty)
        assert_eq((a <|> b) <|> c, a <|> (b <|> c))
      }
    }

  }

  describe("Functor laws") {
    it("identity preserves Some and None") {
      do {
        law_left11: Option<Int> = Option::Some(3)
        law_right11: Option<Int> = Option::Some(3) |*> {|value| value}

        law_left10: Option<Int> = Option<Int>::None
        law_right10: Option<Int> = Option<Int>::None |*> {|value| value}

        assert_eq(law_left11, law_right11)
        assert_eq(law_left10, law_right10)
      }
    }

    it("composition agrees on both sides") {
      do {
        value = Option::Some(3)
        left = (value |*> {|x| x + 1}) |*> {|x| x * 2}
        right = value |*> {|x| (x + 1) * 2}

        assert_eq(left, right)
      }
    }

  }

  describe("Applicative laws") {
    it("identity compares applied and original values") {
      do {
        value = Option::Some(3)
        law_left9: Option<Int> = value
        law_right9: Option<Int> = Option::Some({|x| x}) |*| value

        assert_eq(law_left9, law_right9)
      }
    }

    it("homomorphism compares both injections") {
      do {
        increment = {|value: Int| value + 1}
          mapper: Option<(Int -> Int)> = Applicative::pure(increment)
          value: Option<Int> = Applicative::pure(3)
          left: Option<Int> = Applicative::ap(mapper, value)
          right: Option<Int> = Applicative::pure(increment(3))
          assert_eq(left, right)
      }
    }

    it("interchange compares both applications") {
      do {
        u: Option<(Int -> Int)> = Option::Some({|x| x + 1})
        law_left7: Option<Int> = u |*| Option::Some(3)
        law_right7: Option<Int> = Option::Some({|f| f(3)}) |*| u

        assert_eq(law_left7, law_right7)
      }
    }

    it("composition compares nested applications") {
      do {
        u: Option<(Int -> Int)> = Option::Some({|x| x + 1})
        v: Option<(Int -> Int)> = Option::Some({|x| x * 2})
        w = Option::Some(3)
        law_left6: Option<Int> = Option::Some({|f| {|g| {|x| f(g(x))}}}) |*| u |*| v |*| w
        law_right6: Option<Int> = u |*| (v |*| w)

        assert_eq(law_left6, law_right6)
      }
    }

  }

  describe("Monad and composition laws") {
    it("left identity compares bind with direct application") {
      do {
        law_left5: Option<Int> = option_step(3)
        law_right5: Option<Int> = option_pure(3) |>= &option_step

        assert_eq(law_left5, law_right5)
      }
    }

    it("right identity preserves Some and None") {
      do {
        law_left4: Option<Int> = Option::Some(3)
        law_right4: Option<Int> = Option::Some(3) |>= &option_pure

        law_left3: Option<Int> = Option<Int>::None
        law_right3: Option<Int> = Option<Int>::None |>= &option_pure

        assert_eq(law_left4, law_right4)
        assert_eq(law_left3, law_right3)
      }
    }

    it("associativity compares both bind trees") {
      do {
        value = Option::Some(3)
        law_left2: Option<Int> = (value |>= &option_step) |>= &option_step
        law_right2: Option<Int> = value |>= {|x| option_step(x) |>= &option_step}

        assert_eq(law_left2, law_right2)
      }
    }

    it("Kleisli composition agrees with bind and preserves stopped branches") {
      do {
        composed = &option_step >=> &option_step
        law_left1: Option<Int> = option_step(3) |>= &option_step
        law_right1: Option<Int> = composed(3)

        assert_eq(law_left1, law_right1)
        assert_none(composed(10))
      }
    }

    it("lifted composition maps the returned payload") {
      do {
        composed = &option_step >* {|x| x + 1}

        assert_some_eq(5, composed(3))
      }
    }

  }


  describe("Eq") {
    it("compares variants and payloads") {
      do {
        assert_true(Eq::eq(Option::Some(3), Option::Some(3)))
        assert_false(Eq::eq(Option::Some(3), Option::Some(4)))
        assert_false(Eq::eq(Option::Some(3), Option::None))
      }
    }

  }

}
