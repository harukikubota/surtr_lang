  describe("flat_map") {
    it("flat_map visits each input once and preserves result order") {
      do {
        values = List::cons(0, [1, 2, 3])
        actual = List::flat_map(values: values, f: {|value|
            print("visit=#{value}")
            match value {
              0 => [],
              1 => [value],
              _ => List::cons(value, [value + 10]),
            }
        })

        assert_eq([1, 2, 12, 3, 13], actual)
        assert_eq([0, 1, 2, 3], values)
        assert_stdout_eq(["visit=0", "visit=1", "visit=2", "visit=3"])
      }
    }

    it("flat_map skips callbacks for empty input") {
      do {
        values: List<Int> = []
        actual = List::flat_map(values, {|value|
            print("visit=#{value}")
            [value]
        })

        assert_eq(values, actual)
        assert_stdout_eq([])
      }
    }

    it("nested flat_map completes inner results in input order") {
      do {
        actual = List::flat_map([1, 2], {|outer|
            print("outer=#{outer}")
            List::flat_map([3, 4], {|inner|
                print("inner=#{outer}:#{inner}")
                [outer * 10 + inner]
            })
        })

        assert_eq([13, 14, 23, 24], actual)
        assert_stdout_eq([
            "outer=1", "inner=1:3", "inner=1:4",
            "outer=2", "inner=2:3", "inner=2:4",
        ])
      }
    }

  }

  describe("Alternative / return") {
    it("concatenates lists with Alternative choice") {
      do {
        assert_eq([1, 2, 3], [1, 2] <|> [3])
      }
    }

    it("obeys Alternative identity and associativity laws") {
      do {
        empty: List<Int> = Alternative::empty()
        first: List<Int> = [1]
        second: List<Int> = [2]
        third: List<Int> = [3]

        assert_eq(first, empty <|> first)
        assert_eq(first, first <|> empty)
        assert_eq((first <|> second) <|> third, first <|> (second <|> third))
      }
    }

    it("keeps Monad return equal to Applicative pure") {
      do {
        pure_value: List<Int> = Applicative::pure(4)
        returned_value: List<Int> = Monad::return(4)

        assert_eq(pure_value, returned_value)
      }
    }

  }

  describe("each") {
    it("each runs callbacks from left to right") {
      do {
        result = List::each([1, 2, 3], {|n| print("n=#{to_string(n)}")})

        assert_eq((), result)
        assert_stdout_eq(["n=1", "n=2", "n=3"])
      }
    }

    it("each returns Unit and does nothing for empty lists") {
      do {
        result = List::each([], {|n: Int| print("n=#{to_string(n)}")})

        assert_eq((), result)
        assert_stdout_eq([])
      }
    }

  }

  describe("Monad and Kleisli laws") {
    it("right identity keeps populated lists") {
      do {
        values: List<Int> = [1, 2]
        law_left6: List<Int> = values
        law_right6: List<Int> = values |>= list_pure()

        assert_eq(law_left6, law_right6)
      }
    }

    it("right identity keeps empty lists") {
      do {
        values: List<Int> = []
        law_left7: List<Int> = values
        law_right7: List<Int> = values |>= list_pure()

        assert_eq(law_left7, law_right7)
      }
    }

    it("associativity holds on populated expansions") {
      do {
        values: List<Int> = [1, 2]
        composed = &list_step1 >=> &list_step2
        sequential: List<Int> = (values |>= list_step1()) |>= list_step2()
        composed_result: List<Int> = values |>= composed

        assert_eq(sequential, composed_result)
      }
    }

    it("associativity holds when branches collapse to empty") {
      do {
        values: List<Int> = [10]
        composed = &list_step1 >=> &list_step2
        sequential: List<Int> = (values |>= list_step1()) |>= list_step2()
        composed_result: List<Int> = values |>= composed

        assert_eq(sequential, composed_result)
      }
    }

    it("kleisli left identity uses pure") {
      do {
        composed = &list_pure >=> &list_step1
        result: List<Int> = composed(2)

        assert_eq(result, list_step1(2))
      }
    }

    it("kleisli right identity uses pure") {
      do {
        composed = &list_step1 >=> &list_pure
        result: List<Int> = composed(2)

        assert_eq(result, list_step1(2))
      }
    }

    it("kleisli composition is associative") {
      do {
        left = (&list_step1 >=> &list_step2) >=> &list_step3
        right = &list_step1 >=> (&list_step2 >=> &list_step3)
        left_result: List<Int> = left(2)
        right_result: List<Int> = right(2)

        assert_eq(left_result, right_result)
      }
    }

    it("kleisli composition matches staged bind") {
      do {
        composed = &list_step1 >=> &list_step2
        composed_result: List<Int> = composed(2)
        sequential: List<Int> = list_step1(2) |>= list_step2()

        assert_eq(composed_result, sequential)
      }
    }

    it("fmap matches bind with pure after mapping") {
      do {
        values: List<Int> = [1, 2]
        mapped: List<Int> = values |*> add_one()
        bound: List<Int> = values |>= {|x| list_pure(add_one(x))}

        assert_eq(mapped, bound)
      }
    }

  }

  describe("flat_map delegation") {
    it("List::flat_map") {
      do {
        values = List::cons(1, [2])
        actual: List<Int> = List::flat_map(values, &list_ordered_step)

        assert_eq([1, 11, 2, 12], actual)
        assert_stdout_eq(["step=1", "step=2"])
      }
    }

    it("Monad::bind") {
      do {
        values = List::cons(1, [2])
        actual: List<Int> = Monad::bind(values, &list_ordered_step)

        assert_eq([1, 11, 2, 12], actual)
        assert_stdout_eq(["step=1", "step=2"])
      }
    }

    it("values |>= list_ordered_step") {
      do {
        values = List::cons(1, [2])
        actual: List<Int> = values |>= list_ordered_step()

        assert_eq([1, 11, 2, 12], actual)
        assert_stdout_eq(["step=1", "step=2"])
      }
    }

    it("do sequences callback effects") {
      do {
        values = List::cons(1, [2])
        actual: List<Int> = list_ordered_do(values)

        assert_eq([1, 11, 2, 12], actual)
        assert_stdout_eq(["step=1", "step=2"])
      }
    }

    it("List::flat_map") {
      do {
        values = List::cons(1, [2])
        actual: List<Int> = List::flat_map(values, &list_pure >=> &list_ordered_step)

        assert_eq([1, 11, 2, 12], actual)
        assert_stdout_eq(["step=1", "step=2"])
      }
    }

  }

  describe("inspect") {
    it("shows a mixed list representation") {
      do {
        assert_eq("[1, 2, 3]", inspect(List::cons(1, [2, 3])))
      }
    }

  }

  describe("Functor laws") {
    it("identity compares both values") {
      do {
        value = List::cons(1, [2, 3])

        assert_eq(value, Functor::fmap(value, {|x| x}))
      }
    }

    it("composition compares both mappings") {
      do {
        value = [1, 2]
        law_left5: List<Int> = (value |*> {|x| x + 1}) |*> {|x| x * 2}
        law_right5: List<Int> = value |*> {|x| (x + 1) * 2}

        assert_eq(law_left5, law_right5)
      }
    }

  }

  describe("Applicative::ap") {
    it("preserves mapper-major result order") {
      do {
        assert_eq([2, 3, 10, 20], Applicative::ap([{|x| x + 1}, {|x| x * 10}], [1, 2]))
      }
    }

  }

  describe("Applicative laws") {
    it("identity compares applied and original values") {
      do {
        value = [1, 2]
        law_left4: List<Int> = value
        law_right4: List<Int> = [{|x| x}] |*| value

        assert_eq(law_left4, law_right4)
      }
    }

    it("homomorphism compares injections") {
      do {
        increment = {|value: Int| value + 1}
          mapper: List<(Int -> Int)> = Applicative::pure(increment)
          value: List<Int> = Applicative::pure(3)
          left: List<Int> = Applicative::ap(mapper, value)
          right: List<Int> = Applicative::pure(increment(3))
          assert_eq(left, right)
      }
    }

    it("interchange compares both sides") {
      do {
        u: List<(Int -> Int)> = [{|x| x + 1}, {|x| x * 2}]
        law_left2: List<Int> = u |*| [3]
        law_right2: List<Int> = [{|f| f(3)}] |*| u

        assert_eq(law_left2, law_right2)
      }
    }

    it("composition compares both applications") {
      do {
        u: List<(Int -> Int)> = [{|x| x + 1}]
        v: List<(Int -> Int)> = [{|x| x * 2}]
        w = [1, 2]
        law_left1: List<Int> = [{|f| {|g| {|x| f(g(x))}}}] |*| u |*| v |*| w
        law_right1: List<Int> = u |*| (v |*| w)

        assert_eq(law_left1, law_right1)
      }
    }

  }


  describe("Eq") {
    it("compares List by length order and element Eq") {
      do {
        assert_true(Eq::eq([1, 2, 3], [1, 2, 3]))
        assert_false(Eq::eq([1, 2], [1, 2, 3]))
        assert_false(Eq::eq([1, 2, 3], [1, 3, 2]))
        assert_true(Eq::eq([EqByValue::new(1, "one")], [EqByValue::new(1, "uno")]))
      }
    }

  }

