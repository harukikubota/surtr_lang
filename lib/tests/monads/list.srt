import Test;

def add_one(x: Int) -> Int { x + 1 }
def list_pure(x: Int) -> List<Int> { Applicative::pure(x) }
def list_step1(x: Int) -> List<Int> { [x, x + 10] }
def list_step2(x: Int) -> List<Int> { if(x < 10, [x * 2], []) }
def list_step3(x: Int) -> List<Int> { [x - 3] }
def list_ordered_step(value: Int) -> List<Int> {
  print("step=#{value}")
  [value, value + 10]
}

def list_ordered_do(values: List<Int>) -> List<Int> {
  do {
    value <- values
    expanded <- list_ordered_step(value)
    Monad::return(expanded)
  }
}

defstruct EqByValue {
  value: Int,
  description: String,
}

impl EqByValue {
  def new(value: Int, description: String) -> Self {
    EqByValue { value: value, description: description }
  }
}

impl Eq for EqByValue {
  def eq(self: Self, rhs: Self) -> Boolean {
    Eq::eq(self.value, rhs.value)
  }
}


test("List") {
  describe("cons") {
    it("prepends without changing the tail") {
      do {
        tail = [2, 3]
        result = List::cons(1, tail)

        assert_eq([1, 2, 3], result)
        assert_eq([2, 3], tail)
      }
    }

    it("prepends to empty input") {
      do {
        assert_eq([1], List::cons(1, []))
      }
    }

  }

  describe("len") {
    it("counts empty and populated lists") {
      do {
        empty: List<Int> = []

        assert_eq(0, List::len(empty))
        assert_eq(3, List::len([1, 2, 3]))
      }
    }

  }

  describe("first") {
    it("returns the first element") {
      do {
        assert_ok_eq(1, List::first([1, 2, 3]))
      }
    }

    it("returns ListFirstEmpty for empty input") {
      do {
        empty: List<Int> = []

        assert_err_kind(ListFirstEmpty, List::first(empty))
      }
    }

  }

  describe("last") {
    it("returns the last element") {
      do {
        assert_ok_eq(3, List::last([1, 2, 3]))
      }
    }

    it("returns ListLastEmpty for empty input") {
      do {
        empty: List<Int> = []

        assert_err_kind(ListLastEmpty, List::last(empty))
      }
    }

  }

  describe("at") {
    it("first index") {
      do {
        assert_ok_eq(1, List::at([1, 2, 3], 0))
      }
    }

    it("last index") {
      do {
        assert_ok_eq(3, List::at([1, 2, 3], 2))
      }
    }

    it("rejects negative index") {
      do {
        assert_err_kind(ListIndexOutOfBounds, List::at([1, 2, 3], -1))
      }
    }

    it("rejects index at length") {
      do {
        assert_err_kind(ListIndexOutOfBounds, List::at([1, 2, 3], 3))
      }
    }

    it("rejects index beyond length") {
      do {
        assert_err_kind(ListIndexOutOfBounds, List::at([1, 2, 3], 9))
      }
    }

    it("rejects an index into an empty list") {
      do {
        empty: List<Int> = []

        assert_err_kind(ListIndexOutOfBounds, List::at(empty, 0))
      }
    }

  }

  describe("append") {
    it("preserves operand order") {
      do {
        assert_eq([1, 2, 3], List::append([1, 2], [3]))
      }
    }

    it("has both empty identities") {
      do {
        assert_eq([1, 2], List::append([], [1, 2]))
        assert_eq([1, 2], List::append([1, 2], []))
      }
    }

    it("is associative") {
      do {
        assert_eq(List::append(List::append([1], [2]), [3]), List::append([1], List::append([2], [3])))
      }
    }

  }

  describe("concat") {
    it("preserves nested order including empty lists") {
      do {
        assert_eq([1, 2, 3], List::concat([[1], [], [2, 3]]))
      }
    }

    it("keeps empty input empty") {
      do {
        values: List<List<Int>> = []
        observed_list14: List<Int> = List::concat(values)
        expected_empty: List<Int> = []

        assert_eq(expected_empty, observed_list14)
      }
    }

  }

  describe("reverse") {
    it("reverses order") {
      do {
        assert_eq([3, 2, 1], List::reverse([1, 2, 3]))
      }
    }

    it("is an involution") {
      do {
        value = List::cons(1, [2, 3])

        assert_eq(value, List::reverse(List::reverse(value)))
      }
    }

  }

  describe("map") {
    it("calls mapper once in input order") {
      do {
        actual = List::map([1, 2, 3], {|value|
            print("map=#{value}")
            value + 1
        })

        assert_eq([2, 3, 4], actual)
        assert_stdout_eq(["map=1", "map=2", "map=3"])
      }
    }

    it("does not call mapper on empty input") {
      do {
        empty: List<Int> = []
        actual = List::map(empty, {|value| print("unexpected"); value})

        assert_eq(empty, actual)
        assert_stdout_eq([])
      }
    }

  }

  describe("filter") {
    it("preserves selected order") {
      do {
        assert_eq([2, 4], List::filter([1, 2, 3, 4], {|x| Int::is_even(x)}))
      }
    }

    it("evaluates every predicate once") {
      do {
        actual = List::filter([1, 2, 3], {|x| print("filter=#{x}"); x > 1})

        assert_eq([2, 3], actual)
        assert_stdout_eq(["filter=1", "filter=2", "filter=3"])
      }
    }

  }

  describe("map / filter composition") {
    it("finishes each eager stage before starting the next") {
      do {
        values = List::cons(1, [2, 3])
        mapped = List::map(values, {|value| print("map=#{value}"); value * 10})
        actual = List::filter(mapped, {|value| print("filter=#{value}"); value != 20})

        assert_eq([10, 30], actual)
        assert_eq([1, 2, 3], values)
        assert_stdout_eq(["map=1", "map=2", "map=3", "filter=10", "filter=20", "filter=30"])
      }
    }

    it("keeps empty input and fully rejected output empty") {
      do {
        empty: List<Int> = []
        from_empty = List::filter(empty, {|value| print("unexpected"); value > 0})
        rejected = List::filter([1, 2], {|value| print("reject=#{value}"); value < 0})

        assert_eq(empty, from_empty)
        assert_eq(empty, rejected)
        assert_stdout_eq(["reject=1", "reject=2"])
      }
    }

    it("completes nested map and filter callbacks in input order") {
      do {
        actual = List::map([1, 2], {|outer|
          List::filter([3, 4], {|inner| print("visit=#{outer}:#{inner}"); inner > outer + 1})
        })

        assert_eq([[3, 4], [4]], actual)
        assert_stdout_eq(["visit=1:3", "visit=1:4", "visit=2:3", "visit=2:4"])
      }
    }

    it("keeps partial patterns and SafeBind failure local in nested do") {
      do {
        actual = do::<List> {
          outer <- List::map([1, 2, 3], {|value| print("map=#{value}"); value})
          inner = do::<List> {
            2 <- List::filter([1, 2, 3], {|value| print("filter=#{outer}:#{value}"); value > 0})
            accepted =? if(outer == 2, Ok(outer), Err(NoneError))
            traced = print("accepted=#{accepted}")
            [accepted * 10]
          }
          value <- inner
          traced = print("result=#{value}")
          [value]
        }

        assert_eq([20], actual)
        assert_stdout_eq([
          "map=1", "map=2", "map=3",
          "filter=1:1", "filter=1:2", "filter=1:3",
          "filter=2:1", "filter=2:2", "filter=2:3", "accepted=2", "result=20",
          "filter=3:1", "filter=3:2", "filter=3:3",
        ])
      }
    }
  }

