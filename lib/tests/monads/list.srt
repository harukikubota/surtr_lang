  describe("reduce") {
    it("folds left to right") {
      do {
        assert_eq(123, List::reduce([1, 2, 3], 0, {|acc, x| acc * 10 + x}))
      }
    }

    it("returns initial accumulator on empty input") {
      do {
        empty: List<Int> = []

        assert_eq(9, List::reduce(empty, 9, {|acc, x| acc + x}))
