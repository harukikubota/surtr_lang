        actual = List::find_map([1, 2, 3], {|x| print("visit=#{x}"); if(x > 1, Option::Some(x * 10), Option::None)})

        assert_ok_eq(20, actual)
        assert_stdout_eq(["visit=1", "visit=2"])
      }
    }

    it("returns ListFindMapNoValue when every callback returns None") {
      do {
        actual = List::find_map([0, 1], {|x| print("visit=#{x}"); if(x > 1, Option::Some(x * 10), Option::None)})

        assert_err_kind(ListFindMapNoValue, actual)
        assert_stdout_eq(["visit=0", "visit=1"])
