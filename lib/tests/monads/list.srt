    it("does not visit an empty input") {
      do {
        empty: List<Int> = []
        actual = List::find_map(empty, {|x| print("unexpected"); if(x > 1, Option::Some(x * 10), Option::None)})

        assert_err_kind(ListFindMapNoValue, actual)
        assert_stdout_eq([])
