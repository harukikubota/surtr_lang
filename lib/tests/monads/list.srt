        assert_eq(3, actual)
        assert_stdout_eq(["step=1", "step=2"])
      }
    }

    it("returns last Resume accumulator") {
      do {
        assert_eq(6, List::reduce_while([1, 2, 3], 0, {|acc, x| ReduceStep::Resume(acc + x)}))
