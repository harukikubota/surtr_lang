  describe("reduce_while") {
    it("stops without calling later steps") {
      do {
        actual = List::reduce_while([1, 2, 3], 0, {|acc, x|
            print("step=#{x}")
            if(x < 2, ReduceStep::Resume(acc + x), ReduceStep::Stop(acc + x))
