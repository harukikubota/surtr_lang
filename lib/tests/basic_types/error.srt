import Test;
deferror ApiError(detail: String) {
  |detail: String|
  Self(message: detail, detail)
}
test("Error") {
  describe("kind") { it("returns the declaration name") {
                       do {
                         assert_eq("NoneError", Error::kind(NoneError))
                       }
                     } }
  describe("message") {
    it("returns the predefined message") {
      do {
        assert_eq("None Value.", Error::message(NoneError))
      }
    }
    it("returns the payload message") {
      do {
        assert_eq("api down", Error::message(ApiError("api down")))
      }
    }
  }
  describe("format") { it("includes the kind and message") {
                         do {
                           assert_eq("Error: ZeroDivisionError: division by zero", Error::format(ZeroDivisionError))
                         }
                       } }
  describe("Error abstraction") { it("retains a concrete error through an OR Pattern") {
                                    do {
                                      actual = match Err(ZeroDivisionError) {
                                        Ok(value) => value,
                                        Err(NoneError | ZeroDivisionError @ error: Error) => Error::kind(error),
                                        Err(error) => Error::kind(error),
                                      }

                                      assert_eq("ZeroDivisionError", actual)
                                    }
                                  } }
  describe("same_kind") {
    it("ignores different payload messages") {
      do {
        assert_true(Error::same_kind(ApiError("first"), ApiError("second")))
      }
    }
    it("distinguishes declaration identities") {
      do {
        assert_false(Error::same_kind(NoneError, ZeroDivisionError))
      }
    }
  }

}
