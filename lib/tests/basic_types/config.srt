import Test;
test("Config") {
  describe("new") {
    it("sets the name") {
      do {
        assert_eq("App", Config::new("App").name)
      }
    }
    it("starts with the default entrypoint") {
      do {
        assert_eq("Main::main", Config::new("App").entrypoint)
      }
    }
    it("starts with no paths") {
      do {
        assert_eq(0, List::len(Config::new("App").paths))
      }
    }
  }
  describe("entry_fun") {
    it("changes only the new entrypoint") {
      do {
        original = Config::new("Cli")
        updated = Config::entry_fun(original, "Cli::main")

        assert_eq("Main::main", original.entrypoint)
        assert_eq("Cli::main", updated.entrypoint)
        assert_eq("Cli", updated.name)
        assert_eq(0, List::len(updated.paths))
      }
    }
  }
  describe("add_path") {
    it("appends search paths in order") {
      do {
        cfg = Config::add_path(Config::add_path(Config::new("Fmt"), "./lib"), "./tests")

        assert_eq(["./lib", "./tests"], cfg.paths)
      }
    }
  }
}
