import String;
import Test;

test("String") {
  describe("emptiness helpers") {
    it("detects empty strings") {
      do {
        assert_true(is_empty(""))
      }
    }
    it("detects non-empty strings") {
      do {
        assert_true(non_empty("surtr"))
      }
    }
    it("reports False for the opposite branch") {
      do {
        assert_false(is_empty("surtr"))
        assert_false(non_empty(""))
      }
    }
  }

  describe("len") {
    it("counts ascii characters") {
      do {
        assert_eq(5, len("surtr"))
      }
    }
    it("counts unicode surface characters") {
      do {
        assert_eq(2, len("あい"))
      }
    }
  }

  describe("surround") {
    it("wraps a string with prefix and suffix") {
      do {
        assert_eq("[core]", surround("core", "[", "]"))
      }
    }
  }

  describe("join") {
    it("joins parts with separators") {
      do {
        assert_eq("a,b,c", join(["a", "b", "c"], ","))
      }
    }
    it("returns an empty string for empty input") {
      do {
        assert_eq("", join([], ","))
      }
    }
  }

  describe("repeat") {
    it("repeats a string") {
      do {
        assert_ok_eq("nanana", repeat("na", 3))
      }
    }

    it("accepts zero repeats") {
      do {
        assert_ok_eq("", repeat("na", 0))
      }
    }

    it("rejects negative counts") {
      do {
        result = repeat("na", -1)

        assert_err_kind(NegativeRepeatCount, result)
        assert_err_contains("repeat count must be non-negative: -1", result)
      }
    }
  }

  describe("starts_with") {
    it("matches a valid prefix") {
      do {
        assert_true(starts_with("surtr", "sur"))
      }
    }
    it("rejects a missing prefix") {
      do {
        assert_false(starts_with("surtr", "urt"))
      }
    }
  }

  describe("ends_with") {
    it("matches a valid suffix") {
      do {
        assert_true(ends_with("surtr", "tr"))
      }
    }
    it("rejects a missing suffix") {
      do {
        assert_false(ends_with("surtr", "su"))
      }
    }
  }

  describe("strip_prefix") {
    it("removes a matching prefix") {
      do {
        assert_ok_eq("tr", strip_prefix("surtr", "sur"))
      }
    }

    it("returns NoneError for a missing prefix") {
      do {
        result = strip_prefix("surtr", "ur")

        assert_err_kind(NoneError, result)
        assert_err_contains("None Value.", result)
      }
    }
  }

  describe("strip_suffix") {
    it("removes a matching suffix") {
      do {
        assert_ok_eq("sur", strip_suffix("surtr", "tr"))
      }
    }

    it("returns NoneError for a missing suffix") {
      do {
        result = strip_suffix("surtr", "su")

        assert_err_kind(NoneError, result)
        assert_err_contains("None Value.", result)
      }
    }
  }

  describe("split_once") {
    it("splits on the first match") {
      do {
        StringSplit::Split(left, right) <- split_once("key=value", "=")

        assert_eq("key", left)
        assert_eq("value", right)
      }
    }

    it("accepts an empty separator") {
      do {
        StringSplit::Split(left, right) <- split_once("surtr", "")

        assert_eq("", left)
        assert_eq("surtr", right)
      }
    }

    it("returns NoneError when not found") {
      do {
        result = split_once("surtr", "/")

        assert_err_kind(NoneError, result)
        assert_err_contains("None Value.", result)
      }
    }
  }

  describe("contains") {
    it("matches an inner substring") {
      do {
        assert_true(contains("surtr", "urt"))
      }
    }
    it("rejects a missing substring") {
      do {
        assert_false(contains("surtr", "zzz"))
      }
    }
    it("matches an empty needle") {
      do {
        assert_true(contains("surtr", ""))
      }
    }
  }

  describe("replace") {
    it("replaces each matched substring") {
      do {
        assert_eq("baNANA", replace("banana", "na", "NA"))
      }
    }
    it("leaves input unchanged for an empty separator") {
      do {
        assert_eq("surtr", replace("surtr", "", "-"))
      }
    }
    it("uses non-overlapping matches") {
      do {
        assert_eq("bb", replace("aaaa", "aa", "b"))
      }
    }
  }

  describe("split") {
    it("keeps empty segments around matches") {
      do {
        assert_eq(["a", "", "b", ""], split("a,,b,", ","))
      }
    }

    it("splits into characters on an empty separator") {
      do {
        assert_eq(["s", "u", "r", "t", "r"], split("surtr", ""))
      }
    }

    it("returns the original string when the separator is absent") {
      do {
        assert_eq(["surtr"], split("surtr", "/"))
      }
    }

    it("splits on unicode separators") {
      do {
        assert_eq(["a", "b", ""], split("aあbあ", "あ"))
      }
    }
  }

  describe("lines") {
    it("returns no lines for empty input") {
      do {
        assert_eq(0, List::len(lines("")))
      }
    }
    it("splits newline-terminated text") {
      do {
        assert_eq(["a", "b"], lines("a\nb\n"))
      }
    }
    it("normalizes CRLF line endings") {
      do {
        assert_eq(["a", "b"], lines("a\u{d}\nb\u{d}\n"))
      }
    }
  }

  describe("chars") {
    it("splits into single-character strings") {
      do {
        assert_eq(["あ", "b"], chars("あb"))
      }
    }
  }

  describe("from_chars") {
    it("rebuilds a valid character list") {
      do {
        assert_ok_eq("あb", from_chars(["あ", "b"]))
      }
    }

    it("accepts an empty character list") {
      do {
        assert_ok_eq("", from_chars([]))
      }
    }

    it("rejects multi-character items") {
      do {
        result = from_chars(["ab"])

        assert_err_kind(InvalidCharList, result)
        assert_err_message_eq("expected single-character string at index 0, got \"ab\"", result)
      }
    }
  }

  describe("codepoints") {
    it("encodes utf8 bytes") {
      do {
        assert_ok_eq([65, 227, 129, 130], codepoints("Aあ", StringEncoding::Utf8))
      }
    }

    it("encodes ascii bytes") {
      do {
        assert_ok_eq([65, 90], codepoints("AZ", StringEncoding::Ascii))
      }
    }

    it("rejects non-ascii characters in ascii mode") {
      do {
        result = codepoints("あ", StringEncoding::Ascii)

        assert_err_kind(InvalidStringEncoding, result)
        assert_err_contains("ASCII encoding does not support character at index 0: あ", result)
      }
    }
  }

  describe("from_codepoints") {
    it("restores utf8 text") {
      do {
        assert_ok_eq("Aあ", from_codepoints([65, 227, 129, 130], StringEncoding::Utf8))
      }
    }

    it("restores ascii text") {
      do {
        assert_ok_eq("AZ", from_codepoints([65, 90], StringEncoding::Ascii))
      }
    }

    it("rejects out-of-range ascii codes") {
      do {
        result = from_codepoints([128], StringEncoding::Ascii)

        assert_err_kind(InvalidStringEncoding, result)
        assert_err_contains("ASCII code out of range at index 0: 128", result)
      }
    }

    it("rejects invalid utf8 byte sequences") {
      do {
        result = from_codepoints([255], StringEncoding::Utf8)

        assert_err_kind(InvalidStringEncoding, result)
        assert_err_contains("invalid UTF-8 byte sequence at index 0 (len 1)", result)
      }
    }
  }

  describe("trim") {
    it("trims actual carriage returns") {
      do {
        assert_eq("core", trim("\u{d}core\u{d}"))
      }
    }
    it("preserves literal backslash-r text") {
      do {
        assert_eq("\\rcore\\r", trim("\\rcore\\r"))
      }
    }
    it("trims leading whitespace") {
      do {
        assert_eq("core", trim_start(" \n\tcore"))
      }
    }
    it("trims trailing whitespace") {
      do {
        assert_eq("core", trim_end("core \n\t"))
      }
    }
    it("trims both sides") {
      do {
        assert_eq("core", trim(" \ncore\t "))
      }
    }
  }

  describe("TryConvert") {
    it("supports result pipeline assertions") {
      do {
        try_to::<Int>("1") |>= {|value| assert_eq(1, value)}
      }
    }

    it("parses signed integers") {
      do {
        try_to::<Int>("-12") |>= {|value| assert_eq(-12, value)}
      }
    }

    it("reports invalid integer text") {
      do {
        assert_err_contains("invalid integer literal", try_to::<Int>("bad"))
      }
    }

    it("parses booleans") {
      do {
        try_to::<Boolean>("true") |>= {|value| assert_true(value)}
      }
    }

    it("parses alternate boolean casing") {
      do {
        try_to::<Boolean>("False") |>= {|value| assert_false(value)}
      }
    }

    it("reports invalid boolean text") {
      do {
        assert_err_contains("invalid boolean literal", try_to::<Boolean>("maybe"))
      }
    }

    it("reads the destination type in a bind pipeline") {
      do {
        Ok("42") |>= try_to::<Int>() |>= {|value| assert_eq(42, value)}
      }
    }
  }


}
