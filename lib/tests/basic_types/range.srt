import Test;

test("Range") {
  describe("construction helpers") {
    it("keeps new in declared order and normalized in ascending order") {
      do {
        raw = Range(3, 1)
        normalized = Range::normalized(3, 1)

        assert_eq(3, raw.min)
        assert_eq(1, raw.max)
        assert_eq(1, normalized.min)
        assert_eq(3, normalized.max)
      }
    }

    it("keeps constructor polymorphism across different endpoint types in one scope") {
      do {
        raw = Range(3, 1)
        dur = Range(10ms, 20ms)

        assert_eq(3, raw.min)
        assert_eq(1, raw.max)
        assert_eq("10ms", to_string(dur.min))
        assert_eq("20ms", to_string(dur.max))
      }
    }
  }

  describe("ordering helpers") {
    it("uses lexicographic compare plus structural equality") {
      do {
        left = Range(1, 4)
        right = Range(2, 0)
        same = Range(1, 4)
        different = Range(1, 5)

        assert_eq(Ordering::Less, compare(left, right))
        assert_eq(Ordering::Equal, compare(left, same))
        assert_true(left == same)
        assert_true(left != different)
      }
    }

    it("specializes generic ordering helpers for Range<Duration>") {
      do {
        left = Range(10ms, 20ms)
        right = Range(10ms, 30ms)
        same = Range(10ms, 20ms)

        assert_eq(Ordering::Less, compare(left, right))
        assert_true(left == same)
        assert_true(left != right)
      }
    }
  }

  describe("movement helpers") {
    it("advances and retreats integer ranges without renormalizing") {
      do {
        raw = Range(3, 1)
        advanced = Range::advance(raw, 2)
        retreated = Range::retreat(raw, 2)

        assert_eq(5, advanced.min)
        assert_eq(3, advanced.max)
        assert_eq(1, retreated.min)
        assert_eq(-1, retreated.max)
      }
    }
  }

  describe("pattern integration") {
    it("supports Range(min, max) deconstruction") {
      do {
        value = Range(4, 6)
        (left, right) = match value { Range(min, max) => (min, max), _ => (0, 0), }

        assert_eq(4, left)
        assert_eq(6, right)
      }
    }
  }
}
