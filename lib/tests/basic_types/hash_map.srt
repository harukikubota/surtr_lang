
import Test;

defstruct EqByValue {
  value: Int,
  description: String,
}

impl EqByValue {
  def new(value: Int, description: String) -> Self {
    EqByValue { value: value, description: description }
  }
}

impl Eq for EqByValue {
  def eq(self: Self, rhs: Self) -> Boolean {
    Eq::eq(self.value, rhs.value)
  }
}


deferror HashMapPatternSource { "map child rejected" }
deferror HashMapPatternContext { "map child context" }

def hashmap_pattern_source(value: Int) -> Result<Int> {
  Result::cause(Err(HashMapPatternSource()), HashMapPatternContext())
}

def hashmap_pattern_select(source: Result<HashMap<Int>>) -> Result<Int> {
  hash!["a" => value] =? source
  Ok(value)
}

test("HashMap") {
  describe("constructors and lookup") {
    it("builds and inspects the empty map") {
      do {
        empty_map: HashMap<Int> = HashMap::empty_map()
        empty_literal: HashMap<Int> = hash![]

        assert_eq(0, HashMap::map_len(empty_map))
        assert_eq(0, HashMap::map_len(empty_literal))
      }
    }

    it("inserts and reports entry presence") {
      do {
        map = HashMap::map_insert(HashMap::map_insert(HashMap::empty_map(), "a", 1), "b", 2)

        assert_eq(2, HashMap::map_len(map))
        assert_true(HashMap::map_contains_key(map, "a"))
        assert_false(HashMap::map_contains_key(map, "z"))
      }
    }

    it("returns Ok for present keys and HashMapKeyMissing for missing keys") {
      do {
        map = HashMap::map_insert(HashMap::map_insert(HashMap::empty_map(), "a", 1), "b", 2)

        assert_ok_eq(1, HashMap::map_get(map, "a"))
        result = HashMap::map_get(map, "z")

        assert_err_kind(HashMapKeyMissing, result)
        assert_err_message_eq("hash map key not found: z", result)
      }
    }
  }

  describe("entry normalization") {
    it("from_entries keeps the last duplicate value") {
      do {
        assert_eq(hash!["a" => 3, "b" => 2], HashMap::map_from_entries([("b", 2), ("a", 1), ("a", 3)]))
      }
    }

    it("remove deletes present keys and ignores missing keys") {
      do {
        from_entries = HashMap::map_from_entries([("b", 2), ("a", 1), ("a", 3)])
        removed = HashMap::map_remove(from_entries, "b")

        assert_eq(hash!["a" => 3], removed)
        assert_eq(hash!["a" => 3], HashMap::map_remove(removed, "missing"))
      }
    }
  }

  describe("deterministic views") {
    it("returns keys values and entries in sorted key order") {
      do {
        from_entries = HashMap::map_from_entries([("b", 2), ("a", 1), ("a", 3)])

        assert_eq(["a", "b"], HashMap::map_keys(from_entries))
        assert_eq([3, 2], HashMap::map_values_list(from_entries))
        assert_eq([("a", 3), ("b", 2)], HashMap::entries(from_entries))
      }
    }

    it("maps only the values while preserving key order") {
      do {
        from_entries = HashMap::map_from_entries([("b", 2), ("a", 1), ("a", 3)])

        assert_eq(hash!["a" => 30, "b" => 20], HashMap::map_values(from_entries, {|v| v * 10}))
      }
    }



    it("maps an empty map without producing entries") {
      do {
        source: HashMap<Int> = hash![]
        mapped: HashMap<String> = HashMap::map_values(source, {|n| to_string(n)})
        assert_eq(0, HashMap::map_len(mapped))
      }
    }

    it("stores callback Err values without dropping their keys") {
      do {
        mapped: HashMap<Result<Int>> = HashMap::map_values(
          hash!["b" => 2, "a" => 1],
          {|n| if(n == 1, Err(NoneError()), Ok(n))},
        )
        assert_eq(["a", "b"], HashMap::map_keys(mapped))
        a <- HashMap::map_get(mapped, "a")
        assert_err_kind(NoneError, a)
        b <- HashMap::map_get(mapped, "b")
        assert_ok_eq(2, b)
      }
    }

    it("renders escaped keys safely") {
      do {
        escaped = HashMap::map_from_entries([
        ("line\nfeed", 1),
        ("path\\to", 2),
        ("say\"hi", 3),
        ("tab\tchar", 4),
        ])

        assert_eq(
        "hash![\"line\\nfeed\" => 1, \"path\\\\to\" => 2, \"say\\\"hi\" => 3, \"tab\\tchar\" => 4]",
        inspect(escaped),
        )
      }
    }
  }

  describe("Eq") {
    it("compares HashMap by keys and value Eq regardless of insertion order") {
      do {
        left = HashMap::map_from_entries([("b", EqByValue::new(2, "two")), ("a", EqByValue::new(1, "one"))])
        right = HashMap::map_from_entries([("a", EqByValue::new(1, "uno")), ("b", EqByValue::new(2, "dos"))])

        assert_true(Eq::eq(left, right))
        assert_false(Eq::eq(left, HashMap::map_from_entries([("a", EqByValue::new(1, "one"))])))
        assert_false(Eq::eq(left, HashMap::map_from_entries([("a", EqByValue::new(1, "one")), ("c", EqByValue::new(2, "two"))])))
        assert_false(Eq::eq(left, HashMap::map_from_entries([("a", EqByValue::new(1, "one")), ("b", EqByValue::new(3, "three"))])))
      }
    }

  }

}


test("HashMap structural patterns") {
  it("accepts additional keys and empty patterns") {
    do {
      map = hash!["a" => 2, "extra" => 3]
      assert_true(is_match(map, hash!["a" => 2]))
      assert_true(is_match(map, hash![]))
      assert_ok_eq(2, apply_pattern(map, hash!["a" => _1]))
      assert_eq(2, match map { hash!["a" => n] => n, hash![] => 0, })
    }
  }

  it("requires wildcard keys and reports only the first missing key") {
    do {
      map: HashMap<Int> = hash![]
      result = apply_pattern(map, hash!["b" => _, "a" => _])
      assert_err_kind(HashMapKeyMissing, result)
      assert_err_message_eq("hash map key not found: b", result)
      assert_eq("b", match result { Err(HashMapKeyMissing(key)) => key, _ => "wrong", })
      assert_err_message_eq("hash map key not found: z", apply_pattern(hash!["a" => map], hash!["a" => hash!["z" => _]]))
    }
  }

  it("does not unwrap Result values or inspect extra keys") {
    do {
      map: HashMap<Result<Int>> = hash!["a" => Ok(2), "extra" => Err(NoneError())]
      assert_ok_eq(Ok(2), apply_pattern(map, hash!["a" => _1]))
      assert_ok_eq(2, apply_pattern(map, hash!["a" => Ok(_1)]))
      assert_true(is_match(apply_pattern(hash!["a" => Err(NoneError())], hash!["a" => _1: Result<Int>]), Ok(Err(NoneError()))))
      assert_false(is_match(hash!["a" => Err(NoneError())], hash!["a" => Ok(_: Int)]))
    }
  }

  it("preserves child Error cause chains through apply_pattern and SafeBind") {
    do {
      rejected = *{|value: Int| accepted =? hashmap_pattern_source(value); MatchResult::Ok(accepted)}
      assert_cause_chain([HashMapPatternContext, HashMapPatternSource], apply_pattern(hash!["a" => 1], hash!["a" => rejected(_1)]))
      runner: (HashMap<Int> -> Result<Int>) = {|map: HashMap<Int>| hash!["a" => rejected(value)] =? map; Ok(value)}
      assert_cause_chain([HashMapPatternContext, HashMapPatternSource], runner(hash!["a" => 1]))
      do_child: Result<Int> = do::<Result> {
        hash!["a" => rejected(value)] <- Ok(hash!["a" => 1])
        Ok(value)
      }
      assert_cause_chain([HashMapPatternContext, HashMapPatternSource], do_child)
      original: Result<HashMap<Int>> = Result::cause(Err(HashMapPatternSource()), HashMapPatternContext())
      transported = hashmap_pattern_select(original)
      assert_cause_chain([HashMapPatternContext, HashMapPatternSource], transported)
      original_text = match original { Err(err) => Error::format(err), _ => "wrong", }
      transported_text = match transported { Err(err) => Error::format(err), _ => "wrong", }
      assert_eq(original_text, transported_text)
      do_transported: Result<Int> = do::<Result> {
        hash!["a" => value] <- original
        Ok(value)
      }
      assert_cause_chain([HashMapPatternContext, HashMapPatternSource], do_transported)
      do_text = match do_transported { Err(err) => Error::format(err), _ => "wrong", }
      assert_eq(original_text, do_text)

    }
  }
}
