import Test;

test("Ordering") {
  describe("enum surface") {
    it("renders through Show") {
      do {
        assert_eq("Ordering::Less", to_string(Ordering::Less))
      }
    }
  }

  describe("integration with Compare") {
    it("is returned by integer comparison") {
      do {
        assert_eq(Ordering::Less, compare(1, 2))
        assert_eq(Ordering::Equal, compare(2, 2))
        assert_eq(Ordering::Greater, compare(3, 2))
      }
    }

    it("is returned by float and duration comparison") {
      do {
        assert_eq(Ordering::Less, compare(1.5, 2.0))
        assert_eq(Ordering::Greater, compare(30ms, 20ms))
      }
    }



    it("is returned by tuple comparison") {
      do {
        assert_eq(Ordering::Less, compare((1, 2), (1, 3)))
        assert_eq(Ordering::Equal, compare((1, 2), (1, 2)))
        assert_eq(Ordering::Less, compare((1, 9), (2, 0)))
      }
    }
  }
}
