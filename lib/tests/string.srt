include "./schema/string_schema.srt"

import String;
import Test;

test("String") {
  describe("emptiness helpers") {
    it("detects empty strings") { assert_true(is_empty("")) }
    it("detects non-empty strings") { assert_true(non_empty("surtr")) }
    it("reports False for the opposite branch") {
      assert_false(is_empty("surtr"))
      assert_false(non_empty(""))
    }
  }

  describe("len") {
    it("counts ascii characters") { assert_eq(5, len("surtr")) }
    it("counts unicode surface characters") { assert_eq(2, len("あい")) }
  }

  describe("surround") {
    it("wraps a string with prefix and suffix") {
      assert_eq("[core]", surround("core", "[", "]"))
    }
  }

  describe("join") {
    it("joins parts with separators") { assert_eq("a,b,c", join(["a", "b", "c"], ",")) }
    it("returns an empty string for empty input") { assert_eq("", join([], ",")) }
  }

  describe("repeat") {
    it("repeats a string") {
      assert_eq("Ok(\"nanana\")", inspect(repeat("na", 3)))
    }

    it("accepts zero repeats") {
      assert_eq("Ok(\"\")", inspect(repeat("na", 0)))
    }

    it("rejects negative counts") {
      assert_eq(
        "Err(NegativeRepeatCount(\"repeat count must be non-negative: -1\"))",
        inspect(repeat("na", -1)),
      )
    }
  }

  describe("starts_with") {
    it("matches a valid prefix") { assert_true(starts_with("surtr", "sur")) }
    it("rejects a missing prefix") { assert_false(starts_with("surtr", "urt")) }
  }

  describe("ends_with") {
    it("matches a valid suffix") { assert_true(ends_with("surtr", "tr")) }
    it("rejects a missing suffix") { assert_false(ends_with("surtr", "su")) }
  }

  describe("strip_prefix") {
    it("removes a matching prefix") {
      assert_eq("Ok(\"tr\")", inspect(strip_prefix("surtr", "sur")))
    }

    it("returns NoneError for a missing prefix") {
      assert_eq(
        "Err(NoneError(\"None Value.\"))",
        inspect(strip_prefix("surtr", "ur")),
      )
    }
  }

  describe("strip_suffix") {
    it("removes a matching suffix") {
      assert_eq("Ok(\"sur\")", inspect(strip_suffix("surtr", "tr")))
    }

    it("returns NoneError for a missing suffix") {
      assert_eq(
        "Err(NoneError(\"None Value.\"))",
        inspect(strip_suffix("surtr", "su")),
      )
    }
  }

  describe("split_once") {
    it("splits on the first match") {
      assert_eq(
        "Ok(StringSplit::Split(\"key\", \"value\"))",
        inspect(split_once("key=value", "=")),
      )
    }

    it("accepts an empty separator") {
      assert_eq(
        "Ok(StringSplit::Split(\"\", \"surtr\"))",
        inspect(split_once("surtr", "")),
      )
    }

    it("returns NoneError when not found") {
      assert_eq(
        "Err(NoneError(\"None Value.\"))",
        inspect(split_once("surtr", "/")),
      )
    }
  }

  describe("contains") {
    it("matches an inner substring") { assert_true(contains("surtr", "urt")) }
    it("rejects a missing substring") { assert_false(contains("surtr", "zzz")) }
    it("matches an empty needle") { assert_true(contains("surtr", "")) }
  }

  describe("replace") {
    it("replaces each matched substring") { assert_eq("baNANA", replace("banana", "na", "NA")) }
    it("leaves input unchanged for an empty separator") { assert_eq("surtr", replace("surtr", "", "-")) }
    it("uses non-overlapping matches") { assert_eq("bb", replace("aaaa", "aa", "b")) }
  }

  describe("split") {
    it("keeps empty segments around matches") {
      assert_eq("[\"a\", \"\", \"b\", \"\"]", inspect(split("a,,b,", ",")))
    }

    it("splits into characters on an empty separator") {
      assert_eq("[\"s\", \"u\", \"r\", \"t\", \"r\"]", inspect(split("surtr", "")))
    }

    it("returns the original string when the separator is absent") {
      assert_eq("[\"surtr\"]", inspect(split("surtr", "/")))
    }

    it("splits on unicode separators") {
      assert_eq("[\"a\", \"b\", \"\"]", inspect(split("aあbあ", "あ")))
    }
  }

  describe("lines") {
    it("returns no lines for empty input") { assert_eq("[]", inspect(lines(""))) }
    it("splits newline-terminated text") { assert_eq("[\"a\", \"b\"]", inspect(lines("a\nb\n"))) }
    it("normalizes CRLF line endings") { assert_eq("[\"a\", \"b\"]", inspect(lines("a\r\nb\r\n"))) }
  }

  describe("chars") {
    it("splits into single-character strings") {
      assert_eq("[\"あ\", \"b\"]", inspect(chars("あb")))
    }
  }

  describe("from_chars") {
    it("rebuilds a valid character list") {
      assert_eq("Ok(\"あb\")", inspect(from_chars(["あ", "b"])))
    }

    it("accepts an empty character list") {
      assert_eq("Ok(\"\")", inspect(from_chars([])))
    }

    it("rejects multi-character items") {
      assert_eq(
        "Err(InvalidCharList(\"expected single-character string at index 0, got \\\"ab\\\"\"))",
        inspect(from_chars(["ab"])),
      )
    }
  }

  describe("codepoints") {
    it("encodes utf8 bytes") {
      assert_eq(
        "Ok([65, 227, 129, 130])",
        inspect(codepoints("Aあ", StringEncoding::Utf8)),
      )
    }

    it("encodes ascii bytes") {
      assert_eq(
        "Ok([65, 90])",
        inspect(codepoints("AZ", StringEncoding::Ascii)),
      )
    }

    it("rejects non-ascii characters in ascii mode") {
      assert_eq(
        "Err(InvalidStringEncoding(\"ASCII encoding does not support character at index 0: あ\"))",
        inspect(codepoints("あ", StringEncoding::Ascii)),
      )
    }
  }

  describe("from_codepoints") {
    it("restores utf8 text") {
      assert_eq(
        "Ok(\"Aあ\")",
        inspect(from_codepoints([65, 227, 129, 130], StringEncoding::Utf8)),
      )
    }

    it("restores ascii text") {
      assert_eq(
        "Ok(\"AZ\")",
        inspect(from_codepoints([65, 90], StringEncoding::Ascii)),
      )
    }

    it("rejects out-of-range ascii codes") {
      assert_eq(
        "Err(InvalidStringEncoding(\"ASCII code out of range at index 0: 128\"))",
        inspect(from_codepoints([128], StringEncoding::Ascii)),
      )
    }

    it("rejects invalid utf8 byte sequences") {
      assert_eq(
        "Err(InvalidStringEncoding(\"invalid UTF-8 byte sequence at index 0 (len 1)\"))",
        inspect(from_codepoints([255], StringEncoding::Utf8)),
      )
    }
  }

  describe("trim") {
    it("trims leading whitespace") { assert_eq("core", trim_start(" \n\tcore")) }
    it("trims trailing whitespace") { assert_eq("core", trim_end("core \n\t")) }
    it("trims both sides") { assert_eq("core", trim(" \ncore\t ")) }
  }

  describe("TryFrom") {
    it("supports result pipeline assertions") {
      try_from::<Int>("1") |>= assert_eq(1)
    }

    it("parses signed integers") {
      try_from::<Int>("-12") |>= assert_eq(-12)
    }

    it("reports invalid integer text") {
      assert_err_contains("invalid integer literal", try_from::<Int>("bad"))
    }

    it("parses booleans") {
      try_from::<Boolean>("true") |>= assert_eq(True)
    }

    it("parses alternate boolean casing") {
      try_from::<Boolean>("False") |>= assert_eq(False)
    }

    it("reports invalid boolean text") {
      assert_err_contains("invalid boolean literal", try_from::<Boolean>("maybe"))
    }
  }

  describe("trait integration") {
    it("converts user wrappers through From") {
      slug = from::<Slug>("  surtr code  ")
      assert_eq("surtr-code", to_string(slug))
    }

    it("reuses string helpers through wrapper methods") {
      slug = from::<Slug>("  surtr code  ")
      assert_eq("[\"surtr\", \"code\"]", inspect(Slug::segments(slug)))
    }
  }
}
