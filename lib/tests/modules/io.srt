import IO;
import Test;
test("IO") {
  describe("get_line") {
    it("reads supplied lines in order") {
      do {
        push_stdin("alpha\nbeta\n")

        assert_ok_eq("alpha", IO::get_line(""))
        assert_ok_eq("beta", IO::get_line(""))
      }
    }
    it("emits the prompt as one entry") {
      do {
        push_stdin("answer\n")
        actual = IO::get_line("prompt")

        assert_ok_eq("answer", actual)
        assert_stdout_eq(["prompt"])
      }
    }
    it("removes CRLF") {
      do {
        cr <- String::from_codepoints([13], StringEncoding::Utf8)
        push_stdin("alpha" ++ cr ++ "\n")

        assert_ok_eq("alpha", IO::get_line(""))
      }
    }
    it("reports EOF") {
      do {
        assert_err_kind(InputLineEnd, IO::get_line(""))
      }
    }
    it("reports EOF after consuming input") {
      do {
        push_stdin("x\n")

        assert_ok_eq("x", IO::get_line(""))
        assert_err_kind(InputLineEnd, IO::get_line(""))
      }
    }
  }
  describe("get") {
    it("reads characters in order") {
      do {
        push_stdin("xy")

        assert_ok_eq("x", IO::get(""))
        assert_ok_eq("y", IO::get(""))
      }
    }
    it("reads a multibyte character") {
      do {
        push_stdin("猫")

        assert_ok_eq("猫", IO::get(""))
      }
    }
    it("emits the prompt") {
      do {
        push_stdin("x")
        actual = IO::get("?")

        assert_ok_eq("x", actual)
        assert_stdout_eq(["?"])
      }
    }
    it("reports EOF after a character") {
      do {
        push_stdin("x")

        assert_ok_eq("x", IO::get(""))
        assert_err_kind(InputCharacterEnd, IO::get(""))
      }
    }
  }
  describe("eprint") {
    it("writes the formatted error to stderr") {
      do {
        eprint(NoneError)

        assert_stderr_eq(["Error: NoneError: None Value."])
      }
    }
  }
}
