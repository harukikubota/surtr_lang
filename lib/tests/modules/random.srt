import Test;

def draw_sequence(rng: RandomGenerator, count: Int) -> Result<List<Int>> {
  if(count == 0, Ok([]), do {
    (value, next_rng) <- Random::next_int_range(rng, -100, 100)
    assert_gte(value, -100)
    assert_lt(value, 100)
    rest <- draw_sequence(next_rng, count - 1)
    Ok([value, ..rest])
  })
}

test("Random") {
  describe("host-seeded helpers") {
    it("returns values inside half-open ranges") {
      do {
        a <- Random::int_until(10)
        b <- Random::int_range(-3, 3)

        assert_gte(a, 0)
        assert_lt(a, 10)
        assert_gte(b, -3)
        assert_lt(b, 3)
      }
    }

    it("rejects empty and reversed ranges") {
      do {
        until_result = Random::int_until(0)
        range_result = Random::int_range(4, 4)
        reversed_result = Random::int_range(4, 3)

        assert_err_kind(InvalidRandomRange, until_result)
        assert_err_message_eq("random range must be non-empty: 0..0", until_result)
        assert_err_kind(InvalidRandomRange, range_result)
        assert_err_message_eq("random range must be non-empty: 4..4", range_result)
        assert_err_kind(InvalidRandomRange, reversed_result)
        assert_err_message_eq("random range must be non-empty: 4..3", reversed_result)
      }
    }
  }

  describe("seeded generators") {
    it("replays ten draws and preserves the original generator") {
      do {
        rng0 = Random::seed(123)
        values <- draw_sequence(rng0, 10)
        replayed <- draw_sequence(Random::seed(123), 10)
        (first_again, _) <- Random::next_int_range(rng0, -100, 100)

        assert_eq(10, List::len(values))
        assert_eq(values, replayed)
        assert_ok_eq(first_again, List::first(values))
      }
    }

    it("threads the returned generator into the next draw") {
      do {
        rng0 = Random::seed(123)
        (_, rng1) <- Random::next_int_range(rng0, -100, 100)
        (v2, _) <- Random::next_int_until(rng1, 10)

        assert_gte(v2, 0)
        assert_lt(v2, 10)
      }
    }

    it("rejects invalid seeded bounds") {
      do {
        rng0 = Random::seed(123)
        until_result = Random::next_int_until(rng0, 0)
        range_result = Random::next_int_range(rng0, 4, 4)
        reversed_result = Random::next_int_range(rng0, 4, 3)

        assert_err_kind(InvalidRandomRange, until_result)
        assert_err_message_eq("random range must be non-empty: 0..0", until_result)
        assert_err_kind(InvalidRandomRange, range_result)
        assert_err_message_eq("random range must be non-empty: 4..4", range_result)
        assert_err_kind(InvalidRandomRange, reversed_result)
        assert_err_message_eq("random range must be non-empty: 4..3", reversed_result)
      }
    }
  }
}
