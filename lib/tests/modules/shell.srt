def prepare_shell_directory(root: FilePath, file: FilePath) -> Result<()> {
  do {
    if(File::exists(file.raw), File::delete(file.raw), Ok(()))
    FS::mkdir_all(root)
  }
}

def check_shell_directory(root: FilePath, setup: Result<()>) -> Result<()> {
  do {
    setup
    _ <- Shell::cd(root)
    after <- Shell::pwd()

    assert_ends_with("lib_test_shell", after.raw)
    _ <- File::write("inside.txt", "cwd")
    assert_ok_eq("cwd", File::read("inside.txt"))
  }
}

def remove_shell_directory(root: FilePath, file: FilePath) -> Result<()> {
  do {
    if(File::exists(file.raw), File::delete(file.raw), Ok(()))
    FS::rm(root)
  }
}

import File;
import Shell;
import Test;

test("Shell") {
  describe("cd/pwd") {
    it("changes the VM directory and restores it after checking") {
      do {
        before <- Shell::pwd()
        relative <- FS::path("./tmp/sandbox/lib_test_shell")
        root <- FS::join(before, relative.raw)
        file <- FS::join(root, "inside.txt")
        setup = prepare_shell_directory(root, file)
        checked = check_shell_directory(root, setup)
        restored = Shell::cd(before)
        cleanup = remove_shell_directory(root, file)
        restored
        cleanup
        checked
      }
    }
  }
  describe("exec") {
    it("returns stdout stderr and a nonzero exit as public fields") {
      do {
        result <- Shell::exec("sh", ["-c", "printf out; printf err >&2; exit 7"])

        assert_eq("sh", result.command)
        assert_eq(7, result.exit_code)
        assert_eq("out", result.stdout)
        assert_eq("err", result.stderr)
      }
    }
  }
}
