include "./schema/float_schema.srt"

import FloatSchema::safe_ratio;
import Test;

test("Float") {
  describe("numeric helpers") {
    it("returns absolute min and max values") {
      assert_eq((1.5, 1.25, 2.5), (Float::abs(-1.5), Float::min(2.5, 1.25), Float::max(2.5, 1.25)))
    }

    it("supports add sub and mul trait dispatch") {
      assert_eq((3.5, 2.5, 3.0), (Add::add(1.5, 2.0), Sub::sub(3.5, 1.0), Mul::mul(1.5, 2.0)))
    }

    it("supports safe division through Numeric") {
      assert_eq(
        ("Ok(1.5)", "Err(ZeroDivisionError(\"division by zero\"))"),
        (inspect(safe_div(3.0, 2.0)), inspect(safe_div(3.0, 0.0))),
      )
    }
  }

  describe("ordering traits") {
    it("supports equality and inequality") {
      assert_eq((True, True), (eq(1.5, 1.5), neq(1.5, 2.0)))
    }

    it("supports compare helpers and relational operators") {
      assert_eq(
        (Ordering::Less, True, True, True, True, True, True, True),
        (
          compare(1.5, 2.0),
          lt(1.5, 2.0),
          lte(1.5, 1.5),
          gt(2.0, 1.5),
          gte(2.0, 2.0),
          1.5 < 2.0,
          1.5 <= 1.5,
          2.0 > 1.5
        ),
      )
    }
  }

  describe("show and conversion") {
    it("renders to string and converts via From") {
      assert_eq(("1.5", 1.5, "1.5"), (to_string(1.5), from(1.5, Float), from(1.5, String)))
    }

    it("renders user-defined wrappers through Show") {
      assert_eq("Score(4.5)", to_string(Score::new(4.5)))
    }
  }

  describe("trait integration") {
    it("uses generic numeric helpers with floats") {
      assert_eq(
        ("Ok(1.5)", "Err(ZeroDivisionError(\"division by zero\"))"),
        (inspect(safe_ratio(3.0, 2.0)), inspect(safe_ratio(3.0, 0.0))),
      )
    }
  }
}
