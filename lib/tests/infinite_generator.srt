include "./schema/infinite_generator_schema.srt"

import InfiniteGeneratorSchema::{fibonacci, natural_numbers, observed_sequence};
import Test;

test("InfiniteGenerator") {
  describe("unfold") {
    it("generates items from tuple state") {
      assert_eq([0, 1, 1, 2, 3, 5], InfiniteGenerator::take(fibonacci(), 6)._0)
    }

    it("constructs and displays a sequence without evaluating its step") {
      capture_stdout()
      shown = inspect(observed_sequence())
      assert_eq("InfiniteGenerator(<opaque>)", shown)
      assert_stdout_eq([])
    }

    it("treats Result items as data") {
      gen = InfiniteGenerator::unfold(0, {|n| (if(n == 0, Err(NoneError), Ok(n)), n + 1)})
      assert_eq([Err(NoneError), Ok(1), Ok(2)], InfiniteGenerator::take(gen, 3)._0)
    }

    it("treats Option items as data") {
      gen = InfiniteGenerator::unfold(0, {|n| (if(n == 0, Option::None, Option::Some(n)), n + 1)})
      assert_eq([Option::None, Option::Some(1)], InfiniteGenerator::take(gen, 2)._0)
    }
  }

  describe("callable composition") {
    it("supports capture, partial application, and pipe acquisition") {
      captured: (InfiniteGenerator<Int> -> (Int, InfiniteGenerator<Int>)) = &InfiniteGenerator::next(&1)
      partial: (Int -> (List<Int>, InfiniteGenerator<Int>)) = &InfiniteGenerator::take(natural_numbers(), &1)
      piped = natural_numbers() |> InfiniteGenerator::take(2)
      assert_eq(1, captured(natural_numbers())._0)
      assert_eq([1, 2], partial(2)._0)
      assert_eq([1, 2], piped._0)
    }
  }

  describe("next") {
    it("returns an item and advances the returned sequence") {
      gen = fibonacci()
      (item, rest) = InfiniteGenerator::next(gen)
      assert_eq(0, item)
      assert_eq([1, 1, 2, 3, 5], InfiniteGenerator::take(rest, 5)._0)
      assert_eq([0, 1, 1, 2, 3], InfiniteGenerator::take(gen, 5)._0)
    }
  }

  describe("take") {
    it("returns a prefix and a resumable rest") {
      (values, rest) = InfiniteGenerator::take(natural_numbers(), 3)
      assert_eq([1, 2, 3], values)
      assert_eq([4, 5], InfiniteGenerator::take(rest, 2)._0)
    }

    it("returns empty values without evaluation for non-positive counts") {
      capture_stdout()
      gen = observed_sequence()
      (zero, rest) = InfiniteGenerator::take(gen, 0)
      (negative, _) = InfiniteGenerator::take(gen, -1)
      empty: List<Int> = []
      assert_eq(empty, zero)
      assert_eq(empty, negative)
      assert_stdout_eq([])
      assert_eq(1, InfiniteGenerator::next(rest)._0)
    }

    it("does not look ahead after obtaining the requested count") {
      capture_stdout()
      values = InfiniteGenerator::take(observed_sequence(), 2)._0
      assert_eq([1, 2], values)
      assert_stdout_eq(["step=1", "step=2"])
    }
  }

  describe("take_exact") {
    it("returns the requested items and rest") {
      match InfiniteGenerator::take_exact(fibonacci(), 3) {
        Ok((values, rest)) => {
          assert_eq([0, 1, 1], values)
          assert_eq(2, InfiniteGenerator::next(rest)._0)
        },
        Err(_) => assert_true(False),
      }
    }

    it("rejects non-positive counts before evaluating the step") {
      capture_stdout()
      match InfiniteGenerator::take_exact(observed_sequence(), -1) {
        Err(err) => {
          assert_eq("InvalidGeneratorCount", Error::kind(err))
          assert_eq("count must be positive: -1", Error::message(err))
          assert_stdout_eq([])
        },
        Ok(_) => assert_true(False),
      }
    }
  }

  describe("take_while") {
    it("leaves the first rejected item at the start of the rest") {
      (values, rest) = InfiniteGenerator::take_while(natural_numbers(), {|n| n < 3})
      assert_eq([1, 2], values)
      assert_eq([3, 4], InfiniteGenerator::take(rest, 2)._0)
    }

    it("returns the original position when the first item is rejected") {
      (values, rest) = InfiniteGenerator::take_while(natural_numbers(), {|_| False})
      empty: List<Int> = []
      assert_eq(empty, values)
      assert_eq(1, InfiniteGenerator::next(rest)._0)
    }
  }

  describe("take_until") {
    it("stops before the first matching item") {
      (values, rest) = InfiniteGenerator::take_until(natural_numbers(), {|n| n >= 3})
      assert_eq([1, 2], values)
      assert_eq([3, 4], InfiniteGenerator::take(rest, 2)._0)
    }
  }

  describe("iterate") {
    it("returns a List beginning with the seed") {
      assert_eq([1, 2, 4, 8, 16], InfiniteGenerator::iterate(1, 5, {|n| n * 2}))
    }

    it("returns an empty List for a non-positive count without calling step") {
      capture_stdout()
      values = InfiniteGenerator::iterate(1, 0, {|n|
        print("step")
        n * 2
      })
      empty: List<Int> = []
      assert_eq(empty, values)
      assert_stdout_eq([])
    }

    it("returns the seed alone without calling step for count one") {
      capture_stdout()
      values = InfiniteGenerator::iterate(7, 1, {|n|
        print("step")
        n * 2
      })
      assert_eq([7], values)
      assert_stdout_eq([])
    }

    it("calls step only for items after the seed") {
      capture_stdout()
      values = InfiniteGenerator::iterate(1, 3, {|n|
        print("step=#{n}")
        n * 2
      })
      assert_eq([1, 2, 4], values)
      assert_stdout_eq(["step=1", "step=2"])
    }
  }
}
