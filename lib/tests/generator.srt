include "./schema/generator_schema.srt"

import GeneratorSchema::{fib_generator, take_and_resume};
import Test;

test("Generator") {
  describe("construction helpers") {
    it("iterates from a seed") {
      assert_eq([1, 2, 4, 8, 16], Generator::to_list(Generator::iterate(1, 5, {|x| x * 2})))
    }

    it("builds inclusive integer ranges") {
      assert_eq([3, 4, 5, 6], Generator::to_list(Generator::range(3, 6)))
    }

    it("builds stepped descending ranges") {
      stepped =? Generator::range_step(7, 1, -2)
      assert_eq([7, 5, 3, 1], Generator::to_list(stepped))
    }

    it("rejects zero step ranges") {
      assert_eq(
        "Err(InvalidRangeStep(\"step must not be 0\"))",
        inspect(Generator::range_step(1, 5, 0)),
      )
    }
  }

  describe("consumption and indexing") {
    it("returns the next item and updated cursor") {
      g0 = Generator::range(10, 12)
      (item1, g1) =? Generator::next(g0)
      assert_eq((10, 1, "Ok((11, (2, [12])))"), (item1, Generator::idx(g1), inspect(Generator::next(g1))))
    }

    it("attaches indices to remaining values") {
      indexed = Generator::with_index(Generator::range(5, 7))
      assert_eq([(0, 5), (1, 6), (2, 7)], Generator::to_list(indexed))
    }

    it("maps values without losing progress information") {
      mapped = Generator::map(Generator::range(1, 4), {|x| "n=" ++ to_string(x) })
      assert_eq(["n=1", "n=2", "n=3", "n=4"], Generator::to_list(mapped))
    }

    it("takes a prefix and handles non-positive counts") {
      assert_eq(
        ([1, 2, 4, 8], []),
        (
          Generator::take(Generator::iterate(1, 10, {|x| x * 2}), 4),
          Generator::take(Generator::range(1, 3), 0),
        ),
      )
    }
  }

  describe("character ranges") {
    it("builds stepped ascii character ranges") {
      chars_up =? Generator::range_char_step("a", "g", 2)
      chars_down =? Generator::range_char_step("g", "a", -2)
      assert_eq((["a", "c", "e", "g"], ["g", "e", "c", "a"]), (
        Generator::to_list(chars_up),
        Generator::to_list(chars_down),
      ))
    }

    it("rejects invalid character inputs") {
      assert_eq(
        (
          "Err(InvalidCharRange(\"start must be a single char\"))",
          "Err(InvalidCharRange(\"start must be a single ASCII char\"))",
        ),
        (
          inspect(Generator::range_char("ab", "d")),
          inspect(Generator::range_char("あ", "d")),
        ),
      )
    }
  }

  describe("resume flows") {
    it("can take from a resumed fibonacci generator") {
      fib0 = fib_generator(12)
      (first5, fib5) = take_and_resume(fib0, 5, [])
      (next3, fib8) = take_and_resume(fib5, 3, [])
      assert_eq(
        ([0, 1, 1, 2, 3], 5, [5, 8, 13, 21], [(5, 5), (6, 8), (7, 13), (8, 21)], [5, 8, 13], 8, [21, 34, 55, 89]),
        (
          first5,
          Generator::idx(fib5),
          Generator::take(fib5, 4),
          Generator::take(Generator::with_index(fib5), 4),
          next3,
          Generator::idx(fib8),
          Generator::take(fib8, 4),
        ),
      )
    }
  }
}
