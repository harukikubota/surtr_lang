include "./schema/list_schema.srt"

import ListSchema::{add_one, list_pure, list_step1, list_step2, list_step3};
import Test;

def list_ordered_step(value: Int) -> List<Int> {
  print("step=#{value}")
  [value, value + 10]
}

test("List") {
  describe("helpers") {
    it("flat_map, bind, do, pipe, and Kleisli preserve callback effects") {
      capture_stdout()
      values = List::cons(1, [2])
      direct = List::flat_map(values, &list_ordered_step)
      bound: List<Int> = Monad::bind(values, &list_ordered_step)
      piped: List<Int> = values |>= list_ordered_step()
      computed: List<Int> = do::<List> {
        value <- values
        expanded <- list_ordered_step(value)
        Monad::return(expanded)
      }
      composed = &list_pure >=> &list_ordered_step
      combined = List::flat_map(values, composed)
      do::<Result> {
        assert_eq([1, 11, 2, 12], direct)
        assert_eq(direct, bound)
        assert_eq(direct, piped)
        assert_eq(direct, computed)
        assert_eq(direct, combined)
        assert_stdout_eq([
          "step=1", "step=2", "step=1", "step=2", "step=1", "step=2",
          "step=1", "step=2", "step=1", "step=2",
        ])
      }
    }

    it("mixed lists preserve decomposition, display, and algebraic laws") {
      packed = [2, 3]
      mixed = List::cons(1, packed)
      uncons(head, tail) =? mixed
      do::<Result> {
        assert_eq(1, head)
        assert_eq([2, 3], tail)
        assert_eq([2, 3], packed)
        assert_eq(3, List::len(mixed))
        assert_eq("[1, 2, 3]", inspect(mixed))
        assert_eq(mixed, List::append([], mixed))
        assert_eq(mixed, List::append(mixed, []))
        assert_eq(mixed, List::reverse(List::reverse(mixed)))
        assert_eq(mixed, List::map(mixed, {|value| value}))
        assert_eq(mixed, List::flat_map(mixed, {|value| [value]}))
        assert_eq(
          List::append(List::append(mixed, [4]), [5]),
          List::append(mixed, List::append([4], [5])),
        )
      }
    }

    it("flat_map visits each input once and preserves result order") {
      capture_stdout()
      values = List::cons(0, [1, 2, 3])
      actual = List::flat_map(values: values, f: {|value|
        print("visit=#{value}")
        match value {
          0 => [],
          1 => [value],
          _ => List::cons(value, [value + 10]),
        }
      })
      do::<Result> {
        assert_eq([1, 2, 12, 3, 13], actual)
        assert_eq([0, 1, 2, 3], values)
        assert_stdout_eq(["visit=0", "visit=1", "visit=2", "visit=3"])
      }
    }

    it("flat_map skips callbacks for empty input") {
      capture_stdout()
      values: List<Int> = []
      actual = List::flat_map(values, {|value|
        print("visit=#{value}")
        [value]
      })
      do::<Result> {
        assert_eq(values, actual)
        assert_stdout_eq([])
      }
    }

    it("nested flat_map completes inner results in input order") {
      capture_stdout()
      actual = List::flat_map([1, 2], {|outer|
        print("outer=#{outer}")
        List::flat_map([3, 4], {|inner|
          print("inner=#{outer}:#{inner}")
          [outer * 10 + inner]
        })
      })
      do::<Result> {
        assert_eq([13, 14, 23, 24], actual)
        assert_stdout_eq([
          "outer=1", "inner=1:3", "inner=1:4",
          "outer=2", "inner=2:3", "inner=2:4",
        ])
      }
    }

    it("concatenates lists with Alternative choice") {
      assert_eq([1, 2, 3], [1, 2] <|> [3])
    }

    it("obeys Alternative identity and associativity laws") {
      empty: List<Int> = Alternative::empty()
      first: List<Int> = [1]
      second: List<Int> = [2]
      third: List<Int> = [3]
      do::<Result> {
        assert_eq(first, empty <|> first)
        assert_eq(first, first <|> empty)
        assert_eq((first <|> second) <|> third, first <|> (second <|> third))
      }
    }

    it("keeps Monad return equal to Applicative pure") {
      pure_value: List<Int> = Applicative::pure(4)
      returned_value: List<Int> = Monad::return(4)
      assert_eq(pure_value, returned_value)
    }

    it("folds, maps, and reduces with a Monoid") {
      sum = Monoid(0, {|left, right| left + right})
      do::<Result> {
        assert_eq(0, List::fold([], sum))
        assert_eq(6, List::fold([1, 2, 3], sum))
        assert_eq(12, List::fold_map([1, 2, 3], sum, {|value| value * 2}))
        assert_eq(Option::Some(6), List::reduce_with([1, 2, 3], sum.combine))
        values: List<Int> = []
        none: Option<Int> = Option::None
        assert_eq(none, List::reduce_with(values, sum.combine))
      }
    }

    it("each runs callbacks from left to right") {
      capture_stdout()
      result = List::each([1, 2, 3], {|n| print("n=#{to_string(n)}")})
      do::<Result> {
        assert_eq((), result)
        assert_stdout_eq(["n=1", "n=2", "n=3"])
      }
    }

    it("each returns Unit and does nothing for empty lists") {
      capture_stdout()
      result = List::each([], {|n: Int| print("n=#{to_string(n)}")})
      do::<Result> {
        assert_eq((), result)
        assert_stdout_eq([])
      }
    }

    it("min_max returns min and max in one result") {
      assert_eq("Ok((1, 4))", inspect(List::min_max([3, 1, 4, 2])))
    }

    it("min_max keeps a singleton as both bounds") {
      assert_eq("Ok((7, 7))", inspect(List::min_max([7])))
    }

    it("min_max handles duplicates") {
      assert_eq("Ok((1, 2))", inspect(List::min_max([2, 2, 1, 2])))
    }

    it("min_max returns NoneError for empty lists") {
      values: List<Int> = []
      assert_err_kind(NoneError, List::min_max(values))
    }
  }

  describe("monad laws") {
    # ghci> let pureL x = [x]
    # ghci> let f x = [x, x + 10]
    # ghci> pureL 2 >>= f
    # ghci> f 2
    it("left identity holds") {
      assert_eq(list_step1(2), list_pure(2) |>= list_step1())
    }

    # ghci> let pureL x = [x]
    # ghci> let xs = [1, 2]
    # ghci> xs >>= pureL
    # ghci> xs
    it("right identity keeps populated lists") {
      values: List<Int> = [1, 2]
      assert_eq(values, values |>= list_pure())
    }

    # ghci> let pureL x = [x]
    # ghci> ([] :: [Int]) >>= pureL
    # ghci> ([] :: [Int])
    it("right identity keeps empty lists") {
      values: List<Int> = []
      assert_eq(values, values |>= list_pure())
    }

    # ghci> let f x = [x, x + 10]
    # ghci> let g x = if x < 10 then [x * 2] else []
    # ghci> let xs = [1, 2]
    # ghci> ((xs >>= f) >>= g) == (xs >>= (f >=> g))
    it("associativity holds on populated expansions") {
      values: List<Int> = [1, 2]
      composed = &list_step1 >=> &list_step2
      sequential: List<Int> = (values |>= list_step1()) |>= list_step2()
      composed_result: List<Int> = values |>= composed
      assert_eq(sequential, composed_result)
    }

    # ghci> let f x = [x, x + 10]
    # ghci> let g x = if x < 10 then [x * 2] else []
    # ghci> let xs = [10]
    # ghci> ((xs >>= f) >>= g) == (xs >>= (f >=> g))
    it("associativity holds when branches collapse to empty") {
      values: List<Int> = [10]
      composed = &list_step1 >=> &list_step2
      sequential: List<Int> = (values |>= list_step1()) |>= list_step2()
      composed_result: List<Int> = values |>= composed
      assert_eq(sequential, composed_result)
    }

    # ghci> let pureL x = [x]
    # ghci> let f x = [x, x + 10]
    # ghci> (pureL >=> f) 2
    # ghci> f 2
    it("kleisli left identity uses pure") {
      composed = &list_pure >=> &list_step1
      result: List<Int> = composed(2)
      assert_eq(result, list_step1(2))
    }

    # ghci> let pureL x = [x]
    # ghci> let f x = [x, x + 10]
    # ghci> (f >=> pureL) 2
    # ghci> f 2
    it("kleisli right identity uses pure") {
      composed = &list_step1 >=> &list_pure
      result: List<Int> = composed(2)
      assert_eq(result, list_step1(2))
    }

    # ghci> let f x = [x, x + 10]
    # ghci> let g x = if x < 10 then [x * 2] else []
    # ghci> let h x = [x - 3]
    # ghci> (((f >=> g) >=> h) 2) == ((f >=> (g >=> h)) 2)
    it("kleisli composition is associative") {
      left = (&list_step1 >=> &list_step2) >=> &list_step3
      right = &list_step1 >=> (&list_step2 >=> &list_step3)
      left_result: List<Int> = left(2)
      right_result: List<Int> = right(2)
      assert_eq(left_result, right_result)
    }

    # ghci> let f x = [x, x + 10]
    # ghci> let g x = if x < 10 then [x * 2] else []
    # ghci> (f >=> g) 2
    # ghci> f 2 >>= g
    it("kleisli composition matches staged bind") {
      composed = &list_step1 >=> &list_step2
      composed_result: List<Int> = composed(2)
      sequential: List<Int> = list_step1(2) |>= list_step2()
      assert_eq(composed_result, sequential)
    }

    # ghci> let pureL x = [x]
    # ghci> let xs = [1, 2]
    # ghci> fmap (+ 1) xs
    # ghci> xs >>= (pureL . (+ 1))
    it("fmap matches bind with pure after mapping") {
      values: List<Int> = [1, 2]
      mapped: List<Int> = values |*> add_one()
      bound: List<Int> = values |>= {|x| list_pure(add_one(x))}
      assert_eq(mapped, bound)
    }
  }
}
