include "./schema/list_schema.srt"

import ListSchema::{add_one, list_pure, list_step1, list_step2, list_step3};
import Test;

def map_applicative(value: Applicative<$A>, mapper: ($A -> $B)) -> Applicative<$B> {
  Functor::fmap(value, mapper)
}

test("List") {
  describe("helpers") {
    it("specializes constructor-constrained fmap") {
      mapped: List<String> = map_applicative([9, 10], &to_string)
      assert_eq(mapped, ["9", "10"])
    }

    it("concatenates lists with Alternative choice") {
      assert_eq([1, 2, 3], [1, 2] <|> [3])
    }

    it("obeys Alternative identity and associativity laws") {
      empty: List<Int> = Alternative::empty::<Int>()
      first: List<Int> = [1]
      second: List<Int> = [2]
      third: List<Int> = [3]
      assert_eq(first, empty <|> first)
      assert_eq(first, first <|> empty)
      assert_eq((first <|> second) <|> third, first <|> (second <|> third))
    }

    it("keeps Monad return equal to Applicative pure") {
      pure_value: List<Int> = Applicative::pure(4)
      returned_value: List<Int> = Monad::return(4)
      assert_eq(pure_value, returned_value)
    }

    it("folds, maps, and reduces with a Monoid") {
      sum = Monoid(0, {|left, right| left + right})
      assert_eq(0, List::fold([], sum))
      assert_eq(6, List::fold([1, 2, 3], sum))
      assert_eq(12, List::fold_map([1, 2, 3], sum, {|value| value * 2}))
      assert_eq(Option::Some(6), List::reduce_with([1, 2, 3], sum.combine))
      values: List<Int> = []
      assert_eq(Option::None, List::reduce_with(values, sum.combine))
    }

    it("each runs callbacks from left to right") {
      capture_stdout()
      result = List::each([1, 2, 3], {|n| print("n=#{to_string(n)}")})
      assert_eq((), result)
      assert_stdout_eq(["n=1", "n=2", "n=3"])
    }

    it("each returns Unit and does nothing for empty lists") {
      capture_stdout()
      result = List::each([], {|n: Int| print("n=#{to_string(n)}")})
      assert_eq((), result)
      assert_stdout_eq([])
    }

    it("min_max returns min and max in one result") {
      assert_eq("Ok((1, 4))", inspect(List::min_max([3, 1, 4, 2])))
    }

    it("min_max keeps a singleton as both bounds") {
      assert_eq("Ok((7, 7))", inspect(List::min_max([7])))
    }

    it("min_max handles duplicates") {
      assert_eq("Ok((1, 2))", inspect(List::min_max([2, 2, 1, 2])))
    }

    it("min_max returns NoneError for empty lists") {
      values: List<Int> = []
      assert_eq("Err(NoneError(\"None Value.\"))", inspect(List::min_max(values)))
    }
  }

  describe("monad laws") {
    # ghci> let pureL x = [x]
    # ghci> let f x = [x, x + 10]
    # ghci> pureL 2 >>= f
    # ghci> f 2
    it("left identity holds") {
      assert_eq(list_step1(2), list_pure(2) |>= list_step1())
    }

    # ghci> let pureL x = [x]
    # ghci> let xs = [1, 2]
    # ghci> xs >>= pureL
    # ghci> xs
    it("right identity keeps populated lists") {
      values: List<Int> = [1, 2]
      assert_eq(values, values |>= list_pure())
    }

    # ghci> let pureL x = [x]
    # ghci> ([] :: [Int]) >>= pureL
    # ghci> ([] :: [Int])
    it("right identity keeps empty lists") {
      values: List<Int> = []
      assert_eq(values, values |>= list_pure())
    }

    # ghci> let f x = [x, x + 10]
    # ghci> let g x = if x < 10 then [x * 2] else []
    # ghci> let xs = [1, 2]
    # ghci> ((xs >>= f) >>= g) == (xs >>= (f >=> g))
    it("associativity holds on populated expansions") {
      values: List<Int> = [1, 2]
      composed = &list_step1 >=> &list_step2
      assert_eq((values |>= list_step1()) |>= list_step2(), values |>= composed)
    }

    # ghci> let f x = [x, x + 10]
    # ghci> let g x = if x < 10 then [x * 2] else []
    # ghci> let xs = [10]
    # ghci> ((xs >>= f) >>= g) == (xs >>= (f >=> g))
    it("associativity holds when branches collapse to empty") {
      values: List<Int> = [10]
      composed = &list_step1 >=> &list_step2
      assert_eq((values |>= list_step1()) |>= list_step2(), values |>= composed)
    }

    # ghci> let pureL x = [x]
    # ghci> let f x = [x, x + 10]
    # ghci> (pureL >=> f) 2
    # ghci> f 2
    it("kleisli left identity uses pure") {
      composed = &list_pure >=> &list_step1
      assert_eq(composed(2), list_step1(2))
    }

    # ghci> let pureL x = [x]
    # ghci> let f x = [x, x + 10]
    # ghci> (f >=> pureL) 2
    # ghci> f 2
    it("kleisli right identity uses pure") {
      composed = &list_step1 >=> &list_pure
      assert_eq(composed(2), list_step1(2))
    }

    # ghci> let f x = [x, x + 10]
    # ghci> let g x = if x < 10 then [x * 2] else []
    # ghci> let h x = [x - 3]
    # ghci> (((f >=> g) >=> h) 2) == ((f >=> (g >=> h)) 2)
    it("kleisli composition is associative") {
      left = (&list_step1 >=> &list_step2) >=> &list_step3
      right = &list_step1 >=> (&list_step2 >=> &list_step3)
      assert_eq(left(2), right(2))
    }

    # ghci> let f x = [x, x + 10]
    # ghci> let g x = if x < 10 then [x * 2] else []
    # ghci> (f >=> g) 2
    # ghci> f 2 >>= g
    it("kleisli composition matches staged bind") {
      composed = &list_step1 >=> &list_step2
      assert_eq(composed(2), list_step1(2) |>= list_step2())
    }

    # ghci> let pureL x = [x]
    # ghci> let xs = [1, 2]
    # ghci> fmap (+ 1) xs
    # ghci> xs >>= (pureL . (+ 1))
    it("fmap matches bind with pure after mapping") {
      values: List<Int> = [1, 2]
      assert_eq(values |*> add_one(), values |>= {|x| list_pure(add_one(x))})
    }
  }
}
