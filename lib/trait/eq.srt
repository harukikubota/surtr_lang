@@doc """
Standard `Eq` trait declaration.
`Eq` models equality and inequality for values that support exact comparison.
The unqualified helpers `eq(...)` / `neq(...)` come from this auto-imported
trait surface rather than from a compiler-only builtin shim.
"""
@@autoimport
deftrait Eq {
  def eq(self: Self, rhs: Self) -> Boolean
  def neq(self: Self, rhs: Self) -> Boolean
}
