@@doc """
Bootstrap module.

Auto-imported root of the standard surface.
This file gives the loader a stable first stage and carries the smallest set of
universally available standard declarations.
Surtr keeps every function inside an explicit or implicit module-like namespace,
and `Bootstrap` is the first explicit example of that rule in the standard
library.
Cross-cutting builtin values live in `kernel.srt`, builtin type declarations
live at the top level of their corresponding files, and the abstract `Error`
type itself lives in `error.srt`.
"""

@@autoimport
# `defmod` introduces a module namespace.
# Bootstrap is the first auto-imported standard module and acts as the fixed
# stage-0 anchor for the loader.
defmod Bootstrap {
  @@doc """
  Debug special form.

  `dbg!` is a language-provided special form for observing intermediate values.
  It evaluates each argument from left to right, writes one debug diagnostic to
  stderr, and returns `Unit`.

  Each argument is type-checked independently.
  The argument list is not collected into `List` or `Tuple`; each expression is
  evaluated as its own input slot and rendered in left-to-right order.
  Rendered values use `inspect`, so strings keep quotes and composite values
  retain their structural shape.

  ## Examples
  dbg!(value)
  dbg!(count, label, make_user(name))

  def main() -> Unit {
    num = 2
    term = "hoge"
    dbg!(num, term)
    print("ok")
  }

  ## REPL
  xldr(1)> num = 1
  > num: Int = 1
  xldr(2)> dbg!(num)
  Debug: inspect values.
     ╭─[ REPL:1:1 ]
     │ 
   1 │ dbg!(num)
     │      ─┬─  
     │       ╰─── Int: 1
  ───╯
  ## Notes
  - `dbg!` returns `()`
  - `x = dbg!(value)` binds `x: Unit = ()`
  - `dbg!()` is invalid
  """
  @@intrinsic def dbg!<$A>(values: *$A) -> Unit

  # `def` introduces a named function declaration.
  # `dummy` exists only to keep the module non-empty and to leave a minimal
  # function-shaped example in the first standard source file.
  @@doc """
  Return `()` without side effects.
  This is a minimal placeholder helper that keeps `Bootstrap` non-empty.
  """
  def dummy() { () }

  @@doc """
  Language-provided import macro function.

  `import` belongs to `Bootstrap`, but its user-facing surface is a top-level
  declaration form that brings public symbols from another module into the
  current file scope.

  Supported surface forms:
  - `import Mod`
  - `import Mod::name`
  - `import Mod::{name1, name2}`

  It stays invalid inside ordinary code blocks and in expression position.
  ## REPL
  xldr(1)> import Option::wrap
  xldr(2)> Option::is_some(wrap(1))
  True
  """
  @@builtin def import() -> Unit

  @@doc """
  Language-provided include macro function.

  `include` belongs to `Bootstrap`, but in script source its user-facing
  surface is a top-level loader directive that appends another module file
  after the standard bootstrap stages.

  Surface form:
  - `include "./path/to/module.srt"`

  It accepts exactly one string literal path in source syntax and stays invalid
  inside ordinary code blocks and in expression position.
  ## REPL
  xldr(1)> include "./path/to/module.srt"
  # loads declarations with no direct value output
  """
  @@builtin def include(path: String) -> Unit
}

# `deferror` introduces a concrete recoverable error declaration.
# Bootstrap carries the most universally useful standard errors so they are
# available from the first standard-library stage.

@@doc """
Concrete bootstrap error for "no value" situations.
`NoneError` is the standard failure used by optional-style sugar such as `T?`
and `None`.
"""
deferror NoneError { "None Value." }

@@doc """
Concrete bootstrap error for division or modulo by zero.
`safe_div` and `safe_mod` return this through `Err(...)` instead of trapping.
"""
deferror ZeroDivisionError { "division by zero" }

@@doc """
Concrete bootstrap error for operations that require at least one list element.
Use this when a list-specific operation cannot proceed because the input is
empty.
"""
deferror EmptyList { "Empty List." }

@@doc """
Concrete bootstrap error for index-based access outside the valid range.
The `detail` field keeps the user-facing message flexible so the runtime can
attach the relevant bounds information.
"""
deferror IndexOutOfBounds(detail: String) { detail }

@@doc """
Concrete bootstrap error for enum-variant selector mismatch in lens access.
`Lens::view` returns this when a variant segment does not match the runtime
value's tag.
"""
deferror VariantMismatch(detail: String) { detail }
