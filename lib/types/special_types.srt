# Compiler-special builtin type declarations.
# This file intentionally has no module body; it only hosts canonical builtin
# type heads reserved by the compiler.

@doc """
Standard `Unit` type declaration.
`Unit` is the type of `()`, typically used for effectful functions that do not
return a meaningful value.
"""
@builtin type Unit

@doc """
Compiler-reserved callable category marker for REPL and doc surfaces.
`Closure` names the family of first-class callable values produced by function
literals and capture forms.
Its runtime-facing shape is still described by ordinary function signatures such
as `(Int -> Int)` or `(String, Int -> Result<Unit, Error>)`; `Closure` does not
replace those signatures.
Like the documentation-only `Tuple` notation, this name exists to reduce
confusion in help text, `:doc`, REPL inspection, and related explanation
surfaces.
Treat it as a special builtin type anchor for callable documentation rather than
as a separate nominal data type to model in user code.
"""
@builtin type Closure

@doc """
Compiler-reserved `match` clause-block marker.
Use level: intrinsic-signature-only marker.
`MatchArms<$Scrutinee, $Result>` does not describe an ordinary first-class
value.
It exists only to name the special clause block consumed by the `match`
surface.
Do not use it in user-defined parameters, return types, fields, bindings, impl
targets, or module/type declarations.
"""
@builtin type MatchArms<$Scrutinee, $Result>

@doc """
Compiler-reserved `cond` clause-block marker.
Use level: intrinsic-signature-only marker.
`CondClauses<$Result>` does not describe an ordinary first-class value.
It exists only to name the special clause block consumed by the `cond`
surface.
Do not use it in user-defined parameters, return types, fields, bindings, impl
targets, or module/type declarations.
"""
@builtin type CondClauses<$Result>

@doc """
Compiler-reserved `Facet::bulk_update` entry-block marker.
Use level: intrinsic-signature-only marker.
`BulkUpdateEntries<$State>` does not describe an ordinary first-class value.
It exists only to name the special update block consumed by the
`Facet::bulk_update` surface.
Do not use it in user-defined parameters, return types, fields, bindings, impl
targets, or module/type declarations.
"""
@builtin type BulkUpdateEntries<$State>

@doc """
Compiler-reserved delayed-evaluation marker for special forms.
Use level: std builtin declaration marker only.
`Lazy<$T>` exists so builtin signatures can describe operands that the
language evaluates conditionally, such as `if`, `and`, `or`, and related
special forms.
It is not an ordinary first-class wrapper type for user data.
Do not use it in user-defined bindings, fields, container elements, or return
types.
"""
@builtin type Lazy<$T>

@doc """
Compiler-reserved process initialization protocol marker.
`StandbyInit<$T>` may only appear as the successful value inside a Standby process
`@init` return type: `Result<StandbyInit<State>>`.
It is not an ordinary public API or data transport type.
"""
@builtin type StandbyInit<$T>

@hidden
@builtin def Pending() -> StandbyInit<$T>

@hidden
@builtin def PendingAfter(duration: Duration) -> StandbyInit<$T>

@hidden
@builtin def Ready(value: $T) -> StandbyInit<$T>

impl Show for Unit {
  @doc """
  Return the standard string rendering for `Unit`.
  ## REPL
  xldr(1)> to_string(())
  "()"
  """
  def to_string(self: Self) -> String {
    inspect(self)
  }
}

impl From<Unit> for Unit {
  @doc """
  Return the value unchanged when converting `Unit` to `Unit`.
  ## REPL
  xldr(1)> from::<Unit>(())
  ()
  """
  def from::<Unit>(self: Self) -> Unit {
    self
  }
}

impl From<String> for Unit {
  @doc """
  Convert `Unit` into its standard string representation.
  ## REPL
  xldr(1)> from::<String>(())
  "()"
  """
  def from::<String>(self: Self) -> String {
    to_string(self)
  }
}


@doc """
Compiler-reserved ignored-input closure marker.
Use level: callable surface marker only.
`Hole` is not a first-class data type.
It exists only as the canonical builtin type behind `_` when a callable value
intentionally accepts an input that is not observed, or when both update-side
slots of `Facet<K, S, A, T, B>` are deferred. Do not use it as plain data,
field, container element, or return hole.
"""
@builtin type Hole
