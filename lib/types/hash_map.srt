@doc """
Standard `HashMap` type declaration.
`HashMap<$V>` is an immutable map with `String` keys and
value-only generics.
The canonical builtin head is fixed to this shape.
Use `hash![key => value, ...]` for generated literals. Literal keys may be
any expression whose type is `String`, and inspect/to_string render the same
literal form in deterministic key-sorted order.

Facet path note:

- `HashMap.[expr]` selects a map value through a Facet path
- `expr` must have plain `String` type
- the same syntax is available in value-side sugar such as `scores.[user_name]`
- `const Facet<...>` still requires a literal bracket segment such as `HashMap.["talk"]`

Examples:

- `Facet::view(HashMap.["talk"], scores)`
- `Facet::view(HashMap.[kind], scores)`
- `Facet::over(User.score_by_kind.[kind], user, {|n| Ok(n + 1)})`
"""
@builtin type HashMap<$V>

impl HashMap {
  defp _map_values_go(
    source: HashMap<$A>,
    remaining_keys: List<String>,
    f: ($A -> $B),
    acc: HashMap<$B>,
  ) -> HashMap<$B> {
    match remaining_keys {
      [] => acc,
      [key, ..tail] => match map_get(source, key) {
        Ok(value) => _map_values_go(source, tail, f, map_insert(acc, key, f(value))),
        Err(_) => _map_values_go(source, tail, f, acc),
      },
    }
  }

  @doc """
  Return the empty map.
  ## REPL
  xldr(1)> map: HashMap<Int> = HashMap::empty_map()
  xldr(2)> literal: HashMap<Int> = hash![]
  xldr(3)> (inspect(map), inspect(literal))
  ("hash![]", "hash![]")
  """
  @builtin def empty_map::<$V>() -> HashMap<$V>

  @doc """
  Build a map from `(String, value)` entries.
  Later duplicates overwrite values.
  ## REPL
  xldr(1)> HashMap::map_from_entries([("a", 1)])
  hash!["a" => 1]
  """
  @builtin def map_from_entries(entries: List<(String, $V)>) -> HashMap<$V>

  @doc """
  Return the number of entries.
  ## REPL
  xldr(1)> HashMap::map_len(HashMap::map_from_entries([("a", 1), ("b", 2)]))
  2
  """
  @builtin def map_len(map: HashMap<$V>) -> Int

  @doc """
  Return `True` when `key` exists in `map`.
  ## REPL
  xldr(1)> HashMap::map_contains_key(HashMap::map_from_entries([("a", 1)]), "a")
  True
  """
  @builtin def map_contains_key(map: HashMap<$V>, key: String) -> Boolean

  @doc """
  Return `Ok(value)` when the key exists, otherwise `Err(NoneError)`.
  ## REPL
  xldr(1)> HashMap::map_get(HashMap::map_from_entries([("a", 1)]), "a")
  Ok(1)
  """
  @builtin def map_get(map: HashMap<$V>, key: String) -> Result<$V, NoneError>

  @doc """
  Return a new map with `key` set to `value`.
  ## REPL
  xldr(1)> HashMap::map_insert(HashMap::empty_map(), "a", 1)
  hash!["a" => 1]
  """
  @builtin def map_insert(map: HashMap<$V>, key: String, value: $V) -> HashMap<$V>

  @doc """
  Return a new map without `key`.
  Missing keys are no-op.
  ## REPL
  xldr(1)> HashMap::map_remove(HashMap::map_from_entries([("a", 1)]), "a")
  hash![]
  """
  @builtin def map_remove(map: HashMap<$V>, key: String) -> HashMap<$V>

  @doc """
  Return keys in deterministic key-sorted order.
  ## REPL
  xldr(1)> HashMap::map_keys(HashMap::map_from_entries([("b", 2), ("a", 1)]))
  ["a", "b"]
  """
  @builtin def map_keys(map: HashMap<$V>) -> List<String>

  @doc """
  Return values in the same deterministic order as `map_keys(map)`.
  ## REPL
  xldr(1)> HashMap::map_values_list(HashMap::map_from_entries([("b", 2), ("a", 1)]))
  [1, 2]
  """
  @builtin def map_values_list(map: HashMap<$V>) -> List<$V>

  @doc """
  Return `(key, value)` entries in deterministic key-sorted order.
  ## REPL
  xldr(1)> HashMap::entries(HashMap::map_from_entries([("b", 2), ("a", 1)]))
  [("a", 1), ("b", 2)]
  """
  def entries(map: HashMap<$V>) -> List<(String, $V)> {
    List::zip(map_keys(map), map_values_list(map))
  }

  @doc """
  Return a new map with the same keys and transformed values.
  The visible order remains deterministic and sorted by key.
  ## REPL
  xldr(1)> HashMap::map_values(HashMap::map_from_entries([("a", 1), ("b", 2)]), {|n| n + 1})
  hash!["a" => 2, "b" => 3]
  """
  def map_values(map: HashMap<$A>, f: ($A -> $B)) -> HashMap<$B> {
    _map_values_go(map, map_keys(map), f, empty_map())
  }
}
