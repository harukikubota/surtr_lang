    f1: ($A1, $B1 -> $C1),
    f2: ($A2, $B2 -> $C2),
    f3: ($A3, $B3 -> $C3),
    f4: ($A4, $B4 -> $C4),
    f5: ($A5, $B5 -> $C5),
    f6: ($A6, $B6 -> $C6),
