@doc """
Standard tuple comparison helpers.
Surtr provides lexicographic `Compare` implementations for tuple arities 2
through 8.
Tuples with 9 or more elements are not covered by the standard library in this
version. Define your own `impl Compare for (...)` or nest tuples to stay within
the provided arity range.
"""
impl Compare for ($A0, $A1)
where
  $A0: Compare
  $A1: Compare
{
  def compare::<Self>(self: Self, rhs: Self) -> Ordering {
    match Compare::compare(self._0, rhs._0) {
      Ordering::Equal => Compare::compare(self._1, rhs._1),
      ordering => ordering,
    }
  }
}

impl Compare for ($A0, $A1, $A2)
where
  $A0: Compare
  $A1: Compare
  $A2: Compare
{
  def compare::<Self>(self: Self, rhs: Self) -> Ordering {
    match Compare::compare(self._0, rhs._0) {
      Ordering::Equal => match Compare::compare(self._1, rhs._1) {
        Ordering::Equal => Compare::compare(self._2, rhs._2),
        ordering => ordering,
      },
      ordering => ordering,
    }
  }
}

impl Compare for ($A0, $A1, $A2, $A3)
where
  $A0: Compare
  $A1: Compare
  $A2: Compare
  $A3: Compare
{
  def compare::<Self>(self: Self, rhs: Self) -> Ordering {
    match Compare::compare(self._0, rhs._0) {
      Ordering::Equal => match Compare::compare(self._1, rhs._1) {
        Ordering::Equal => match Compare::compare(self._2, rhs._2) {
          Ordering::Equal => Compare::compare(self._3, rhs._3),
          ordering => ordering,
        },
        ordering => ordering,
      },
      ordering => ordering,
    }
  }
}

impl Compare for ($A0, $A1, $A2, $A3, $A4)
where
  $A0: Compare
  $A1: Compare
  $A2: Compare
  $A3: Compare
  $A4: Compare
{
  def compare::<Self>(self: Self, rhs: Self) -> Ordering {
    match Compare::compare(self._0, rhs._0) {
      Ordering::Equal => match Compare::compare(self._1, rhs._1) {
        Ordering::Equal => match Compare::compare(self._2, rhs._2) {
          Ordering::Equal => match Compare::compare(self._3, rhs._3) {
            Ordering::Equal => Compare::compare(self._4, rhs._4),
            ordering => ordering,
          },
          ordering => ordering,
        },
        ordering => ordering,
      },
      ordering => ordering,
    }
  }
}

impl Compare for ($A0, $A1, $A2, $A3, $A4, $A5)
where
  $A0: Compare
  $A1: Compare
  $A2: Compare
  $A3: Compare
  $A4: Compare
  $A5: Compare
{
  def compare::<Self>(self: Self, rhs: Self) -> Ordering {
    match Compare::compare(self._0, rhs._0) {
      Ordering::Equal => match Compare::compare(self._1, rhs._1) {
        Ordering::Equal => match Compare::compare(self._2, rhs._2) {
          Ordering::Equal => match Compare::compare(self._3, rhs._3) {
            Ordering::Equal => match Compare::compare(self._4, rhs._4) {
              Ordering::Equal => Compare::compare(self._5, rhs._5),
              ordering => ordering,
            },
            ordering => ordering,
          },
          ordering => ordering,
        },
        ordering => ordering,
      },
      ordering => ordering,
    }
  }
}

impl Compare for ($A0, $A1, $A2, $A3, $A4, $A5, $A6)
where
  $A0: Compare
  $A1: Compare
  $A2: Compare
  $A3: Compare
  $A4: Compare
  $A5: Compare
  $A6: Compare
{
  def compare::<Self>(self: Self, rhs: Self) -> Ordering {
    match Compare::compare(self._0, rhs._0) {
      Ordering::Equal => match Compare::compare(self._1, rhs._1) {
        Ordering::Equal => match Compare::compare(self._2, rhs._2) {
          Ordering::Equal => match Compare::compare(self._3, rhs._3) {
            Ordering::Equal => match Compare::compare(self._4, rhs._4) {
              Ordering::Equal => match Compare::compare(self._5, rhs._5) {
                Ordering::Equal => Compare::compare(self._6, rhs._6),
                ordering => ordering,
              },
              ordering => ordering,
            },
            ordering => ordering,
          },
          ordering => ordering,
        },
        ordering => ordering,
      },
      ordering => ordering,
    }
  }
}

impl Compare for ($A0, $A1, $A2, $A3, $A4, $A5, $A6, $A7)
where
  $A0: Compare
  $A1: Compare
  $A2: Compare
  $A3: Compare
  $A4: Compare
  $A5: Compare
  $A6: Compare
  $A7: Compare
{
  def compare::<Self>(self: Self, rhs: Self) -> Ordering {
    match Compare::compare(self._0, rhs._0) {
      Ordering::Equal => match Compare::compare(self._1, rhs._1) {
        Ordering::Equal => match Compare::compare(self._2, rhs._2) {
          Ordering::Equal => match Compare::compare(self._3, rhs._3) {
            Ordering::Equal => match Compare::compare(self._4, rhs._4) {
              Ordering::Equal => match Compare::compare(self._5, rhs._5) {
                Ordering::Equal => match Compare::compare(self._6, rhs._6) {
                  Ordering::Equal => Compare::compare(self._7, rhs._7),
                  ordering => ordering,
                },
                ordering => ordering,
              },
              ordering => ordering,
            },
            ordering => ordering,
          },
          ordering => ordering,
        },
        ordering => ordering,
      },
      ordering => ordering,
    }
  }
}

@doc """
Tuple helper module.

Provides tuple-oriented value helpers and pointwise zip helpers for tuple
arities 2 through 8.
"""
defmod Tuple {
  @doc """
  Swap the positions of a 2-tuple.

  ## REPL
  xldr(1)> Tuple::swap((1, "one"))
  ("one", 1)
  """
  def swap(pair: ($A, $B)) -> ($B, $A) {
    (pair._1, pair._0)
  }

  @doc """
  Apply a unary callable to the first element of a pair.

  ## REPL
  xldr(1)> show_first = Tuple::first(&to_string)
  xldr(2)> show_first((10, "ok"))
  ("10", "ok")
  """
  def first(f: ($A -> $C)) -> (($A, $B) -> ($C, $B)) {
    {|pair: ($A, $B)|
      (left, right) = pair
      (f(left), right)
    }
  }

  @doc """
  Apply a unary callable to the second element of a pair.

  ## REPL
  xldr(1)> len_second = Tuple::second(&String::len)
  xldr(2)> len_second((10, "four"))
  (10, 4)
  """
  def second(f: ($B -> $C)) -> (($A, $B) -> ($A, $C)) {
    {|pair: ($A, $B)|
      (left, right) = pair
      (left, f(right))
    }
  }

  @doc """
  Build one callable that applies two projections to the same input.

  ## REPL
  xldr(1)> pair = Tuple::both(&String::len, {|text: String| text ++ "!"})
  xldr(2)> pair("abc")
  (3, "abc!")
  """
  def both(f: ($A -> $B), g: ($A -> $C)) -> ($A -> ($B, $C)) {
    {|value| (f(value), g(value)) }
  }

  @doc """
  Build one callable that applies three projections to the same input.

  ## REPL
  xldr(1)> triple = Tuple::both3(&String::len, {|text: String| text ++ "!"}, {|text: String| text ++ "?"})
  xldr(2)> triple("abc")
  (3, "abc!", "abc?")
  """
  def both3(f: ($A -> $B), g: ($A -> $C), h: ($A -> $D)) -> ($A -> ($B, $C, $D)) {
    {|value| (f(value), g(value), h(value)) }
  }

  @doc """
  Build one callable that applies four projections to the same input.
  """
  def both4(f: ($A -> $B), g: ($A -> $C), h: ($A -> $D), i: ($A -> $E)) -> ($A -> ($B, $C, $D, $E)) {
    {|value| (f(value), g(value), h(value), i(value)) }
  }

  @doc """
  Build one callable that applies five projections to the same input.
  """
  def both5(f: ($A -> $B), g: ($A -> $C), h: ($A -> $D), i: ($A -> $E), j: ($A -> $F)) -> ($A -> ($B, $C, $D, $E, $F)) {
    {|value| (f(value), g(value), h(value), i(value), j(value)) }
  }

  @doc """
  Build one callable that applies six projections to the same input.
  """
  def both6(f: ($A -> $B), g: ($A -> $C), h: ($A -> $D), i: ($A -> $E), j: ($A -> $F), k: ($A -> $G)) -> ($A -> ($B, $C, $D, $E, $F, $G)) {
    {|value| (f(value), g(value), h(value), i(value), j(value), k(value)) }
  }

  @doc """
  Build one callable that applies seven projections to the same input.
  """
  def both7(f: ($A -> $B), g: ($A -> $C), h: ($A -> $D), i: ($A -> $E), j: ($A -> $F), k: ($A -> $G), l: ($A -> $H)) -> ($A -> ($B, $C, $D, $E, $F, $G, $H)) {
    {|value| (f(value), g(value), h(value), i(value), j(value), k(value), l(value)) }
  }

  @doc """
  Build one callable that applies eight projections to the same input.
  """
  def both8(f: ($A -> $B), g: ($A -> $C), h: ($A -> $D), i: ($A -> $E), j: ($A -> $F), k: ($A -> $G), l: ($A -> $H), m: ($A -> $I)) -> ($A -> ($B, $C, $D, $E, $F, $G, $H, $I)) {
    {|value| (f(value), g(value), h(value), i(value), j(value), k(value), l(value), m(value)) }
  }

  @doc """
  Map two 2-tuples pointwise with one mapper per position.

  ## REPL
  xldr(1)> Tuple::zip_with2((1, 2), (10, 20), {|a, b| a + b}, {|a, b| a + b})
  (11, 22)
  """
  def zip_with2(
    left: ($A0, $A1),
    right: ($B0, $B1),
    f0: ($A0, $B0 -> $C0),
    f1: ($A1, $B1 -> $C1),
  ) -> ($C0, $C1) {
    (f0(left._0, right._0), f1(left._1, right._1))
  }

  @doc """
  Map two 2-tuples pointwise with `Result`-returning mappers.

  ## REPL
  xldr(1)> Tuple::zip_with2_result((1, 2), (10, 20), {|a, b| Ok(a + b)}, {|a, b| Ok(a + b)})
  Ok((11, 22))
  """
  def zip_with2_result(
    left: ($A0, $A1),
    right: ($B0, $B1),
    f0: ($A0, $B0 -> Result<$C0>),
    f1: ($A1, $B1 -> Result<$C1>),
  ) -> Result<($C0, $C1)> {
    c0 =? f0(left._0, right._0)
    c1 =? f1(left._1, right._1)
    Ok((c0, c1))
  }

  @doc """
  Map two 3-tuples pointwise with one mapper per position.
  """
  def zip_with3(
    left: ($A0, $A1, $A2),
    right: ($B0, $B1, $B2),
    f0: ($A0, $B0 -> $C0),
    f1: ($A1, $B1 -> $C1),
    f2: ($A2, $B2 -> $C2),
  ) -> ($C0, $C1, $C2) {
    (f0(left._0, right._0), f1(left._1, right._1), f2(left._2, right._2))
  }

  @doc """
  Map two 3-tuples pointwise with `Result`-returning mappers.
  """
  def zip_with3_result(
    left: ($A0, $A1, $A2),
    right: ($B0, $B1, $B2),
    f0: ($A0, $B0 -> Result<$C0>),
    f1: ($A1, $B1 -> Result<$C1>),
    f2: ($A2, $B2 -> Result<$C2>),
  ) -> Result<($C0, $C1, $C2)> {
    c0 =? f0(left._0, right._0)
    c1 =? f1(left._1, right._1)
    c2 =? f2(left._2, right._2)
    Ok((c0, c1, c2))
  }

  @doc """
  Map two 4-tuples pointwise with one mapper per position.
  """
  def zip_with4(
    left: ($A0, $A1, $A2, $A3),
    right: ($B0, $B1, $B2, $B3),
    f0: ($A0, $B0 -> $C0),
    f1: ($A1, $B1 -> $C1),
    f2: ($A2, $B2 -> $C2),
    f3: ($A3, $B3 -> $C3),
  ) -> ($C0, $C1, $C2, $C3) {
    (f0(left._0, right._0), f1(left._1, right._1), f2(left._2, right._2), f3(left._3, right._3))
  }

  @doc """
  Map two 4-tuples pointwise with `Result`-returning mappers.
  """
  def zip_with4_result(
    left: ($A0, $A1, $A2, $A3),
    right: ($B0, $B1, $B2, $B3),
    f0: ($A0, $B0 -> Result<$C0>),
    f1: ($A1, $B1 -> Result<$C1>),
    f2: ($A2, $B2 -> Result<$C2>),
    f3: ($A3, $B3 -> Result<$C3>),
  ) -> Result<($C0, $C1, $C2, $C3)> {
    c0 =? f0(left._0, right._0)
    c1 =? f1(left._1, right._1)
    c2 =? f2(left._2, right._2)
    c3 =? f3(left._3, right._3)
    Ok((c0, c1, c2, c3))
  }

  @doc """
  Map two 5-tuples pointwise with one mapper per position.
  """
  def zip_with5(
    left: ($A0, $A1, $A2, $A3, $A4),
    right: ($B0, $B1, $B2, $B3, $B4),
    f0: ($A0, $B0 -> $C0),
    f1: ($A1, $B1 -> $C1),
    f2: ($A2, $B2 -> $C2),
    f3: ($A3, $B3 -> $C3),
    f4: ($A4, $B4 -> $C4),
  ) -> ($C0, $C1, $C2, $C3, $C4) {
    (f0(left._0, right._0), f1(left._1, right._1), f2(left._2, right._2), f3(left._3, right._3), f4(left._4, right._4))
  }

  @doc """
  Map two 5-tuples pointwise with `Result`-returning mappers.
  """
  def zip_with5_result(
    left: ($A0, $A1, $A2, $A3, $A4),
    right: ($B0, $B1, $B2, $B3, $B4),
    f0: ($A0, $B0 -> Result<$C0>),
    f1: ($A1, $B1 -> Result<$C1>),
    f2: ($A2, $B2 -> Result<$C2>),
    f3: ($A3, $B3 -> Result<$C3>),
    f4: ($A4, $B4 -> Result<$C4>),
  ) -> Result<($C0, $C1, $C2, $C3, $C4)> {
    c0 =? f0(left._0, right._0)
    c1 =? f1(left._1, right._1)
    c2 =? f2(left._2, right._2)
    c3 =? f3(left._3, right._3)
    c4 =? f4(left._4, right._4)
    Ok((c0, c1, c2, c3, c4))
  }

  @doc """
  Map two 6-tuples pointwise with one mapper per position.
  """
  def zip_with6(
    left: ($A0, $A1, $A2, $A3, $A4, $A5),
    right: ($B0, $B1, $B2, $B3, $B4, $B5),
    f0: ($A0, $B0 -> $C0),
    f1: ($A1, $B1 -> $C1),
    f2: ($A2, $B2 -> $C2),
    f3: ($A3, $B3 -> $C3),
    f4: ($A4, $B4 -> $C4),
    f5: ($A5, $B5 -> $C5),
  ) -> ($C0, $C1, $C2, $C3, $C4, $C5) {
    (f0(left._0, right._0), f1(left._1, right._1), f2(left._2, right._2), f3(left._3, right._3), f4(left._4, right._4), f5(left._5, right._5))
  }

  @doc """
  Map two 6-tuples pointwise with `Result`-returning mappers.
  """
  def zip_with6_result(
    left: ($A0, $A1, $A2, $A3, $A4, $A5),
    right: ($B0, $B1, $B2, $B3, $B4, $B5),
    f0: ($A0, $B0 -> Result<$C0>),
    f1: ($A1, $B1 -> Result<$C1>),
    f2: ($A2, $B2 -> Result<$C2>),
    f3: ($A3, $B3 -> Result<$C3>),
    f4: ($A4, $B4 -> Result<$C4>),
    f5: ($A5, $B5 -> Result<$C5>),
  ) -> Result<($C0, $C1, $C2, $C3, $C4, $C5)> {
    c0 =? f0(left._0, right._0)
    c1 =? f1(left._1, right._1)
    c2 =? f2(left._2, right._2)
    c3 =? f3(left._3, right._3)
    c4 =? f4(left._4, right._4)
    c5 =? f5(left._5, right._5)
