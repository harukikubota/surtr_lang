deferror GeneratorExhausted() {
  Self(message: "generator has no next item")
}

@doc """
Standard `Generator` type declaration.
`Generator<$Item>` models a finite lazy sequence and exposes only the item type.
`unfold` stores the state and callable; `next` evaluates the step on demand.
The finite step reports normal termination with `Option::None`.
The public `next` returns `Ok((item, rest))` or `Err(GeneratorExhausted)` at the end.
`Result` and `Option` items remain ordinary data.
The original value is immutable. Pass the returned rest to the next call to
advance the sequence.
Provide a step that eventually returns `None`. The compiler does not prove
termination for an arbitrary step.

## REPL
xldr(1)> Generator::range(1, 3)
Generator(<opaque>)
"""
@builtin type Generator<$Item>

@doc """
Error for a zero step in an integer or character range.
"""
deferror ZeroIntegerRangeStep(step: Int) {
  |step: Int|
  Self(message: "integer range step must not be 0: #{step}", step)
}

deferror ZeroCharacterRangeStep(step: Int) {
  |step: Int|
  Self(message: "character range step must not be 0: #{step}", step)
}

@doc """
Error for a character range endpoint that is not a single ASCII character.
"""
deferror CharacterRangeStartLengthInvalid(value: String) {
  |value: String|
  Self(message: "start must be a single character: #{inspect(value)}", value)
}

deferror CharacterRangeStartNonAscii(value: String) {
  |value: String|
  Self(message: "start must be a single ASCII character: #{inspect(value)}", value)
}

deferror CharacterRangeStopLengthInvalid(value: String) {
  |value: String|
  Self(message: "stop must be a single character: #{inspect(value)}", value)
}

deferror CharacterRangeStopNonAscii(value: String) {
  |value: String|
  Self(message: "stop must be a single ASCII character: #{inspect(value)}", value)
}

@doc """
Argument error for a non-positive `take_exact` count.
The count is checked before generating any items.
"""
deferror InvalidGeneratorCount(requested: Int) {
  |requested: Int|
  Self(message: "count must be positive: #{requested}", requested)
}

@doc """
Error for too few items returned by `take_exact`.
The message preserves the requested and actual counts.
"""
deferror GeneratorShortage(requested: Int, actual: Int) {
  |requested: Int, actual: Int|
  Self(message: "requested #{requested} items, got #{actual}", requested, actual)
}

impl Generator {
  # The shared runtime pull protocol uses Option for normal termination.
  # Only the public next API converts that protocol to Result.
  @builtin defp _step(gen: Generator<$Item>) -> Option<($Item, Generator<$Item>)>

  @doc """
  Build a finite sequence from a state and a step returning
  `Some((item, next_state))` or `None`.
  Construction does not evaluate the step. The next state must have the same
  type as the seed.
  ## REPL
  xldr(1)> gen = Generator::unfold(1, {|n| if(n <= 3, Option::Some((n, n + 1)), Option::None)})
  xldr(2)> Generator::to_list(gen)
  [1, 2, 3]
  """
  @builtin def unfold(seed: $State, step: ($State -> Option<($Item, $State)>)) -> Generator<$Item>

  @doc """
  Generate one item and return `Ok((item, rest))`.
  Return `Err(GeneratorExhausted)` on normal termination.
  The original generator is unchanged. A separate call on the same value
  reevaluates the step from its saved state.
  ## REPL
  xldr(1)> Generator::next(Generator::range(10, 12))
  Ok((10, Generator(<opaque>)))
  """
  def next(gen: Generator<$Item>) -> Result<($Item, Generator<$Item>), GeneratorExhausted> {
    match _step(gen) {
      Option::Some(pair) => Ok(pair),
      Option::None => Err(GeneratorExhausted),
    }
  }

  @doc """
  Generate up to `count` items and return `(values, rest)`.
  A shorter finite sequence is a normal result.
  `count <= 0` returns `([], gen)` without evaluation. Reaching the requested
  count does not evaluate another step.
  After normal termination has been observed, the rest is terminal: its `next`
  returns `Err(GeneratorExhausted)` without calling the step.
  ## REPL
  xldr(1)> Generator::take(Generator::range(1, 5), 3)
  ([1, 2, 3], Generator(<opaque>))
  """
  @builtin def take(gen: Generator<$Item>, count: Int) -> (List<$Item>, Generator<$Item>)

  @doc """
  Check that a positive `count` of items was obtained.
  A non-positive count returns `InvalidGeneratorCount` before generation.
  If too few items are available, return `GeneratorShortage` without a list
  or rest. The original generator is unchanged.
  Success does not guarantee that the rest is terminal.
  ## REPL
  xldr(1)> Generator::take_exact(Generator::range(1, 3), 2)
  Ok(([1, 2], Generator(<opaque>)))
  """
  def take_exact(gen: Generator<$Item>, count: Int) -> Result<(List<$Item>, Generator<$Item>)> {
    if(count <= 0,
      Err(InvalidGeneratorCount(count)),
      _take_exact_checked(take(gen, count), count))
  }

  defp _take_exact_checked(pair: (List<$Item>, Generator<$Item>), count: Int) -> Result<(List<$Item>, Generator<$Item>)> {
    actual = List::len(pair._0)
    if(actual == count, Ok(pair), Err(GeneratorShortage(count, actual)))
  }

  @doc """
  Take items while the predicate is `True`, checking each item before adding
  it to the list. The first `False` item is excluded.
  When the predicate returns `False`, the rest starts before that item was generated.
  Reusing the rest reevaluates that position.
  Normal termination returns a terminal rest. No separate stop reason is returned.
  ## REPL
  xldr(1)> Generator::take_while(Generator::range(1, 4), {|n| n < 3})
  ([1, 2], Generator(<opaque>))
  """
  @builtin def take_while(gen: Generator<$Item>, predicate: ($Item -> Boolean)) -> (List<$Item>, Generator<$Item>)

  @doc """
  Take items until the predicate first becomes `True`.
  The stopping item is excluded and remains at the start of the rest.
  ## REPL
  xldr(1)> Generator::take_until(Generator::range(1, 4), {|n| n >= 3})
  ([1, 2], Generator(<opaque>))
  """
  def take_until(gen: Generator<$Item>, predicate: ($Item -> Boolean)) -> (List<$Item>, Generator<$Item>) {
    take_while(gen, {|item| Boolean::not(predicate(item))})
  }

  @doc """
  Generate all remaining items up to normal termination and return a list.
  An empty sequence returns `[]`.
  A runtime failure in the step is not converted to termination or a partial
  successful list. `InfiniteGenerator` is not accepted.
  ## REPL
  xldr(1)> Generator::to_list(Generator::range(1, 3))
  [1, 2, 3]
  """
  @builtin def to_list(gen: Generator<$Item>) -> List<$Item>

  @doc """
  Build an inclusive ascending integer range with unit step.
  `start > stop` produces an empty sequence.
  ## REPL
  xldr(1)> Generator::to_list(Generator::range(1, 3))
  [1, 2, 3]
  """
  @builtin def range(start: Int, stop: Int) -> Generator<Int>

  @doc """
  Build an inclusive integer range with an explicit step.
  A positive step is ascending, a negative step is descending, and zero is an
  argument error. Construction does not generate the sequence.
  ## REPL
  xldr(1)> gen =? Generator::range_step(7, 1, -2)
  xldr(2)> Generator::to_list(gen)
  [7, 5, 3, 1]
  """
  def range_step(start: Int, stop: Int, step: Int) -> Result<Generator<Int>, Error> {
    if(step == 0, Err(ZeroIntegerRangeStep(step)),
      Ok(unfold(start, {|current|
        if(if(step > 0, current <= stop, current >= stop),
          Option::Some((current, current + step)), Option::None)
      })))
  }

  defp _single_ascii_start(value: String) -> Result<Int> {
    if(String::len(value) != 1,
      Err(CharacterRangeStartLengthInvalid(value)),
      match String::codepoints(value, StringEncoding::Ascii) {
        Ok([cp]) => Ok(cp),
        Ok(_) => Err(CharacterRangeStartLengthInvalid(value)),
        Err(_) => Err(CharacterRangeStartNonAscii(value)),
      },
    )
  }

  defp _single_ascii_stop(value: String) -> Result<Int> {
    if(String::len(value) != 1,
      Err(CharacterRangeStopLengthInvalid(value)),
      match String::codepoints(value, StringEncoding::Ascii) {
        Ok([cp]) => Ok(cp),
        Ok(_) => Err(CharacterRangeStopLengthInvalid(value)),
        Err(_) => Err(CharacterRangeStopNonAscii(value)),
      },
    )
  }


  @builtin defp range_char_validated(start: Int, stop: Int, step: Int) -> Generator<String>

  @doc """
  Build an inclusive ascending ASCII character range.
  Endpoints are validated as single ASCII characters before construction.
  The outer `Result` reports input validation; it is not the step protocol.
  ## REPL
  xldr(1)> gen =? Generator::range_char("a", "c")
  xldr(2)> Generator::to_list(gen)
  ["a", "b", "c"]
  """
  def range_char(start: String, stop: String) -> Result<Generator<String>, Error> {
    range_char_step(start, stop, 1)
  }

  defp _range_char_step_checked(start: String, stop: String, step: Int) -> Result<Generator<String>, Error> {
    start_cp =? _single_ascii_start(start)
    stop_cp =? _single_ascii_stop(stop)
    Ok(range_char_validated(start_cp, stop_cp, step))
  }

  @doc """
  Build an inclusive ASCII character range with an explicit step.
  A positive step is ascending and a negative step is descending. Zero is an
  argument error, checked before endpoint validation.
  Validated endpoints are stored; each character is generated when requested.
  ## REPL
  xldr(1)> gen =? Generator::range_char_step("e", "a", -2)
  xldr(2)> Generator::to_list(gen)
  ["e", "c", "a"]
  """
  def range_char_step(start: String, stop: String, step: Int) -> Result<Generator<String>, Error> {
    if(step == 0, Err(ZeroCharacterRangeStep(step)), _range_char_step_checked(start, stop, step))
  }
}
