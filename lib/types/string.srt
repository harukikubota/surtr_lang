@doc """
Standard `String` type declaration.
Text values produced by literals, interpolation, and textual conversion use this
head.
The compiler validates this exact top-level declaration as the canonical
surface shape for strings.
"""
@builtin type String

@doc """
Concrete string-module error for `String::repeat`.
Negative counts stay as recoverable values instead of becoming implicit
runtime traps.
"""
deferror NegativeRepeatCount(count: Int) {
  "repeat count must be non-negative: #{count}"
}

@doc """
Successful result shape for `String::split_once`.
`before` is the text before the first separator match, and `after` is the
remaining suffix after the matched separator.
"""
defenum StringSplit {
  Split(String, String),
}

@doc """
Encoding selector for integer-based string conversion helpers.
`Utf8` treats integers as raw UTF-8 byte values, while `Ascii` restricts the
sequence to 7-bit ASCII.
"""
defenum StringEncoding {
  Utf8,
  Ascii,
}

@doc """
Concrete string-module error for `String::from_chars`.
This keeps invalid "char list" construction explicit when the input contains
elements that are not exactly one surface character.
"""
deferror InvalidCharList(detail: String) {
  detail
}

@doc """
Concrete string-module error for encoding-aware integer conversion helpers.
Used when a string cannot be represented in the selected encoding or when an
integer sequence is not valid for restoration.
"""
deferror InvalidStringEncoding(detail: String) {
  detail
}

@doc """
Concrete string-module error for decimal integer parsing used by `TryFrom<Int>`.
"""
deferror InvalidIntegerLiteral(input: String) {
  "invalid integer literal: #{input}"
}

@doc """
Concrete string-module error for boolean parsing used by `TryFrom<Boolean>`.
"""
deferror InvalidBooleanLiteral(input: String) {
  "invalid boolean literal: #{input}"
}

impl String {
  defp _from_chars_go(chars: List<String>, acc: String) -> String {
    match chars {
      [] => acc,
      [head, ..tail] => _from_chars_go(tail, acc ++ head),
    }
  }

  defp _strip_prefix_chars(values: List<String>, prefix: List<String>) -> Result<List<String>, NoneError> {
    match prefix {
      [] => Ok(values),
      [prefix_head, ..prefix_tail] => match values {
        [] => Err(NoneError),
        [value_head, ..value_tail] => if(
          value_head == prefix_head,
          _strip_prefix_chars(value_tail, prefix_tail),
          Err(NoneError),
        ),
      },
    }
  }

  defp _is_trim_char(value: String) -> Boolean {
    if(
      value == " ",
      True,
      if(value == "\n", True, if(value == "\t", True, value == "\r")),
    )
  }

  defp _trim_start_chars(chars: List<String>) -> List<String> {
    match chars {
      [] => [],
      [head, ..tail] => if(_is_trim_char(head), _trim_start_chars(tail), chars),
    }
  }

  defp _validate_char_list(chars: List<String>, index: Int) -> Result<Unit, InvalidCharList> {
    match chars {
      [] => Ok(()),
      [head, ..tail] => if(
        len(head) == 1,
        _validate_char_list(tail, index + 1),
        Err(InvalidCharList("expected single-character string at index #{index}, got #{inspect(head)}")),
      ),
    }
  }

  defp _split_once_go(value: String, separator: String, prefix_rev: List<String>) -> Result<StringSplit, NoneError> {
    match strip_prefix(value, separator) {
      Ok(after) => Ok(StringSplit::Split(_from_chars_go(List::reverse(prefix_rev), ""), after)),
      Err(_) => match value {
        "" => Err(NoneError),
        [head, ..tail] => _split_once_go(tail, separator, [head, ..prefix_rev]),
      },
    }
  }

  defp _replace_go(value: String, from: String, to: String) -> String {
    match split_once(value, from) {
      Ok(StringSplit::Split(before, after)) => before ++ to ++ _replace_go(after, from, to),
      Err(_) => value,
    }
  }

  defp _strip_trailing_cr(value: String) -> String {
    match strip_suffix(value, "\r") {
      Ok(stripped) => stripped,
      Err(_) => value,
    }
  }

  defp _drop_last(values: List<$A>) -> List<$A> {
    match values {
      [] => [],
      [head, ..tail] => match tail {
        [] => [],
        _ => [head, .._drop_last(tail)],
      },
    }
  }

  defp _parse_negative_decimal(tail: List<String>, input: String) -> Result<Int, InvalidIntegerLiteral> {
    num =? _parse_decimal_go(tail, 0, input)
    Ok(0 - num)
  }

  defp _decimal_digit_value(ch: String, input: String) -> Result<Int, InvalidIntegerLiteral> {
    if(
      ch == "0",
      Ok(0),
      if(
        ch == "1",
        Ok(1),
        if(
          ch == "2",
          Ok(2),
          if(
            ch == "3",
            Ok(3),
            if(
              ch == "4",
              Ok(4),
              if(
                ch == "5",
                Ok(5),
                if(
                  ch == "6",
                  Ok(6),
                  if(
                    ch == "7",
                    Ok(7),
                    if(ch == "8", Ok(8), if(ch == "9", Ok(9), Err(InvalidIntegerLiteral(input)))),
                  ),
                ),
              ),
            ),
          ),
        ),
      ),
    )
  }

  defp _parse_decimal_go(chars: List<String>, acc: Int, input: String) -> Result<Int, InvalidIntegerLiteral> {
    match chars {
      [] => Ok(acc),
      [head, ..tail] => _parse_decimal_cons(head, tail, acc, input),
    }
  }

  defp _parse_decimal_cons(head: String, tail: List<String>, acc: Int, input: String) -> Result<Int, InvalidIntegerLiteral> {
    digit =? _decimal_digit_value(head, input)
    _parse_decimal_go(tail, acc * 10 + digit, input)
  }

  @doc """
  Return `True` when `value` is the empty string.
  ## REPL
  xldr(1)> String::is_empty("")
  True
  """
  def is_empty(value: String) -> Boolean {
    value == ""
  }

  @doc """
  Return `True` when `value` is not the empty string.
  ## REPL
  xldr(1)> String::non_empty("a")
  True
  """
  def non_empty(value: String) -> Boolean {
    value != ""
  }

  @doc """
  Return the number of surface characters in `value`.
  ## REPL
  xldr(1)> String::len("hello")
  5
  """
  @builtin def len(value: String) -> Int

  @doc """
  Wrap `value` with `prefix` and `suffix`.
  ## REPL
  xldr(1)> String::surround("x", "[", "]")
  "[x]"
  """
  def surround(value: String, prefix: String, suffix: String) -> String {
    prefix ++ value ++ suffix
  }

  defp _join_go(parts: List<String>, separator: String, acc: String) -> String {
    match parts {
      [] => acc,
      [head, ..tail] => _join_go(tail, separator, acc ++ separator ++ head),
    }
  }

  @doc """
  Join string elements with `separator`.
  Empty input returns the empty string.
  ## REPL
  xldr(1)> String::join(["a", "b"], ",")
  "a,b"
  """
  def join(parts: List<String>, separator: String) -> String {
    match parts {
      [] => "",
      [head, ..tail] => _join_go(tail, separator, head),
    }
  }

  defp _repeat_go(value: String, remaining: Int, acc: String) -> String {
    if(remaining == 0, acc, _repeat_go(value, remaining - 1, acc ++ value))
  }

  @doc """
  Repeat `value` `count` times.
  Negative counts return `Err(NegativeRepeatCount(...))`.
  ## REPL
  xldr(1)> String::repeat("ha", 3)
  Ok("hahaha")
  """
  def repeat(value: String, count: Int) -> Result<String, NegativeRepeatCount> {
    if(
      count < 0,
      Err(NegativeRepeatCount(count)),
      Ok(_repeat_go(value, count, "")),
    )
  }

  @doc """
  Return `True` when `value` starts with `prefix`.
  The empty prefix always matches.
  ## REPL
  xldr(1)> String::starts_with("hello", "he")
  True
  """
  @builtin def starts_with(value: String, prefix: String) -> Boolean

  @doc """
  Return `True` when `value` ends with `suffix`.
  The empty suffix always matches.
  ## REPL
  xldr(1)> String::ends_with("hello", "lo")
  True
  """
  @builtin def ends_with(value: String, suffix: String) -> Boolean

  @doc """
  Remove `prefix` from the start of `value`.
  Missing prefixes return `Err(NoneError)`.
  ## REPL
  xldr(1)> String::strip_prefix("hello", "he")
  Ok("llo")
  """
  def strip_prefix(value: String, prefix: String) -> Result<String, NoneError> {
    match prefix {
      "" => Ok(value),
      [prefix_head, ..prefix_tail] => match value {
        "" => Err(NoneError),
        [value_head, ..value_tail] => if(
          value_head == prefix_head,
          strip_prefix(value_tail, prefix_tail),
          Err(NoneError),
        ),
      },
    }
  }

  @doc """
  Remove `suffix` from the end of `value`.
  Missing suffixes return `Err(NoneError)`.
  ## REPL
  xldr(1)> String::strip_suffix("hello", "lo")
  Ok("hel")
  """
  def strip_suffix(value: String, suffix: String) -> Result<String, NoneError> {
    reversed_rest =? _strip_prefix_chars(
      List::reverse(chars(value)),
      List::reverse(chars(suffix)),
    )
    Ok(_from_chars_go(List::reverse(reversed_rest), ""))
  }

  @doc """
  Split `value` at the first occurrence of `separator`.
  Success returns `StringSplit::Split(before, after)`.
  Missing separators return `Err(NoneError)`.
  ## REPL
  xldr(1)> String::split_once("a,b", ",")
  Ok(StringSplit::Split("a", "b"))
  """
  def split_once(value: String, separator: String) -> Result<StringSplit, NoneError> {
    _split_once_go(value, separator, [])
  }

  @doc """
  Return `True` when `needle` occurs anywhere inside `value`.
  The empty needle always matches.
  ## REPL
  xldr(1)> String::contains("hello", "ell")
  True
  """
  @builtin def contains(value: String, needle: String) -> Boolean

  @doc """
  Replace every non-overlapping occurrence of `from` with `to`.
  The empty `from` string leaves `value` unchanged.
  ## REPL
  xldr(1)> String::replace("abc", "b", "B")
  "aBc"
  """
  def replace(value: String, from: String, to: String) -> String {
    if(from == "", value, _replace_go(value, from, to))
  }

  @doc """
  Split `value` at every occurrence of `separator`.
  An empty `separator` returns `chars(value)`.
  ## REPL
  xldr(1)> String::split("a,b,c", ",")
  Ok(["a", "b", "c"] )
  """
  def split(value: String, separator: String) -> List<String> {
    if(
      separator == "",
      chars(value),
      match split_once(value, separator) {
        Ok(StringSplit::Split(before, after)) => [before, ..split(after, separator)],
        Err(_) => [value],
      },
    )
  }

  @doc """
  Split `value` into lines.
  Lines are separated by `\n`, and a trailing `\r` in each line is removed.
  A final empty line produced by a trailing newline is omitted.
  ## REPL
  xldr(1)> String::lines("a\nb")
  ["a", "b"]
  """
  def lines(value: String) -> List<String> {
    if(
      value == "",
      [],
      _lines_non_empty(value),
    )
  }

  defp _lines_non_empty(value: String) -> List<String> {
    stripped = List::map(split(value, "\n"), {|line| _strip_trailing_cr(line) })
    if(ends_with(value, "\n"), _drop_last(stripped), stripped)
  }

  @doc """
  Expand `value` into a list of single-character `String` values.
  ## REPL
  xldr(1)> String::chars("ab")
  ["a", "b"]
  """
  def chars(value: String) -> List<String> {
    match value {
      "" => [],
      [head, ..tail] => [head, ..chars(tail)],
    }
  }

  @doc """
  Build a string from a list of single-character strings.
  Non-character elements return `Err(InvalidCharList(...))`.
  ## REPL
  xldr(1)> String::from_chars(["a", "b"])
  Ok("ab")
  """
  def from_chars(chars: List<String>) -> Result<String, InvalidCharList> {
    _validated =? _validate_char_list(chars, 0)
    Ok(_from_chars_go(chars, ""))
  }

  @doc """
  Convert `value` into an encoding-specific integer sequence.
  `Utf8` returns raw byte values.
  `Ascii` returns 7-bit ASCII codes and rejects non-ASCII text.
  ## REPL
  xldr(1)> String::codepoints("AB", StringEncoding::Ascii)
  Ok([65, 66])
  """
  @builtin
  def codepoints(value: String, encoding: StringEncoding) -> Result<List<Int>, InvalidStringEncoding>

  @doc """
  Restore a string from an encoding-specific integer sequence.
  `Utf8` expects raw byte values in the range `0..255`.
  `Ascii` expects byte values in the range `0..127`.
  ## REPL
  xldr(1)> String::from_codepoints([65, 66], StringEncoding::Ascii)
  Ok("AB")
  """
  @builtin
  def from_codepoints(values: List<Int>, encoding: StringEncoding) -> Result<String, InvalidStringEncoding>

  @doc """
  Remove ASCII whitespace from the start of `value`.
  Trimmed characters are space, newline, tab, and carriage return.
  ## REPL
  xldr(1)> String::trim_start("  hi")
  "hi"
  """
  def trim_start(value: String) -> String {
    _from_chars_go(_trim_start_chars(chars(value)), "")
  }

  @doc """
  Remove ASCII whitespace from the end of `value`.
  Trimmed characters are space, newline, tab, and carriage return.
  ## REPL
  xldr(1)> String::trim_end("hi  ")
  "hi"
  """
  def trim_end(value: String) -> String {
    trimmed_rev = _trim_start_chars(List::reverse(chars(value)))
    _from_chars_go(List::reverse(trimmed_rev), "")
  }

  @doc """
  Remove ASCII whitespace from both ends of `value`.
  Trimmed characters are space, newline, tab, and carriage return.
  ## REPL
  xldr(1)> String::trim("  hi  ")
  "hi"
  """
  def trim(value: String) -> String {
    trim_end(trim_start(value))
  }

  @doc """
  Parse `value` as a base-10 `Int`.
  Accepts an optional leading `+` or `-`.
  ## REPL
  xldr(1)> String::try_to_int("42")
  Ok(42)
  """
  def try_to_int(value: String) -> Result<Int, InvalidIntegerLiteral> {
    value_chars = chars(value)
    match value_chars {
      [] => Err(InvalidIntegerLiteral(value)),
      ["-", ..tail] => if(
        List::len(tail) == 0,
        Err(InvalidIntegerLiteral(value)),
        _parse_negative_decimal(tail, value),
      ),
      ["+", ..tail] => if(
        List::len(tail) == 0,
        Err(InvalidIntegerLiteral(value)),
        _parse_decimal_go(tail, 0, value),
      ),
      _ => _parse_decimal_go(value_chars, 0, value),
    }
  }

  @doc """
  Parse `value` as a `Boolean`.
  Accepts `True`, `False`, `true`, and `false`.
  ## REPL
  xldr(1)> String::try_to_boolean("true")
  Ok(True)
  """
  def try_to_boolean(value: String) -> Result<Boolean, InvalidBooleanLiteral> {
    match value {
      "True" | "true" => Ok(True),
      "False" | "false" => Ok(False),
      _ => Err(InvalidBooleanLiteral(value)),
    }
  }
}

impl Show for String {
  @doc """
  Return the string value unchanged.
  ## REPL
  xldr(1)> to_string("abc")
  "abc"
  """
  def to_string(self: Self) -> String {
    self
  }
}

impl From<String> for String {
  @doc """
  Return the value unchanged when converting `String` to `String`.
  ## REPL
  xldr(1)> from("abc", String)
  "abc"
  """
  def from(self: Self, to: TypeRef<String>) -> String {
    self
  }
}

impl TryFrom<Int> for String {
  @doc """
  Parse the string as an `Int`, returning an error result on invalid input.
  ## REPL
  xldr(1)> try_from("42", Int)
  Ok(42)
  """
  def try_from(self: Self, to: TypeRef<Int>) -> Result<Int, Error> {
    String::try_to_int(self)
  }
}

impl TryFrom<Boolean> for String {
  @doc """
  Parse the string as a `Boolean`, returning an error result on invalid input.
  ## REPL
  xldr(1)> try_from("True", Boolean)
  Ok(True)
  """
  def try_from(self: Self, to: TypeRef<Boolean>) -> Result<Boolean, Error> {
    String::try_to_boolean(self)
  }
}

impl Eq for String {
  @doc """
  Return `True` when both string values are equal.
  ## REPL
  xldr(1)> eq("a", "a")
  True
  """
  @builtin def eq(self: Self, rhs: Self) -> Boolean
}

impl Neq for String {
  @doc """
  Return `True` when the string values differ.
  ## REPL
  xldr(1)> neq("a", "b")
  True
  """
  @builtin def neq(self: Self, rhs: Self) -> Boolean
}

impl Concat for String {
  @doc """
  Return the concatenation of the two string values.
  ## REPL
  xldr(1)> concat("ab", "cd")
  "abcd"
  """
  @builtin def concat(self: Self, rhs: Self) -> Self
}
