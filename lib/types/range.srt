@doc """
Standard `Range` data type.
`Range<$A>` stores just two boundary values and does not expand into a list.
The list range literal `[start..stop]` keeps its existing meaning and does not
construct `Range` values.

## REPL
xldr(1)> Range(1, 3)
Range(min: 1, max: 3)
xldr(2)> Range::normalized(3, 1)
Range(min: 1, max: 3)
"""
defstruct Range<$A> {
  min: $A,
  max: $A,
}

impl Range {
  @doc """
  Construct a range while preserving the input order.

  ## REPL
  xldr(1)> Range(3, 1)
  Range(min: 3, max: 1)
  """
  def new(min: $A, max: $A) -> Range<$A> {
    Range { min, max }
  }

  @doc """
  Construct a range whose boundaries are in ascending order according to
  `compare(a, b)`.

  ## REPL
  xldr(1)> Range::normalized(3, 1)
  Range(min: 1, max: 3)
  """
  def normalized(a: $A, b: $A) -> Range<$A>
  where
    $A: Compare
  {
    match compare(a, b) {
      Ordering::Greater => Range { min: b, max: a },
      Ordering::Less | Ordering::Equal => Range { min: a, max: b },
    }
  }

  @doc """
  Return a new integer range shifted forward by `steps`.

  ## REPL
  xldr(1)> Range::advance(Range(1, 3), 2)
  Range(min: 3, max: 5)
  """
  def advance(range: Range<Int>, steps: Int) -> Range<Int> {
    Range { min: range.min + steps, max: range.max + steps }
  }

  @doc """
  Return a new integer range shifted backward by `steps`.

  ## REPL
  xldr(1)> Range::retreat(Range(3, 5), 2)
  Range(min: 1, max: 3)
  """
  def retreat(range: Range<Int>, steps: Int) -> Range<Int> {
    Range { min: range.min - steps, max: range.max - steps }
  }

  @doc """
  Deconstruct a `Range` into `(min, max)` in pattern position.

  ## REPL
  xldr(1)> match Range(1, 3) { Range(min, max) => (min, max) }
  (1, 3)
  """
  defextractor deconstruct(self: Range<$A>) -> Option<($A, $A)> {
    Option::Some((self.min, self.max))
  }
}

impl Eq for Range<$A>
where
  $A: Eq
{
  @doc """
  Return `True` when both boundaries are equal.
  """
  def eq::<Self>(self: Self, rhs: Self) -> Boolean {
    if(Eq::eq(self.min, rhs.min), Eq::eq(self.max, rhs.max), False)
  }

  def neq::<Self>(self: Self, rhs: Self) -> Boolean {
    if(Eq::eq(self.min, rhs.min), Eq::neq(self.max, rhs.max), True)
  }
}

impl Compare for Range<$A>
where
  $A: Compare
{
  @doc """
  Return the lexicographic ordering between two ranges.
  """
  def compare::<Self>(self: Self, rhs: Self) -> Ordering {
    match Compare::compare(self.min, rhs.min) {
      Ordering::Equal => Compare::compare(self.max, rhs.max),
      order => order,
    }
  }
}
