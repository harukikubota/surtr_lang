@doc """
Standard `Result` type declaration.
`Result` represents success-or-error control flow as a value.
The canonical builtin enum surface is `Result<$T>`.
Variable, parameter, field, and callable type annotations use one type argument.
Only a function definition's direct return position may write `Result<$T, E>`
to document its error contract. `NoneError` does not create an annotation exception.
Value inspection uses `Result<$T>`; REPL declaration queries preserve a written
error contract without adding one when it was omitted.
This is the language's Either-oriented success/failure representation.
Its runtime representation is enum-like, but the language treats `Result` as a
dedicated built-in abstraction rather than exposing it as the future general
`Enum` surface.
`Result<$T>` supports `Eq` when `$T: Eq`. `Ok` values compare their contents;
an `Ok` and an `Err` differ; two `Err` values compare only the first concrete
error kind, regardless of message or cause.
"""
@builtin
defenum Result<$T> {
  Ok($T),
  Err(Error),
}

impl Eq for Result<$T>
where
  $T: Eq
{
  def eq(self: Self, rhs: Self) -> Boolean {
    match self {
      Ok(left) => match rhs {
        Ok(right) => Eq::eq(left, right),
        Err(_) => False,
      },
      Err(left) => match rhs {
        Ok(_) => False,
        Err(right) => Error::same_kind(left, right),
      },
    }
  }
}

@autoimport
impl Result {
  defp _all_go(values: List<Result<$A>>, acc_rev: List<$A>) -> Result<List<$A>> {
    match values {
      [] => Ok(List::reverse(acc_rev)),
      [head, ..tail] => _all_cons(head, tail, acc_rev),
    }
  }

  defp _all_cons(head: Result<$A>, tail: List<Result<$A>>, acc_rev: List<$A>) -> Result<List<$A>> {
    value =? head
    _all_go(tail, [value, ..acc_rev])
  }

  @doc """
  Helper for matching on `Result` success vs failure.
  This is not a general-purpose combinator, but it is a common enough pattern that it deserves a helper.
  The `is_ok` name is a bit of a misnomer since it returns `True` for any `Ok(...)` value, even if the inner value is an error type.
  It's really more of an `is_ok_variant` check, but the shorter name is more ergonomic for common use.
  ## REPL
  xldr(1)> Result::is_ok(Ok(1))
  True
  """
  def is_ok(result: Result<$T>) -> Boolean {
    match result {
      Ok(_) => True,
      Err(_) => False,
    }
  }

  @doc """
  Helper for matching on `Result` success vs failure.
  This is not a general-purpose combinator,
  but it is a common enough pattern that it deserves a helper.
  The `is_err` name is a bit of a misnomer since it returns `True` for any `Err(...)` value,
  even if the inner error is an `Ok`-wrapped success type. It's really more of an `is_err_variant` check,
  but the shorter name is more ergonomic for common use.
  ## REPL
  xldr(1)> Result::is_err(Err(NoneError))
  True
  """
  def is_err(result: Result<$T>) -> Boolean {
    Boolean::not(is_ok(result))
  }

  @doc """
  Replace the error branch of a `Result` without preserving the previous cause.

  - `Ok(value)` stays `Ok(value)`
  - `Err(old)` becomes `Err(err)`

  This is a special form. The error argument is declared as `Lazy<Error>` so
  call sites can pass a concrete `deferror` name or constructor directly, or
  reuse an `Error` value already obtained from `Err(e)` pattern matching. The
  expression is evaluated only when `result` is `Err(...)`.

  An error placeholder normalizes to `(-> Error)`. For `Result<Int>`,
  `&Result::map_err(&1, &2)` has the shape
  `(Result<Int>, (-> Error) -> Result<Int>)`, but existing Error restrictions
  prevent calling or forwarding that capture as an ordinary function value.
  Fix the error expression inside the capture to expose only the Result input.

  Use `cause(...)` when the previous error should remain in the chain.
  ## REPL
  xldr(1)> Result::map_err(Err(NoneError), EmptyList)
  Err(EmptyList("Empty List."))
  xldr(2)> replace_error: (Result<Int> -> Result<Int>) = &Result::map_err(&1, EmptyList())
  xldr(3)> replace_error(Ok(1))
  Ok(1)
  """
  @builtin def map_err(result: Result<$T>, err: Lazy<Error>) -> Result<$T>

  @doc """
  Add a higher-level domain error on top of an existing `Err(...)`.

  - `Ok(value)` stays `Ok(value)`
  - `Err(old)` becomes `Err(err)` and the previous error is appended to the new error's cause chain

  This is also a special form. The error argument is surface-typed as
  `Lazy<Error>` so the compiler can delay constructing the new error, or
  forwarding an existing `Error` value, until the input is actually `Err(...)`.

  An error placeholder normalizes to `(-> Error)`. For `Result<Int>`,
  `&Result::cause(&1, &2)` has the shape
  `(Result<Int>, (-> Error) -> Result<Int>)`, which existing Error restrictions
  prevent using as an ordinary function value. Fix the error expression inside
  the capture instead. Unlike `map_err`, the new error keeps the old error in
  its cause chain; the expression still runs only for `Err`.

  This keeps `Error` runtime-managed and opaque while still allowing domain layering.
  ## REPL
  xldr(1)> Result::cause(Ok(1), EmptyList)
  Ok(1)
  xldr(2)> add_cause: (Result<Int> -> Result<Int>) = &Result::cause(&1, EmptyList())
  xldr(3)> add_cause(Ok(1))
  Ok(1)
  """
  @builtin def cause(result: Result<$T>, err: Lazy<Error>) -> Result<$T>

  @doc """
  Sequence a `Result<$T>` with a later `Result<()>` operation.

  - `chain(Ok(value), Ok(()))` returns `Ok(value)`
  - `chain(Ok(_), Err(right))` returns `Err(right)`
  - `chain(Err(left), Ok(()))` returns `Err(left)`
  - `chain(Err(left), Err(right))` returns `Err(right)` and appends `left` to the tail of `right`

  This keeps the success value on the left and uses the right side only for trailing error-capable work.
  ## REPL
  xldr(1)> Result::chain(Ok(1), Ok(()))
  Ok(1)
  """
  @builtin def chain(head: Result<$T>, tail: Result<()>) -> Result<$T>

  @doc """
  Recover from any error without inspecting the concrete error kind.

  The handler body is evaluated only when `value` is `Err(...)`; `Ok(value)`
  returns unchanged.
  ## REPL
  xldr(1)> Result::recover(Err(NoneError), {|| Ok(1)})
  Ok(1)
  """
  def recover(value: Result<$A>, handler: (-> Result<$A>)) -> Result<$A> {
    match value {
      Ok(ok) => Ok(ok),
      Err(_) => handler(),
    }
  }

  @doc """
  Recover from one concrete error kind.

  This is a special form: `marker` has the compiler-reserved `ErrorKind`
  type and accepts only a concrete `deferror` type name, such as `Timeout`,
  including names qualified by a module. Constructor calls, runtime Error
  values, strings, abstract `Error`, and non-error names are rejected.
  The kind marker does not construct an Error and does not depend on the
  constructor's payload arity. In a complete call capture, keep the concrete
  type name in place; a direct placeholder cannot replace the marker.
  Existing restrictions on Error-observing handlers remain in force.
  The handler is evaluated only when
  `value` is `Err(...)` with the same concrete kind.
  ## REPL
  xldr(1)> Result::recover_kind(Err(NoneError), NoneError, {|_| Ok(1)})
  Ok(1)
  """
  @builtin def recover_kind(value: Result<$A>, marker: ErrorKind, handler: (Error -> Result<$A>)) -> Result<$A>

  @doc """
  Bundle two `Result` values into one tuple-shaped `Result`.
  ## REPL
  xldr(1)> Result::zip(Ok(1), Ok(2))
  Ok((1, 2))
  """
  def zip(left: Result<$A>, right: Result<$B>) -> Result<($A, $B)> {
    ll =? left
    rr =? right
    Ok((ll, rr))
  }

  @doc """
  Bundle three `Result` values into one tuple-shaped `Result`.
  ## REPL
  xldr(1)> Result::zip3(Ok(1), Ok(2), Ok(3))
  Ok((1, 2, 3))
  """
  def zip3(a: Result<$A>, b: Result<$B>, c: Result<$C>) -> Result<($A, $B, $C)> {
    aa =? a
    bb =? b
    cc =? c
    Ok((aa, bb, cc))
  }

  @doc """
  Convert `List<Result<$A>>` into `Result<List<$A>>`.
  ## REPL
  xldr(1)> Result::all([Ok(1), Ok(2)])
  Ok([1, 2])
  """
  def all(values: List<Result<$A>>) -> Result<List<$A>> {
    _all_go(values, [])
  }

  @doc """
  Flatten one level of nested `Result`.
  ## REPL
  xldr(1)> Result::flatten(Ok(Ok(1)))
  Ok(1)
  """
  def flatten(value: Result<Result<$A>>) -> Result<$A> {
    inner =? value
    inner
  }

  @doc """
  Observe success values and return the original `Result` unchanged.
  ## REPL
  xldr(1)> Result::tap_ok(Ok(1), {|_| ()})
  Ok(1)
  """
  def tap_ok(value: Result<$A>, f: ($A -> Unit)) -> Result<$A> {
    match value {
      Ok(v) => _tap_ok_value(value, f, v),
      Err(_) => value,
    }
  }

  defp _tap_ok_value(value: Result<$A>, f: ($A -> Unit), inner: $A) -> Result<$A> {
    f(inner)
    value
  }

  @doc """
  Observe failure values and return the original `Result` unchanged.
  ## REPL
  xldr(1)> Result::tap_err(Err(NoneError), {|_| ()})
  Err(NoneError)
  """
  def tap_err(value: Result<$A>, f: (Error -> Unit)) -> Result<$A> {
    match value {
      Ok(_) => value,
      Err(err) => _tap_err_value(value, f, err),
    }
  }

  defp _tap_err_value(value: Result<$A>, f: (Error -> Unit), err: Error) -> Result<$A> {
    f(err)
    value
  }

  @doc """
  Continue with `next` only when the left `Result` is `Ok(...)`.
  ## REPL
  xldr(1)> Result::then(Ok(1), {|| Ok(2)})
  Ok(2)
  """
  def then(value: Result<$A>, next: (-> Result<$B>)) -> Result<$B> {
    _ =? value
    next()
  }
}

@doc """
`Functor` implementation for `Result`.
This is the source-level meaning of `value |*> f`.
"""
impl Functor for Result<$T> {
  @doc """
  Map an `Ok` payload and preserve `Err` values.

  ## REPL
  xldr(1)> Functor::fmap(Ok(2), {|item| item + 1})
  Ok(3)
  """
  def fmap(self: Result<$A>, mapper: ($A -> $B)) -> Result<$B> {
    match self {
      Ok(value) => Ok(mapper(value)),
      _ => self,
    }
  }
}

@doc """
`Applicative` implementation for `Result`.
"""
impl Applicative for Result<$T> {
  @doc """
  Lift a plain value into `Ok`.

  ## REPL
  xldr(1)> value: Result<Int> = Applicative::pure(2)
  xldr(2)> value
  Ok(2)
  """
  def pure::<Result<$T>>(value: $A) -> Result<$A> {
    Ok(value)
  }

  @doc """
  Apply an `Ok` function to an `Ok` payload, preserving the first error.

  ## REPL
  xldr(1)> mapper: Result<(Int -> Int)> = Ok({|item| item + 1})
  xldr(2)> Applicative::ap(mapper, Ok(2))
  Ok(3)
  """
  def ap(mapper: Result<($A -> $B)>, value: Result<$A>) -> Result<$B> {
    match mapper {
      Ok(f) => match value {
        Ok(inner) => Ok(f(inner)),
        _ => value,
      },
      _ => mapper,
    }
  }
}

@doc """
`Monad` implementation for `Result`.
This is the source-level meaning of `value |>= mapper`.
"""
impl Monad for Result<$T> {
  @doc """
  Return a plain value as `Ok`.

  ## REPL
  xldr(1)> value: Result<Int> = Monad::return(2)
  xldr(2)> value
  Ok(2)
  """
  def return::<Result<$T>>(value: $A) -> Result<$A> {
    Ok(value)
  }

  @doc """
  Continue an `Ok` payload with a Result-returning mapper and preserve `Err`.

  ## REPL
  xldr(1)> Monad::bind(Ok(2), {|item| Ok(item + 1)})
  Ok(3)
  """
  def bind(self: Result<$A>, mapper: ($A -> Result<$B>)) -> Result<$B> {
    match self {
      Ok(value) => mapper(value),
      _ => self,
    }
  }
}
