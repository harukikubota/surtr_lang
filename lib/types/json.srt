deferror JsonFieldMissing(key: String) {
  |key: String|
  Self(message: "json field missing at $.#{key}", key)
}

deferror JsonIndexMissing(index: Int) {
  |index: Int|
  Self(message: "json array index missing at $[#{index}]", index)
}

deferror JsonParseDepthLimitExceeded(line: Int, column: Int, depth: Int, limit: Int) {
  |line: Int, column: Int, depth: Int, limit: Int|
  Self(message: "json parse depth #{depth} reached the limit #{limit} at #{line}:#{column}", line, column, depth, limit)
}

@doc """
JSON abstract syntax tree used by the standard library.
`Object` stores values in `HashMap<JsonValue>`, so keys are always `String`
and visible ordering follows the `HashMap` deterministic key order.
`Json::parse` / `Json::stringify` define the text boundary; `Encode` and
`Decode` bridge typed Surtr values to this representation.
"""
defenum JsonValue {
  Null,
  Bool(Boolean),
  Int(Int),
  Float(Float),
  String(String),
  Array(List<JsonValue>),
  Object(HashMap<JsonValue>),
}

@doc """
Error returned when JSON text cannot be parsed.
"""
deferror JsonParseError(line: Int, column: Int, detail: String) {
  |line: Int, column: Int, detail: String|
  Self(message: "json parse error at #{line}:#{column}: #{detail}", line, column, detail)
}

@doc """
Error returned when a `JsonValue` does not match the expected shape.
"""
deferror JsonObjectExpected(path: String, got: String) {
  |path: String, got: String|
  Self(message: "json decode error at #{path}: expected object, got #{got}", path, got)
}

deferror JsonArrayExpected(path: String, got: String) {
  |path: String, got: String|
  Self(message: "json decode error at #{path}: expected array, got #{got}", path, got)
}

deferror JsonStringExpected(path: String, got: String) {
  |path: String, got: String|
  Self(message: "json decode error at #{path}: expected string, got #{got}", path, got)
}

deferror JsonIntExpected(path: String, got: String) {
  |path: String, got: String|
  Self(message: "json decode error at #{path}: expected int, got #{got}", path, got)
}

deferror JsonFloatExpected(path: String, got: String) {
  |path: String, got: String|
  Self(message: "json decode error at #{path}: expected float, got #{got}", path, got)
}

deferror JsonBooleanExpected(path: String, got: String) {
  |path: String, got: String|
  Self(message: "json decode error at #{path}: expected boolean, got #{got}", path, got)
}

@doc """
Error returned when a `JsonValue` cannot be serialized as JSON text.
"""
deferror JsonIntegerOutOfRange(value: Int) {
  |value: Int|
  Self(message: "JSON integer cannot be represented as a JSON number: #{value}", value)
}

defmod Json {
  @doc """
  Parse JSON text into `JsonValue`.
  Integer literals become `JsonValue::Int(Int)`.
  Decimal or exponent literals become `JsonValue::Float(Float)`.
  Malformed user JSON returns `Err(JsonParseError(...))`.
  """
  @builtin def parse(text: String) -> Result<JsonValue>

  @doc """
  Convert `JsonValue` into JSON text.
  Object key order is deterministic and follows `HashMap::entries`.
  Values that cannot be represented by JSON return `Err(JsonIntegerOutOfRange(...))`.
  """
  @builtin def stringify(value: JsonValue) -> Result<String, JsonIntegerOutOfRange>

  @doc """
  Decode JSON text into `JsonValue`.
  This is the public text boundary wrapper around `Json::parse`.
  """
  def decode(text: String) -> Result<JsonValue> {
    Json::parse(text)
  }

  @doc """
  Encode `JsonValue` into JSON text.
  This is the public text boundary wrapper around `Json::stringify`.
  """
  def encode(value: JsonValue) -> Result<String, JsonIntegerOutOfRange> {
    Json::stringify(value)
  }

  @doc """
  Read an object field by key.
  Returns `JsonObjectExpected` for a non-object and `JsonFieldMissing` for a
  missing field.
  """
  def get(value: JsonValue, key: String) -> Result<JsonValue> {
    match value {
      JsonValue::Object(map) => Result::map_err(HashMap::map_get(map, key), JsonFieldMissing(key)),
      other => Err(JsonObjectExpected("$." ++ key, kind(other))),
    }
  }

  @doc """
  Read an array element by index.
  Returns `JsonArrayExpected` for a non-array and `JsonIndexMissing` for a
  missing index.
  """
  def at(value: JsonValue, index: Int) -> Result<JsonValue> {
    match value {
      JsonValue::Array(values) => Result::map_err(List::at(values, index), JsonIndexMissing(index)),
      other => Err(JsonArrayExpected("$[#{index}]", kind(other))),
    }
  }

  @doc """
  Return the JSON kind name used in decode error messages.
  """
  def kind(value: JsonValue) -> String {
    match value {
      JsonValue::Null => "null",
      JsonValue::Bool(_) => "boolean",
      JsonValue::Int(_) => "int",
      JsonValue::Float(_) => "float",
      JsonValue::String(_) => "string",
      JsonValue::Array(_) => "array",
      JsonValue::Object(_) => "object",
    }
  }

  @doc """
  Decode a JSON string value.
  """
  def as_string(value: JsonValue) -> Result<String> {
    match value {
      JsonValue::String(text) => Ok(text),
      other => Err(JsonStringExpected("$", kind(other))),
    }
  }

  @doc """
  Decode a JSON integer value.
  """
  def as_int(value: JsonValue) -> Result<Int> {
    match value {
      JsonValue::Int(n) => Ok(n),
      other => Err(JsonIntExpected("$", kind(other))),
    }
  }

  @doc """
  Decode a JSON floating-point value.
  """
  def as_float(value: JsonValue) -> Result<Float> {
    match value {
      JsonValue::Float(n) => Ok(n),
      other => Err(JsonFloatExpected("$", kind(other))),
    }
  }

  @doc """
  Decode a JSON boolean value.
  """
  def as_bool(value: JsonValue) -> Result<Boolean> {
    match value {
      JsonValue::Bool(value) => Ok(value),
      other => Err(JsonBooleanExpected("$", kind(other))),
    }
  }

  @doc """
  Decode a JSON array value.
  """
  def as_array(value: JsonValue) -> Result<List<JsonValue>> {
    match value {
      JsonValue::Array(values) => Ok(values),
      other => Err(JsonArrayExpected("$", kind(other))),
    }
  }

  @doc """
  Decode a JSON object value.
  """
  def as_object(value: JsonValue) -> Result<HashMap<JsonValue>> {
    match value {
      JsonValue::Object(map) => Ok(map),
      other => Err(JsonObjectExpected("$", kind(other))),
    }
  }
}

impl JsonValue {
  @doc """
  Encode a typed value into `JsonValue`.
  This source-level alias fixes the JSON target and dispatches through
  `Encode<JsonValue> for typeof(value)`.
  """
  def encode(value: $T) -> Result<JsonValue, Error>
  where
    $T: Encode
  {
    Encode::encode::<JsonValue>(value)
  }
}

impl Decode<JsonValue> for String {
  @doc """
  Parse a JSON text string into `JsonValue`.
  """
  def decode::<JsonValue>(self: Self) -> Result<JsonValue, Error> {
    Json::decode(self)
  }
}

impl Decode<String> for JsonValue {
  @doc """
  Decode a `JsonValue::String` through the generic `Decode` trait.
  """
  def decode::<String>(self: Self) -> Result<String, Error> {
    Json::as_string(self)
  }
}

impl Decode<Int> for JsonValue {
  @doc """
  Decode a `JsonValue::Int` through the generic `Decode` trait.
  """
  def decode::<Int>(self: Self) -> Result<Int, Error> {
    Json::as_int(self)
  }
}

impl Decode<Float> for JsonValue {
  @doc """
  Decode a `JsonValue::Float` through the generic `Decode` trait.
  """
  def decode::<Float>(self: Self) -> Result<Float, Error> {
    Json::as_float(self)
  }
}

impl Decode<Boolean> for JsonValue {
  @doc """
  Decode a `JsonValue::Bool` through the generic `Decode` trait.
  """
  def decode::<Boolean>(self: Self) -> Result<Boolean, Error> {
    Json::as_bool(self)
  }
}

impl Encode<JsonValue> for JsonValue {
  @doc """
  Keep an existing `JsonValue` unchanged when encoding to JSON.
  """
  def encode::<JsonValue>(self: Self) -> Result<JsonValue, Error> {
    Ok(self)
  }
}

impl Encode<JsonValue> for String {
  @doc """
  Encode a string as `JsonValue::String`.
  """
  def encode::<JsonValue>(self: Self) -> Result<JsonValue, Error> {
    Ok(JsonValue::String(self))
  }
}

impl Encode<JsonValue> for Int {
  @doc """
  Encode an integer as `JsonValue::Int`.
  """
  def encode::<JsonValue>(self: Self) -> Result<JsonValue, Error> {
    Ok(JsonValue::Int(self))
  }
}

impl Encode<JsonValue> for Float {
  @doc """
  Encode a floating-point value as `JsonValue::Float`.
  """
  def encode::<JsonValue>(self: Self) -> Result<JsonValue, Error> {
    Ok(JsonValue::Float(self))
  }
}

impl Encode<JsonValue> for Boolean {
  @doc """
  Encode a boolean as `JsonValue::Bool`.
  """
  def encode::<JsonValue>(self: Self) -> Result<JsonValue, Error> {
    Ok(JsonValue::Bool(self))
  }
}
