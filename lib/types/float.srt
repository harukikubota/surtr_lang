@doc """
Standard `Float` type declaration.
Floating-point support is implemented, but the exact language contract is still
provisional.
This top-level declaration exists so the rest of the pipeline can talk about
`Float` consistently while the finer contract remains under active review.
"""
@builtin type Float

impl Default for Float {
  def default::<Float>() -> Float { 0.0 }
}

impl Float {
  @doc """
  Divide two float values and return `Err(ZeroDivisionError)` instead of trapping.
  ## REPL
  xldr(1)> Float::safe_div(3.0, 2.0)
  Ok(1.5)
  """
  @builtin def safe_div(a: Float, b: Float) -> Result<Float, ZeroDivisionError>

  @doc """
  Return the absolute value of `value`.
  ## REPL
  xldr(1)> Float::abs(-1.5)
  1.5
  """
  def abs(value: Float) -> Float {
    if(value < 0.0, 0.0 - value, value)
  }

  @doc """
  Return the smaller of `a` and `b`.
  ## REPL
  xldr(1)> Float::min(1.5, 2.0)
  1.5
  """
  def min(a: Float, b: Float) -> Float {
    if(a <= b, a, b)
  }

  @doc """
  Return the larger of `a` and `b`.
  ## REPL
  xldr(1)> Float::max(1.5, 2.0)
  2.0
  """
  def max(a: Float, b: Float) -> Float {
    if(a >= b, a, b)
  }

  @doc """
  Round `value` down to the nearest integer value, keeping the result as `Float`.
  ## REPL
  xldr(1)> Float::floor(1.8)
  1.0
  """
  @builtin def floor(value: Float) -> Float

  @doc """
  Round `value` up to the nearest integer value, keeping the result as `Float`.
  ## REPL
  xldr(1)> Float::ceil(1.2)
  2.0
  """
  @builtin def ceil(value: Float) -> Float

  @doc """
  Round `value` to the nearest integer value, keeping the result as `Float`.
  ## REPL
  xldr(1)> Float::round(1.5)
  2.0
  """
  @builtin def round(value: Float) -> Float

  @doc """
  Drop the fractional part of `value`, keeping the result as `Float`.
  ## REPL
  xldr(1)> Float::trunc(-1.8)
  -1.0
  """
  @builtin def trunc(value: Float) -> Float

  @doc """
  Return the builtin `pi` constant as a finite `Float`.
  ## REPL
  xldr(1)> Float::pi()
  3.141592653589793
  """
  @builtin def pi() -> Float

  @doc """
  Return the builtin `e` constant as a finite `Float`.
  ## REPL
  xldr(1)> Float::e()
  2.718281828459045
  """
  @builtin def e() -> Float
}

impl Add for Float {
  @doc """
  Return the sum of the two float values.
  ## REPL
  xldr(1)> Add::add(1.5, 2.0)
  3.5
  """
  @builtin def add::<Float>(self: Self, rhs: Self) -> Self
}

impl Sub for Float {
  @doc """
  Return the difference of the two float values.
  ## REPL
  xldr(1)> Sub::sub(3.5, 1.0)
  2.5
  """
  @builtin def sub::<Float>(self: Self, rhs: Self) -> Self
}

impl Mul for Float {
  @doc """
  Return the product of the two float values.
  ## REPL
  xldr(1)> Mul::mul(1.5, 2.0)
  3.0
  """
  @builtin def mul::<Float>(self: Self, rhs: Self) -> Self
}

impl Show for Float {
  @doc """
  Return the standard string rendering for `Float`.
  ## REPL
  xldr(1)> to_string(1.5)
  "1.5"
  """
  def to_string::<Float>(self: Self) -> String {
    inspect(self)
  }
}

impl From<Float> for Float {
  @doc """
  Return the value unchanged when converting `Float` to `Float`.
  ## REPL
  xldr(1)> from::<Float>(1.5)
  1.5
  """
  def from::<Float>(self: Self) -> Float {
    self
  }
}

impl From<String> for Float {
  @doc """
  Convert `Float` into its standard string representation.
  ## REPL
  xldr(1)> from::<String>(1.5)
  "1.5"
  """
  def from::<String>(self: Self) -> String {
    to_string(self)
  }
}

impl Eq for Float {
  @doc """
  Return `True` when both float values are equal.
  ## REPL
  xldr(1)> eq(1.5, 1.5)
  True
  """
  @builtin def eq::<Float>(self: Self, rhs: Self) -> Boolean
}

impl Compare for Float {
  @doc """
  Return the three-way ordering between the two float values.
  ## REPL
  xldr(1)> compare(1.5, 2.0)
  Ordering::Less
  """
  @builtin def compare::<Float>(self: Self, rhs: Self) -> Ordering

  @doc """
  Return `True` when the left float is strictly less than the right float.
  ## REPL
  xldr(1)> lt(1.5, 2.0)
  True
  """
  @builtin def lt::<Float>(self: Self, rhs: Self) -> Boolean

  @doc """
  Return `True` when the left float is less than or equal to the right float.
  ## REPL
  xldr(1)> lte(1.5, 1.5)
  True
  """
  @builtin def lte::<Float>(self: Self, rhs: Self) -> Boolean

  @doc """
  Return `True` when the left float is strictly greater than the right float.
  ## REPL
  xldr(1)> gt(2.0, 1.5)
  True
  """
  @builtin def gt::<Float>(self: Self, rhs: Self) -> Boolean

  @doc """
  Return `True` when the left float is greater than or equal to the right float.
  ## REPL
  xldr(1)> gte(2.0, 2.0)
  True
  """
  @builtin def gte::<Float>(self: Self, rhs: Self) -> Boolean
}
