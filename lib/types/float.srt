@@doc """
Standard `Float` type declaration.
Floating-point support is implemented, but the exact language contract is still
provisional.
This top-level declaration exists so the rest of the pipeline can talk about
`Float` consistently while the finer contract remains under active review.
"""
@@builtin type Float

@@doc """
Float module.
Groups float-specific helpers while the exact `Float` contract continues to be
refined.
This module stays intentionally small and focuses on arithmetic helpers that
are independent of rounding-policy decisions.
"""
impl Float {
  @@doc """
  Return the absolute value of `value`.
  ## REPL
  xldr(1)> Float::abs(-1.5)
  1.5
  """
  def abs(value: Float) -> Float {
    if(value < 0.0, 0.0 - value, value)
  }

  @@doc """
  Return the smaller of `a` and `b`.
  ## REPL
  xldr(1)> Float::min(1.5, 2.0)
  1.5
  """
  def min(a: Float, b: Float) -> Float {
    if(a <= b, a, b)
  }

  @@doc """
  Return the larger of `a` and `b`.
  ## REPL
  xldr(1)> Float::max(1.5, 2.0)
  2.0
  """
  def max(a: Float, b: Float) -> Float {
    if(a >= b, a, b)
  }
}

