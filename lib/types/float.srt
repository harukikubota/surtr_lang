  @@doc """
  Divide by `rhs`, returning `Err(ZeroDivisionError)` for zero divisors.
  ## REPL
  xldr(1)> safe_div(3.0, 2.0)
  Ok(1.5)
  """
  def safe_div(self: Self, rhs: Self) -> Result<Self, ZeroDivisionError> {
    safe_div(self, rhs)
  }

  @@doc """
  Return the absolute value of the float.
  ## REPL
  xldr(1)> abs(-1.5)
  1.5
  """
  def abs(self: Self) -> Self {
    Float::abs(self)
