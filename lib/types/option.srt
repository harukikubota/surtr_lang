@doc """
Standard `Option` enum.
`Option<$T>` represents an optional value in user code.
It is not part of Surtr's failure-propagation machinery: `=?` still rejects
`Option`, and missing values only participate in Result control flow after an
explicit conversion.
The type sugar `T?` builds `Option<T>`.
Using `Option<T>` in a struct field is therefore equivalent to using `T?`.
Result-oriented updates still need explicit conversion in and out of `Option`.
`Option` does support the contextual operators `|*>` and `|>=` in its own
container family.

Example:

`user.nickname |> from(Result) |>= normalize_name |> from(Option)`

The equivalent `nickname: String?` field has the same `Option<String>` surface
and uses the same explicit bridge when you want to enter `Result` control flow.

## REPL
xldr(1)> Option::is_some(Option::Some(1))
True
"""
defenum Option<$T> {
  Some($T),
  None,
}

impl Option {
  @doc """
  Return `True` when the option is `Some(...)`.
  ## REPL
  xldr(1)> Option::is_some(Option::Some(1))
  True
  """
  def is_some(value: Option<$T>) -> Boolean {
    match value {
      Option::Some(_) => True,
      Option::None => False,
    }
  }

  @doc """
  Return `True` when the option is `None`.
  ## REPL
  xldr(1)> Option::is_none(Option::None)
  True
  """
  def is_none(value: Option<$T>) -> Boolean {
    Boolean::not(Option::is_some(value))
  }

  @doc """
  Wrap the value in `Option::Some(...)`.
  ## REPL
  xldr(1)> Option::wrap(1)
  Option::Some(1)
  """
  def wrap(value: $T) -> Option<$T> {
    Option::Some(value)
  }

  @doc """
  Apply a `Result`-returning mapper to an optional value while preserving both
  layers of control flow.

  - `Some(value)` and `Ok(mapped)` become `Ok(Some(mapped))`
  - `Some(value)` and `Err(error)` become `Err(error)`
  - `None` becomes `Ok(None)`

  Use this when an optional field needs to participate in a `Result` pipeline
  without converting `None` into `NoneError` or discarding mapper errors.
  """
  def traverse_result(value: Option<$A>, mapper: ($A -> Result<$B>)) -> Result<Option<$B>> {
    match value {
      Option::Some(inner) => match mapper(inner) {
        Ok(mapped) => Ok(Option::Some(mapped)),
        Err(error) => Err(error),
      },
      Option::None => Ok(Option::None),
    }
  }
}

@doc """
`Functor` implementation for `Option`.
This is the source-level meaning of `value |*> f`.
"""
impl Functor for Option<$T> {
  def fmap(self: Option<$A>, mapper: ($A -> $B)) -> Option<$B> {
    match self {
      Option::Some(value) => Option::Some(mapper(value)),
      Option::None => Option::None,
    }
  }
}

@doc """
`Applicative` implementation for `Option`.
"""
impl Applicative for Option<$T> {
  def pure::<Option<$T>>(value: $A) -> Option<$A> {
    Option::Some(value)
  }

  def ap(mapper: Option<($A -> $B)>, value: Option<$A>) -> Option<$B> {
    match mapper {
      Option::Some(f) => match value {
        Option::Some(inner) => Option::Some(f(inner)),
        Option::None => Option::None,
      },
      Option::None => Option::None,
    }
  }
}

@doc """
`Monad` implementation for `Option`.
This is the source-level meaning of `value |>= mapper`.
"""
impl Monad for Option<$T> {
  def return::<Option<$T>>(value: $A) -> Option<$A> {
    Option::Some(value)
  }

  def bind(self: Option<$A>, mapper: ($A -> Option<$B>)) -> Option<$B> {
    match self {
      Option::Some(value) => mapper(value),
      Option::None => Option::None,
    }
  }
}

@doc """
`Alternative` implementation for `Option`.
`<|>` returns the first `Some` value, or its right operand when the left is
`None`.
"""
impl Alternative for Option<$T> {
  def empty::<Option<$T>, $A>() -> Option<$A> {
    Option::None
  }

  def choose(left: Option<$A>, right: Option<$A>) -> Option<$A> {
    match left {
      Option::Some(_) => left,
      Option::None => right,
    }
  }
}

@doc """
`LiftComposable` implementation for `Option`-returning unary functions.
This is the source-level meaning of `left >* right` for `Option`.
"""
impl LiftComposable<$A, $B, $C, Option<$C>> for ($A -> Option<$B>) {
  def lift_compose::<($A -> Option<$B>), $A, $B, $C, Option<$C>>(self: Self, rhs: ($B -> $C)) -> ($A -> Option<$C>) {
    {|value| Functor::fmap(self(value), rhs)}
  }
}

@doc """
`KleisliComposable` implementation for `Option`-returning unary functions.
This is the source-level meaning of `left >=> right` for `Option`.
"""
impl KleisliComposable<$A, $B, Option<$C>> for ($A -> Option<$B>) {
  def kleisli_compose::<($A -> Option<$B>), $A, $B, Option<$C>>(self: Self, rhs: ($B -> Option<$C>)) -> ($A -> Option<$C>) {
    {|value| Monad::bind(self(value), rhs)}
  }
}

impl From<Result<$T>> for Option<$T> {
  @doc """
  Convert `Option<$T>` into `Result<$T>` using `NoneError` for missing values.
  ## REPL
  xldr(1)> from::<Result>(Option::Some(1))
  Ok(1)
  """
  def from::<Result<$T>>(self: Self) -> Result<$T> {
    match self {
      Option::Some(value) => Ok(value),
      Option::None => Err(NoneError),
    }
  }
}

impl From<Option<$T>> for Result<$T> {
  @doc """
  Convert `Result<$T>` into `Option<$T>`, dropping the concrete error value.
  ## REPL
  xldr(1)> from::<Option>(Ok(1))
  Option::Some(1)
  """
  def from::<Option<$T>>(self: Self) -> Option<$T> {
    match self {
      Ok(value) => Option::Some(value),
      Err(_) => Option::None,
    }
  }
}
