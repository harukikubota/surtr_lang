@doc """
Standard `Duration` data type.
`Duration` is an opaque millisecond span used by process and task APIs.
The field stays private so callers construct validated values through `Duration(...)`
or `try_to::<Duration>(...)`, while the `100ms` literal remains syntax sugar.

## REPL
xldr(1)> 250ms
250ms
xldr(2)> Duration(250)
Ok(250ms)
"""
@derive Eq, Compare
defstruct Duration {
  readonly millis: Int,
}

impl Duration {
  @doc """
  Construct a `Duration` from a millisecond count.
  Negative values are rejected with `NegativeDurationMillis`.

  ## REPL
  xldr(1)> Duration(10)
  Ok(10ms)
  xldr(2)> Duration(-1)
  Err(NegativeDurationMillis("duration must be non-negative: -1"))
  """
  def new(value: Int) -> Result<Self, Error> {
    if(
      value < 0,
      Err(NegativeDurationMillis(value)),
      Ok(Duration { millis: value })
    )
  }

  @doc """
  Subtract `rhs` from `self`.
  The `-` operator is intentionally not implemented for `Duration` because
  `Sub` must return `Self`, while duration subtraction can fail.

  ## REPL
  xldr(1)> Duration::sub(20ms, 10ms)
  Ok(10ms)
  xldr(2)> Duration::sub(10ms, 20ms)
  Err(NegativeDurationDifference("duration subtraction would be negative: 10ms - 20ms"))
  """
  def sub(self: Self, rhs: Self) -> Result<Self, Error> {
    if(
      self.millis < rhs.millis,
      Err(NegativeDurationDifference(self.millis, rhs.millis)),
      Duration(self.millis - rhs.millis),
    )
  }

  @doc """
  Deconstruct a `Duration` into its millisecond count in pattern position.

  ## REPL
  xldr(1)> match 20ms { Duration(ms) => ms }
  20
  """
  defextractor deconstruct(self: Self) -> MatchResult<Int> {
    MatchResult::Ok(self.millis)
  }
}

impl Add for Duration {
  @doc """
  Return the sum of two durations.
  ## REPL
  xldr(1)> 10ms + 20ms
  30ms
  """
  def add(self: Self, rhs: Self) -> Self {
    Duration { millis: self.millis + rhs.millis }
  }
}

impl Show for Duration {
  @doc """
  Return the standard string rendering for `Duration`.

  ## REPL
  xldr(1)> to_string(250ms)
  "250ms"
  """
  def to_string(self: Self) -> String {
    inspect(self)
  }
}

deferror NegativeDurationMillis(value: Int) {
  |value: Int|
  Self(message: "duration must be non-negative: #{value}", value)
}

deferror NegativeDurationDifference(lhs_millis: Int, rhs_millis: Int) {
  |lhs_millis: Int, rhs_millis: Int|
  Self(
    message: "duration subtraction would be negative: #{lhs_millis}ms - #{rhs_millis}ms",
    lhs_millis,
    rhs_millis,
  )
}
