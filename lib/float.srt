@@doc """
Standard `Float` type declaration.
Floating-point support is implemented, but the exact language contract is still
provisional.
This top-level declaration exists so the rest of the pipeline can talk about
`Float` consistently while the finer contract remains under active review.
"""
@@builtin type Float

@@doc """
Float module.
Groups float-specific helpers while the exact `Float` contract continues to be
refined.
This module stays intentionally small and focuses on arithmetic helpers that
are independent of rounding-policy decisions.
"""
defmod Float {
  @@doc """
  Return the absolute value of `value`.
  """
  def abs(value: Float) -> Float {
    if(value < 0.0, 0.0 - value, value)
  }

  @@doc """
  Return the smaller of `a` and `b`.
  """
  def min(a: Float, b: Float) -> Float {
    if(a <= b, a, b)
  }

  @@doc """
  Return the larger of `a` and `b`.
  """
  def max(a: Float, b: Float) -> Float {
    if(a >= b, a, b)
  }
}

impl Numeric for Float {
  def add(self: Self, rhs: Self) -> Self {
    self + rhs
  }

  def sub(self: Self, rhs: Self) -> Self {
    self - rhs
  }

  def mul(self: Self, rhs: Self) -> Self {
    self * rhs
  }

  def safe_div(self: Self, rhs: Self) -> Result<Self, ZeroDivisionError> {
    safe_div(self, rhs)
  }

  def abs(self: Self) -> Self {
    Float::abs(self)
  }

  def min(self: Self, rhs: Self) -> Self {
    Float::min(self, rhs)
  }

  def max(self: Self, rhs: Self) -> Self {
    Float::max(self, rhs)
  }
}

impl Show for Float {
  def to_string(self: Self) -> String {
    inspect(self)
  }
}

impl Eq for Float {
  def eq(self: Self, rhs: Self) -> Boolean {
    self == rhs
  }

  def neq(self: Self, rhs: Self) -> Boolean {
    self != rhs
  }
}

impl Ord for Float {
  def lt(self: Self, rhs: Self) -> Boolean {
    self < rhs
  }

  def lte(self: Self, rhs: Self) -> Boolean {
    self <= rhs
  }

  def gt(self: Self, rhs: Self) -> Boolean {
    self > rhs
  }

  def gte(self: Self, rhs: Self) -> Boolean {
    self >= rhs
  }
}
