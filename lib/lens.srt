@@doc """
Standard `Lens` type declaration.
`Lens<S, A>` is a compiler-managed path capability from source `S` to focus `A`.
Lens values are consumed in the same scope via `Lens::view/set/over` and are not
transported as runtime values across function boundaries.
"""
@@builtin type Lens<$S, $A>

@@doc """
Lens module.
Provides compiler-managed path access/update intrinsics:
`view`, `set`, `over`, `compose`.
"""
@@autoimport
defmod Lens {
  @@doc """
  View the focus at `lens` from `source`.
  The declared contract is `Result`-shaped; the compiler refines this in
  Stage1 based on path context.
  """
  @@builtin def view(lens: Lens<$S, $A>, source: $S) -> Result<$A>

  @@doc """
  Replace the focus at `lens` in `source` with `value`.
  Returns the updated source wrapped in `Result`.
  """
  @@builtin def set(lens: Lens<$S, $A>, source: $S, value: $A) -> Result<$S>

  @@doc """
  Update the focus at `lens` in `source` with `update_fun`.
  `update_fun` receives the current focus and returns `Result<$A>`.
  """
  @@builtin def over(lens: Lens<$S, $A>, source: $S, update_fun: ($A -> Result<$A>)) -> Result<$S>

  @@doc """
  Compose two lens paths in sequence.
  `compose(outer, inner)` focuses from `S` to `B` via `A`.
  """
  @@builtin def compose(outer: Lens<$S, $A>, inner: Lens<$A, $B>) -> Lens<$S, $B>
}
