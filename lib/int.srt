@@doc """
Standard `Int` type declaration.
User-visible integer values are backed by arbitrary-precision arithmetic across
the pipeline.
The compiler validates this top-level head as the canonical source-level
contract for integers, so changing the shape here is a compile error rather
than a local library tweak.
"""
@@builtin type Int

@@doc """
Concrete integer-module error for negative bit shift counts.
`Int::shl` and `Int::shr` return this instead of trapping when `bits < 0`.
"""
deferror NegativeShiftCount(bits: Int) {
  "shift amount must be non-negative: #{bits}"
}

@@doc """
Concrete integer-module error for negative bit indexes.
Index-based bit helpers return this instead of trapping when `index < 0`.
"""
deferror NegativeBitIndex(index: Int) {
  "bit index must be non-negative: #{index}"
}

@@doc """
Fixed-width selector for integer bit helpers.
Named variants cover common machine widths, while `Any(bits)` accepts custom
positive widths.
"""
defenum BitWidth {
  W8,
  W16,
  W32,
  W64,
  W128,
  Any(Int),
}

@@doc """
Concrete integer-module error for invalid custom bit widths.
`BitWidth::Any(bits)` must use a positive width.
"""
deferror InvalidBitWidth(width: Int) {
  "bit width must be positive: #{width}"
}

@@doc """
Concrete integer-module error for fixed-width bit indexes outside the available
range.
`index` must satisfy `0 <= index < width`.
"""
deferror BitIndexOutOfRange(index: Int, width: Int) {
  "bit index #{index} out of range for width #{width}"
}

@@doc """
Int module.
Groups integer-specific helpers and arithmetic predicates.
The type declaration lives at the top level of this file, while the module body
is reserved for integer-owned helpers.
"""
defmod Int {
  @@doc """
  Divide two values and return `Err(ZeroDivisionError)` instead of trapping.
  The success case keeps the same value type as the inputs.
  This follows the `Result`/`Either` style of representing failure as a value.
  """
  @@builtin def safe_div(a: $A, b: $A) -> Result<$A, ZeroDivisionError>

  @@doc """
  Compute `a mod b` for integers and return `Err(ZeroDivisionError)` on zero.
  Failure stays on the value side rather than becoming an implicit exception.
  """
  @@builtin def safe_mod(a: Int, b: Int) -> Result<Int, ZeroDivisionError>

  @@doc """
  Return the bitwise AND of `a` and `b`.
  """
  @@builtin
  @@test bit_and(6, 3) == 2
  def bit_and(a: Int, b: Int) -> Int

  @@doc """
  Return the bitwise OR of `a` and `b`.
  """
  @@builtin
  @@test bit_or(6, 3) == 7
  def bit_or(a: Int, b: Int) -> Int

  @@doc """
  Return the bitwise XOR of `a` and `b`.
  """
  @@builtin
  @@test bit_xor(6, 3) == 5
  def bit_xor(a: Int, b: Int) -> Int

  @@doc """
  Return the bitwise complement of `value`.
  """
  @@builtin
  @@test bit_not(0) == -1
  @@test bit_not(6) == -7
  def bit_not(value: Int) -> Int

  @@doc """
  Return whether the bit at `index` is set on `value`.
  Negative bit indexes return `Err(NegativeBitIndex(...))`.
  """
  @@builtin
  @@test inspect(test_bit(5, 0)) == "Ok(True)"
  @@test inspect(test_bit(5, 1)) == "Ok(False)"
  @@test inspect(test_bit(5, 2)) == "Ok(True)"
  @@test inspect(test_bit(5, -1)) == "Err(NegativeBitIndex(\"bit index must be non-negative: -1\"))"
  def test_bit(value: Int, index: Int) -> Result<Boolean, NegativeBitIndex>

  @@doc """
  Return `value` with the bit at `index` set.
  Negative bit indexes return `Err(NegativeBitIndex(...))`.
  """
  @@builtin
  @@test inspect(set_bit(0, 1)) == "Ok(2)"
  @@test inspect(set_bit(5, -1)) == "Err(NegativeBitIndex(\"bit index must be non-negative: -1\"))"
  def set_bit(value: Int, index: Int) -> Result<Int, NegativeBitIndex>

  @@doc """
  Return `value` with the bit at `index` cleared.
  Negative bit indexes return `Err(NegativeBitIndex(...))`.
  """
  @@builtin
  @@test inspect(clear_bit(7, 1)) == "Ok(5)"
  @@test inspect(clear_bit(5, -1)) == "Err(NegativeBitIndex(\"bit index must be non-negative: -1\"))"
  def clear_bit(value: Int, index: Int) -> Result<Int, NegativeBitIndex>

  @@doc """
  Return `value` with the bit at `index` toggled.
  Negative bit indexes return `Err(NegativeBitIndex(...))`.
  """
  @@builtin
  @@test inspect(toggle_bit(5, 0)) == "Ok(4)"
  @@test inspect(toggle_bit(5, -1)) == "Err(NegativeBitIndex(\"bit index must be non-negative: -1\"))"
  def toggle_bit(value: Int, index: Int) -> Result<Int, NegativeBitIndex>

  def _pow2_go(remaining: Int, acc: Int) -> Int {
    if(remaining == 0, acc, Int::_pow2_go(remaining - 1, acc + acc))
  }

  def _pow2(count: Int) -> Int {
    Int::_pow2_go(count, 1)
  }

  def _positive_mod(value: Int, modulus: Int) -> Int {
    match Int::safe_mod(value, modulus) {
      Ok(rem) => if(rem < 0, rem + modulus, rem),
      Err(_) => 0,
    }
  }

  def _mask_bits(width_bits: Int) -> Int {
    Int::_pow2(width_bits) - 1
  }

  def _wrap_unsigned_bits(value: Int, width_bits: Int) -> Int {
    Int::_positive_mod(value, Int::_pow2(width_bits))
  }

  def _validate_shift_count(bits: Int) -> Result<Int, NegativeShiftCount> {
    if(bits < 0, Err(NegativeShiftCount(bits)), Ok(bits))
  }

  def _validate_fixed_bit_index(index: Int, width_bits: Int) -> Result<Int> {
    if(
      index < 0,
      Err(NegativeBitIndex(index)),
      if(index < width_bits, Ok(index), Err(BitIndexOutOfRange(index, width_bits))),
    )
  }

  def _shr_logical_bits(value: Int, shift: Int, width_bits: Int) -> Int {
    if(
      shift >= width_bits,
      0,
      match Int::safe_div(value, Int::_pow2(shift)) {
        Ok(quotient) => quotient,
        Err(_) => 0,
      },
    )
  }

  @@doc """
  Resolve a `BitWidth` selector to its concrete bit count.
  `BitWidth::Any(bits)` accepts only positive widths.
  """
  @@test inspect(width_bits(BitWidth::W8)) == "Ok(8)"
  @@test inspect(width_bits(BitWidth::Any(24))) == "Ok(24)"
  @@test inspect(width_bits(BitWidth::Any(0))) == "Err(InvalidBitWidth(\"bit width must be positive: 0\"))"
  def width_bits(width: BitWidth) -> Result<Int, InvalidBitWidth> {
    match width {
      BitWidth::W8 => Ok(8),
      BitWidth::W16 => Ok(16),
      BitWidth::W32 => Ok(32),
      BitWidth::W64 => Ok(64),
      BitWidth::W128 => Ok(128),
      BitWidth::Any(bits) => if(bits > 0, Ok(bits), Err(InvalidBitWidth(bits))),
    }
  }

  @@doc """
  Return the all-ones mask for `width`.
  For example, `W8` returns `255`.
  """
  @@test inspect(mask(BitWidth::W8)) == "Ok(255)"
  @@test inspect(mask(BitWidth::Any(5))) == "Ok(31)"
  def mask(width: BitWidth) -> Result<Int, InvalidBitWidth> {
    width_bits =? Int::width_bits(width)
    Ok(Int::_mask_bits(width_bits))
  }

  @@doc """
  Wrap `value` into the unsigned range represented by `width`.
  """
  @@test inspect(wrap_unsigned(-1, BitWidth::W8)) == "Ok(255)"
  @@test inspect(wrap_unsigned(260, BitWidth::W8)) == "Ok(4)"
  def wrap_unsigned(value: Int, width: BitWidth) -> Result<Int, InvalidBitWidth> {
    width_bits =? Int::width_bits(width)
    Ok(Int::_wrap_unsigned_bits(value, width_bits))
  }

  @@doc """
  Wrap `value` into the signed two's-complement range represented by `width`.
  """
  @@test inspect(wrap_signed(255, BitWidth::W8)) == "Ok(-1)"
  @@test inspect(wrap_signed(129, BitWidth::W8)) == "Ok(-127)"
  def wrap_signed(value: Int, width: BitWidth) -> Result<Int, InvalidBitWidth> {
    width_bits =? Int::width_bits(width)
    unsigned = Int::_wrap_unsigned_bits(value, width_bits)
    modulus = Int::_pow2(width_bits)
    sign_bit = Int::_pow2(width_bits - 1)
    Ok(if(unsigned >= sign_bit, unsigned - modulus, unsigned))
  }

  @@doc """
  Return the fixed-width bitwise complement of `value`.
  `value` is first wrapped into the unsigned range of `width`.
  """
  @@test inspect(bit_not_in(6, BitWidth::W8)) == "Ok(249)"
  @@test inspect(bit_not_in(1, BitWidth::Any(5))) == "Ok(30)"
  def bit_not_in(value: Int, width: BitWidth) -> Result<Int, InvalidBitWidth> {
    width_bits =? Int::width_bits(width)
    width_mask = Int::_mask_bits(width_bits)
    wrapped = Int::_wrap_unsigned_bits(value, width_bits)
    Ok(Int::bit_xor(width_mask, wrapped))
  }

  @@doc """
  Return whether the fixed-width bit at `index` is set on `value`.
  Indexes must satisfy `0 <= index < width`.
  """
  @@test inspect(test_bit_in(5, 2, BitWidth::W8)) == "Ok(True)"
  @@test inspect(test_bit_in(5, 8, BitWidth::W8)) == "Err(BitIndexOutOfRange(\"bit index 8 out of range for width 8\"))"
  def test_bit_in(value: Int, index: Int, width: BitWidth) -> Result<Boolean> {
    width_bits =? Int::width_bits(width)
    checked =? Int::_validate_fixed_bit_index(index, width_bits)
    wrapped = Int::_wrap_unsigned_bits(value, width_bits)
    bit_mask = Int::_pow2(checked)
    Ok(Int::bit_and(wrapped, bit_mask) != 0)
  }

  @@doc """
  Return `value` with the fixed-width bit at `index` set.
  Indexes must satisfy `0 <= index < width`.
  """
  @@test inspect(set_bit_in(0, 1, BitWidth::W8)) == "Ok(2)"
  @@test inspect(set_bit_in(0, -1, BitWidth::W8)) == "Err(NegativeBitIndex(\"bit index must be non-negative: -1\"))"
  def set_bit_in(value: Int, index: Int, width: BitWidth) -> Result<Int> {
    width_bits =? Int::width_bits(width)
    checked =? Int::_validate_fixed_bit_index(index, width_bits)
    wrapped = Int::_wrap_unsigned_bits(value, width_bits)
    bit_mask = Int::_pow2(checked)
    Ok(Int::bit_or(wrapped, bit_mask))
  }

  @@doc """
  Return `value` with the fixed-width bit at `index` cleared.
  Indexes must satisfy `0 <= index < width`.
  """
  @@test inspect(clear_bit_in(7, 1, BitWidth::W8)) == "Ok(5)"
  @@test inspect(clear_bit_in(0, 8, BitWidth::W8)) == "Err(BitIndexOutOfRange(\"bit index 8 out of range for width 8\"))"
  def clear_bit_in(value: Int, index: Int, width: BitWidth) -> Result<Int> {
    width_bits =? Int::width_bits(width)
    checked =? Int::_validate_fixed_bit_index(index, width_bits)
    wrapped = Int::_wrap_unsigned_bits(value, width_bits)
    bit_mask = Int::_pow2(checked)
    clear_mask = Int::bit_xor(Int::_mask_bits(width_bits), bit_mask)
    Ok(Int::bit_and(wrapped, clear_mask))
  }

  @@doc """
  Return `value` with the fixed-width bit at `index` toggled.
  Indexes must satisfy `0 <= index < width`.
  """
  @@test inspect(toggle_bit_in(5, 0, BitWidth::W8)) == "Ok(4)"
  @@test inspect(toggle_bit_in(5, 8, BitWidth::W8)) == "Err(BitIndexOutOfRange(\"bit index 8 out of range for width 8\"))"
  def toggle_bit_in(value: Int, index: Int, width: BitWidth) -> Result<Int> {
    width_bits =? Int::width_bits(width)
    checked =? Int::_validate_fixed_bit_index(index, width_bits)
    wrapped = Int::_wrap_unsigned_bits(value, width_bits)
    bit_mask = Int::_pow2(checked)
    Ok(Int::bit_xor(wrapped, bit_mask))
  }

  @@doc """
  Shift `value` left inside the unsigned range represented by `width`.
  Negative shift counts return `Err(NegativeShiftCount(...))`.
  """
  @@test inspect(shl_in(255, 1, BitWidth::W8)) == "Ok(254)"
  @@test inspect(shl_in(1, -1, BitWidth::W8)) == "Err(NegativeShiftCount(\"shift amount must be non-negative: -1\"))"
  def shl_in(value: Int, bits: Int, width: BitWidth) -> Result<Int> {
    width_bits =? Int::width_bits(width)
    shift =? Int::_validate_shift_count(bits)
    wrapped = Int::_wrap_unsigned_bits(value, width_bits)
    Ok(Int::_wrap_unsigned_bits(wrapped * Int::_pow2(shift), width_bits))
  }

  @@doc """
  Shift `value` right logically inside the unsigned range represented by `width`.
  Negative shift counts return `Err(NegativeShiftCount(...))`.
  """
  @@test inspect(shr_logical_in(-1, 1, BitWidth::W8)) == "Ok(127)"
  @@test inspect(shr_logical_in(1, -1, BitWidth::W8)) == "Err(NegativeShiftCount(\"shift amount must be non-negative: -1\"))"
  def shr_logical_in(value: Int, bits: Int, width: BitWidth) -> Result<Int> {
    width_bits =? Int::width_bits(width)
    shift =? Int::_validate_shift_count(bits)
    wrapped = Int::_wrap_unsigned_bits(value, width_bits)
    Ok(Int::_shr_logical_bits(wrapped, shift, width_bits))
  }

  @@doc """
  Rotate `value` left inside the unsigned range represented by `width`.
  Negative shift counts return `Err(NegativeShiftCount(...))`.
  """
  @@test inspect(rotl_in(129, 1, BitWidth::W8)) == "Ok(3)"
  @@test inspect(rotl_in(17, 1, BitWidth::Any(5))) == "Ok(3)"
  def rotl_in(value: Int, bits: Int, width: BitWidth) -> Result<Int> {
    width_bits =? Int::width_bits(width)
    shift =? Int::_validate_shift_count(bits)
    normalized = Int::_positive_mod(shift, width_bits)
    wrapped = Int::_wrap_unsigned_bits(value, width_bits)
    left = Int::_wrap_unsigned_bits(wrapped * Int::_pow2(normalized), width_bits)
    right = Int::_shr_logical_bits(wrapped, width_bits - normalized, width_bits)
    Ok(Int::bit_or(left, right))
  }

  @@doc """
  Rotate `value` right inside the unsigned range represented by `width`.
  Negative shift counts return `Err(NegativeShiftCount(...))`.
  """
  @@test inspect(rotr_in(129, 1, BitWidth::W8)) == "Ok(192)"
  @@test inspect(rotr_in(1, -1, BitWidth::W8)) == "Err(NegativeShiftCount(\"shift amount must be non-negative: -1\"))"
  def rotr_in(value: Int, bits: Int, width: BitWidth) -> Result<Int> {
    width_bits =? Int::width_bits(width)
    shift =? Int::_validate_shift_count(bits)
    normalized = Int::_positive_mod(shift, width_bits)
    wrapped = Int::_wrap_unsigned_bits(value, width_bits)
    left = Int::_wrap_unsigned_bits(wrapped * Int::_pow2(width_bits - normalized), width_bits)
    right = Int::_shr_logical_bits(wrapped, normalized, width_bits)
    Ok(Int::bit_or(left, right))
  }

  @@doc """
  Shift `value` left by `bits`.
  Negative shift counts return `Err(NegativeShiftCount(...))`.
  """
  @@builtin
  @@test inspect(shl(1, 1)) == "Ok(2)"
  @@test inspect(shl(1, 4)) == "Ok(16)"
  @@test inspect(shl(8, 2)) == "Ok(32)"
  @@test inspect(shl(1, -1)) == "Err(NegativeShiftCount(\"shift amount must be non-negative: -1\"))"
  def shl(value: Int, bits: Int) -> Result<Int, NegativeShiftCount>

  @@doc """
  Shift `value` right by `bits`.
  Negative shift counts return `Err(NegativeShiftCount(...))`.
  """
  @@builtin
  @@test inspect(shr(1, 1)) == "Ok(0)"
  @@test inspect(shr(16, 2)) == "Ok(4)"
  @@test inspect(shr(1024, 10)) == "Ok(1)"
  @@test inspect(shr(1, -1)) == "Err(NegativeShiftCount(\"shift amount must be non-negative: -1\"))"
  def shr(value: Int, bits: Int) -> Result<Int, NegativeShiftCount>

  @@doc """
  Return the absolute value of `value`.
  """
  def abs(value: Int) -> Int {
    if(value < 0, 0 - value, value)
  }

  @@doc """
  Return the smaller of `a` and `b`.
  """
  def min(a: Int, b: Int) -> Int {
    if(a <= b, a, b)
  }

  @@doc """
  Return the larger of `a` and `b`.
  """
  def max(a: Int, b: Int) -> Int {
    if(a >= b, a, b)
  }

  @@doc """
  Return `-1`, `0`, or `1` depending on the sign of `value`.
  """
  def sign(value: Int) -> Int {
    if(value < 0, -1, if(value > 0, 1, 0))
  }

  @@doc """
  Return `True` when `value` is divisible by two.
  """
  def is_even(value: Int) -> Boolean {
    match Int::safe_mod(value, 2) {
      Ok(rem) => rem == 0,
      Err(_) => False,
    }
  }

  @@doc """
  Return `True` when `value` is not divisible by two.
  """
  def is_odd(value: Int) -> Boolean {
    match Int::safe_mod(value, 2) {
      Ok(rem) => rem != 0,
      Err(_) => False,
    }
  }
}

impl Numeric for Int {
  def add(self: Self, rhs: Self) -> Self {
    self + rhs
  }

  def sub(self: Self, rhs: Self) -> Self {
    self - rhs
  }

  def mul(self: Self, rhs: Self) -> Self {
    self * rhs
  }

  def safe_div(self: Self, rhs: Self) -> Result<Self, ZeroDivisionError> {
    Int::safe_div(self, rhs)
  }

  def abs(self: Self) -> Self {
    Int::abs(self)
  }

  def min(self: Self, rhs: Self) -> Self {
    Int::min(self, rhs)
  }

  def max(self: Self, rhs: Self) -> Self {
    Int::max(self, rhs)
  }
}

impl Show for Int {
  def to_string(self: Self) -> String {
    inspect(self)
  }
}

impl From<Int> for Int {
  def from(self: Self, to: TypeRef<Int>) -> Int {
    self
  }
}

impl From<String> for Int {
  def from(self: Self, to: TypeRef<String>) -> String {
    to_string(self)
  }
}

impl Eq for Int {
  def eq(self: Self, rhs: Self) -> Boolean {
    self == rhs
  }

  def neq(self: Self, rhs: Self) -> Boolean {
    self != rhs
  }
}

impl Ord for Int {
  def lt(self: Self, rhs: Self) -> Boolean {
    self < rhs
  }

  def lte(self: Self, rhs: Self) -> Boolean {
    self <= rhs
  }

  def gt(self: Self, rhs: Self) -> Boolean {
    self > rhs
  }

  def gte(self: Self, rhs: Self) -> Boolean {
    self >= rhs
  }
}
