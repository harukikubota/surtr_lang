@@doc """
Standard `Boolean` type declaration.
Represents `True` and `False`, the values used by `if` and boolean `match`.
This exact top-level declaration is part of the compiler-checked builtin type
contract.
"""
@@builtin type Boolean

@@doc """
Boolean module.
Groups boolean-specific helpers and connective-style combinators.
"""
defmod Boolean {
  @@doc """
  Return the logical negation of `value`.
  """
  def not(value: Boolean) -> Boolean {
    if(value, False, True)
  }

  @@doc """
  Return `True` when exactly one input is `True`.
  """
  def xor(left: Boolean, right: Boolean) -> Boolean {
    if(left, not(right), right)
  }

  @@doc """
  Return `True` when both inputs have the same truth value.
  """
  def eqv(left: Boolean, right: Boolean) -> Boolean {
    if(left, right, not(right))
  }

  @@doc """
  Return material implication `left -> right`.
  """
  def implies(left: Boolean, right: Boolean) -> Boolean {
    if(left, right, True)
  }
}

impl Show for Boolean {
  def to_string(self: Self) -> String {
    inspect(self)
  }
}

impl From<Boolean> for Boolean {
  def from(self: Self, to: TypeRef<Boolean>) -> Boolean {
    self
  }
}

impl From<String> for Boolean {
  def from(self: Self, to: TypeRef<String>) -> String {
    to_string(self)
  }
}

impl Eq for Boolean {
  def eq(self: Self, rhs: Self) -> Boolean {
    self == rhs
  }

  def neq(self: Self, rhs: Self) -> Boolean {
    self != rhs
  }
}
