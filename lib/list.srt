@@doc """
Standard `List` type declaration.
`List` is the homogeneous sequence type used by list literals and list
patterns.
The canonical builtin head is `List<$A>`, and the compiler validates that exact
shape at this file's top level.
"""
@@builtin type List<$A>

@@doc """
List module.
Groups helpers for constructing and transforming list values.
Empty lists usually need a type annotation such as `List<Int>`, and `[]` is the
canonical Nil value.
The type declaration stays top-level while the module body exposes the
list-owned helper surface used by bind/pipeline lowering.
"""
defmod List {
  @@doc """
  Wrap one value into a singleton list.
  This is the value-side constructor counterpart to `[]` as Nil.
  """
  @@builtin def wrap(value: $A) -> List<$A>

  @@doc """
  Map a plain unary callable over each element and keep the list shape.
  This matches the semantics of `|*>` on `List`.
  """
  @@builtin def map(values: List<$A>, f: ($A -> $B)) -> List<$B>

  @@doc """
  Apply a unary callable that itself returns a list and flatten one level.
  This matches the semantics of `|>=` / `|=>` on `List`.
  """
  @@builtin def flat_map(values: List<$A>, f: ($A -> List<$B>)) -> List<$B>
}
