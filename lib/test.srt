@doc """
An assertion failure whose message is the supplied `detail`.
"""
deferror TestAssertionFailed(detail: String) {
  detail
}

import StyledDoc;

@doc """
Build named test suites and check values, errors, documents, and captured I/O.
Available to test files executed by `surtr test`.

`test` and `describe` group cases; `it` records each case's result.
Assertions return `Ok(())` on success or `Err(TestAssertionFailed(...))` on failure.
Tests run serially, with separate stdin, stdout, and stderr buffers for each case.

Example file: `lib/tests/test_examples.srt` (`surtr test test_examples`).

```surtr
import Test;

test("examples") {
  it("adds two values") {
    assert_eq(3, 1 + 2)
  }
  it("checks an expected error") {
    result: Result<Int> = Err(NoneError)
    assert_err_contains("NoneError", result)
  }
}
```
"""
defmod Test {
  @builtin def __test_push(kind: String, name: String) -> Unit
  @builtin def __test_pop() -> Unit
  @builtin def __test_pass(name: String) -> Unit
  @builtin def __test_fail(name: String, detail: String) -> Unit
  @builtin def __test_fail_error(name: String, err: Error) -> Unit
  @builtin def __test_fail_current(detail: String) -> Unit
  @builtin def __test_capture_stdout() -> List<String>
  @builtin def __test_capture_stderr() -> List<String>
  @builtin def __test_push_stdin(input: String) -> Unit
  @builtin def __test_begin_it() -> Unit

  defp _fail(detail: String) -> Result<()> {
    Err(TestAssertionFailed(detail))
  }

  defp _finish_ok() -> Result<()> {
    __test_pop()
    Ok(())
  }

  defp _finish_unexpected_test_error_rendered(rendered: String) -> Result<()> {
    __test_fail_current("unexpected test error: " ++ rendered)
    __test_pop()
    Ok(())
  }

  defp _finish_unexpected_describe_error_rendered(rendered: String) -> Result<()> {
    __test_fail_current("unexpected describe error: " ++ rendered)
    __test_pop()
    Ok(())
  }

  defp _finish_it_ok(name: String) -> Result<()> {
    __test_pass(name)
    Ok(())
  }

  defp _finish_it_err(name: String, err: Error) -> Result<()> {
    __test_fail_error(name, err)
    Ok(())
  }

  defp _assert_err_rendered_contains(fragment: String, rendered: String) -> Result<()> {
    if(
      String::contains(rendered, fragment),
      Ok(()),
      _fail("expected Err containing #{fragment}, got #{rendered}"),
    )
  }

  @doc """
  Run `body` as a named test suite, grouping its case results under `name`.
  A returned `Err` records a suite failure. Returns `Ok(())` after either outcome.
  """
  def test(name: String, body: (-> Result<()>)) -> Result<()> {
    __test_push("test", name)
    result = body()
    match result {
      Ok(_) => _finish_ok(),
      Err(err) => _finish_unexpected_test_error_rendered(inspect(err)),
    }
  }

  @doc """
  Run `body` as a named group within the current suite or group.
  A returned `Err` records a group failure. Returns `Ok(())` after either outcome.
  """
  def describe(name: String, body: (-> Result<()>)) -> Result<()> {
    __test_push("describe", name)
    result = body()
    match result {
      Ok(_) => _finish_ok(),
      Err(err) => _finish_unexpected_describe_error_rendered(inspect(err)),
    }
  }

  @doc """
  Run `body` as one named test case with fresh stdin, stdout, and stderr buffers.
  Record one pass for `Ok(())` or one failure for `Err(error)`.
  Returns `Ok(())` after either result so later cases can run.
  """
  def it(name: String, body: (-> Result<()>)) -> Result<()> {
    __test_begin_it()
    match body() {
      Ok(_) => _finish_it_ok(name),
      Err(err) => _finish_it_err(name, err),
    }
  }

  @doc """
  Check that `flag` is `True`.
  Returns `Ok(())` for `True`, or `Err(TestAssertionFailed(...))` for `False`.

  ```surtr
  import Test;

  test("assert_true") {
    it("accepts a true condition") {
      assert_true(1 < 2)
    }
  }
  ```
  """
  def assert_true(flag: Boolean) -> Result<()> {
    if(flag, Ok(()), _fail("expected True, got False"))
  }

  @doc """
  Check that `flag` is `False`.
  Returns `Ok(())` for `False`, or `Err(TestAssertionFailed(...))` for `True`.

  ```surtr
  import Test;

  test("assert_false") {
    it("accepts a false condition") {
      assert_false(1 > 2)
    }
  }
  ```
  """
  def assert_false(flag: Boolean) -> Result<()> {
    if(flag, _fail("expected False, got True"), Ok(()))
  }

  @doc """
  Check that `actual` equals `expected` according to `Eq`.
  Returns `Ok(())` for equal values, or `Err(TestAssertionFailed(...))` describing the mismatch.

  ```surtr
  import Test;

  test("assert_eq") {
    it("compares the sum with the expected value") {
      assert_eq(3, 1 + 2)
    }
  }
  ```
  """
  def assert_eq(expected: $A, actual: $A) -> Result<()>
  where
    $A: Eq
  {
    if(
      Eq::eq(expected, actual),
      Ok(()),
      Err(TestAssertionFailed("expected #{inspect(expected)}, got #{inspect(actual)}")),
    )
  }

  @doc """
  Check that `result` is `Ok(actual)` and that `actual` equals `expected` according to `Eq`.
  Returns `Ok(())` on a match, or `Err(TestAssertionFailed(...))` for an unequal value or an `Err`.

  ```surtr
  import Test;

  test("assert_ok_eq") {
    it("compares the successful result value") {
      assert_ok_eq(3, Ok(1 + 2))
    }
  }
  ```
  """
  def assert_ok_eq(expected: $A, result: Result<$A>) -> Result<()>
  where
    $A: Eq
  {
    match result {
      Ok(actual) => assert_eq(expected, actual),
      Err(err) => _fail("expected Ok(#{inspect(expected)}), got Err(#{inspect(err)})"),
    }
  }

  @doc """
  Check that `result` is `Err(error)` and `inspect(error)` contains `fragment` as a case-sensitive substring.
  Returns `Ok(())` on a match, or `Err(TestAssertionFailed(...))` for an `Ok` or a missing fragment.

  ```surtr
  import Test;

  test("assert_err_contains") {
    it("checks the expected error text") {
      result: Result<Int> = Err(NoneError)
      assert_err_contains("NoneError", result)
    }
  }
  ```
  """
  def assert_err_contains(fragment: String, result: Result<$A>) -> Result<()> {
    match result {
      Ok(actual) => _fail("expected Err containing #{fragment}, got Ok(#{inspect(actual)})"),
      Err(err) => _assert_err_rendered_contains(fragment, inspect(err)),
    }
  }

  @doc """
  Check that `doc` rendered as plain text equals `expected`.
  Returns `Ok(())` on a match, or `Err(TestAssertionFailed(...))` describing the text mismatch.

  ```surtr
  import Test;
  import StyledDoc;

  test("assert_doc_plain_eq") {
    it("compares text without styling") {
      doc = StyledDoc::bold(StyledDoc::text("hello"))
      assert_doc_plain_eq("hello", doc)
    }
  }
  ```
  """
  def assert_doc_plain_eq(expected: String, doc: StyledDocDoc) -> Result<()> {
    assert_eq(expected, StyledDoc::plain(doc))
  }

  @doc """
  Check that `doc` rendered with ANSI styling equals `expected`, including escape sequences.
  Returns `Ok(())` on a match, or `Err(TestAssertionFailed(...))` describing the text mismatch.

  ```surtr
  import Test;
  import StyledDoc;

  test("assert_doc_ansi_eq") {
    it("compares text with ANSI styling") {
      doc = StyledDoc::bold(StyledDoc::text("hello"))
      assert_doc_ansi_eq("\u{1b}[1mhello\u{1b}[0m", doc)
    }
  }
  ```
  """
  def assert_doc_ansi_eq(expected: String, doc: StyledDocDoc) -> Result<()> {
    assert_eq(expected, StyledDoc::to_ansi(doc))
  }

  @doc """
  Return unread stdout entries from the current test case, in output order, and empty the buffer.
  Entries may contain embedded newlines and include input prompts.
  Includes output since the case began or the last `capture_stdout` or `assert_stdout_eq` call.
  """
  def capture_stdout() -> List<String> {
    __test_capture_stdout()
  }

  @doc """
  Return unread stderr entries from the current test case, in output order, and empty the buffer.
  Entries may contain embedded newlines.
  Includes output since the case began or the last `capture_stderr` or `assert_stderr_eq` call.
  """
  def capture_stderr() -> List<String> {
    __test_capture_stderr()
  }

  @doc """
  Supply text for `IO::get` and `IO::get_line` in the current test case.
  Append `input` without adding a newline and return `Ok(())`.
  After this call, reads use only this buffer and return `Err(InputError(...))` when it is exhausted.
  """
  def push_stdin(input: String) -> Result<()> {
    __test_push_stdin(input)
    Ok(())
  }

  @doc """
  Compare the current case's captured stdout entries with `expected`, in output order.
  Consume the captured entries even when the comparison fails.
  Returns `Ok(())` on a match, or `Err(TestAssertionFailed(...))` describing the mismatch.

  ```surtr
  import Test;

  test("assert_stdout_eq") {
    it("compares captured stdout") {
      print("hello")
      assert_stdout_eq(["hello"])
    }
  }
  ```
  """
  def assert_stdout_eq(expected: List<String>) -> Result<()> {
    assert_eq(expected, __test_capture_stdout())
  }

  @doc """
  Compare the current case's captured stderr entries with `expected`, in output order.
  Consume the captured entries even when the comparison fails.
  Returns `Ok(())` on a match, or `Err(TestAssertionFailed(...))` describing the mismatch.

  ```surtr
  import Test;

  test("assert_stderr_eq") {
    it("compares captured stderr") {
      eprint(NoneError)
      assert_stderr_eq(["Error: NoneError: None Value."])
    }
  }
  ```
  """
  def assert_stderr_eq(expected: List<String>) -> Result<()> {
    assert_eq(expected, __test_capture_stderr())
  }
}
