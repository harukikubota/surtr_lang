@doc """
Recoverable assertion failure raised by the test DSL.
"""
deferror TestAssertionFailed(detail: String) {
  detail
}

import StyledDoc;

@doc """
`surtr test` で使うテスト DSL。

`test`、任意の `describe`、`it` でテストをまとめます。`it` 本文は `Result<()>` を返し、
その Result を一件の成否として記録します。アサーション自体は成否を記録せず、
成功時に `Ok(())`、失敗時に `Err(TestAssertionFailed(...))` を返します。

複数のアサーションは `do::<Result>` で順に実行し、最初の失敗で短絡できます。
通常の本文に並べるだけでは、途中の失敗を捨ててしまいます。

次の例はテストファイルに保存し、`surtr test` で実行します。
`Test` は test サブコマンドで読み込まれるため、通常の REPL では import できません。

```surtr
import Test;

test("examples") {
  it("checks several conditions") {
    do::<Result> {
      assert_true(True)
      assert_eq(3, 1 + 2)
      assert_false(False)
    }
  }
  it("checks an expected error") {
    result: Result<Int> = Err(NoneError)
    assert_err_contains("NoneError", result)
  }
}
```

`do` を使わず、独立したアサーション文の末尾に `?` を付けても失敗を伝播できます。
文末 `?` は成功時に Unit を返すので、すべてのアサーションに付ける場合は
本文の末尾に `Ok(())` を置きます。期待する Err は通常の束縛か直接引数で検証し、
検証対象自体に `?` / `=?` を使いません。

テストは直列に実行し、stdout・stderr・stdin のバッファは `it` ごとに分離します。
"""
defmod Test {
  @builtin def __test_push(kind: String, name: String) -> Unit
  @builtin def __test_pop() -> Unit
  @builtin def __test_pass(name: String) -> Unit
  @builtin def __test_fail(name: String, detail: String) -> Unit
  @builtin def __test_fail_error(name: String, err: Error) -> Unit
  @builtin def __test_fail_current(detail: String) -> Unit
  @builtin def __test_capture_stdout() -> List<String>
  @builtin def __test_capture_stderr() -> List<String>
  @builtin def __test_push_stdin(input: String) -> Unit
  @builtin def __test_begin_it() -> Unit

  defp _fail(detail: String) -> Result<()> {
    Err(TestAssertionFailed(detail))
  }

  defp _finish_ok() -> Result<()> {
    __test_pop()
    Ok(())
  }

  defp _finish_unexpected_test_error_rendered(rendered: String) -> Result<()> {
    __test_fail_current("unexpected test error: " ++ rendered)
    __test_pop()
    Ok(())
  }

  defp _finish_unexpected_describe_error_rendered(rendered: String) -> Result<()> {
    __test_fail_current("unexpected describe error: " ++ rendered)
    __test_pop()
    Ok(())
  }

  defp _finish_it_ok(name: String) -> Result<()> {
    __test_pass(name)
    Ok(())
  }

  defp _finish_it_err(name: String, err: Error) -> Result<()> {
    __test_fail_error(name, err)
    Ok(())
  }

  defp _assert_err_rendered_contains(fragment: String, rendered: String) -> Result<()> {
    if(
      String::contains(rendered, fragment),
      Ok(()),
      _fail("expected Err containing #{fragment}, got #{rendered}"),
    )
  }

  def test(name: String, body: (-> Result<()>)) -> Result<()> {
    __test_push("test", name)
    result = body()
    match result {
      Ok(_) => _finish_ok(),
      Err(err) => _finish_unexpected_test_error_rendered(inspect(err)),
    }
  }

  def describe(name: String, body: (-> Result<()>)) -> Result<()> {
    __test_push("describe", name)
    result = body()
    match result {
      Ok(_) => _finish_ok(),
      Err(err) => _finish_unexpected_describe_error_rendered(inspect(err)),
    }
  }

  @doc """
  本文の `Result<()>` を一件のテスト結果として記録します。
  Err を記録した後も `Ok(())` を返し、次の `it` へ進みます。
  一つの本文に複数のアサーションを書けますが、`do::<Result>`、文末 `?`、
  SafeBind などで最初の失敗を本文から返してください。
  VM の実行異常からの回復は行いません。
  """
  def it(name: String, body: (-> Result<()>)) -> Result<()> {
    __test_begin_it()
    match body() {
      Ok(_) => _finish_it_ok(name),
      Err(err) => _finish_it_err(name, err),
    }
  }

  def assert_true(flag: Boolean) -> Result<()> {
    if(flag, Ok(()), _fail("expected True, got False"))
  }

  def assert_false(flag: Boolean) -> Result<()> {
    if(flag, _fail("expected False, got True"), Ok(()))
  }

  @doc """
  Assert equality through `Eq` for two values of the same static type.
  `inspect` is used only to render a failure message, not to decide equality.
  """
  def assert_eq(expected: $A, actual: $A) -> Result<()>
  where
    $A: Eq
  {
    if(
      Eq::eq(expected, actual),
      Ok(()),
      Err(TestAssertionFailed("expected #{inspect(expected)}, got #{inspect(actual)}")),
    )
  }

  @doc """
  Assert that a result is `Ok(actual)` and that `actual` equals `expected` via `Eq`.
  """
  def assert_ok_eq(expected: $A, result: Result<$A>) -> Result<()>
  where
    $A: Eq
  {
    match result {
      Ok(actual) => assert_eq(expected, actual),
      Err(err) => _fail("expected Ok(#{inspect(expected)}), got Err(#{inspect(err)})"),
    }
  }

  def assert_err_contains(fragment: String, result: Result<$A>) -> Result<()> {
    match result {
      Ok(actual) => _fail("expected Err containing #{fragment}, got Ok(#{inspect(actual)})"),
      Err(err) => _assert_err_rendered_contains(fragment, inspect(err)),
    }
  }

  def assert_doc_plain_eq(expected: String, doc: StyledDocDoc) -> Result<()> {
    assert_eq(expected, StyledDoc::plain(doc))
  }

  def assert_doc_ansi_eq(expected: String, doc: StyledDocDoc) -> Result<()> {
    assert_eq(expected, StyledDoc::to_ansi(doc))
  }

  @doc """
  Drain captured stdout lines produced since the previous capture read.
  Current contract:
  - buffer is backed by the VM standard stdout test handler
  - the buffer is isolated for each `it`
  """
  def capture_stdout() -> List<String> {
    __test_capture_stdout()
  }

  @doc """
  Drain captured stderr lines produced since the previous capture read.
  Shares the same per-`it` handler buffer semantics as `capture_stdout`.
  """
  def capture_stderr() -> List<String> {
    __test_capture_stderr()
  }

  @doc """
  Append text to the current test stdin buffer.
  `IO::get` and `IO::get_line` read this buffer before host stdin.
  """
  def push_stdin(input: String) -> Result<()> {
    __test_push_stdin(input)
    Ok(())
  }

  @doc """
  Assert captured stdout lines equal expected lines.
  """
  def assert_stdout_eq(expected: List<String>) -> Result<()> {
    assert_eq(expected, __test_capture_stdout())
  }

  @doc """
  Assert captured stderr lines equal expected lines.
  """
  def assert_stderr_eq(expected: List<String>) -> Result<()> {
    assert_eq(expected, __test_capture_stderr())
  }
}
