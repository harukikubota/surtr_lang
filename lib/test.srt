@doc """
An assertion failure whose message is the supplied `detail`.
"""
deferror TestAssertionFailed(detail: String) {
  detail
}


@doc """
Build named test suites and check values, errors, documents, and captured I/O.
Available to test files executed by `surtr test`.
assert_err_kind and assert_cause_chain are ordinary names. Their static
ErrorKind argument rules belong only to the standard Test declarations.
User functions with these names follow their own signatures and cannot expose
ErrorKind as an ordinary value.

`test` and `describe` group cases; `it` records each selected case's result.
`xit(name, reason, body)` pauses a case; `pend(name, reason)` declares an unimplemented case.
Reasons must be nonblank. Case declarations inside an executing case are rejected.
Use `--test`, `--describe`, and `--it` for case-sensitive substring filters,
`--include-xit` to run paused cases, and `--deny-pending` to reject selected pending cases.
`--list` skips case bodies but still executes top-level and test/describe traversal.
`--timings` measures executed cases; `--format json` produces one structured report.
`--quiet` suppresses normal details while retaining failures and denied pending cases.
Assertions return `Ok(())` on success or `Err(TestAssertionFailed(...))` on failure.
Tests run serially, with separate stdin, stdout, and stderr buffers for each case.

Example file: `lib/tests/basic_types/int.srt` (`surtr test lib/tests/basic_types/int.srt`).

```surtr
import Test;

test("examples") {
  it("adds two values") {
    assert_eq(3, 1 + 2)
  }
  it("checks an expected error") {
    result: Result<Int> = Err(NoneError)
    assert_err_contains("NoneError", result)
  }
}
```
"""
defmod Test {
  @builtin def __test_push(kind: String, name: String) -> Unit
  @builtin def __test_pop() -> Unit
  @builtin def __test_pass(name: String) -> Unit
  @builtin def __test_fail(name: String, detail: String) -> Unit
  @builtin def __test_fail_error(name: String, err: Error) -> Unit
  @builtin def __test_fail_current(detail: String) -> Unit
  @builtin def __test_capture_stdout() -> List<String>
  @builtin def __test_capture_stderr() -> List<String>
  @builtin def __test_push_stdin(input: String) -> Unit
  @builtin def __test_begin_case(kind: String, name: String, reason: String) -> Boolean

  defp _fail(detail: String) -> Result<()> {
    Err(TestAssertionFailed(detail))
  }

  defp _finish_ok() -> Result<()> {
    __test_pop()
    Ok(())
  }

  defp _finish_unexpected_test_error_rendered(rendered: String) -> Result<()> {
    __test_fail_current("unexpected test error: " ++ rendered)
    __test_pop()
    Ok(())
  }

  defp _finish_unexpected_describe_error_rendered(rendered: String) -> Result<()> {
    __test_fail_current("unexpected describe error: " ++ rendered)
    __test_pop()
    Ok(())
  }

  defp _finish_it_ok(name: String) -> Result<()> {
    __test_pass(name)
    Ok(())
  }

  defp _finish_it_err(name: String, err: Error) -> Result<()> {
    __test_fail_error(name, err)
    Ok(())
  }

  defp _assert_err_rendered_contains(fragment: String, rendered: String) -> Result<()> {
    if(
      String::contains(rendered, fragment),
      Ok(()),
      _fail("expected Err containing #{fragment}, got #{rendered}"),
    )
  }

  @doc """
  Run `body` as a named test suite, grouping its case results under `name`.
  A returned `Err` records a suite failure. Returns `Ok(())` after either outcome.
  """
  def test(name: String, body: (-> Result<()>)) -> Result<()> {
    __test_push("test", name)
    result = body()
    match result {
      Ok(_) => _finish_ok(),
      Err(err) => _finish_unexpected_test_error_rendered(inspect(err)),
    }
  }

  @doc """
  Run `body` as a named group within the current suite or group.
  A returned `Err` records a group failure. Returns `Ok(())` after either outcome.
  """
  def describe(name: String, body: (-> Result<()>)) -> Result<()> {
    __test_push("describe", name)
    result = body()
    match result {
      Ok(_) => _finish_ok(),
      Err(err) => _finish_unexpected_describe_error_rendered(inspect(err)),
    }
  }

  @doc """
  Run a selected `body` as one named test case with fresh stdin, stdout, and stderr buffers.
  Filtered cases and list mode do not execute the body or consume I/O buffers.
  Record one pass for `Ok(())` or one failure for `Err(error)`.
  Returns `Ok(())` after either result so later cases can run.
  """
  def it(name: String, body: (-> Result<()>)) -> Result<()> {
    _case("it", name, "", body)
  }

  defp _case(kind: String, name: String, reason: String, body: (-> Result<()>)) -> Result<()> {
    match __test_begin_case(kind, name, reason) {
      True => match body() {
        Ok(_) => _finish_it_ok(name),
        Err(err) => _finish_it_err(name, err),
      },
      False => Ok(()),
    }
  }

  @doc """
  Declare a paused case with a required nonblank reason.
  The body runs only with `surtr test --include-xit`, subject to name filters.
  Example: `xit("parser", "repairing nesting") { assert_true(True) }`.
  """
  def xit(name: String, reason: String, body: (-> Result<()>)) -> Result<()> {
    _case("xit", name, reason, body)
  }

  @doc """
  Declare an unimplemented case with a required nonblank reason and no body.
  Example: `pend("parser", "implementation pending")`.
  `--deny-pending` rejects selected pending cases, including in list mode.
  """
  def pend(name: String, reason: String) -> Result<()> {
    __test_begin_case("pend", name, reason)
    Ok(())
  }

  @doc """
  Require a true condition with a caller-supplied message.
  Returns `Ok(())` or `Err(TestAssertionFailed(message))`; an empty message is preserved.
  This is an ordinary function. Propagate its Result to fail the current case.

  ```surtr
  import Test;
  test("assert") { it("checks a condition") { assert(1 < 2, "ordered") } }
  ```
  """
  def assert(flag: Boolean, message: String) -> Result<()> {
    Kernel::require(flag, TestAssertionFailed(message))
  }

  @doc """
  Call `predicate(actual)` exactly once and require True.
  The String message is evaluated normally. On failure only, inspect the actual value
  and return `TestAssertionFailed` with the message followed by `actual: ...`.

  ```surtr
  import Test;
  test("assert_satisfies") {
    it("checks a predicate") { assert_satisfies(3, "positive", {|n| n > 0}) }
  }
  ```
  """
  def assert_satisfies(actual: $A, message: String, predicate: ($A -> Boolean)) -> Result<()> {
    Kernel::require(predicate(actual), TestAssertionFailed("#{message}\nactual: #{inspect(actual)}"))
  }

  @doc """
  Require `lhs < rhs` using Compare for two values of the same type.
  Failure reports both values and the expected relation. No Show constraint is required.

  ```surtr
  import Test;
  test("assert_lt") { it("compares values") { assert_lt(1, 2) } }
  ```
  """
  def assert_lt(lhs: $A, rhs: $A) -> Result<()>
  where
    $A: Compare
  {
    Kernel::require(Compare::lt(lhs, rhs), TestAssertionFailed("expected #{inspect(lhs)} < #{inspect(rhs)}"))
  }

  @doc """
  Require `lhs <= rhs` using Compare for two values of the same type.
  Failure reports both values and the expected relation. No Show constraint is required.

  ```surtr
  import Test;
  test("assert_lte") { it("compares values") { assert_lte(2, 2) } }
  ```
  """
  def assert_lte(lhs: $A, rhs: $A) -> Result<()>
  where
    $A: Compare
  {
    Kernel::require(Compare::lte(lhs, rhs), TestAssertionFailed("expected #{inspect(lhs)} <= #{inspect(rhs)}"))
  }

  @doc """
  Require `lhs > rhs` using Compare for two values of the same type.
  Failure reports both values and the expected relation. No Show constraint is required.

  ```surtr
  import Test;
  test("assert_gt") { it("compares values") { assert_gt(2, 1) } }
  ```
  """
  def assert_gt(lhs: $A, rhs: $A) -> Result<()>
  where
    $A: Compare
  {
    Kernel::require(Compare::gt(lhs, rhs), TestAssertionFailed("expected #{inspect(lhs)} > #{inspect(rhs)}"))
  }

  @doc """
  Require `lhs >= rhs` using Compare for two values of the same type.
  Failure reports both values and the expected relation. No Show constraint is required.

  ```surtr
  import Test;
  test("assert_gte") { it("compares values") { assert_gte(2, 2) } }
  ```
  """
  def assert_gte(lhs: $A, rhs: $A) -> Result<()>
  where
    $A: Compare
  {
    Kernel::require(Compare::gte(lhs, rhs), TestAssertionFailed("expected #{inspect(lhs)} >= #{inspect(rhs)}"))
  }

  @doc """
  Require Err and compare only Error::message with the expected String, exactly.
  Error kind, cause, location, and full error rendering do not participate.
  Failure shows expected and actual messages, or the unexpected Ok payload.

  ```surtr
  import Test;
  test("assert_err_message_eq") {
    it("checks only the message") { assert_err_message_eq("detail", Err(TestAssertionFailed("detail"))) }
  }
  ```
  """
  def assert_err_message_eq(expected: String, result: Result<$A>) -> Result<()> {
    match result {
      Err(err) => assert_eq(expected, Error::message(err)),
      Ok(actual) => _fail("expected Err with message #{inspect(expected)}, got Ok(#{inspect(actual)})"),
    }
  }

  @doc """
  Require a case-sensitive literal prefix; an empty prefix always matches.
  Failure shows the expected prefix and the actual String.

  ```surtr
  import Test;
  test("assert_starts_with") { it("matches text") { assert_starts_with("hello", "hello") } }
  ```
  """
  def assert_starts_with(prefix: String, actual: String) -> Result<()> {
    Kernel::require(String::starts_with(actual, prefix), TestAssertionFailed("expected #{inspect(actual)} to start with #{inspect(prefix)}"))
  }

  @doc """
  Require a case-sensitive literal suffix; an empty suffix always matches.
  Failure shows the expected suffix and the actual String.

  ```surtr
  import Test;
  test("assert_ends_with") { it("matches text") { assert_ends_with("hello", "hello") } }
  ```
  """
  def assert_ends_with(suffix: String, actual: String) -> Result<()> {
    Kernel::require(String::ends_with(actual, suffix), TestAssertionFailed("expected #{inspect(actual)} to end with #{inspect(suffix)}"))
  }

  @doc """
  Require only the Some branch, without comparing or extracting its payload.
  Function values and other payloads without Eq are accepted. None fails.

  ```surtr
  import Test;
  test("assert_some") { it("accepts a function") { assert_some(Option::Some({|x: Int| x})) } }
  ```
  """
  def assert_some(option: Option<$A>) -> Result<()> {
    match option {
      Option::Some(_) => Ok(()),
      Option::None => _fail("expected Some, got None"),
    }
  }

  @doc """
  Check that `flag` is `True`.
  Returns `Ok(())` for `True`, or `Err(TestAssertionFailed(...))` for `False`.

  ```surtr
  import Test;

  test("assert_true") {
    it("accepts a true condition") {
      assert_true(1 < 2)
    }
  }
  ```
  """
  def assert_true(flag: Boolean) -> Result<()> {
    if(flag, Ok(()), _fail("expected True, got False"))
  }

  @doc """
  Check that `flag` is `False`.
  Returns `Ok(())` for `False`, or `Err(TestAssertionFailed(...))` for `True`.

  ```surtr
  import Test;

  test("assert_false") {
    it("accepts a false condition") {
      assert_false(1 > 2)
    }
  }
  ```
  """
  def assert_false(flag: Boolean) -> Result<()> {
    if(flag, _fail("expected False, got True"), Ok(()))
  }

  @doc """
  Check that `actual` equals `expected` according to `Eq`.
  Returns `Ok(())` for equal values, or `Err(TestAssertionFailed(...))` describing the mismatch.

  ```surtr
  import Test;

  test("assert_eq") {
    it("compares the sum with the expected value") {
      assert_eq(3, 1 + 2)
    }
  }
  ```
  """
  def assert_eq(expected: $A, actual: $A) -> Result<()>
  where
    $A: Eq
  {
    if(
      Eq::eq(expected, actual),
      Ok(()),
      Err(TestAssertionFailed("expected #{inspect(expected)}, got #{inspect(actual)}")),
    )
  }

  @doc """
  Check that same-typed values differ according to Eq. Inspection is diagnostic only.
  Example: `assert_ne(1, 2)` returns `Ok(())`.
  """
  def assert_ne(expected: $A, actual: $A) -> Result<()>
  where
    $A: Eq
  {
    if(Eq::eq(expected, actual), _fail("expected unequal values, got #{inspect(actual)}"), Ok(()))
  }

  @doc """
  Check only the Ok branch, without requiring Eq for the payload.
  Example: `assert_ok(Ok(3))` returns `Ok(())`.
  """
  def assert_ok(result: Result<$A>) -> Result<()> {
    match result {
      Ok(_) => Ok(()),
      Err(err) => _fail("expected Ok, got Err(#{inspect(err)})"),
    }
  }

  @doc """
  Check only the Err branch, without comparing the error kind or payload.
  Example: `assert_err(Err(NoneError))` returns `Ok(())`.
  """
  def assert_err(result: Result<$A>) -> Result<()> {
    match result {
      Err(_) => Ok(()),
      Ok(actual) => _fail("expected Err, got Ok(#{inspect(actual)})"),
    }
  }

  @doc """
  Check Err against a concrete deferror declaration's canonical identity.
  Payloads, messages, causes, and locations do not participate in the comparison.
  The marker must be a declaration name, never a string, variable, or error instance.
  Example: `assert_err_kind(NoneError, Err(NoneError))` returns `Ok(())`.
  """
  @builtin def assert_err_kind(marker: ErrorKind, result: Result<$A>) -> Result<()>

  @doc """
  Compares the complete error cause chain, outermost error first.
  Pass a direct list of concrete deferror names. Order and length must match;
  payloads and display strings are ignored. Ok and an empty expected list fail.
  Example: `assert_cause_chain([ZeroDivisionError, NoneError], Result::cause(Err(NoneError), ZeroDivisionError))`.
  """
  @builtin def assert_cause_chain(expected: List<ErrorKind>, result: Result<$A>) -> Result<()>

  @doc """
  Check that the option is Some and its content equals expected according to Eq.
  Example: `assert_some_eq(3, Option::Some(3))` returns `Ok(())`.
  """
  def assert_some_eq(expected: $A, option: Option<$A>) -> Result<()>
  where
    $A: Eq
  {
    match option {
      Option::Some(actual) => assert_eq(expected, actual),
      Option::None => _fail("expected Some(#{inspect(expected)}), got None"),
    }
  }

  @doc """
  Check the None branch without requiring Eq. A failure shows the actual Some content.
  Example: `assert_none(Option<Int>::None)` returns `Ok(())`.
  """
  def assert_none(option: Option<$A>) -> Result<()> {
    match option {
      Option::None => Ok(()),
      Option::Some(actual) => _fail("expected None, got Some(#{inspect(actual)})"),
    }
  }

  @doc """
  Check a case-sensitive literal substring. The empty fragment always matches.
  Example: `assert_contains("ell", "hello")` returns `Ok(())`.
  """
  def assert_contains(fragment: String, actual: String) -> Result<()> {
    if(String::contains(actual, fragment), Ok(()), _fail("expected #{inspect(actual)} to contain #{inspect(fragment)}"))
  }

  @builtin def __test_approx_equal(expected: Float, actual: Float, tolerance: Float) -> Boolean

  @doc """
  Check absolute Float error against a nonnegative tolerance, including equality at the boundary.
  Negative tolerance is an assertion failure. An overflowing difference also fails without aborting the VM.
  Example: `assert_approx(1.0, 1.25, 0.25)` returns `Ok(())`.
  """
  def assert_approx(expected: Float, actual: Float, tolerance: Float) -> Result<()> {
    if(tolerance < 0.0,
      _fail("invalid negative tolerance: #{inspect(tolerance)}"),
      if(__test_approx_equal(expected, actual, tolerance), Ok(()),
        _fail("expected #{inspect(expected)} within tolerance #{inspect(tolerance)}, got #{inspect(actual)}")),
    )
  }

  @doc """
  Always return Err(TestAssertionFailed(detail)), preserving detail unchanged.
  Example: `fail("not reached")` returns an assertion failure containing `not reached`.
  """
  def fail(detail: String) -> Result<()> { _fail(detail) }

  @doc """
  Check that `result` is `Ok(actual)` and that `actual` equals `expected` according to `Eq`.
  Returns `Ok(())` on a match, or `Err(TestAssertionFailed(...))` for an unequal value or an `Err`.

  ```surtr
  import Test;

  test("assert_ok_eq") {
    it("compares the successful result value") {
      assert_ok_eq(3, Ok(1 + 2))
    }
  }
  ```
  """
  def assert_ok_eq(expected: $A, result: Result<$A>) -> Result<()>
  where
    $A: Eq
  {
    match result {
      Ok(actual) => assert_eq(expected, actual),
      Err(err) => _fail("expected Ok(#{inspect(expected)}), got Err(#{inspect(err)})"),
    }
  }

  @doc """
  Check that `result` is `Err(error)` and `inspect(error)` contains `fragment` as a case-sensitive substring.
  Returns `Ok(())` on a match, or `Err(TestAssertionFailed(...))` for an `Ok` or a missing fragment.

  ```surtr
  import Test;

  test("assert_err_contains") {
    it("checks the expected error text") {
      result: Result<Int> = Err(NoneError)
      assert_err_contains("NoneError", result)
    }
  }
  ```
  """
  def assert_err_contains(fragment: String, result: Result<$A>) -> Result<()> {
    match result {
      Ok(actual) => _fail("expected Err containing #{fragment}, got Ok(#{inspect(actual)})"),
      Err(err) => _assert_err_rendered_contains(fragment, inspect(err)),
    }
  }

  @doc """
  Check that `doc` rendered as plain text equals `expected`.
  Returns `Ok(())` on a match, or `Err(TestAssertionFailed(...))` describing the text mismatch.

  ```surtr
  import Test;

  test("assert_doc_plain_eq") {
    it("compares text without styling") {
      doc = StyledDoc::bold(StyledDoc::text("hello"))
      assert_doc_plain_eq("hello", doc)
    }
  }
  ```
  """
  def assert_doc_plain_eq(expected: String, doc: StyledDocDoc) -> Result<()> {
    assert_eq(expected, StyledDoc::plain(doc))
  }

  @doc """
  Check that `doc` rendered with ANSI styling equals `expected`, including escape sequences.
  Returns `Ok(())` on a match, or `Err(TestAssertionFailed(...))` describing the text mismatch.

  ```surtr
  import Test;

  test("assert_doc_ansi_eq") {
    it("compares text with ANSI styling") {
      doc = StyledDoc::bold(StyledDoc::text("hello"))
      assert_doc_ansi_eq("\u{1b}[1mhello\u{1b}[0m", doc)
    }
  }
  ```
  """
  def assert_doc_ansi_eq(expected: String, doc: StyledDocDoc) -> Result<()> {
    assert_eq(expected, StyledDoc::to_ansi(doc))
  }

  @doc """
  Return unread stdout entries from the current test case, in output order, and empty the buffer.
  Entries may contain embedded newlines and include input prompts.
  Includes output since the case began or the last `capture_stdout` or `assert_stdout_eq` call.
  """
  def capture_stdout() -> List<String> {
    __test_capture_stdout()
  }

  @doc """
  Return unread stderr entries from the current test case, in output order, and empty the buffer.
  Entries may contain embedded newlines.
  Includes output since the case began or the last `capture_stderr` or `assert_stderr_eq` call.
  """
  def capture_stderr() -> List<String> {
    __test_capture_stderr()
  }

  @doc """
  Supply text for `IO::get` and `IO::get_line` in the current test case.
  Append `input` without adding a newline and return `Ok(())`.
  After this call, reads use only this buffer and return `Err(InputError(...))` when it is exhausted.
  """
  def push_stdin(input: String) -> Result<()> {
    __test_push_stdin(input)
    Ok(())
  }

  @doc """
  Compare the current case's captured stdout entries with `expected`, in output order.
  Consume the captured entries even when the comparison fails.
  Returns `Ok(())` on a match, or `Err(TestAssertionFailed(...))` describing the mismatch.

  ```surtr
  import Test;

  test("assert_stdout_eq") {
    it("compares captured stdout") {
      print("hello")
      assert_stdout_eq(["hello"])
    }
  }
  ```
  """
  def assert_stdout_eq(expected: List<String>) -> Result<()> {
    assert_eq(expected, __test_capture_stdout())
  }

  @doc """
  Compare the current case's captured stderr entries with `expected`, in output order.
  Consume the captured entries even when the comparison fails.
  Returns `Ok(())` on a match, or `Err(TestAssertionFailed(...))` describing the mismatch.

  ```surtr
  import Test;

  test("assert_stderr_eq") {
    it("compares captured stderr") {
      eprint(NoneError)
      assert_stderr_eq(["Error: NoneError: None Value."])
    }
  }
  ```
  """
  def assert_stderr_eq(expected: List<String>) -> Result<()> {
    assert_eq(expected, __test_capture_stderr())
  }
}
