@@doc """
Task provides the first process-oriented surface while the scheduler-backed
runtime is still staged.
"""
defmod Task {
  @@doc """
  Run a zero-argument task body and return its Result.
  """
  def call(body: (-> Result<$A>)) -> Result<$A> {
    __task_call(body)
  }

  @@doc """
  Run a zero-argument task body through the task runtime and return its Result.
  """
  def async(body: (-> Result<$A>)) -> Result<$A> {
    __task_async(body)
  }

  @@doc """
  Start a detached task body and return Ok(()) after the runtime accepts it.
  """
  def launch(body: (-> Result<Unit>)) -> Result<Unit> {
    __task_launch(body)
  }

  @@doc """
  Schedule a fire-and-forget task body and return Ok(()) after acceptance.
  """
  def cast(body: (-> Unit)) -> Result<Unit> {
    __task_cast(body)
  }
}
