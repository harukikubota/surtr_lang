@doc """
Process and Task provide the staged process-oriented surface.
"""
defstruct SupervisorStatus {
  supervisor: String,
  child_count: Int,
  strategy: String,
  max_restarts: Int,
  max_seconds: Int,
  allow_adopt: Boolean,
}

impl SupervisorStatus {
  def new(
    supervisor: String,
    child_count: Int,
    strategy: String,
    max_restarts: Int,
    max_seconds: Int,
    allow_adopt: Boolean,
  ) -> Self {
    SupervisorStatus {
      supervisor: supervisor,
      child_count: child_count,
      strategy: strategy,
      max_restarts: max_restarts,
      max_seconds: max_seconds,
      allow_adopt: allow_adopt,
    }
  }
}

@builtin type Workers<$Worker>
@builtin type WorkerLease<$Worker>

impl Workers {
  @builtin def submit(workers: Workers<$Worker>, message: (PID<$Worker> -> Result<Unit>)) -> Result<Unit>

  @builtin def broadcast(workers: Workers<$Worker>, message: (PID<$Worker> -> Result<$A>)) -> List<Result<$A>>

  @builtin def reserve(workers: Workers<$Worker>) -> Result<WorkerLease<$Worker>>

  @builtin def size(workers: Workers<$Worker>) -> Int
}

defmod GenServer {
  @hidden
  @builtin def pid(name: String, init: (-> Result<$State>)) -> PID<$Process>

  @hidden
  @builtin def spawn(name: String, init: (-> Result<$State>)) -> Result<PID<$Process>>

  @hidden
  @builtin def state(pid: PID<$Process>) -> Result<$State>

  @hidden
  @builtin def store(pid: PID<$Process>, state: $State) -> Result<Unit>

  @hidden
  @builtin def self() -> PID<$Process>

  @hidden
  @builtin def context_handler(process_name: String, slot: String) -> PID<$Handler>
}

defmod Supervisor {
  @hidden
  @builtin def spawn(supervisor: String, worker_init: (-> Result<$State>)) -> Result<PID<$Process>>

  @hidden
  @builtin def adopt(supervisor: String, pid: PID<$Process>) -> Result<Unit>

  @hidden
  @builtin def status(supervisor: String) -> Result<SupervisorStatus>

  @hidden
  @builtin def workers(
    supervisor: String,
    worker_init: (-> Result<$State>),
    size: Int,
  ) -> Result<Workers<$Process>>
}

defmod Process {
  @doc """
  Return the current process PID.

  ## REPL
  xldr(1)> Process::self()
  <pid>
  """
  @builtin def self() -> PID<$Process>

  @hidden
  @builtin def __process_pid(name: String, init: (-> Result<$State>)) -> PID<$Process>

  @hidden
  @builtin def __process_spawn(name: String, init: (-> Result<$State>)) -> Result<PID<$Process>>

  @hidden
  @builtin def __process_state(pid: PID<$Process>) -> Result<$State>

  @hidden
  @builtin def __process_store(pid: PID<$Process>, state: $State) -> Result<Unit>

  @hidden
  @builtin def __process_self() -> PID<$Process>

  @hidden
  @builtin def __process_context_handler(process_name: String, slot: String) -> PID<$Handler>

  @doc """
  Sleep the current execution for the given duration.

  ## REPL
  xldr(1)> Process::sleep(10ms)
  Ok(())
  """
  @builtin def sleep(duration: Duration) -> Result<Unit>

  @hidden
  @builtin def __process_sleep(duration: Duration) -> Result<Unit>
}

defmod OutHandler {
  @doc """
  Write text through a process-local output handler dependency.
  """
  @builtin def write(pid: PID<OutHandler>, text: String) -> Result<Unit>

  @hidden
  @builtin def __out_handler_write(pid: PID<OutHandler>, text: String) -> Result<Unit>
}

@doc """
Marker module for process-local input handler dependencies.

v2 standardizes `StdIn` as the builtin input handler identity. Buffered input
test helpers remain a later surface extension.
"""
defmod InHandler {}

defsupervisor DynamicSupervisor {
  meta {
    strategy: OneForOne
    max_restarts: 10
    max_seconds: 5
    child_restart_default: Transient
    allow_adopt: True
  }
}

defmod Task {
  @doc """
  Run a zero-argument task body and return its Result.

  ## REPL
  xldr(1)> Task::call({|| Ok(1)})
  Ok(1)
  """
  @builtin def call(body: (-> Result<$A>)) -> Result<$A>

  @doc """
  Run a zero-argument task body through the task runtime and return its Result.

  ## REPL
  xldr(1)> Task::async({|| Ok("ready")})
  Ok("ready")
  """
  @builtin def async(body: (-> Result<$A>)) -> Result<$A>

  @doc """
  Start a detached task body and return Ok(()) after the runtime accepts it.

  ## REPL
  xldr(1)> Task::launch({|| Ok(())})
  Ok(())
  """
  @builtin def launch(body: (-> Result<Unit>)) -> Result<Unit>

  @doc """
  Schedule a fire-and-forget task body and return Ok(()) after acceptance.

  ## REPL
  xldr(1)> Task::cast({|| ()})
  Ok(())
  """
  @builtin def cast(body: (-> Unit)) -> Result<Unit>

  @hidden
  @builtin def __task_call_timeout(timeout: Duration, body: (-> Result<$A>)) -> Result<$A>

  @hidden
  @builtin def __task_async_timeout(timeout: Duration, body: (-> Result<$A>)) -> Result<$A>

  @hidden
  @builtin def __task_launch_timeout(timeout: Duration, body: (-> Result<Unit>)) -> Result<Unit>

  @hidden
  @builtin def __task_cast_timeout(timeout: Duration, body: (-> Unit)) -> Result<Unit>
}
