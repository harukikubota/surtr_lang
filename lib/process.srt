@doc """
Process runtime public surface and compiler-managed lowering declarations.
"""
defstruct SupervisorStatus {
  supervisor: String,
  child_count: Int,
  strategy: String,
  max_restarts: Int,
  max_seconds: Int,
  allow_adopt: Boolean,
  shutdown_timeout: Option<Duration>,
}

impl SupervisorStatus {
  @doc """
  Create a supervisor status value.

  Runtime supervisor helpers return this value from generated status APIs.

  ## Examples
  status =? ImageWorkerSupervisor::status()
  """
  def new(
    supervisor: String,
    child_count: Int,
    strategy: String,
    max_restarts: Int,
    max_seconds: Int,
    allow_adopt: Boolean,
    shutdown_timeout: Option<Duration>,
  ) -> Self {
    SupervisorStatus {
      supervisor: supervisor,
      child_count: child_count,
      strategy: strategy,
      max_restarts: max_restarts,
      max_seconds: max_seconds,
      allow_adopt: allow_adopt,
      shutdown_timeout: shutdown_timeout,
    }
  }
}

@doc """
Worker-set scale mode.

`Fix(size)` is the v1 executable strategy. The runtime keeps exactly `size`
members alive under the owning supervisor.
"""
defenum WorkerScale {
  Fix(Int),
}

@doc """
Runtime worker-set strategy.

This is ordinary Surtr data and can be built in any module. The runtime only
receives it through the generated `Sup::workers(...)` owner helper, which the
compiler restricts to Singleton GenServer `@init`.
"""
defstruct WorkerStrategy {
  init: Int,
  min: Int,
  max: Int,
  scale: WorkerScale,
}

impl WorkerStrategy {
  @doc """
  Create a worker strategy value.
  """
  def new(init: Int, min: Int, max: Int, scale: WorkerScale) -> Self {
    WorkerStrategy { init: init, min: min, max: max, scale: scale }
  }

  @doc """
  Create a fixed-size worker strategy.
  """
  def fixed(size: Int) -> Self {
    WorkerStrategy::new(size, size, size, WorkerScale::Fix(size))
  }

  @doc """
  Default worker strategy: one fixed worker.
  """
  def default::<Self>() -> Self {
    WorkerStrategy::fixed(1)
  }
}

@doc """
Runtime-managed worker set handle for one worker process type.

`Workers<$Worker>` is only usable as Singleton GenServer state. Initialize it
from that GenServer's `@init` with the generated supervisor owner helper, then
keep it in the GenServer state returned by `@init`, `@call`, and `@cast`.

## Examples
State is just the worker set:

defgenserver ImageWorkerPool {
  meta {
    instance: Singleton
    init_policy: Eager
  }

  @init
  def init() -> Result<Workers<ImageWorker>> {
    ImageWorkerSupervisor::workers(ImageWorker::init("./input"), WorkerStrategy::fixed(4))
  }
}

State contains the worker set:

defstruct ImageWorkerPoolState {
  workers: Workers<ImageWorker>,
  accepted: Int,
}

impl ImageWorkerPoolState {
  def new(workers: Workers<ImageWorker>, accepted: Int) -> Self {
    ImageWorkerPoolState { workers: workers, accepted: accepted }
  }
}

defgenserver ImageWorkerPool {
  meta {
    instance: Singleton
    init_policy: Eager
    state: ImageWorkerPoolState
  }

  @init
  def init() -> Result<ImageWorkerPoolState> {
    workers =? ImageWorkerSupervisor::workers(
      ImageWorker::init("./input"),
      WorkerStrategy::fixed(4),
    )
    Ok(ImageWorkerPoolState::new(workers, 0))
  }
}
"""
@builtin type Workers<$Worker>

@doc """
Runtime-managed task handle for an async task body.

`TaskHandle<$T>` is returned by `Task::async(...)` and consumed by
`Task::await(...)`.
"""
@builtin type TaskHandle<$T>

@doc """
Return contract for worker `@call` handlers.
"""
defenum CallResult<$Reply, $State> {
  Reply($Reply, $State),
  ReplyLater($State, (-> Result<$Reply>)),
  Stop(StopReply<$Reply>),
}

@doc """
Stop payload for worker `@call` handlers.
"""
defenum StopReply<$Reply> {
  Normal($Reply),
  Error(Error),
}

@doc """
Return contract for worker `@cast` handlers.
"""
defenum CastResult<$State> {
  Next($State),
  Stop(StopReason),
}

@doc """
Stop payload for worker `@cast` handlers.
"""
defenum StopReason {
  Normal,
  Error(Error),
}

@doc """
Runtime-managed reservation for one worker from a `Workers<$Worker>` handle.

`WorkerLease<$Worker>` is returned by `Workers::reserve(workers)`. Pass the
lease to the worker message helper that should run on the reserved worker.

## Examples
defgenserver ImageWorkerPool {
  meta {
    instance: Singleton
    init_policy: Eager
  }

  @init
  def init() -> Result<Workers<ImageWorker>> {
    ImageWorkerSupervisor::workers(ImageWorker::init("./input"), WorkerStrategy::fixed(4))
  }

  def assign_reserved(workers: Workers<ImageWorker>, job: ImageJob) -> Result<Unit> {
    lease =? Workers::reserve(workers)
    ImageWorker::assign(lease, job)
  }
}
"""
@builtin type WorkerLease<$Worker>

impl Workers {
  @doc """
  Submit one message template to an idle worker managed by `workers`.

  The worker PID is injected by the runtime; ordinary code passes the worker
  message without a PID. This API is intended for Singleton GenServer pool
  implementations, usually from `@call`, `@cast`, or helper functions inside
  the `defgenserver` body.

  ## Examples
  defgenserver ImageWorkerPool {
    meta {
      instance: Singleton
      init_policy: Eager
    }

    @cast
    def submit(workers: Workers<ImageWorker>, job: ImageJob) -> Result<CastResult<Workers<ImageWorker>>> {
      _ =? Workers::submit(workers, ImageWorker::assign(job))
      Ok(CastResult::Next(workers))
    }
  }
  """
  @builtin def submit(workers: Workers<$Worker>, message: (PID<$Worker> -> Result<Unit>)) -> Result<Unit>

  @doc """
  Send one message template to every worker in `workers`.

  The target set is runtime-managed. Ordinary code passes the worker message
  without a PID. This API is intended for Singleton GenServer pool
  implementations, usually from `@call`, `@cast`, or helper functions inside
  the `defgenserver` body.

  ## Examples
  defgenserver ImageWorkerPool {
    meta {
      instance: Singleton
      init_policy: Eager
    }

    @call
    def current_states(
      workers: Workers<ImageWorker>
    ) -> Result<CallResult<List<Result<ImageWorkerStateView>>, Workers<ImageWorker>>> {
      views = Workers::broadcast(workers, ImageWorker::current_state())
      Ok(CallResult::Reply(views, workers))
    }
  }
  """
  @builtin def broadcast(workers: Workers<$Worker>, message: (PID<$Worker> -> Result<$A>)) -> List<Result<$A>>

  @doc """
  Reserve one worker from `workers` and return a lease for later messaging.

  Use this when work needs an explicit worker reservation before sending the
  next message. This API is intended for Singleton GenServer pool
  implementations, usually from `@call`, `@cast`, or helper functions inside
  the `defgenserver` body.

  ## Examples
  defgenserver ImageWorkerPool {
    meta {
      instance: Singleton
      init_policy: Eager
    }

    def assign_reserved(workers: Workers<ImageWorker>, job: ImageJob) -> Result<Unit> {
      lease =? Workers::reserve(workers)
      ImageWorker::assign(lease, job)
    }
  }
  """
  @builtin def reserve(workers: Workers<$Worker>) -> Result<WorkerLease<$Worker>>

  @doc """
  Return the number of workers managed by `workers`.

  This API is intended for Singleton GenServer pool implementations, usually
  from `@call`, `@cast`, or helper functions inside the `defgenserver` body.

  ## Examples
  defgenserver ImageWorkerPool {
    meta {
      instance: Singleton
      init_policy: Eager
    }

    @call
    def size(workers: Workers<ImageWorker>) -> Result<CallResult<Int, Workers<ImageWorker>>> {
      Ok(CallResult::Reply(Workers::size(workers), workers))
    }
  }
  """
  @builtin def size(workers: Workers<$Worker>) -> Int
}

defmod Supervisor {
  @doc """
  Compiler-managed lower target for spawning a worker under a supervisor.

  Ordinary code cannot call this function directly. Use `DynamicSupervisor` or
  the generated owner helper from `defsupervisor` instead.

  ## Regular Surface
  xldr(1)> ImageWorkerSupervisor::spawn(ImageWorker::init("./input"))
  Ok(<pid>)
  """
  @hidden
  @builtin def spawn::<$Process>(supervisor: $Supervisor, worker_init: (-> Result<$State>)) -> Result<PID<$Process>>

  @doc """
  Compiler-managed lower target for adopting a worker PID under a supervisor.

  Ordinary code cannot call this function directly. Use `DynamicSupervisor` or
  the generated owner helper from `defsupervisor` instead.

  ## Regular Surface
  xldr(1)> ImageWorkerSupervisor::adopt(pid)
  Ok(())
  """
  @hidden
  @builtin def adopt(supervisor: $Supervisor, pid: PID<$Process>) -> Result<Unit>

  @doc """
  Compiler-managed lower target for reading supervisor status.

  Ordinary code cannot call this function directly. Use `DynamicSupervisor` or
  the generated owner helper from `defsupervisor` instead.

  ## Regular Surface
  xldr(1)> ImageWorkerSupervisor::status()
  Ok(SupervisorStatus { ... })
  """
  @hidden
  @builtin def status(supervisor: $Supervisor) -> Result<SupervisorStatus>

  @doc """
  Compiler-managed lower target for creating a runtime-managed worker set.

  Ordinary code cannot call this function directly. Use the generated owner
  helper from `defsupervisor`, then operate on the returned handle through
  `Workers` inside a Singleton GenServer pool implementation.

  ## Regular Surface
  defgenserver ImageWorkerPool {
    meta {
      instance: Singleton
      init_policy: Eager
    }

    @init
    def init() -> Result<Workers<ImageWorker>> {
      ImageWorkerSupervisor::workers(ImageWorker::init("./input"), WorkerStrategy::fixed(4))
    }
  }
  """
  @hidden
  @builtin def workers::<$Process>(
    supervisor: $Supervisor,
    worker_init: (-> Result<$State>),
    strategy: WorkerStrategy,
  ) -> Result<Workers<$Process>>
}

defmod GenServer {
  @doc """
  Compiler-managed lower target for GenServer singleton PID lookup.

  Ordinary code cannot call this function directly. Use the generated owner
  helper from `defgenserver` instead.

  REPL note: `GenServer::pid` is the hidden lower doc source, while
  `QueueServer::pid()` is the public singleton surface.

  ## Regular Surface
  xldr(1)> QueueServer::pid()
  <pid>
  """
  @hidden
  @builtin def pid::<$Process>(owner: $Owner, init: (-> Result<$State>)) -> PID<$Process>

  @doc """
  Compiler-managed lower target for GenServer worker spawn.

  Ordinary code cannot call this function directly. Use the generated owner
  helper from `defgenserver` instead.

  ## Regular Surface
  xldr(1)> QueueServer::spawn(0)
  Ok(<pid>)
  """
  @hidden
  @builtin def spawn::<$Process>(owner: $Owner, init: (-> Result<$State>)) -> Result<PID<$Process>>

  @doc """
  Compiler-managed lower target for reading GenServer state.

  Ordinary code cannot call this function directly. Use generated `@call` /
  `@cast` owner helpers from `defgenserver` instead.

  ## Regular Surface
  xldr(1)> QueueServer::size()
  Ok(0)
  """
  @hidden
  @builtin def state::<$State>(pid: PID<$Process>) -> Result<$State>

  @doc """
  Compiler-managed lower target for storing GenServer state.

  Ordinary code cannot call this function directly. Return the next state from
  a generated `@call` or `@cast` handler instead.

  ## Regular Surface
  _ =? QueueServer::push("job")
  """
  @hidden
  @builtin def store(pid: PID<$Process>, state: $State) -> Result<Unit>

  @doc """
  Compiler-managed lower target for reading the current GenServer PID.

  Ordinary code cannot call this function directly. Use `Process::self()` from
  inside process code instead.

  ## Regular Surface
  xldr(1)> Process::self()
  <pid>
  """
  @hidden
  @builtin def self::<$Process>() -> PID<$Process>

  @doc """
  Compiler-managed lower target for resolving a GenServer handler dependency.

  Ordinary code cannot call this function directly. Use the generated process
  context field from `defgenserver` instead.

  ## Regular Surface
  _ =? ctx.out.write("hello")
  """
  @hidden
  @builtin def context_handler::<$Handler>(owner: $Owner, slot: String) -> PID<$Handler>
}

@doc """
Compiler-managed lower surface for Agent family lowering.

Ordinary code should use generated owner helpers from `defagent`.
"""
defmod Agent {
  @doc """
  Compiler-managed lower target for Agent singleton PID lookup.

  Ordinary code cannot call this function directly. Use the generated owner
  helper from `defagent` instead.

  REPL note: `Agent::pid` is the hidden lower doc source, while
  `Counter::pid()` is the public singleton surface.

  ## Regular Surface
  xldr(1)> Counter::pid()
  <pid>
  """
  @hidden
  @builtin def pid::<$Process>(owner: $Owner, init: (-> Result<$State>)) -> PID<$Process>

  @doc """
  Compiler-managed lower target for Agent worker spawn.

  Ordinary code cannot call this function directly. Use the generated owner
  helper from `defagent` instead.

  ## Regular Surface
  xldr(1)> Counter::spawn(0)
  Ok(<pid>)
  """
  @hidden
  @builtin def spawn::<$Process>(owner: $Owner, init: (-> Result<$State>)) -> Result<PID<$Process>>

  @doc """
  Compiler-managed lower target for reading Agent state.

  Ordinary code cannot call this function directly. Use generated `@get` or
  `@set` owner helpers from `defagent` instead.

  ## Regular Surface
  xldr(1)> Counter::get()
  Ok(0)
  """
  @hidden
  @builtin def state::<$State>(pid: PID<$Process>) -> Result<$State>

  @doc """
  Compiler-managed lower target for storing Agent state.

  Ordinary code cannot call this function directly. Return the next state from
  a generated `@set` handler instead.

  ## Regular Surface
  _ =? Counter::set(1)
  """
  @hidden
  @builtin def store(pid: PID<$Process>, state: $State) -> Result<Unit>

  @doc """
  Compiler-managed lower target for reading the current Agent PID.

  Ordinary code cannot call this function directly. Use `Process::self()` from
  inside process code instead.

  ## Regular Surface
  xldr(1)> Process::self()
  <pid>
  """
  @hidden
  @builtin def self::<$Process>() -> PID<$Process>

  @doc """
  Compiler-managed lower target for resolving an Agent handler dependency.

  Ordinary code cannot call this function directly. Use the generated process
  context field from `defagent` instead.

  ## Regular Surface
  _ =? ctx.out.write("hello")
  """
  @hidden
  @builtin def context_handler::<$Handler>(owner: $Owner, slot: String) -> PID<$Handler>
}

defmod Process {
  @doc """
  Return the current process PID.

  ## REPL
  xldr(1)> Process::self()
  <pid>
  """
  @builtin def self::<$Process>() -> PID<$Process>

  @doc """
  Sleep the current execution for the given duration.

  ## REPL
  xldr(1)> Process::sleep(10ms)
  Ok(())
  """
  @builtin def sleep(duration: Duration) -> Result<Unit>
}

defmod OutHandler {
  @doc """
  Write text through a process-local output handler dependency.
  """
  @builtin def write(pid: PID<OutHandler>, text: String) -> Result<Unit>

  @doc """
  Compiler-managed lower target for writing through an output handler.

  Ordinary code cannot call this function directly. Use the handler module or
  generated process context field instead.

  ## Regular Surface
  _ =? OutHandler::write(pid, "hello")
  _ =? ctx.out.write("hello")
  """
  @hidden
  @builtin def __out_handler_write(pid: PID<OutHandler>, text: String) -> Result<Unit>
}

@doc """
Marker module for process-local input handler dependencies.

v2 standardizes `StdIn` as the builtin input handler identity. Buffered input
test helpers remain a later surface extension.
"""
defmod InHandler {}

defsupervisor DynamicSupervisor {
  meta {
    strategy: OneForOne
    max_restarts: 10
    max_seconds: 5
    child_restart_default: Transient
    allow_adopt: True
  }
}

defmod Task {
  @doc """
  Run a zero-argument task body and return its Result.

  ## REPL
  xldr(1)> Task::call({|| Ok(1)})
  Ok(1)
  """
  @builtin def call(body: (-> Result<$A>)) -> Result<$A>

  @doc """
  Start a zero-argument task body through the task runtime and return a handle.

  ## REPL
  xldr(1)> Task::async({|| Ok("ready")})
  <task>
  """
  @builtin def async(body: (-> Result<$A>)) -> TaskHandle<$A>

  @doc """
  Await a task handle and return its Result.

  ## REPL
  xldr(1)> task = Task::async({|| Ok("ready")})
  xldr(2)> Task::await(task)
  Ok("ready")
  """
  @builtin def await(task: TaskHandle<$A>) -> Result<$A>

  @doc """
  Start a detached task body and return Ok(()) after the runtime accepts it.

  ## REPL
  xldr(1)> Task::launch({|| Ok(())})
  Ok(())
  """
  @builtin def launch(body: (-> Result<Unit>)) -> Result<Unit>

  @doc """
  Schedule a fire-and-forget task body and return Ok(()) after acceptance.

  ## REPL
  xldr(1)> Task::cast({|| ()})
  Ok(())
  """
  @builtin def cast(body: (-> Unit)) -> Result<Unit>
}
