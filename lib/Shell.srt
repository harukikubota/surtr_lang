@doc """
Execution-context working directory and external command helpers.

`Shell::exec` does not invoke a shell parser; pass the command and argv
separately.
"""
defmod Shell {
  @builtin def pwd() -> Result<FilePath, Error>
  @builtin def cd(path: FilePath) -> Result<Unit, Error>
  @builtin def exec(command: String, args: List<String>) -> Result<CommandResult, Error>
}

impl CommandResult {
  def new(
    command: String,
    args: List<String>,
    exit_code: Int,
    stdout: String,
    stderr: String,
  ) -> Self {
    CommandResult {
      command: command,
      args: args,
      exit_code: exit_code,
      stdout: stdout,
      stderr: stderr,
    }
  }
}

@doc """
Result of a launched external command.

A non-zero exit code remains an `Ok(CommandResult)` because the process was
successfully launched and observed.
"""
defstruct CommandResult {
  command: String,
  args: List<String>,
  exit_code: Int,
  stdout: String,
  stderr: String,
}

deferror ShellSpawnResourceNotFound(command: String, args: List<String>, cwd: FilePath, detail: String) {
  |command: String, args: List<String>, cwd: FilePath, detail: String|
  Self(
    message: "shell could not start #{command} in #{to_string(cwd)}: #{detail}",
    command,
    args,
    cwd,
    detail,
  )
}

deferror ShellSpawnFailed(command: String, args: List<String>, cwd: FilePath, detail: String) {
  |command: String, args: List<String>, cwd: FilePath, detail: String|
  Self(
    message: "shell spawn failed for #{command} in #{to_string(cwd)}: #{detail}",
    command,
    args,
    cwd,
    detail,
  )
}

deferror ShellWorkingDirectoryNotFound(path: FilePath) {
  |path: FilePath|
  Self(message: "shell working directory not found: #{to_string(path)}", path)
}

deferror ShellWorkingDirectoryNotDirectory(path: FilePath) {
  |path: FilePath|
  Self(message: "shell working directory is not a directory: #{to_string(path)}", path)
}

deferror ShellWorkingDirectoryInspectFailed(path: FilePath, detail: String) {
  |path: FilePath, detail: String|
  Self(
    message: "shell working directory inspect failed for #{to_string(path)}: #{detail}",
    path,
    detail,
  )
}

deferror ShellUnsupported(feature: String) {
  |feature: String|
  Self(message: "shell feature is unsupported: #{feature}", feature)
}

deferror ShellStdoutEncodingError(command: String, detail: String) {
  |command: String, detail: String|
  Self(message: "shell stdout encoding failed for #{command}: #{detail}", command, detail)
}

deferror ShellStderrEncodingError(command: String, detail: String) {
  |command: String, detail: String|
  Self(message: "shell stderr encoding failed for #{command}: #{detail}", command, detail)
}

deferror ShellWorkingDirectoryResolveFailed(path: FilePath, detail: String) {
  |path: FilePath, detail: String|
  Self(
    message: "shell working directory resolve failed for #{to_string(path)}: #{detail}",
    path,
    detail,
  )
}
