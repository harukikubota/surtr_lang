@@doc """
Standard `HashMap` type declaration.
`HashMap<$V>` is an immutable insertion-ordered map with `String` keys and
value-only generics.
The canonical builtin head is fixed to this shape.
"""
@@builtin type HashMap<$V>

@@doc """
HashMap module.
Provides immutable map helpers backed by runtime builtins.
Keys are always `String`, and insertion order is preserved.
"""
defmod HashMap {
  defp _map_values_go(
    source: HashMap<$A>,
    remaining_keys: List<String>,
    f: ($A -> $B),
    acc: HashMap<$B>,
  ) -> HashMap<$B> {
    match remaining_keys {
      [] => acc,
      [key, ..tail] => match get(source, key) {
        Ok(value) => _map_values_go(source, tail, f, insert(acc, key, f(value))),
        Err(_) => _map_values_go(source, tail, f, acc),
      },
    }
  }

  @@doc """
  Return the empty map.
  """
  @@builtin def empty_map() -> HashMap<$V>

  def empty() -> HashMap<$V> {
    empty_map()
  }

  @@doc """
  Build a map from `(String, value)` entries.
  Later duplicates overwrite values while preserving first-key order.
  """
  @@builtin def map_from_entries(entries: List<(String, $V)>) -> HashMap<$V>

  def from_entries(entries: List<(String, $V)>) -> HashMap<$V> {
    map_from_entries(entries)
  }

  @@doc """
  Return the number of entries.
  """
  @@builtin def map_len(map: HashMap<$V>) -> Int

  def len(map: HashMap<$V>) -> Int {
    map_len(map)
  }

  @@doc """
  Return `True` when `key` exists in `map`.
  """
  @@builtin def map_contains_key(map: HashMap<$V>, key: String) -> Boolean

  def contains_key(map: HashMap<$V>, key: String) -> Boolean {
    map_contains_key(map, key)
  }

  @@doc """
  Return `Ok(value)` when the key exists, otherwise `Err(NoneError)`.
  """
  @@builtin def map_get(map: HashMap<$V>, key: String) -> Result<$V, NoneError>

  def get(map: HashMap<$V>, key: String) -> Result<$V, NoneError> {
    map_get(map, key)
  }

  @@doc """
  Return a new map with `key` set to `value`.
  Existing key order is preserved.
  """
  @@builtin def map_insert(map: HashMap<$V>, key: String, value: $V) -> HashMap<$V>

  def insert(map: HashMap<$V>, key: String, value: $V) -> HashMap<$V> {
    map_insert(map, key, value)
  }

  @@doc """
  Return a new map without `key`.
  Missing keys are no-op.
  """
  @@builtin def map_remove(map: HashMap<$V>, key: String) -> HashMap<$V>

  def remove(map: HashMap<$V>, key: String) -> HashMap<$V> {
    map_remove(map, key)
  }

  @@doc """
  Return keys in insertion order.
  """
  @@builtin def map_keys(map: HashMap<$V>) -> List<String>

  def keys(map: HashMap<$V>) -> List<String> {
    map_keys(map)
  }

  @@doc """
  Return values in the same order as `keys(map)`.
  """
  @@builtin def map_values_list(map: HashMap<$V>) -> List<$V>

  def values(map: HashMap<$V>) -> List<$V> {
    map_values_list(map)
  }

  @@doc """
  Return `(key, value)` entries in insertion order.
  """
  def entries(map: HashMap<$V>) -> List<(String, $V)> {
    List::zip(keys(map), values(map))
  }

  @@doc """
  Return a new map with the same keys and transformed values.
  Key order is preserved.
  """
  def map_values(map: HashMap<$A>, f: ($A -> $B)) -> HashMap<$B> {
    _map_values_go(map, keys(map), f, empty())
  }
}
