@@doc """
Standard `Result` type declaration.
`Result` represents success-or-error control flow as a value.
The canonical builtin head is `Result<$T>`.
This is the language's Either-oriented success/failure representation.
Its runtime representation is enum-like, but the language treats `Result` as a
dedicated built-in abstraction rather than exposing it as the future general
`Enum` surface.
"""
@@builtin type Result<$T>

@@doc """
Extractor が MatchBlock evaluator へ返す内部制御用の列挙結果。
surface 上の canonical な型位置は `MatchResult<$Value, Error>` だが、
error 側は抽象型 `Error` に固定される。
`MatchResult` は `defextractor` / `@@builtin defextractor` の戻り値と
Extractor 本文内でだけ使える。通常 API は `Result`, `Option`, user-defined enum を返す。
"""
defenum MatchResult<$Value> {
  Success($Value),
  NoMatch,
  Err(Error),
}

@@doc """
Construct the success branch of `Result`.
This is a declaration-only surface contract for the constructor shape.
The parser normalizes this special `@@builtin type` spelling into the internal
Result-constructor declaration that later phases validate.
"""
@@builtin type Ok($T) -> Result<$T>

@@doc """
Construct the failure branch of `Result`.
Concrete `deferror` values flow through the abstract `Error` type here.
This keeps the language surface focused on `Result` as an Either-style value
without exposing the runtime representation directly.
"""
@@builtin type Err(Error) -> Result<$T>

@@doc """
Result module.
Groups documentation and future helpers around `Ok(...)` / `Err(...)`.
Return-position `Result<T, E>` notation refines function contracts, while the
builtin type declaration itself stays `Result<$T>` in this file.
Although the implementation uses a tagged two-branch representation, the
language keeps `Result` distinct from the future general `Enum` surface.
`Result` is auto-imported. `Ok(...)` / `Err(...)` belong to the `Result` module,
but they are available without an explicit `import Result`.
"""
@@autoimport
defmod Result {
  defp _all_go(values: List<Result<$A>>, acc_rev: List<$A>) -> Result<List<$A>> {
    match values {
      [] => Ok(List::reverse(acc_rev)),
      [head, ..tail] => {
        value =? head
        _all_go(tail, [value, ..acc_rev])
      },
    }
  }

  @@doc """
  Helper for matching on `Result` success vs failure.
  This is not a general-purpose combinator, but it is a common enough pattern that it deserves a helper.
  The `is_ok` name is a bit of a misnomer since it returns `True` for any `Ok(...)` value, even if the inner value is an error type.
  It's really more of an `is_ok_variant` check, but the shorter name is more ergonomic for common use.
  """
  def is_ok(result: Result<$T>) -> Boolean {
    match result {
      Ok(_) => True,
      Err(_) => False,
    }
  }

  @@doc """
  Helper for matching on `Result` success vs failure.
  This is not a general-purpose combinator,
  but it is a common enough pattern that it deserves a helper.
  The `is_err` name is a bit of a misnomer since it returns `True` for any `Err(...)` value,
  even if the inner error is an `Ok`-wrapped success type. It's really more of an `is_err_variant` check,
  but the shorter name is more ergonomic for common use.
  """
  def is_err(result: Result<$T>) -> Boolean {
    Boolean::not(is_ok(result))
  }

  @@doc """
  Replace the error branch of a `Result` without preserving the previous cause.

  - `Ok(value)` stays `Ok(value)`
  - `Err(old)` becomes `Err(err)`

  Use `cause(...)` when the previous error should remain in the chain.
  """
  @@builtin def map_err(result: Result<$T>, err: Error) -> Result<$T>

  @@doc """
  Add a higher-level domain error on top of an existing `Err(...)`.

  - `Ok(value)` stays `Ok(value)`
  - `Err(old)` becomes `Err(err)` and the previous error is appended to the new error's cause chain

  This keeps `Error` runtime-managed and opaque while still allowing domain layering.
  """
  @@builtin def cause(result: Result<$T>, err: Error) -> Result<$T>

  @@doc """
  Sequence a `Result<$T>` with a later `Result<()>` operation.

  - `chain(Ok(value), Ok(()))` returns `Ok(value)`
  - `chain(Ok(_), Err(right))` returns `Err(right)`
  - `chain(Err(left), Ok(()))` returns `Err(left)`
  - `chain(Err(left), Err(right))` returns `Err(right)` and appends `left` to the tail of `right`

  This keeps the success value on the left and uses the right side only for trailing error-capable work.
  """
  @@builtin def chain(head: Result<$T>, tail: Result<()>) -> Result<$T>

  @@doc """
  Recover from any error without inspecting the concrete error kind.

  The handler body is evaluated only when `value` is `Err(...)`; `Ok(value)`
  returns unchanged.
  """
  def recover(value: Result<$A>, handler: (-> Result<$A>)) -> Result<$A> {
    match value {
      Ok(ok) => Ok(ok),
      Err(_) => handler(),
    }
  }

  @@doc """
  Recover from one concrete error kind.

  This is a special form: `marker` is treated as a `deferror` kind marker and
  is not evaluated as an ordinary `Error` value. The handler is evaluated only
  when `value` is `Err(...)` with the same concrete kind.
  """
  @@builtin def recover_kind(value: Result<$A>, marker: Error, handler: (Error -> Result<$A>)) -> Result<$A>

  @@doc """
  Apply a function wrapped in `Result` to a value wrapped in `Result`.
  """
  def lift(f: Result<($A -> $B)>, value: Result<$A>) -> Result<$B> {
    ff =? f
    vv =? value
    Ok(ff(vv))
  }

  @@doc """
  Apply a 2-argument function wrapped in `Result` to two `Result` values.
  """
  def lift2(f: Result<($A, $B -> $C)>, left: Result<$A>, right: Result<$B>) -> Result<$C> {
    ff =? f
    ll =? left
    rr =? right
    Ok(ff(ll, rr))
  }

  @@doc """
  Apply a 3-argument function wrapped in `Result` to three `Result` values.
  """
  def lift3(f: Result<($A, $B, $C -> $D)>, a: Result<$A>, b: Result<$B>, c: Result<$C>) -> Result<$D> {
    ff =? f
    aa =? a
    bb =? b
    cc =? c
    Ok(ff(aa, bb, cc))
  }

  @@doc """
  Apply a `Result`-returning function wrapped in `Result` to one `Result` value.
  """
  def flat_lift(f: Result<($A -> Result<$B>)>, value: Result<$A>) -> Result<$B> {
    ff =? f
    vv =? value
    ff(vv)
  }

  @@doc """
  Apply a `Result`-returning 2-argument function wrapped in `Result`.
  """
  def flat_lift2(
    f: Result<($A, $B -> Result<$C>)>,
    left: Result<$A>,
    right: Result<$B>,
  ) -> Result<$C> {
    ff =? f
    ll =? left
    rr =? right
    ff(ll, rr)
  }

  @@doc """
  Apply a `Result`-returning 3-argument function wrapped in `Result`.
  """
  def flat_lift3(
    f: Result<($A, $B, $C -> Result<$D>)>,
    a: Result<$A>,
    b: Result<$B>,
    c: Result<$C>,
  ) -> Result<$D> {
    ff =? f
    aa =? a
    bb =? b
    cc =? c
    ff(aa, bb, cc)
  }

  @@doc """
  Pipeline-friendly `lift` variant with value first.
  """
  def with(value: Result<$A>, f: Result<($A -> $B)>) -> Result<$B> {
    lift(f, value)
  }

  @@doc """
  Pipeline-friendly `lift2` variant with values first.
  """
  def with2(left: Result<$A>, right: Result<$B>, f: Result<($A, $B -> $C)>) -> Result<$C> {
    lift2(f, left, right)
  }

  @@doc """
  Pipeline-friendly `lift3` variant with values first.
  """
  def with3(
    a: Result<$A>,
    b: Result<$B>,
    c: Result<$C>,
    f: Result<($A, $B, $C -> $D)>,
  ) -> Result<$D> {
    lift3(f, a, b, c)
  }

  @@doc """
  Pipeline-friendly `flat_lift` variant with value first.
  """
  def flat_with(value: Result<$A>, f: Result<($A -> Result<$B>)>) -> Result<$B> {
    flat_lift(f, value)
  }

  @@doc """
  Pipeline-friendly `flat_lift2` variant with values first.
  """
  def flat_with2(
    left: Result<$A>,
    right: Result<$B>,
    f: Result<($A, $B -> Result<$C>)>,
  ) -> Result<$C> {
    flat_lift2(f, left, right)
  }

  @@doc """
  Pipeline-friendly `flat_lift3` variant with values first.
  """
  def flat_with3(
    a: Result<$A>,
    b: Result<$B>,
    c: Result<$C>,
    f: Result<($A, $B, $C -> Result<$D>)>,
  ) -> Result<$D> {
    flat_lift3(f, a, b, c)
  }

  @@doc """
  Bundle two `Result` values into one tuple-shaped `Result`.
  """
  def zip(left: Result<$A>, right: Result<$B>) -> Result<($A, $B)> {
    ll =? left
    rr =? right
    Ok((ll, rr))
  }

  @@doc """
  Bundle three `Result` values into one tuple-shaped `Result`.
  """
  def zip3(a: Result<$A>, b: Result<$B>, c: Result<$C>) -> Result<($A, $B, $C)> {
    aa =? a
    bb =? b
    cc =? c
    Ok((aa, bb, cc))
  }

  @@doc """
  Convert `List<Result<$A>>` into `Result<List<$A>>`.
  """
  def all(values: List<Result<$A>>) -> Result<List<$A>> {
    _all_go(values, [])
  }

  @@doc """
  Flatten one level of nested `Result`.
  """
  def flatten(value: Result<Result<$A>>) -> Result<$A> {
    inner =? value
    inner
  }

  @@doc """
  Observe success values and return the original `Result` unchanged.
  """
  def tap_ok(value: Result<$A>, f: ($A -> Unit)) -> Result<$A> {
    match value {
      Ok(v) => {
        f(v)
        value
      },
      Err(_) => value,
    }
  }

  @@doc """
  Observe failure values and return the original `Result` unchanged.
  """
  def tap_err(value: Result<$A>, f: (Error -> Unit)) -> Result<$A> {
    match value {
      Ok(_) => value,
      Err(err) => {
        f(err)
        value
      },
    }
  }

  @@doc """
  Continue with `next` only when the left `Result` is `Ok(...)`.
  """
  def then(value: Result<$A>, next: (-> Result<$B>)) -> Result<$B> {
    flat_lift(Ok({|_| next()}), value)
  }
}
