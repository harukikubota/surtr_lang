@doc """
Opaque seeded random generator state.
`RandomGenerator` values are returned by `Random::seed` and threaded through
`Random::next_*` helpers. The display form is intentionally opaque.
"""
@builtin type RandomGenerator

@doc """
Concrete random-module error for empty half-open ranges.
Random integer helpers require `start < end`.
"""
deferror InvalidRandomRange(start: Int, end: Int) {
  "random range must be non-empty: #{start}..#{end}"
}

@doc """
Random module.
Provides integer random helpers over half-open ranges.

`Random::int_*` uses host-provided entropy for each call.
`Random::next_*` takes and returns an explicit generator so repeatable sequences
can be threaded through ordinary Surtr values.
"""
defmod Random {
  @doc """
  Create a repeatable generator from an integer seed.
  The exact generated sequence is implementation-defined within Surtr.
  ## REPL
  xldr(1)> Random::seed(1)
  RandomGenerator(<opaque>)
  """
  @builtin def seed(seed: Int) -> RandomGenerator

  @doc """
  Return a host-seeded integer in `0 <= n < end`.
  `end <= 0` returns `Err(InvalidRandomRange(0, end))`.
  ## REPL
  xldr(1)> Random::int_until(10)
  Ok(7)
  """
  @builtin def int_until(end: Int) -> Result<Int, InvalidRandomRange>

  @doc """
  Return a host-seeded integer in `start <= n < end`.
  Empty or reversed ranges return `Err(InvalidRandomRange(start, end))`.
  ## REPL
  xldr(1)> Random::int_range(-3, 3)
  Ok(1)
  """
  @builtin def int_range(start: Int, end: Int) -> Result<Int, InvalidRandomRange>

  @doc """
  Return a repeatable integer in `0 <= n < end` and the next generator state.
  `end <= 0` returns `Err(InvalidRandomRange(0, end))`.
  ## REPL
  xldr(1)> rng = Random::seed(1)
  xldr(2)> Random::next_int_until(rng, 10)
  Ok((7, RandomGenerator(<opaque>)))
  """
  @builtin def next_int_until(rng: RandomGenerator, end: Int) -> Result<(Int, RandomGenerator), InvalidRandomRange>

  @doc """
  Return a repeatable integer in `start <= n < end` and the next generator
  state. Empty or reversed ranges return `Err(InvalidRandomRange(start, end))`.
  ## REPL
  xldr(1)> rng = Random::seed(1)
  xldr(2)> Random::next_int_range(rng, -3, 3)
  Ok((1, RandomGenerator(<opaque>)))
  """
  @builtin def next_int_range(rng: RandomGenerator, start: Int, end: Int) -> Result<(Int, RandomGenerator), InvalidRandomRange>
}
