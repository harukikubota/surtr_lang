@doc """
Concrete file-system errors returned by `File`.

`File` is a UTF-8 text-only surface in v1. Host I/O failures are normalized
into these recoverable Surtr errors so ordinary code can handle them through
`Result` instead of treating them as VM failures.

Typical mapping:
- missing file or missing parent path: `FileNotFound`
- permission failure: `FilePermissionDenied`
- invalid or unsupported path syntax: `FileInvalidPath`
- non-UTF-8 text input: `FileReadEncodingError` or `FileChunkEncodingError`
- other host-side failures: operation-specific file errors
"""
deferror FileNotFound(path: String) {
  |path: String|
  Self(message: "file not found: #{path}", path)
}

deferror FilePermissionDenied(path: String) {
  |path: String|
  Self(message: "permission denied: #{path}", path)
}

deferror FileAlreadyExists(path: String) {
  |path: String|
  Self(message: "file already exists: #{path}", path)
}

deferror FileInvalidPath(path: String) {
  |path: String|
  Self(message: "invalid path: #{path}", path)
}

deferror FileClosed {
  "file is already closed"
}

deferror FileReadEncodingError(path: String, detail: String) {
  |path: String, detail: String|
  Self(message: "file read encoding failed for #{path}: #{detail}", path, detail)
}

deferror FileChunkEncodingError(path: String, detail: String) {
  |path: String, detail: String|
  Self(message: "file chunk read encoding failed for #{path}: #{detail}", path, detail)
}

deferror FileReadFailed(path: String, detail: String) {
  |path: String, detail: String|
  Self(message: "file read failed for #{path}: #{detail}", path, detail)
}

deferror FileWriteFailed(path: String, detail: String) {
  |path: String, detail: String|
  Self(message: "file write failed for #{path}: #{detail}", path, detail)
}

deferror FileAppendOpenFailed(path: String, detail: String) {
  |path: String, detail: String|
  Self(message: "file append open failed for #{path}: #{detail}", path, detail)
}

deferror FileAppendWriteFailed(path: String, detail: String) {
  |path: String, detail: String|
  Self(message: "file append write failed for #{path}: #{detail}", path, detail)
}

deferror FileAppendCloseFailed(path: String, detail: String) {
  |path: String, detail: String|
  Self(message: "file append close failed for #{path}: #{detail}", path, detail)
}

deferror FileDeleteFailed(path: String, detail: String) {
  |path: String, detail: String|
  Self(message: "file delete failed for #{path}: #{detail}", path, detail)
}

deferror FileOpenFailed(path: String, detail: String, mode: FileMode) {
  |path: String, detail: String, mode: FileMode|
  Self(message: "file open failed for #{path}: #{detail}", path, detail, mode)
}

deferror FileReadChunkFailed(path: String, detail: String) {
  |path: String, detail: String|
  Self(message: "file chunk read failed for #{path}: #{detail}", path, detail)
}

deferror FileWriteChunkFailed(path: String, detail: String) {
  |path: String, detail: String|
  Self(message: "file chunk write failed for #{path}: #{detail}", path, detail)
}

deferror FileFlushFailed(path: String, detail: String) {
  |path: String, detail: String|
  Self(message: "file flush failed for #{path}: #{detail}", path, detail)
}

deferror FileCloseFailed(path: String, detail: String) {
  |path: String, detail: String|
  Self(message: "file close failed for #{path}: #{detail}", path, detail)
}

deferror FileHandleNotReadable(path: String, mode: FileMode) {
  |path: String, mode: FileMode|
  Self(message: "file handle is not readable for #{path} in mode #{inspect(mode)}", path, mode)
}

deferror FileHandleNotWritable(path: String, mode: FileMode) {
  |path: String, mode: FileMode|
  Self(message: "file handle is not writable for #{path} in mode #{inspect(mode)}", path, mode)
}

@doc """
Opaque runtime-managed file handle used by `File::with_open`.

`FileHandle` values are created and closed by the runtime. User code can
store a handle or return it from the callback passed to `File::with_open`,
but the file is closed before `with_open` returns. Reading, writing, or
flushing that closed handle returns `Err(FileClosed(...))`.

User code cannot construct or close handles directly. The runtime guarantees
cleanup when the callback returns, when the current VM run ends, and when
an interactive chunk is rolled back.

## REPL
Create `./tmp/sandbox/` before running this example.
xldr(1)> File::write("./tmp/sandbox/handle.txt", "hello")
Ok(())
xldr(2)> handle =? File::with_open("./tmp/sandbox/handle.txt", FileMode::Read, {|file| Ok(file)}); print(inspect(File::read_chunk(handle, 1)))
Err(FileClosed("file is already closed"))
handle: FileHandle = FileHandle#1
"""
@builtin type FileHandle

@doc """
Open mode for `File::with_open`.

Modes describe how one temporary handle is opened for the callback body.

- `Read`
  Read-only access. `File::write_chunk` returns `Err(FileHandleNotWritable(...))`.
- `Write`
  Create or truncate, then write from the start of the file.
- `Append`
  Create if missing and write at the end of the file.
- `ReadWrite`
  Open for both reading and writing. The write position starts at the
  beginning of the file.
- `ReadAppend`
  Open for reading and appending. Writes always target the end of the file.
"""
defenum FileMode {
  Read,
  Write,
  Append,
  ReadWrite,
  ReadAppend,
}

@doc """
UTF-8 text file helpers.

`File` is intentionally not auto-imported; use qualified calls such as
`File::read("./tmp/sandbox/note.txt")`.

All paths are resolved relative to the current working directory of the Surtr
process. In tests this usually means the project root of the current run.

Design boundaries for v1:
- text only: all read APIs decode UTF-8 into `String`
- no user-visible `close`: prefer `File::with_open` for structured resource use
- one-shot helpers (`read`, `write`, `append`, `delete`) open and close within
  a single call
- append-only process log sinks remain the responsibility of `FileOutHandler`,
  not `File`

## REPL
xldr(1)> File::write("./tmp/sandbox/repl-note.txt", "hello")
Ok(())
xldr(2)> File::read("./tmp/sandbox/repl-note.txt")
Ok("hello")
"""
defmod File {
  @doc """
  Read the whole file as UTF-8 text.

  This is the simplest entry point when the file comfortably fits in memory and
  chunked access is unnecessary. The file is opened, read, decoded, and closed
  within one call.

  Returns:
  - `Ok(text)` on success
  - `Err(FileNotFound(path))` when the path is missing
  - `Err(FileReadEncodingError(...))` when the bytes are not valid UTF-8
  - `Err(FilePermissionDenied(path))` or `Err(FileHandleNotWritable(...))` for host-side
    failures

  ## REPL
  xldr(1)> File::read("./tmp/sandbox/repl-note.txt")
  Ok("hello")
  """
  @builtin def read(path: String) -> Result<String>

  @doc """
  Create or truncate the file and write the whole text.

  Use this when replacing the entire contents of a text file. Missing parent
  directories are not created automatically.

  ## REPL
  xldr(1)> File::write("./tmp/sandbox/repl-note.txt", "alpha")
  Ok(())
  """
  @builtin def write(path: String, text: String) -> Result<Unit>

  @doc """
  Create the file if missing and append text to the end.

  This is a one-shot append helper for simple logging or incremental text
  accumulation. For multiple related writes, prefer `File::with_open` so one
  handle can be reused during the callback.

  ## REPL
  xldr(1)> File::append("./tmp/sandbox/repl-note.txt", "\\nbeta")
  Ok(())
  """
  @builtin def append(path: String, text: String) -> Result<Unit>

  @doc """
  Return `True` when the path exists.

  `exists` only reports presence. It does not prove the path is readable,
  writable, or a regular file.

  ## REPL
  xldr(1)> File::exists("./tmp/sandbox/repl-note.txt")
  True
  """
  @builtin def exists(path: String) -> Boolean

  @doc """
  Delete one file.

  Use this for ordinary file cleanup. Deleting a missing path returns
  `Err(FileNotFound(path))`.

  ## REPL
  xldr(1)> File::delete("./tmp/sandbox/repl-note.txt")
  Ok(())
  """
  @builtin def delete(path: String) -> Result<Unit>

  @doc """
  Open a file for the duration of `body`.

  The runtime always flushes and closes the handle before returning from this
  call, whether `body` returns `Ok(...)` or `Err(...)`.

  This is the primary API when several operations should share one open file.
  `FileHandle` values are opaque. A handle may be stored or returned from
  `body`, but it is closed before this call returns. Later read, write, or
  flush operations on it return `Err(FileClosed(...))`.

  Cleanup guarantee:
  - success path: flush, then close
  - error path from `body`: flush if possible, then close
  - VM shutdown or interactive rollback: remaining handles are closed by the VM

  Prefer this API over any manual open/close pattern. `File` does not expose a
  user-visible `close` function on purpose.

  ## REPL
  Create `./tmp/sandbox/` before running this example.
  xldr(1)> File::with_open("./tmp/sandbox/chunked.txt", FileMode::Write, {|file| _ =? File::write_chunk(file, "hello"); File::write_chunk(file, "\nworld")})
  Ok(())
  xldr(2)> File::read("./tmp/sandbox/chunked.txt")
  Ok("hello\nworld")
  """
  @builtin def with_open(path: String, mode: FileMode, body: (FileHandle -> Result<$A>)) -> Result<$A>

  @doc """
  Read at most `max_chars` UTF-8 characters from an opened file.
  Returns `Ok("")` at EOF.

  `max_chars` counts decoded UTF-8 characters rather than raw bytes. This makes
  the API predictable for text processing, though it is not intended as a
  binary streaming surface.

  ## REPL
  Create `./tmp/sandbox/` before running this example.
  xldr(1)> File::write("./tmp/sandbox/chunked.txt", "helloworld")
  Ok(())
  xldr(2)> File::with_open("./tmp/sandbox/chunked.txt", FileMode::Read, {|file| first =? File::read_chunk(file, 5); second =? File::read_chunk(file, 5); Ok((first, second))})
  Ok(("hello", "world"))
  """
  @builtin def read_chunk(file: FileHandle, max_chars: Int) -> Result<String>

  @doc """
  Write UTF-8 text through an opened file handle.

  The exact behavior depends on the `FileMode` used to open the handle.
  Writing through a `FileMode::Read` handle returns `Err(FileHandleNotWritable(...))`.

  ## REPL
  Create `./tmp/sandbox/` before running this example.
  xldr(1)> File::write("./tmp/sandbox/chunked.txt", "head")
  Ok(())
  xldr(2)> File::with_open("./tmp/sandbox/chunked.txt", FileMode::Append, {|file| File::write_chunk(file, "tail")})
  Ok(())
  xldr(3)> File::read("./tmp/sandbox/chunked.txt")
  Ok("headtail")
  """
  @builtin def write_chunk(file: FileHandle, text: String) -> Result<Unit>

  @doc """
  Flush buffered writes for an opened file handle.

  Most code does not need an explicit flush because `File::with_open` flushes on
  the way out. Call `flush` when the callback needs the host file contents to be
  visible before the callback returns.
  """
  @builtin def flush(file: FileHandle) -> Result<Unit>
}
