deferror InvalidTaskTransition(reason: String) {
  |reason: String|
  Self(message: "invalid task transition: #{reason}", reason)
}

defenum WorkflowTask {
  Draft(String),
  Open(String),
  Doing(String, String),
  Done(String),
  Archived(String),
}

impl WorkflowTask {
  def start(title: String) -> Self {
    WorkflowTask::Draft(title)
  }

  def open(self: Self) -> Result<Self, InvalidTaskTransition> {
    match self {
      WorkflowTask::Draft(title) => Ok(WorkflowTask::Open(title)),
      _ => Err(InvalidTaskTransition("only Draft tasks can be opened")),
    }
  }

  def assign(self: Self, assignee: String) -> Result<Self, InvalidTaskTransition> {
    match self {
      WorkflowTask::Open(title) => Ok(WorkflowTask::Doing(title, assignee)),
      _ => Err(InvalidTaskTransition("only Open tasks can be assigned")),
    }
  }

  def complete(self: Self) -> Result<Self, InvalidTaskTransition> {
    match self {
      WorkflowTask::Doing(title, _) => Ok(WorkflowTask::Done(title)),
      _ => Err(InvalidTaskTransition("only Doing tasks can be completed")),
    }
  }

  def archive(self: Self) -> Result<Self, InvalidTaskTransition> {
    match self {
      WorkflowTask::Done(title) => Ok(WorkflowTask::Archived(title)),
      _ => Err(InvalidTaskTransition("only Done tasks can be archived")),
    }
  }

  def title(self: Self) -> String {
    match self {
      WorkflowTask::Draft(title) => title,
      WorkflowTask::Open(title) => title,
      WorkflowTask::Doing(title, _) => title,
      WorkflowTask::Done(title) => title,
      WorkflowTask::Archived(title) => title,
    }
  }

  def status(self: Self) -> String {
    match self {
      WorkflowTask::Draft(_) => "draft",
      WorkflowTask::Open(_) => "open",
      WorkflowTask::Doing(_, assignee) => "doing:" ++ assignee,
      WorkflowTask::Done(_) => "done",
      WorkflowTask::Archived(_) => "archived",
    }
  }

  def render(self: Self) -> String {
    WorkflowTask::title(self) ++ " [" ++ WorkflowTask::status(self) ++ "]"
  }
}
