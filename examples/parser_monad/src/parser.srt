# Positions count Unicode scalar values, starting at zero.
@derive Eq
defstruct ParseInput {
  rest: String,
  offset: Int,
}

# A nominal wrapper keeps Parser recovery local to this carrier.
defstruct Parser<$A> {
  transition: StateT<ParseInput, Result, $A>,
}

impl Parser {
  def new(transition: (ParseInput -> Result<($A, ParseInput)>)) -> Parser<$A> {
    Parser::_store_transition(StateT::new(transition))
  }

  def run(self: Parser<$A>, input: ParseInput) -> Result<($A, ParseInput)> {
    StateT::run(Parser::_checked_transition(self), input)
  }

  def parse(self: Parser<$A>, text: String) -> Result<($A, ParseInput)> {
    Parser::run(self, ParseInput::new(text, 0))
  }

  def parse_all(self: Parser<$A>, text: String) -> Result<$A> {
    match Parser::parse(Parser::before(self, Parser::eof()), text) {
      Ok((value, _)) => Ok(value),
      Err(error) => Err(error),
    }
  }

  def pure(value: $A) -> Parser<$A> {
    transition = Applicative::pure::<StateT<ParseInput, Result, $A>>(value)
    Parser::_store_transition(transition)
  }

  def fail::<$A>(error: Error) -> Parser<$A> {
    transition = MonadFail::fail::<StateT<ParseInput, Result, $A>>(error)
    Parser::_store_transition(transition)
  }

  def reject::<$A>(expected: String) -> Parser<$A> {
    Parser::new({|input: ParseInput| Err(ParseMismatch(input.offset, expected))})
  }

  def recover(self: Parser<$A>, handler: (Error -> Parser<$A>)) -> Parser<$A> {
    Parser::new({|input: ParseInput|
      Result::recover(StateT::run(Parser::_checked_transition(self), input), {|error|
        StateT::run(Parser::_checked_transition(handler(error)), input)
      })
    })
  }

  def item() -> Parser<String> {
    Parser::satisfy({|_| True}, "character")
  }

  def satisfy(predicate: (String -> Boolean), expected: String) -> Parser<String> {
    Parser::new({|input: ParseInput|
      match input.rest {
        [head, ..tail] => {
          if(predicate(head), {
            Ok((head, ParseInput::new(tail, input.offset + 1)))
          }, { Err(ParseMismatch(input.offset, expected)) })
        },
        "" => Err(ParseMismatch(input.offset, expected)),
      }
    })
  }

  def char(text: String) -> Parser<String> {
    match String::chars(text) {
      [_] => Parser::satisfy({|value| value == text}, text),
      _ => Parser::fail(ParserConfigurationError("char requires one Unicode scalar")),
    }
  }

  def literal(text: String) -> Parser<String> {
    Parser::new({|input: ParseInput|
      match Parser::_literal(text, input) {
        Ok((_, next)) => Ok((text, next)),
        Err(error) => Err(error),
      }
    })
  }

  def eof() -> Parser<Unit> {
    Parser::new({|input: ParseInput|
      if(input.rest == "", { Ok(((), input)) }, { Err(ParseMismatch(input.offset, "end of input")) })
    })
  }

  def choice(left: Parser<$A>, right: Parser<$A>) -> Parser<$A> {
    Parser::new({|input: ParseInput|
      match Parser::run(left, input) {
        Ok(pair) => Ok(pair),
        Err(ParseMismatch(first_offset, _) @ first) => {
          if(Parser::_recoverable_mismatch(input, first), {
            match Parser::run(right, input) {
              Ok(pair) => Ok(pair),
              Err(ParseMismatch(second_offset, _) @ second) => {
                if(Parser::_recoverable_mismatch(input, second), {
                  if(second_offset > first_offset, { Err(second) }, { Err(first) })
                }, { Err(second) })
              },
              Err(error) => Err(error),
            }
          }, { Err(first) })
        },
        Err(error) => Err(error),
      }
    })
  }

  def many(self: Parser<$A>) -> Parser<List<$A>> {
    Parser::new({|input: ParseInput| Parser::_many(self, input, [])})
  }

  def some(self: Parser<$A>) -> Parser<List<$A>> {
    Parser::and_then(self, {|head|
      Parser::and_then(Parser::many(self), {|tail| Parser::pure([head, ..tail])})
    })
  }

  def optional(self: Parser<$A>) -> Parser<Option<$A>> {
    Parser::new({|input: ParseInput|
      match Parser::run(self, input) {
        Ok((value, next)) => Ok((Option::Some(value), next)),
        Err(error) => {
          if(Parser::_recoverable_mismatch(input, error), {
            Ok((Option<$A>::None, input))
          }, { Err(error) })
        },
      }
    })
  }

  def pair(left: Parser<$A>, right: Parser<$B>) -> Parser<($A, $B)> {
    Parser::and_then(left, {|first| Parser::and_then(right, {|second| Parser::pure((first, second))})})
  }

  def before(self: Parser<$A>, suffix: Parser<$B>) -> Parser<$A> {
    Parser::and_then(self, {|value| Parser::and_then(suffix, {|_| Parser::pure(value)})})
  }

  def after(prefix: Parser<$A>, parser: Parser<$B>) -> Parser<$B> {
    Parser::and_then(prefix, {|_| parser})
  }

  def between(open: Parser<$L>, parser: Parser<$A>, close: Parser<$R>) -> Parser<$A> {
    Parser::after(open, Parser::before(parser, close))
  }

  def sep_by1(self: Parser<$A>, separator: Parser<$S>) -> Parser<List<$A>> {
    Parser::and_then(self, {|head|
      Parser::and_then(Parser::many(Parser::after(separator, self)), {|tail| Parser::pure([head, ..tail])})
    })
  }

  def sep_by(self: Parser<$A>, separator: Parser<$S>) -> Parser<List<$A>> {
    Parser::new({|input: ParseInput|
      match Parser::run(Parser::sep_by1(self, separator), input) {
        Ok(pair) => Ok(pair),
        Err(ParseMismatch(position, _) @ original) => {
          if(Parser::_recoverable_mismatch(input, original) && position == input.offset, {
            Ok(([], input))
          }, { Err(original) })
        },
        Err(error) => Err(error),
      }
    })
  }

  def lazy(build: (Unit -> Parser<$A>)) -> Parser<$A> {
    Parser::new({|input: ParseInput| Parser::run(build(()), input)})
  }

  def map(self: Parser<$A>, mapper: ($A -> $B)) -> Parser<$B> {
    Parser::and_then(self, {|value| Parser::pure(mapper(value))})
  }

  def and_then(self: Parser<$A>, mapper: ($A -> Parser<$B>)) -> Parser<$B> {
    left: StateT<ParseInput, Result, $A> = Parser::_checked_transition(self)
    continuation: ($A -> StateT<ParseInput, Result, $B>) = {|value|
      Parser::_checked_transition(mapper(value))
    }
    bound: StateT<ParseInput, Result, $B> = Monad::bind(left, continuation)
    Parser::_store_transition(bound)
  }

  def ap(mapper: Parser<($A -> $B)>, value: Parser<$A>) -> Parser<$B> {
    Parser::_store_transition(Applicative::ap(Parser::_checked_transition(mapper), Parser::_checked_transition(value)))
  }

  # Saving a transition does not add another checking wrapper.
  defp _store_transition(transition: StateT<ParseInput, Result, $A>) -> Parser<$A> {
    Parser { transition }
  }

  # All execution and sequencing pass through this single state-contract check.
  defp _checked_transition(self: Parser<$A>) -> StateT<ParseInput, Result, $A> {
    StateT::new({|input: ParseInput|
      if(input.offset < 0, {
        Err(ParserStateError("input offset must be nonnegative"))
      }, {
        match StateT::run(self.transition, input) {
          Err(error) => Err(error),
          Ok((value, next)) => {
            if(!String::ends_with(input.rest, next.rest), {
              Err(ParserStateError("successful parser must return a suffix of its input"))
            }, {
              consumed = String::len(input.rest) - String::len(next.rest)
              if(next.offset < 0 || next.offset != input.offset + consumed, {
                Err(ParserStateError("successful parser offset must match consumed input"))
              }, { Ok((value, next)) })
            })
          },
        }
      })
    })
  }

  defp _literal(text: String, input: ParseInput) -> Result<(Unit, ParseInput)> {
    match text {
      "" => Ok(((), input)),
      [head, ..tail] => {
        match Parser::run(Parser::char(head), input) {
          Ok((_, next)) => Parser::_literal(tail, next),
          Err(error) => Err(error),
        }
      },
    }
  }

  # Only diagnostics inside this attempt's input range permit automatic recovery.
  defp _recoverable_mismatch(input: ParseInput, error: Error) -> Boolean {
    match error {
      ParseMismatch(position, _) => {
        position >= input.offset && position <= input.offset + String::len(input.rest)
      },
      _ => False,
    }
  }

  defp _many(self: Parser<$A>, input: ParseInput, acc: List<$A>) -> Result<(List<$A>, ParseInput)> {
    match Parser::run(self, input) {
      Ok((value, next)) => {
        if(next.offset == input.offset, {
          Err(ParserProgressError(input.offset))
        }, { Parser::_many(self, next, [value, ..acc]) })
      },
      Err(ParseMismatch(position, _) @ original) => {
        if(Parser::_recoverable_mismatch(input, original) && position == input.offset, {
          Ok((List::reverse(acc), input))
        }, { Err(original) })
      },
      Err(error) => Err(error),
    }
  }
}

impl ParseInput {
  def new(rest: String, offset: Int) -> ParseInput { ParseInput { rest, offset } }
}

impl Functor for Parser<$T> where $T: Functor.$A {
  def fmap(self: Parser<$A>, mapper: ($A -> $B)) -> Parser<$B> {
    Parser::map(self, mapper)
  }
}

impl Applicative for Parser<$T> where $T: Applicative.$A {
  def pure::<Parser<$T>>(value: $A) -> Parser<$A> { Parser::pure(value) }
  def ap(mapper: Parser<($A -> $B)>, value: Parser<$A>) -> Parser<$B> {
    Parser::ap(mapper, value)
  }
}

impl Monad for Parser<$T> where $T: Monad.$A {
  def return::<Parser<$T>>(value: $A) -> Parser<$A> { Parser::pure(value) }
  def bind(self: Parser<$A>, mapper: ($A -> Parser<$B>)) -> Parser<$B> {
    Parser::and_then(self, mapper)
  }
}

impl MonadFail for Parser<$T> {
  def fail::<Parser<$T>>(error: Error) -> Parser<$T> { Parser::fail(error) }
}

impl MonadRecover for Parser<$T> {
  def recover(self: Parser<$T>, handler: (Error -> Parser<$T>)) -> Parser<$T> {
    Parser::recover(self, handler)
  }
}

deferror ParseMismatch(offset: Int, expected: String) {
  |position: Int, expectation: String|
  Self(message: "at #{position}: expected #{expectation}", offset: position, expected: expectation)
}

deferror ParserConfigurationError(reason: String) {
  |detail: String|
  Self(message: detail, reason: detail)
}

deferror ParserProgressError(offset: Int) {
  |position: Int|
  Self(message: "repeated parser must consume input", offset: position)
}

deferror ParserStateError(reason: String) {
  |detail: String|
  Self(message: detail, reason: detail)
}
