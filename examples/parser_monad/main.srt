defmod ParserExample {
  def main() -> Unit {
    _show("2 + 3 * 4")
    _show("(2 + 3) * 4")
    _show("20 / 2 / 5")
    _show("1 +")
    _show("1 / 0")
  }

  defp _show(text: String) -> Unit {
    print("input: " ++ inspect(text))
    match Parser::parse_all(Arithmetic::parser(), text) {
      Ok(tree) => {
        print("AST: " ++ inspect(tree))
        print("value: " ++ inspect(Arithmetic::evaluate(tree)))
      },
      Err(ParseMismatch(offset, expected)) => print("parse error at scalar " ++ to_string(offset) ++ ": expected " ++ expected),
      Err(error) => print(Error::format(error)),
    }
  }
}
