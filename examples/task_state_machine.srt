include './task_state_types.srt'

def describe(result: Result<WorkflowTask>) -> String {
  match result {
    Ok(task) => WorkflowTask::render(task),
    Err(err) => Error::message(err),
  }
}

draft = WorkflowTask::start("write task-state sample")
open = WorkflowTask::open(draft)
doing = open |>= WorkflowTask::assign("haruca")
done = doing |>= WorkflowTask::complete()
archived = done |>= WorkflowTask::archive()

print(describe(archived))
print(describe(WorkflowTask::complete(WorkflowTask::start("skip required states"))))
