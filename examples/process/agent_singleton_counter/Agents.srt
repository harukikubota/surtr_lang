@@agent(kind: State, instance: Singleton, boot: true, registry: true, lazy: false)
defagent Counter {
  @init
  def init() -> Result<Int> {
    Ok(0)
  }

  @get
  def get(state: Int, label: String) -> Result<String> {
    Ok(label ++ "=" ++ to_string(state))
  }

  @set
  def set(state: Int, delta: Int) -> Result<Int> {
    next = state + delta
    if(next >= 0, Ok(next), Err(NoneError))
  }
}
