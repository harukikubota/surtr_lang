defagent Worker {
  meta {
    instance: Worker
    init_policy: Eager
  }

  @init
  def init(initial_jobs: Int) -> Result<Int> {
    if(initial_jobs >= 0, Ok(initial_jobs), Err(NoneError))
  }

  @get
  def get(state: Int, label: String) -> Result<String> {
    Ok(label ++ "=" ++ to_string(state))
  }

  @set
  def set(state: Int, completed_jobs: Int) -> Result<Int> {
    next = state - completed_jobs
    if(next >= 0, Ok(next), Err(NoneError))
  }
}
