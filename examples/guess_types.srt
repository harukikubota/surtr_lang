deferror EmptyGuessError {
  "Empty input. Enter one digit from 1 to 9."
}

deferror NotNumberGuessError(input: String) {
  |input: String|
  Self(message: "Not a number: #{inspect(input)}. Enter one digit from 1 to 9.", input)
}

deferror OutOfRangeGuessError(input: String) {
  |input: String|
  Self(message: "Out of range: #{input}. Enter a number from 1 to 9.", input)
}
